
	/**
	 * Overview method
	 *
	 * @throws \Exception
	 */
	public function overview(): void {
		$this->Authorization->ensure('read');

{% set belongsTo = Bake.aliasExtractor(modelObj, 'BelongsTo') %}
{% if belongsTo %}
		$this->paginate = [
			'contain' => {{ Bake.exportArray(belongsTo)|raw }},
		];
{% endif %}
		$lo_{{ pluralName }} = $this->paginate($this->{{ currentModelName }}->find());

		$this->set([
			'ao_{{ pluralName }}' => $lo_{{ pluralName }},
		]);
	}
