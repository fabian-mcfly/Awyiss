	/**
	 * Overview method
	 *
	 * @throws \Exception
	 */
	public function overview(): void {
		$this->Authorization->ensure('read');

{% set belongsTo = Bake.aliasExtractor(modelObj, 'BelongsTo') %}
{% if belongsTo %}
		$lo_query = $this->{{ currentModelName }}->find()->contain({{ Bake.exportArray(belongsTo)|raw }});
{% else %}
		$lo_query = $this->{{ currentModelName }}->find();
{% endif %}
		$lo_{{ pluralName }} = $this->paginate($lo_query);

		$this->set([
			'ao_{{ pluralName }}' => $lo_{{ pluralName }},
		]);
	}
