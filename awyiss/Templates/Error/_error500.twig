{% layout 'error' %}

{% block title %}
	error500.twig in root/Error

	{{ parent() }}
{% endblock %}

{% if staticCall('\\Cake\\Core\\Configure', 'read', 'debug') %}
	{% layout 'dev_error' %}

	{% do _view.assign('title', message) %}
	{% do _view.assign('templateName', 'error500.twig') %}

	{% do _view.start('file') %}

	{% if error.queryString %}
		<p class="notice">
			<strong>SQL Query: </strong>
			{{ error.queryString|escape }}
		</p>
	{% endif %}

	{% if error.params %}
		<strong>SQL Query Params: </strong>
		{{ staticCall('\\Cake\\Error\\Debugger', 'dump', error.params)|raw }}
	{% endif %}

	{% if error is instanceOf('Error') or error is instanceOf('Exception') %}
		<strong>Error in: </strong>
		{{ helper_Html_link('%s, line %s'|format(staticCall('\\Cake\\Error\\Debugger', 'trimPath', error.getFile), error.getLine), staticCall('\\Cake\\Error\\Debugger', 'editorUrl', error.getFile, error.getLine)) }}
	{% endif %}

	{{ element('error/auto_table_warning') }}

	{% do _view.end()%}

{% endif %}

<h2>{{ __('An Internal Error Has Occurred') }}</h2>
<p class="error">
	<strong>{{ __('Error') }}: </strong>
	{{ message|escape }}
</p>
