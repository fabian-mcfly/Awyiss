{#
@var ao_menu \Awyiss\Utilities\Menu\BackendMenu
@var _view \Awyiss\View\BackendView
#}

<div class="MenuEntries Overview">
	{% if helper_Authorization_isAccessible('create') %}
		{{ helper_Html_link(__('create'), {action: 'add'}, {class : 'Button'}) }}
	{% endif %}

	<h1>{{ __('headline_overview') }}</h1>

	<div class="table-responsive">
		<table>
			<thead>
				<tr>
					<th>{{ __('id') }}</th>
					<th>{{ __('title') }}</th>
					<th>{{ __('link') }}</th>
					<th class="actions"></th>
				</tr>
			</thead>
			<tbody>
				{# @var lo_menuEntry \Awyiss\Utilities\Menu\MenuEntry #}
				{% for lx_identifier, lo_menuEntry in ao_menu.getDynamicMenu().toArray() %}
				<tr>
					<td>{{ lx_identifier }}<br>
						level {{ lo_menuEntry.level }} - active {{ lo_menuEntry.active }}</td>
					<td>{{ lo_menuEntry.title }}</td>
					<td>{{ lo_menuEntry.link is defined ? lo_menuEntry.link.url : '' }}</td>
					<td class="actions">
						{% if lx_identifier is numeric %}
							{% if helper_Authorization_isAccessible('update') %}
								{{ helper_Html_link(__('edit'), {action: 'edit', id: lx_identifier}) }}
							{% endif %}
							{% if helper_Authorization_isAccessible('delete') %}
								{{ helper_Html_link(__('delete'), {action: 'delete', id: lx_identifier}, {confirm: __('confirm_delete', lx_identifier) }) }}
							{% endif %}
						{% endif %}
					</td>
				</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
</div>
