{#
@var ao_menus Awyiss\Model\Entity\Menu[]
@var _view \Awyiss\View\BackendView
#}

<div class="Menus Overview">
	{% if helper_Authorization_isAccessible('create') %}
		{{ helper_Html_link(__('create'), {action: 'add'}, {class: 'Button'}) }}
	{% endif %}

	<h1>{{ __('headline_overview') }}</h1>

	<div class="table-responsive">
		<table>
			<thead>
				<tr>
					<th>{{ helper_Paginator_sort('id') }}</th>
					<th>{{ helper_Paginator_sort('title') }}</th>
					<th>{{ helper_Paginator_sort('identifier') }}</th>
					<th>{{ helper_Paginator_sort('active') }}</th>
					<th class="actions"></th>
				</tr>
			</thead>
			<tbody>
				{% for lo_menu in ao_menus %}
				<tr>
					<td>{{ helper_Number_format(lo_menu.id) }}</td>
					<td>{{ lo_menu.title }}</td>
					<td>{{ lo_menu.identifier }}</td>
					<td>{{ lo_menu.active }}</td>
					<td class="actions">
						{% if helper_Authorization_scopeIsAccessible('MenuEntries', [], ['read']) %}
							{{ helper_Html_link(__('view_entries'), {controller: 'MenuEntries', action: 'overview', menu_id: lo_menu.id}) }}
						{% endif %}

						{% if helper_Authorization_isAccessible('update') %}
							{{ helper_Html_link(__('edit'), {action: 'edit', id: lo_menu.id}) }}
						{% endif %}

						{% if helper_Authorization_isAccessible('delete') %}
							{{ helper_Html_link(__('delete'), {action: 'delete', id: lo_menu.id}, {confirm: __('confirm_delete', lo_menu.id) }) }}
						{% endif %}
					</td>
				</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
	{{ helper_Paginator_render() }}
</div>
