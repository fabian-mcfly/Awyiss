<!DOCTYPE html>
<html>
	<head>
		{{ helper_Html_charset() }}
		<title>
			{{ fetch('title') }}
		</title>
		{{ helper_Html_meta('icon') }}

		<link href="https://fonts.googleapis.com/css?family=Lato:400,700" rel="stylesheet">

		{{ helper_Html_css(['normalize.min', 'milligram.min', 'cake']) }}

		{{ fetch('meta') }}
		{{ fetch('css') }}
		{{ fetch('script') }}
	</head>
	<body>
		<div class="error-container">
			{{ helper_Flash_render() }}
			{{ fetch('content') }}
			{{ helper_Flash_render(__('Back'), 'javascript:history.back()') }}
		</div>
	</body>
</html>
