<!DOCTYPE html>
<html lang="en">
	<head>
		{{ helper_Html_charset() }}
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>
			{{ fetch('title') }}
		</title>
		{{ helper_Html_meta('icon') }}

		<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">

		{{ helper_Html_css(['normalize.min', 'milligram.min', 'cake']) }}

		{{ fetch('meta') }}
		{{ fetch('css') }}
		{{ fetch('script') }}
	</head>
	<body>
		{% block sidebar %}
			<aside id="Sidebar">
				<a href="{{ helper_Url_build({controller: 'dashboard', action: 'overview'}) }}" class="Title">Aw<span>Yiss</span></a>

				{% block systemMenu %}
					{{ cell('Backend/Menu') }}

					{#
					<ul class="Menu-System">
						{% if helper_Authorization_scopeIsAccessible('Pages', null, ['read']) %}
							<li>{{ helper_Html_link(__d('pages', 'title_menu'), {controller: 'Pages', action: 'overview'}) }}</li>
						{% endif %}

						{% if helper_Authorization_scopeIsAccessible('Matches', null, ['read']) %}
							<li>{{ helper_Html_link(__d('matches', 'title_menu'), {controller: 'Matches', action: 'overview'}) }}</li>
						{% endif %}

						{% if helper_Authorization_scopeIsAccessible('Promotions', null, ['read']) %}
							<li>{{ helper_Html_link(__d('promotions', 'title_menu'), {controller: 'Promotions', action: 'overview'}) }}</li>
						{% endif %}

						{% if helper_Authorization_scopeIsAccessible('PromotionTests', null, ['read']) %}
							<li>{{ helper_Html_link(__d('promotion_tests', 'title_menu'), {controller: 'PromotionTests', action: 'overview'}) }}</li>
						{% endif %}

						{% if helper_Authorization_scopeIsAccessible('ContentTemplates', null, ['read']) %}
							<li>{{ helper_Html_link(__d('content_templates', 'title_menu'), {controller: 'ContentTemplates', action: 'overview'}) }}</li>
						{% endif %}

						{% if helper_Authorization_scopeIsAccessible('Languages', null, ['read']) %}
							<li>{{ helper_Html_link(__d('languages', 'title_menu'), {controller: 'Languages', action: 'overview'}) }}</li>
						{% endif %}

						{% if helper_Authorization_scopeIsAccessible('PageRoles', null, ['read']) %}
							<li>{{ helper_Html_link(__d('page_roles', 'title_menu'), {controller: 'PageRoles', action: 'overview'}) }}</li>
						{% endif %}

						{% if helper_Authorization_scopeIsAccessible('PageTemplates', null, ['read']) %}
							<li>{{ helper_Html_link(__dx('page_templates', 'menu', 'title'), {controller: 'PageTemplates', action: 'overview'}) }}</li>
						{% endif %}

						{% if helper_Authorization_scopeIsAccessible('Configuration', {scope: ''}, ['read']) %}
							<li>{{ helper_Html_link(__d('configuration', 'title_menu'), {controller: 'Configuration', action: 'overview'}) }}</li>
						{% endif %}

						{% if helper_Authorization_scopeIsAccessible('Users', null, ['read']) %}
							<li>{{ helper_Html_link(__d('users', 'title_menu'), {controller: 'Users', action: 'overview'}) }}</li>
						{% endif %}

						{% if helper_Authorization_scopeIsAccessible('Usergroups', null, ['read']) %}
							<li>{{ helper_Html_link(__d('usergroups', 'title_menu'), {controller: 'Usergroups', action: 'overview'}) }}</li>
						{% endif %}

						{% if helper_Authorization_scopeIsAccessible('Attributes', null, ['read']) %}
							<li>{{ helper_Html_link(__d('attributes', 'title_menu'), {controller: 'Attributes', action: 'overview'}) }}</li>
						{% endif %}

						{% if helper_Authorization_scopeIsAccessible('Menus', null, ['read']) %}
							<li>{{ helper_Html_link(__d('menus', 'title_menu'), {controller: 'Menus', action: 'overview'}) }}</li>
						{% endif %}
					</ul>
					#}
				{% endblock %}
			</aside>
		{% endblock %}
		{% block body %}
			<div id="Body">
				{% block content %}
					<main id="Content">
						{{ helper_Flash_render() }}
						{{ fetch('content') }}
					</main>
				{% endblock %}
				{% block footer %}
					<footer>
						{{ helper_Html_link(__d('users', 'logout'), {controller: 'users', action: 'logout'}) }}
					</footer>
				{% endblock %}
			</div>
		{% endblock %}
	</body>
</html>
