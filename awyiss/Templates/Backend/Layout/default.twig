<!DOCTYPE html>
<html lang="en">
	<head>
		{{ helper_Html_charset() }}
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>
			{{ fetch('title') }}
		</title>
		{{ helper_Html_meta('icon') }}

		<link href="https://fonts.googleapis.com/css?family=Lato:400,700" rel="stylesheet">

		{{ helper_Html_css(['normalize.min', 'milligram.min', 'cake']) }}

		{{ fetch('meta') }}
		{{ fetch('css') }}
		{{ fetch('script') }}
	</head>
	<body>
		{% block sidebar %}
			<aside id="Sidebar">
				<a href="{{ helper_Url_build({controller: 'dashboard'}) }}" class="Title">Aw<span>Yiss</span></a>

				{% block system_menu %}
					<ul class="Menu-System">
						{% if helper_Access_scopeIsAccessible('ContentTemplates', NULL, ['create', 'update', 'delete']) %}
							<li>{{ helper_Html_link(__('contentTemplates::title_menu'), {controller: 'ContentTemplates'}) }}</li>
						{% endif %}

						{% if helper_Access_scopeIsAccessible('Languages', NULL, ['create', 'update', 'delete']) %}
							<li>{{ helper_Html_link(__('languages::title_menu'), {controller: 'Languages'}) }}</li>
						{% endif %}

						{% if helper_Access_scopeIsAccessible('PageRoles', NULL, ['create', 'update', 'delete']) %}
							<li>{{ helper_Html_link(__('pageRoles::title_menu'), {controller: 'PageRoles'}) }}</li>
						{% endif %}

						{% if helper_Access_scopeIsAccessible('PageTemplates', NULL, ['create', 'update', 'delete']) %}
							<li>{{ helper_Html_link(__('pageTemplates::title_menu'), {controller: 'PageTemplates'}) }}</li>
						{% endif %}

						{% if helper_Access_scopeIsAccessible('Configuration', NULL, ['create', 'update', 'delete']) %}
							<li>{{ helper_Html_link(__('configuration::title_menu'), {controller: 'Configuration'}) }}</li>
						{% endif %}

						{% if helper_Access_scopeIsAccessible('Users', NULL, ['create', 'update', 'delete']) %}
							<li>{{ helper_Html_link(__('users::title_menu'), {controller: 'Users'}) }}</li>
						{% endif %}

						{% if helper_Access_scopeIsAccessible('Usergroups', NULL, ['create', 'update', 'delete']) %}
							<li>{{ helper_Html_link(__('usergroups::title_menu'), {controller: 'Usergroups'}) }}</li>
						{% endif %}
					</ul>
				{% endblock %}
			</aside>
		{% endblock %}
		{% block body %}
			<div id="Body">
				{% block content %}
					<main id="Content">
						{{ helper_Flash_render() }}
						{{ fetch('content') }}
					</main>
				{% endblock %}
				{% block footer %}
					<footer>
						{{ helper_Html_link(__('users::logout'), {controller: 'users', action: 'logout'}) }}
					</footer>
				{% endblock %}
			</div>
		{% endblock %}
	</body>
</html>
