{# @var ao_usergroup \Awyiss\Model\Entity\Usergroup #}
{# @var ao_users \Awyiss\Model\Entity\User[] #}
{# @var aa_authorizationPolicies array #}
{# @var _view \Awyiss\View\BackendView #}

<div class="Usergroups Form Edit">
	{{ helper_Form_create(ao_usergroup, {method: 'post', idPrefix: 'Usergroup'}) }}

	<h1>{{ __('::headline_edit') }}</h1>

	<fieldset>
		<legend>{{ __('::fieldset_general') }}</legend>
		{{ helper_Form_control('active') }}

		{{ helper_Form_control('title') }}
	</fieldset>

	{% if helper_Access_scopeIsAccessible('Users', NULL, ['create', 'update', 'delete']) %}
		<fieldset>
			<legend>{{ __('::users') }}</legend>
			{{ helper_Form_hidden('users._ids', {value: ''}) }}
			<ul class="NoList">
				{% for lo_user in ao_users %}
					<li>
						{{ helper_Form_control('users._ids.' ~ lo_user.id, {
							hiddenField: FALSE,
							type: 'checkbox',
							value: lo_user.id,
							label: lo_user.username,
							checked: lo_user.id in (ao_usergroup.users ?? [])|column('id'),
						}) }}
					</li>
				{% endfor %}
			</ul>
		</fieldset>
	{% endif %}

	<fieldset>
		<legend>{{ __('::permissions') }}</legend>

		{% for lx_policyClass in aa_authorizationPolicies %}
			<fieldset>
				<legend>{{ lx_policyClass is string ? staticCall(lx_policyClass, 'getScope') : lx_policyClass.getScope }}</legend>
				<ul class="NoList Permissions">
					{% set lo_permissions = lx_policyClass is string ? staticCall(lx_policyClass, 'getPermissions') : lx_policyClass.getPermissions %}
					{% for ls_identifier,lo_permission in lo_permissions %}
						{# @var lo_permission \Awyiss\Authorization\Permission\PermissionInterface #}
						<li class="Permission">
							{{ __('::' ~ ls_identifier) }}
							{{ helper_Permission_options(lo_permission, ao_usergroup, NULL, 'Usergroups') }}
							{# $lo_permissions->getSettings()->render($this, 'usergroups') #}
						</li>
					{% endfor %}
				</ul>
			</fieldset>
		{% endfor %}
	</fieldset>

	{{ helper_Form_hidden('reload_form', {val: 0}) }}

	{{ helper_Form_button(__('::save')) }}
	{{ helper_Form_button(__('::save_close'), {name: 'submit', value: 'submit_close'}) }}
	{{ helper_Form_end() }}
</div>