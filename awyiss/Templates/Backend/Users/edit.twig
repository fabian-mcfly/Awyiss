<div class="Users Form Edit">
	{{ helper_Form_create(ao_user, {method: 'post', idPrefix: 'user'}) }}

	<h1>{{ __('headline_edit') }}</h1>

	{% block formButtons %}
		{{ helper_Form_button(__('save')) }}
