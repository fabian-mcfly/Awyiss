{#
@var ao_users \Awyiss\Model\Entity\User[]
@var _view \Awyiss\View\BackendView
#}

<div class="Users Overview">
	{% block buttonsOverview %}
		{% if helper_Authorization_isAccessible('create') %}
			{{ helper_Html_link(__('create'), {action: 'add'}, {class: 'Button'}) }}
		{% endif %}
	{% endblock %}

	{% block headlineOverview %}
		<h1>{{ __('headline_overview') }}</h1>
	{% endblock %}

	{% block categoriesFilterOverview %}
		{{ helper_Categories_filter('usergroup') }}
	{% endblock %}

	{% block tableOverview %}
		<table class="Table-Overview">
			{% block tableOverviewHead %}
				<thead>
					{% block tableOverviewHeadRow %}
						<tr>
							{% block tableOverviewHeaderUsername %}
								<th>{{ helper_Paginator_sort('username') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderLastLogin %}
								<th>{{ helper_Paginator_sort('last_login') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderFirstname %}
								<th>{{ helper_Paginator_sort('firstname') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderLastname %}
								<th>{{ helper_Paginator_sort('lastname') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderEmail %}
								<th>{{ helper_Paginator_sort('email') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderActions %}
								<th class="actions"></th>
							{% endblock %}
						</tr>
					{% endblock %}
				</thead>
			{% endblock %}
			{% block tableOverviewBody %}
				<tbody>
					{# @var lo_user \Awyiss\Model\Entity\User #}
					{% for lo_user in ao_users %}
						{% block tableOverviewBodyRow %}
							<tr>
								{% block tableOverviewCellUsername %}
									<td>{{ lo_user.username }}</td>
								{% endblock %}

								{% block tableOverviewCellLastLogin %}
									<td>{{ lo_user.last_login is defined ? helper_Time_format(lo_user.last_login) : '' }}</td>
								{% endblock %}

								{% block tableOverviewCellFirstname %}
									<td>{{ lo_user.firstname }}</td>
								{% endblock %}

								{% block tableOverviewCellLastname %}
									<td>{{ lo_user.lastname }}</td>
								{% endblock %}

								{% block tableOverviewCellEmail %}
									<td>{{ lo_user.email }}</td>
								{% endblock %}

								{% block tableOverviewCellActions %}
									<td class="actions">
										{% if helper_Authorization_isAccessible('update') %}
											{{ helper_Html_link(__('edit'), {action: 'edit', id: lo_user.id}) }}
										{% endif %}
										{% if helper_Authorization_isAccessible('delete') %}
											{{ helper_Html_link(__('delete'), {action: 'delete', id: lo_user.id}) }}
										{% endif %}
									</td>
								{% endblock %}
							</tr>
						{% endblock %}
					{% endfor %}
				</tbody>
			{% endblock %}
		</table>
	{% endblock %}

	{% block paginationOverview %}
		{{ helper_Paginator_render() }}
	{% endblock %}
</div>
