{# @var ao_configuration \Awyiss\Model\Entity\Configuration #}
{# @var aa_configScopes array #}
{# @var ao_configOptions \Awyiss\ConfigOptions\AbstractConfigOptions #}
{# @var _view \Awyiss\View\BackendView #}

<div class="Configuration Form Add">
	{{ helper_Form_create(ao_configuration, {method: 'post', idPrefix: 'Configuration'}) }}

	<h1>{{ __('::headline_add') }}</h1>

	<fieldset>
		<legend>{{ __('::headline_add') }}</legend>
		{{ helper_Form_control('scope', {options: naturalSort(aa_configScopes|map((value,key) => __(key ~ '::title')))}) }}
		{{ helper_Form_control('name') }}

		<label>
			<select name="">
				<option value=""></option>
				{{ _self.recursiveConfigOptions(ao_configOptions) }}
			</select>
		</label>

		{{ helper_Form_control('value') }}
		{{ helper_Locale_control('languages_shortcode') }}
	</fieldset>

	{{ helper_Form_hidden('reload_form', {val: 0}) }}

	{{ helper_Form_button(__('::save')) }}
	{{ helper_Form_button(__('::save_close'), {name: 'submit', value: 'submit_close'}) }}
	{{ helper_Form_end() }}
</div>


{% macro recursiveConfigOptions(aa_items, ai_level = 0, aa_parent = []) %}
	{% for ls_key, lx_configuration in aa_items %}
		{% if lx_configuration is iterable %}
			{% if ai_level == 0 %}
				<optgroup label="{{ ls_key }}">
					{{ _self.recursiveConfigOptions(lx_configuration, ai_level + 1, aa_parent|merge([ls_key])) }}
				</optgroup>
			{% else %}
				{{ _self.recursiveConfigOptions(lx_configuration, ai_level + 1, aa_parent|merge([ls_key])) }}
			{% endif %}
		{% else %}
			<option>{{ aa_parent|length > 1 ? aa_parent|slice(-1)|join('.') ~ '.' : '' }}{{ ls_key }}</option>
		{% endif %}
	{% endfor %}
{% endmacro %}