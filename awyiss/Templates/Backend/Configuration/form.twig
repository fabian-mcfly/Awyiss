{#
@var ao_configuration \Awyiss\Model\Entity\Configuration
@var aa_configScopes array
@var aa_configOptions array
@var aa_realms array
@var _view \Awyiss\View\BackendView
#}

{% macro recursiveConfigOptions(aa_items, ai_level = 0, aa_parent = []) %}
	{% for ls_key, lx_configuration in aa_items %}
		{% if lx_configuration is iterable %}
			{% if ai_level == 0 %}
				<optgroup label="{{ ls_key }}">
					{{ _self.recursiveConfigOptions(lx_configuration, ai_level + 1, aa_parent|merge([ls_key])) }}
				</optgroup>
			{% else %}
				{{ _self.recursiveConfigOptions(lx_configuration, ai_level + 1, aa_parent|merge([ls_key])) }}
			{% endif %}
		{% else %}
			<option>{{ aa_parent|length > 0 ? aa_parent|join('.') ~ '.' : '' }}{{ ls_key }}</option>
		{% endif %}
	{% endfor %}
{% endmacro %}

{% block fieldsetPresentation %}
	<fieldset>
		<legend>{{ __('fieldset_presentation') }}</legend>

		{% block fieldsetPresentationInner %}
			{% block fieldsetPresentationAttributes %}
				{{ helper_Attributes_allControls('presentation') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetConditions %}
	<fieldset>
		<legend>{{ __('fieldset_conditions') }}</legend>

		{% block fieldsetConditionsInner %}
			{% block formControlScope %}
				{{ helper_Form_control('scope', {options: naturalSort(aa_configScopes|map((value,key) => __d(key, 'title')))}) }}
			{% endblock %}

			{% block formControlRealm %}
				{{ helper_Form_control('realm', {options: combine(aa_realms, aa_realms)}) }}
			{% endblock %}

			{% block formControlLanguageShortcode %}
				{{ helper_Locale_control('language_shortcode', {realm: ao_configuration.realm}) }}
			{% endblock %}

			{% block fieldsetConditionsAttributes %}
				{{ helper_Attributes_allControls('conditions') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetGeneral %}
	<fieldset>
		<legend>{{ __('fieldset_general') }}</legend>

		{% block fieldsetGeneralInner %}
			{% block formControlIdentifier %}
				{{ helper_Form_control('identifier') }}

				{% block formControlIdentifierSelect %}
					<label>
						<select name="">
							<option value=""></option>
							{{ _self.recursiveConfigOptions(aa_configOptions) }}
						</select>
					</label>
				{% endblock %}
			{% endblock %}

			{% block formControlValue %}
				{{ helper_Form_control('value') }}
			{% endblock %}

			{% block fieldsetGeneralAttributes %}
				{{ helper_Attributes_allControls('general') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetContent %}
	<fieldset>
