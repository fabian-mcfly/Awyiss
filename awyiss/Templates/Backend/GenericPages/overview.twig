{#
@var ao_pages \Awyiss\Model\Entity\Page[]
@var _view \Awyiss\View\BackendView
#}

<div class="Pages Overview">
	{% if helper_Authorization_isAccessible('create') %}
		{{ helper_Html_link(__('create'), {action: 'add'}, {class: 'Button' }) }}
	{% endif %}

	<h1>{{ __('headline_overview') }}</h1>

	{{ helper_Categories_filter('category') }}

	<div class="table-responsive">
		<table>
			<thead>
				<tr>
					<th>{{ __('id') }}</th>
					<th>{{ __('title') }}</th>
					<th>{{ __('system_order') }}</th>
					<th class="actions"></th>
				</tr>
			</thead>
			<tbody>
				{% for lo_page in ao_pages %}
					<tr>
						<td>{{ lo_page.id }}</td>
						<td>{{ lo_page.title }} <br> {{ lo_page.slug }}</td>
						<td>level {{ lo_page.level }} - order {{ lo_page.systemOrder }}</td>
						<td class="actions">
							{% if lo_page.duplicate_of is empty and helper_Authorization_isAccessible('contents') and localConfig('contents.enabled', false) == true %}
								{{ helper_Html_link(__('view_contents'), {controller: 'contents', action: 'overview', page_id: lo_page.id}) }}
							{% endif %}

							{% if helper_Authorization_isAccessible('update') %}
								{{ helper_Html_link(__('edit'), {action: 'edit', id: lo_page.id}) }}
							{% endif %}

							{% if helper_Authorization_isAccessible('delete') %}
								{{ helper_Html_link(__('delete'), {action: 'delete', id: lo_page.id}, {confirm: __('confirm_delete', lo_page.id) }) }}
							{% endif %}
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
</div>
