{#@var ao_pages Awyiss\Model\Entity\Page[] #}
{#@var _view \Awyiss\View\BackendView #}

<div class="Pages Overview">
	{{ helper_Html_link(__('::create'), {action : 'add'}, {class : 'Button' }) }}
	<h1>{{ __('::headline_overview') }}</h1>
	<div class="table-responsive">
		<table>
			<thead>
				<tr>
					<th>{{ helper_Paginator_sort('id') }}</th>
					<th>{{ helper_Paginator_sort('title') }}</th>
					<th>{{ helper_Paginator_sort('slug') }}</th>
					<th>{{ helper_Paginator_sort('language_shortcode') }}</th>
					<th>{{ helper_Paginator_sort('system_order') }}</th>
					<th>{{ helper_Paginator_sort('duplicate_of') }}</th>
					<th>{{ helper_Paginator_sort('active') }}</th>
					<th class="actions"></th>
				</tr>
			</thead>
			<tbody>
				{% for lo_page in ao_pages %}
					<tr>
						<td>{{ lo_page.id }} {{ lo_page.level }}</td>
						<td>{{ lo_page.title }}</td>
						<td>{{ lo_page.slug }}</td>
						<td>{{ lo_page.language_shortcode }}</td>
						<td>{{ lo_page.system_order }}</td>
						<td>{{ lo_page.duplicate_of }}</td>
						<td>{{ lo_page.active }}</td>
						<td class="actions">
							{% if helper_Access_scopeIsAccessible('Contents', NULL, NULL, ['read']) %}
								{{ helper_Html_link(__('::view_contents'), {controller: 'contents', action: 'overview', page_id: lo_page.id}) }}
							{% endif %}

							{% do helper_Access_setPolicyClass(policyClass) %}

							{% if helper_Access_isAccessible('update') %}
								{{ helper_Html_link(__('::edit'), {action: 'edit', id: lo_page.id}) }}
							{% endif %}

							{% if helper_Access_isAccessible('delete') %}
								{{ helper_Html_link(__('::delete'), {action: 'delete', id: lo_page.id}, {confirm: __('::confirm_delete', lo_page.id) }) }}
							{% endif %}

							{% do helper_Access_setPolicyClass(NULL) %}
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
	{{ helper_Paginator_render() }}
</div>
