{#
@var ao_page \Awyiss\Model\Entity\Page
@var ao_pageTemplates \Cake\Collection\CollectionInterface
@var ao_threadedPages \Cake\Collection\CollectionInterface
@var as_languageRealm string
@var _view \Awyiss\View\BackendView
#}

{% block fieldsetPresentation %}
	<fieldset>
		<legend>{{ __('fieldset_presentation') }}</legend>

		{% block fieldsetPresentationInner %}
			{% block formControlActive %}
				{{ helper_Form_control('active') }}
			{% endblock %}

			{% block formControlPageTemplateId %}
				{{ helper_Form_control('page_template_id', {empty: false, options: ao_pageTemplates.combine('id', 'label')}) }}
			{% endblock %}

			{% block fieldsetPresentationAttributes %}
				{{ helper_Attributes_allControls('presentation') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetConditions %}
	<fieldset>
		<legend>{{ __('fieldset_conditions') }}</legend>

		{% block fieldsetConditionsInner %}
			{% block formControlLanguageShortcode %}
				{{ helper_Locale_control('language_shortcode', {languageRealm: as_languageRealm}) }}
			{% endblock %}

			{% block formControlParentId %}
				{{ helper_Form_control('parent_id', {options: ao_threadedPages.printer('label', 'id', '- ')}) }}
			{% endblock %}

			{% if localConfig('systemOrder.field', 'systemOrder') == 'systemOrder' %}
				{% block formControlSystemOrder %}
					{{ helper_SystemOrder_control('system_order') }}
				{% endblock %}
			{% endif %}

			{% block formControlDuplicateOf %}
				{{ helper_Form_control('duplicate_of', {options: ao_threadedPages.printer('label', 'id', '- ')}) }}
			{% endblock %}

			{% block fieldsetConditionsAttributes %}
				{{ helper_Attributes_allControls('conditions') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetGeneral %}
	<fieldset>
		<legend>{{ __('fieldset_general') }}</legend>

		{% block fieldsetGeneralInner %}
			{% block formControlTitle %}
				{{ helper_Form_control('title') }}
			{% endblock %}

			{% block formControlSlug %}
				{{ helper_Form_control('slug', {required: false}) }}
			{% endblock %}

			{% block fieldsetGeneralAttributes %}
				{{ helper_Attributes_allControls('general') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

