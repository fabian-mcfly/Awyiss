{# @var ao_permission \Awyiss\Authorization\PermissionOptions\SimplePermissionOption #}
{# @var ao_entity \Awyiss\Model\Entity\Usergroup|NULL #}
{# @var as_identifier string #}
{# @var as_scope string #}
{# @var _view \Awyiss\View\BackendView #}

{% set ls_fieldName = 'permissions[' ~ as_scope ~ '][' ~ as_identifier ~ ']' %}
{% set ls_label = 'Permissions-' ~ as_scope|camelize ~ '-' ~ as_identifier|camelize %}
{% set lx_value = ao_entity.usergroup_permissions[ as_scope ][ as_identifier ].access ?? NULL %}
{% set la_options = ao_permission.getOptions %}

<span class="Options SimpleRadio">
	<input type="radio" name="{{ ls_fieldName }}" value="{{ la_options.granted }}"
		{{ lx_value is same as (la_options.granted) ? 'checked="checked"' : '' }}
		id="{{ ls_label ~ '-' ~ la_options.granted }}">

	<input type="radio" name="{{ ls_fieldName }}" value="{{ la_options.indifferent }}"
		{{ lx_value is same as (la_options.indifferent) ? 'checked="checked"' : '' }}
		id="{{ ls_label }}">

	<input type="radio" name="{{ ls_fieldName }}" value="{{ la_options.denied }}"
		{{ lx_value is same as (la_options.denied) ? 'checked="checked"' : '' }}
		id="{{ ls_label ~ '-' ~ la_options.denied }}">

	<span class="Labels">
		<label for="{{ ls_label ~ '-' ~ la_options.granted }}">{{ __('::simple_permission_option_granted') }}</label>
		<label for="{{ ls_label }}">{{ __('::simple_permission_option_indifferent') }}</label>
		<label for="{{ ls_label ~ '-' ~ la_options.denied }}">{{ __('::simple_permission_option_denied') }}</label>
	</span>
</span>
