{# @var ao_permission \Awyiss\Authorization\Permission\SimplePermission #}
{# @var ao_entity \Awyiss\Model\Entity\Usergroup|NULL #}
{# @var as_identifier string #}
{# @var as_scope string #}
{# @var _view \Awyiss\View\BackendView #}

{% set ls_fieldName = 'permissions[' ~ as_scope ~ '][' ~ as_identifier ~ ']' %}
{% set ls_label = 'Permissions-' ~ as_scope|camelize ~ '-' ~ as_identifier|camelize %}
{% set lx_value = ao_entity.usergroup_permissions[ as_scope ][ as_identifier ].access ?? NULL %}
{% set la_options = [
	{
		id: ls_label ~ '-' ~ constant('OPTION_GRANTED', ao_permission),
		text: '',
		value: constant('OPTION_GRANTED', ao_permission),
	},
	{
		id: ls_label ~ '-' ~ constant('OPTION_INDIFFERENT', ao_permission),
		text: '',
		value: constant('OPTION_INDIFFERENT', ao_permission),
	},
	{
		id: ls_label ~ '-' ~ constant('OPTION_DENIED', ao_permission),
		text: '',
		value: constant('OPTION_DENIED', ao_permission),
	},
] %}


<span class="Options SimpleRadio">
	<input type="radio" name="{{ ls_fieldName }}" value="{{ constant('OPTION_GRANTED', ao_permission) }}"
		{{ lx_value is same as(constant('OPTION_GRANTED', ao_permission)) ? 'checked="checked"' : '' }}
		id="{{ ls_label ~ '-' ~ constant('OPTION_GRANTED', ao_permission) }}">

	<input type="radio" name="{{ ls_fieldName }}" value="{{ constant('OPTION_INDIFFERENT', ao_permission) }}"
		{{ lx_value is same as(constant('OPTION_INDIFFERENT', ao_permission)) ? 'checked="checked"' : '' }}
		id="{{ ls_label ~ '-' ~ constant('OPTION_INDIFFERENT', ao_permission) }}">

	<input type="radio" name="{{ ls_fieldName }}" value="{{ constant('OPTION_DENIED', ao_permission) }}"
		{{ lx_value is same as(constant('OPTION_DENIED', ao_permission)) ? 'checked="checked"' : '' }}
		id="{{ ls_label ~ '-' ~ constant('OPTION_DENIED', ao_permission) }}">

	<span class="Labels">
		<label for="{{ ls_label ~ '-' ~ constant('OPTION_GRANTED', ao_permission) }}">{{ __('::simple_permission_option_granted') }}</label>
		<label for="{{ ls_label ~ '-' ~ constant('OPTION_INDIFFERENT', ao_permission) }}">{{ __('::simple_permission_option_indifferent') }}</label>
		<label for="{{ ls_label ~ '-' ~ constant('OPTION_DENIED', ao_permission) }}">{{ __('::simple_permission_option_denied') }}</label>
	</span>
</span>
