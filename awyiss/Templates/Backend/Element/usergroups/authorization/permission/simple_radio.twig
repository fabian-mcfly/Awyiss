{# @var ao_permission \Awyiss\Authorization\Permission\SimplePermission #}
{# @var ao_entity \Awyiss\Model\Entity\Usergroup|NULL #}
{# @var as_identifier string #}
{# @var as_scope string #}
{# @var _view \Awyiss\View\BackendView #}

{% set ls_fieldName = 'permissions[' ~ as_scope ~ '][' ~ as_identifier ~ ']' %}
{% set ls_label = ls_fieldName|slug|lower %}
{% set lx_value = ao_entity.usergroup_permissions[ as_scope ][ as_identifier ].access ?? NULL %}
{% set la_options = {
	(constant('OPTION_GRANTED', ao_permission)): NULL,
	(constant('OPTION_INDIFFERENT', ao_permission)): NULL,
	(constant('OPTION_DENIED', ao_permission)): NULL,
} %}

{{ helper_Form_radio(ls_fieldName, la_options, {label: FALSE, hiddenField: FALSE, value: lx_value ?? ''}) }}
{{ helper_Form_label(ls_label ~ ' ' ~ constant('OPTION_GRANTED', ao_permission), __('::simple_permission_option_granted')) }}
{{ helper_Form_label(ls_label ~ ' ' ~ constant('OPTION_INDIFFERENT', ao_permission), __('::simple_permission_option_indifferent')) }}
{{ helper_Form_label(ls_label ~ ' ' ~ constant('OPTION_DENIED', ao_permission), __('::simple_permission_option_denied')) }}
