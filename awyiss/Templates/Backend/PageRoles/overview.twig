{# @var ao_pageRoles \Awyiss\Model\Entity\PageRole[] #}
{# @var _view \Awyiss\View\BackendView #}

{# {{ helper_Categories_filter() }} #}

<div class="PageRoles Overview">
	{% if helper_Access_isAccessible('create') %}
		{{ helper_Html_link(__('::create'), {action: 'add'}, {class: 'Button'}) }}
	{% endif %}
	<h1>{{ __('::headline_overview') }}</h1>
	<div class="table-responsive">
		<table>
			<thead>
				<tr>
					<th>{{ helper_Paginator_sort('title') }}</th>
					<th>{{ helper_Paginator_sort('identifier') }}</th>
					<th>{{ helper_Paginator_sort('include_in_linklist') }}</th>
					<th>{{ helper_Paginator_sort('active') }}</th>
					<th class="actions"></th>
				</tr>
			</thead>
			<tbody>
				{% for lo_pageRole in ao_pageRoles %}
					<tr>
						<td>{{ lo_pageRole.title }} ({{ lo_pageRole.system_order }})</td>
						<td>{{ lo_pageRole.identifier }}</td>
						<td>{{ lo_pageRole.include_in_linklist }}</td>
						<td>{{ lo_pageRole.active }}</td>
						<td class="actions">
							{% if helper_Access_isAccessible('update') %}
								{{ helper_Html_link(__('::edit'), {action: 'edit', id: lo_pageRole.id}) }}
							{% endif %}
							{% if helper_Access_isAccessible('delete') %}
								{{ helper_Form_postLink(__('::delete'), {action: 'delete', id: lo_pageRole.id}, {confirm: __('::confirm_delete', lo_pageRole.id) }) }}
							{% endif %}
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
	{# { helper_Paginator_render() } #}
</div>