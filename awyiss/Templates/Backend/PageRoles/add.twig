{# @var ao_pageRole \Awyiss\Model\Entity\PageRole #}
{# @var _view \Awyiss\View\BackendView #}

<div class="PageRoles Form Add">
	{{ helper_Form_create(ao_pageRole, {method: 'post', idPrefix: 'PageRole'}) }}

	<fieldset>
		<legend>{{ __('::headline_add') }}</legend>
		{{ helper_Form_control('active') }}
		{{ helper_Form_control('title') }}
		{{ helper_Form_control('identifier') }}
		{{ helper_Form_control('include_in_linklist') }}
		{{ helper_SystemOrder_control('system_order', {entity: ao_pageRole}) }}
	</fieldset>

	{{ helper_Form_hidden('reload_form', {val: 0}) }}

	{{ helper_Form_button(__('::save')) }}
	{{ helper_Form_button(__('::save_close'), {name: 'submit', value: 'submit_close'}) }}
	{{ helper_Form_end() }}
</div>