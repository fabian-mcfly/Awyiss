{# @var ao_languages \Cake\Collection\Collection #}
{# @var aa_types array #}
{# @var _view \Awyiss\View\BackendView #}

{% set la_languages = ao_languages.toArray() %}
{% set la_types = ['frontend', 'backend'] %}

{# {{ helper_Categories_filter() }} #}

<div class="Languages Overview">
	{% if helper_Access_isAccessible('create') %}
		{{ helper_Html_link(__('::create'), {action: 'add'}, {class: 'Button'}) }}
	{% endif %}
	<h1>{{ __('::headline_overview') }}</h1>
	<div class="table-responsive">
		<table>
			<thead>
				<tr>
					<th>{{ helper_Paginator_sort('title') }}</th>
					<th>{{ helper_Paginator_sort('shortcode') }}</th>
					<th>{{ helper_Paginator_sort('timezone') }}</th>
					<th>{{ helper_Paginator_sort('locale') }}</th>
					<th class="actions"></th>
				</tr>
			</thead>
			<tbody>
				{% for ls_type in la_types %}
					<tr>
						<th colspan="5">{{ __('::' ~ ls_type) }}</th>
					</tr>
					{% for lo_language in la_languages[ ls_type ] %}
						{# @var lo_language \Awyiss\Model\Entity\Language #}
						<tr>
							<td>{{ lo_language.title }} ({{ lo_language.system_order }})</td>
							<td>{{ lo_language.shortcode }}</td>
							<td>{{ lo_language.timezone }}</td>
							<td>{{ lo_language.locale }}</td>
							<td class="actions">
								{% if helper_Access_isAccessible('update') %}
									{{ helper_Html_link(__('::edit'), {action: 'edit', id: lo_language.id}) }}
								{% endif %}
								{% if helper_Access_isAccessible('delete') %}
									{{ helper_Html_link(__('::delete'), {action: 'delete', id: lo_language.id}, {confirm: __('::confirm_delete', lo_language.id) }) }}
								{% endif %}
							</td>
						</tr>
					{% endfor %}
				{% endfor %}
			</tbody>
		</table>
	</div>
	{# { helper_Paginator_render() } #}
</div>
