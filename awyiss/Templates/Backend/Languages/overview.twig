{#
@var ao_languages \Cake\Collection\Collection
@var aa_realms array
@var _view \Awyiss\View\BackendView
#}

{% set la_languages = ao_languages.toArray() %}

<div class="Languages Overview">
	{% if helper_Authorization_isAccessible('create') %}
		{{ helper_Html_link(__('create'), {action: 'add'}, {class: 'Button'}) }}
	{% endif %}
	<h1>{{ __('headline_overview') }}</h1>


	{% for ls_realm in aa_realms %}
		<fieldset>
			<legend>{{ ls_realm }}</legend>

			<div class="table-responsive">
				<table>
					<thead>
						<tr>
							<th>{{ __('title') }}</th>
							<th>{{ __('shortcode') }}</th>
							<th>{{ __('timezone') }}</th>
							<th>{{ __('locale') }}</th>
							<th class="actions"></th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<th colspan="5">{{ __('' ~ ls_realm) }}</th>
						</tr>
						{% for lo_language in la_languages[ ls_realm ] %}
							{# @var lo_language \Awyiss\Model\Entity\Language #}
							<tr>
								<td>{{ lo_language.title }} ({{ lo_language.systemOrder }})</td>
								<td>{{ lo_language.shortcode }}</td>
								<td>{{ lo_language.timezone }}</td>
								<td>{{ lo_language.locale }}</td>
								<td class="actions">
									{% if helper_Authorization_isAccessible('update') %}
										{{ helper_Html_link(__('edit'), {action: 'edit', id: lo_language.id}) }}
									{% endif %}
									{% if helper_Authorization_isAccessible('delete') %}
										{{ helper_Html_link(__('delete'), {action: 'delete', id: lo_language.id}, {confirm: __('confirm_delete', lo_language.id) }) }}
									{% endif %}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</fieldset>
	{% endfor %}
</div>
