{#
@var ao_language \Awyiss\Model\Entity\Language
@var _view \Awyiss\View\BackendView
#}

{% set la_realms = [] %}
{% for as_realm in aa_realms %}
	{% set la_realms = la_realms|merge({(as_realm): __('realm_' ~ as_realm|underscore)}) %}
{% endfor %}

<div class="Languages Form Edit">
	{{ helper_Form_create(ao_language, {method: 'post', idPrefix: 'Language'}) }}

	<h1>{{ __('headline_edit') }}</h1>

	{% block formButtons %}
		{{ helper_Form_button(__('save')) }}
		{{ helper_Form_button(__('save_close'), {name: 'submit', value: 'submit_close'}) }}
	{% endblock %}

	{% include('@Backend/Languages/form.twig') %}

	{{ block('formButtons') }}

	{{ helper_Form_end() -}}
</div>