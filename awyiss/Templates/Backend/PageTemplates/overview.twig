{#
@var ao_pageTemplates \Cake\Datasource\ResultSetDecorator
@var aa_pageTemplates array
@var ai_selectedPageRoleId int
@var _view \Awyiss\View\BackendView
#}

{% set lx_selectedPageRoleId = helper_Categories_getSelectedCategory('pageRole') %}

<div class="PageTemplates Overview">
	{% if helper_Authorization_isAccessible('create') %}
		{{ helper_Html_link(__('create'), {action: 'add', pageRoleId: lx_selectedPageRoleId}, {class: 'Button'}) }}
	{% endif %}

	<h1>{{ __dx('page_templates', 'overview', 'headline') }}</h1>

	{{ helper_Categories_filter('pageRole') }}

	{% for li_pageRoleId, ls_pageRole in aa_pageRoles.simple %}
		{% if aa_pageTemplates[ li_pageRoleId ] is defined or lx_selectedPageRoleId == 'all' or lx_selectedPageRoleId == li_pageRoleId %}
			<fieldset>
				<legend>
					{% if helper_Authorization_scopeIsAccessible('PageRoles', [], ['read']) %}
						{{ helper_Html_link(ls_pageRole, {controller: 'PageRoles', action: 'edit', id: li_key}) }}
					{% else %}
						{{ ls_pageRole }}
					{% endif %}
				</legend>

				<table>
					<thead>
						<tr>
							<th>{{ __('title') }}</th>
							<th>{{ __('file_name') }}</th>
							<th>{{ __('content_areas') }}</th>
							<th>{{ __('used_for_pages') }}</th>
							<th class="actions"></th>
						</tr>
					</thead>
						<tbody>
							{% set la_templates = aa_pageTemplates[ li_pageRoleId ] %}
							{% for lo_pageTemplate in la_templates %}
								{# @var lo_pageTemplate \Awyiss\Model\Entity\PageTemplate #}
								<tr>
									<td>{{ lo_pageTemplate.title }} ({{ lo_pageTemplate.systemOrder }})</td>
									<td>{{ lo_pageTemplate.fileName }}</td>
									<td>{{ lo_pageTemplate.contentAreas|column('label')|join(',<br>')|raw }}</td>
									<td>{{ lo_pageTemplate.usedForPages }}</td>
									<td class="actions">
										{% if helper_Authorization_isAccessible('update') %}
											{{ helper_Html_link(__('edit'), {action: 'edit', id: lo_pageTemplate.id}) }}
										{% endif %}
										{% if helper_Authorization_isAccessible('delete') %}
											{{ helper_Html_link(__('delete'), {action: 'delete', id: lo_pageTemplate.id}, {confirm: __('confirm_delete', lo_pageTemplate.id) }) }}
										{% endif %}
									</td>
								</tr>
							{% endfor %}
						</tbody>
				</table>
			</fieldset>
		{% endif %}
	{% endfor %}
</div>
