{#
@var ao_records Cake\Datasource\EntityInterface[]
@var ao_datatable \Awyiss\Model\Entity\Datatable
@var ab_paginated bool
@var ab_nesting bool
@var ab_splitIntoLanguages bool
@var ab_translatable bool
@var _view \Awyiss\View\BackendView
#}

<div class="GenericDatatables Overview">
	{% block buttonsOverview %}
		{% if helper_Authorization_isAccessible('create') %}
			{{ helper_Html_link(__('create'), {action: 'add'}, {class: 'Button'}) }}
		{% endif %}
	{% endblock %}

	{% block headlineOverview %}
		<h1>{{ __('headline_overview') }}</h1>
	{% endblock %}

	{% block tableOverview %}
		<table>
			{% block tableOverviewHead %}
				<thead>
					{% block tableOverviewHeadRow %}
						<tr>
							{% block tableOverviewHeaderId %}
								<th>{{ ab_paginated ? helper_Paginator_sort('id') : __('id') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderParentId %}
								<th>{{ ab_paginated ? helper_Paginator_sort('parent_id') : __('parent_id') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderLanguageShortcode %}
								{% if (ab_splitIntoLanguages) %}
									<th>{{ ab_paginated ? helper_Paginator_sort('language_shortcode') : __('language_shortcode') }}</th>
								{% endif %}
							{% endblock %}

							{% block tableOverviewHeaderTitle %}
								<th>{{ ab_paginated ? helper_Paginator_sort('title') : __('title') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderActive %}
								<th>{{ ab_paginated ? helper_Paginator_sort('active') : __('active') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderActions %}
								<th class="actions"></th>
							{% endblock %}
						</tr>
					{% endblock %}
				</thead>
			{% endblock %}
			{% block tableOverviewBody %}
				<tbody>
					{# @var lo_record \Cake\Datasource\EntityInterface #}
					{% for lo_record in ao_records %}
						{% block tableOverviewBodyRow %}
							<tr>
								{% block tableOverviewCellId %}
									<td>{{ helper_Number_format(lo_record.id) }}</td>
								{% endblock %}

								{% block tableOverviewCellParentId %}
									<td>{{ lo_record.parent_id }}</td>
								{% endblock %}

								{% block tableOverviewCellLanguageShortcode %}
									{% if (ab_splitIntoLanguages) %}
										<td>{{ lo_record.language_shortcode }}</td>
									{% endif %}
								{% endblock %}

								{% block tableOverviewCellTitle %}
									<td>{{ lo_record.title }}</td>
								{% endblock %}

								{% block tableOverviewCellActive %}
									<td>{{ lo_record.active }}</td>
								{% endblock %}

								{% block tableOverviewCellActions %}
									<td class="actions">
										{% if helper_Authorization_isAccessible('update') %}
											{{ helper_Html_link(__('edit'), {action: 'edit', id: lo_record.id}) }}
										{% endif %}
										{% if helper_Authorization_isAccessible('delete') %}
											{{ helper_Html_link(__('delete'), {action: 'delete', id: lo_record.id}, {confirm: __('confirm_delete', lo_record.id) }) }}
										{% endif %}
									</td>
								{% endblock %}
							</tr>
						{% endblock %}
					{% endfor %}
				</tbody>
			{% endblock %}
		</table>
	{% endblock %}

	{% if ab_paginated %}
		{{ helper_Paginator_render() }}
	{% endif %}
</div>
