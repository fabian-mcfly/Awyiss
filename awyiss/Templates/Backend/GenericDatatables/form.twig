{#
@var ao_record Cake\Datasource\EntityInterface
@var ao_datatable \Awyiss\Model\Entity\Datatable
@var as_languageRealm string
@var ab_nesting bool
@var ab_splitIntoLanguages bool
@var ab_translatable bool
@var localConfig array
@var _view \Awyiss\View\BackendView
#}

{% block fieldsetPresentation %}
	<fieldset class="Fieldset-Presentation">
		<legend>{{ __('fieldset_presentation') }}</legend>

		{% block formControlActive %}
			{{ helper_Form_control('active') }}
		{% endblock %}

		{% block fieldsetPresentationInner %}
			{% block fieldsetPresentationAttributes %}
				{{ helper_Attributes_allControls('presentation') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetConditions %}
	<fieldset class="Fieldset-Conditions">
		<legend>{{ __('fieldset_conditions') }}</legend>

		{% block formControlLanguagesShortcode %}
			{% if (ab_splitIntoLanguages) %}
				{{ helper_Locale_control('language_shortcode', {languageRealm: as_languageRealm}) }}
			{% endif %}
		{% endblock %}

		{% block formControlParentId %}
			{% if (as_categoriesIdentifier is defined) %}
				{{ helper_Categories_control(as_categoriesIdentifier) }}
			{% endif %}

			{% if (ao_parentRecords is not null) %}
				{{ helper_Form_control('parent_id', {options: hashPrinter(ao_parentRecords, 'label', 'id', '- ')}) }}
			{% endif %}
		{% endblock %}

		{% block formControlSystemOrder %}
			{% if as_systemOrderField == 'systemOrder' %}
				{{ helper_SystemOrder_control('system_order') }}
			{% endif %}
		{% endblock %}

		{% block fieldsetConditionsInner %}
			{% block fieldsetConditionsAttributes %}
				{{ helper_Attributes_allControls('conditions') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetGeneral %}
	<fieldset class="Fieldset-General">
		<legend>{{ __('fieldset_general') }}</legend>

		{% block formControlTitle %}
			{{ helper_Form_control('title') }}
		{% endblock %}

		{% block fieldsetGeneralInner %}
			{% block fieldsetGeneralAttributes %}
				{{ helper_Attributes_allControls('general') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetContent %}
	<fieldset class="Fieldset-Content">
		<legend>{{ __('fieldset_content') }}</legend>

		{% block fieldsetContentInner %}
