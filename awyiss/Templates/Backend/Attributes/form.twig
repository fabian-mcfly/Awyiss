			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetAttributes %}
	<fieldset>
		<legend>{{ __('fieldset_attributes') }}</legend>

		{% block fieldsetAttributesInner %}
			{% block fieldsetAttributesAttributes %}
				{{ helper_Attributes_allControls('attributes') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{{- helper_Form_hidden('reload_form', {val: 0}) }}
