{#
@var ao_attribute \Awyiss\Model\Entity\Attribute
@var aa_availableFieldsets array
@var aa_availableInputTypes array
@var _view \Awyiss\View\BackendView
#}

{% block fieldsetPresentation %}
	<fieldset>
		<legend>{{ __('fieldset_presentation') }}</legend>

		{% block fieldsetPresentationInner %}
			{% block formControlActive %}
				{{ helper_Form_control('active') }}
			{% endblock %}

			{% block formControlInputType %}
				{{ helper_Form_control('input_type', {empty: false, options: combine(aa_availableInputTypes, aa_availableInputTypes)}) }}
			{% endblock %}

			{% block formControlTranslatable %}
				{{ helper_Form_control('translatable', {disabled: ao_attribute.scope in aa_pageRoles|merge(['contents', 'menu_entries', 'pages'])}) }}
			{% endblock %}

			{% block formControlRequired %}
				{{ helper_Form_control('required', {disabled: ao_attribute.scope in ['contents']}) }}
			{% endblock %}

			{% block formControlHasIndex %}
				{{ helper_Form_control('has_index') }}
			{% endblock %}

			{% block fieldsetPresentationAttributes %}
				{{ helper_Attributes_allControls('presentation') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetConditions %}
	<fieldset>
		<legend>{{ __('fieldset_conditions') }}</legend>

		{% block fieldsetConditionsInner %}
			{% block formControlScope %}
				{{ helper_Categories_control('scope', {empty: false}) }}
			{% endblock %}

			{% block formControlFieldset %}
				{{ helper_Form_control('fieldset', {
					empty: false,
					options: combine(aa_availableFieldsets, aa_availableFieldsets),
					disabled: ao_attribute.scope == 'contents'
				}) }}
			{% endblock %}

			{% block formControlSystemOrder %}
				{{ helper_SystemOrder_control('system_order', {entity: ao_attribute}) }}
			{% endblock %}

			{% block fieldsetConditionsAttributes %}
				{{ helper_Attributes_allControls('conditions') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetGeneral %}
	<fieldset>
		<legend>{{ __('fieldset_general') }}</legend>

		{% block fieldsetGeneralInner %}
			{% block formControlTitle %}
				{{ helper_Form_control('title') }}
			{% endblock %}

			{% block formControlIdentifier %}
				{{ helper_Form_control('identifier') }}
			{% endblock %}

			{% block formControlDefaultValue %}
				{{ helper_Form_control('default_value') }}
			{% endblock %}

			{% block formControlType %}
				{{ helper_Form_control('type') }}
			{% endblock %}

			{% block fieldsetGeneralAttributes %}
				{{ helper_Attributes_allControls('general') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

