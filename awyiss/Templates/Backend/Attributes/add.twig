{# @var ao_attribute Awyiss\Model\Entity\Attribute #}
{# @var aa_attributeScopes array #}
{# @var _view \Awyiss\View\BackendView #}

<div class="Attributes Form Add">
	{{ helper_Form_create(ao_attribute, {method: 'post', idPrefix: 'attribute'}) }}
	
	<h1>{{ __('::headline_add') }}</h1>
	<fieldset>
		<legend>{{ __('::fieldset_general') }}</legend>

		{{ helper_Form_control('scope', {options: naturalSort(aa_attributeScopes|map((value,key) => __(key ~ '::title')))}) }}

		{{ helper_Form_control('name') }}
		{{ helper_Form_control('default_value') }}
		{{ helper_Form_control('fieldset') }}
		{{ helper_Form_control('input_type') }}
		{{ helper_Form_control('type') }}
		{{ helper_Form_control('has_index') }}
		{{ helper_Form_control('required') }}
		{{ helper_Form_control('active') }}
		{{ helper_SystemOrder_control('system_order', {entity: ao_attribute}) }}
	</fieldset>
	
	{{- helper_Form_hidden('reload_form', {val: 0}) }}

	{{ helper_Form_button(__('::save')) }}
	{{ helper_Form_button(__('::save_close'), {name: 'submit', value: 'submit_close'}) }}
	{{ helper_Form_end() -}}
</div>