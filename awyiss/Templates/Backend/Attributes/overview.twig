{#
@var ao_attributes \Awyiss\Model\Entity\Attribute[]
@var aa_attributesGroupedByFieldset array
@var aa_attributeScopes array
@var _view \Awyiss\View\BackendView
#}

<div class="Attributes Overview">
	{% if helper_Authorization_isAccessible('create') %}
		{{ helper_Html_link(__('create'), {action: 'add', scope: as_selectedScope}, {class: 'Button'}) }}
	{% endif %}

	<h1>{{ __('headline_overview') }}</h1>

	{{ helper_Categories_filter('scope') }}

	{% for ls_fieldset in aa_availableFieldsets %}
		<fieldset>
			<legend>{{ ls_fieldset }}</legend>
			<table>
				<thead>
					<tr>
						<th>{{ __('title') }}<br>
							{{ __('identifier') }}</th>
						<th>{{ __('default_value') }}</th>
						<th>{{ __('input_type') }}</th>
						<th>{{ __('type') }}</th>
						<th>{{ __('required') }}</th>
						<th class="actions"></th>
					</tr>
				</thead>
				<tbody>
					{% if aa_attributesGroupedByFieldset[ ls_fieldset ] is defined %}
						{# @var lo_attribute \Awyiss\Model\Entity\Attribute #}
						{% for lo_attribute in aa_attributesGroupedByFieldset[ ls_fieldset ] %}
							<tr>
								<td>{{ lo_attribute.title }}<br>
									{{ lo_attribute.identifier }}</td>
								<td>{{ lo_attribute.default_value }}</td>
								<td>{{ lo_attribute.input_type }}</td>
								<td>{{ lo_attribute.type }}</td>
								<td>{{ lo_attribute.required }}</td>
								<td class="actions">
									{% if helper_Authorization_isAccessible('update') %}
										{{ helper_Html_link(__('edit'), {action: 'edit', id: lo_attribute.id}) }}
									{% endif %}
									{% if helper_Authorization_isAccessible('delete') %}
										{{ helper_Html_link(__('delete'), {action: 'delete', id: lo_attribute.id}, {confirm: __('confirm_delete', lo_attribute.id) }) }}
									{% endif %}
								</td>
							</tr>
						{% endfor %}
					{% endif %}
				</tbody>
			</table>
		</fieldset>
	{% endfor %}
</div>
