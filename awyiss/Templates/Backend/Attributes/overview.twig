{# @var ao_attributes Awyiss\Model\Entity\Attribute[] #}
{# @var aa_attributeScopes array #}
{# @var _view \Awyiss\View\BackendView #}

<div class="Attributes Overview">
	{% if helper_Authorization_isAccessible('create') %}
		{{ helper_Html_link(__('::create'), {action: 'add'}, {class: 'Button'}) }}
	{% endif %}

	<h1>{{ __('::headline_overview') }}</h1>

	{{ helper_Categories_filter('scope', naturalSort(aa_attributeScopes|map((value,key) => __(key ~ '::title'))), {
		includeAggregation: FALSE,
		val: as_selectedScope
	}) }}

	<div class="table-responsive">
		<table>
			<thead>
				<tr>
					<th>{{ helper_Paginator_sort('id') }}</th>
					<th>{{ helper_Paginator_sort('name') }}</th>
					<th>{{ helper_Paginator_sort('default_value') }}</th>
					<th>{{ helper_Paginator_sort('scope') }}</th>
					<th>{{ helper_Paginator_sort('fieldset') }}</th>
					<th>{{ helper_Paginator_sort('input_type') }}</th>
					<th>{{ helper_Paginator_sort('type') }}</th>
					<th>{{ helper_Paginator_sort('has_index') }}</th>
					<th>{{ helper_Paginator_sort('required') }}</th>
					<th>{{ helper_Paginator_sort('active') }}</th>
					<th class="actions"></th>
				</tr>
			</thead>
			<tbody>
				{% for lo_attribute in ao_attributes %}
				<tr>
					<td>{{ helper_Number_format(lo_attribute.id) }}</td>
					<td>{{ lo_attribute.name }}</td>
					<td>{{ lo_attribute.default_value }}</td>
					<td>{{ lo_attribute.scope }}</td>
					<td>{{ lo_attribute.fieldset }}</td>
					<td>{{ lo_attribute.input_type }}</td>
					<td>{{ lo_attribute.type }}</td>
					<td>{{ lo_attribute.has_index }}</td>
					<td>{{ lo_attribute.required }}</td>
					<td>{{ lo_attribute.active }}</td>
					<td class="actions">
						{% if helper_Authorization_isAccessible('update') %}
							{{ helper_Html_link(__('::edit'), {action: 'edit', id: lo_attribute.id}) }}
						{% endif %}
						{% if helper_Authorization_isAccessible('delete') %}
							{{ helper_Html_link(__('::delete'), {action: 'delete', id: lo_attribute.id}, {confirm: __('::confirm_delete', lo_attribute.id) }) }}
						{% endif %}
					</td>
				</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
	{{ helper_Paginator_render() }}
</div>
