{#
@var ao_attribute \Awyiss\Model\Entity\Attribute
@var aa_availableFieldsets array
@var aa_availableInputTypes array
@var _view \Awyiss\View\BackendView
#}

<div class="Attributes Form Edit">
	{{ helper_Form_create(ao_attribute, {method: 'post', idPrefix: 'attribute'}) }}

	{% block headlineEdit %}
		<h1>{{ __('headline_edit') }}</h1>
	{% endblock %}

	{% block formEditButtons %}
		{{ helper_Form_button(__('save')) }}
		{{ helper_Form_button(__('save_close'), {name: 'submit', value: 'submit_close'}) }}
	{% endblock %}

	{% block formEdit %}
		{% include('@Backend/Attributes/form.twig') %}
	{% endblock %}

	{% block formEditButtonsBottom %}
		{{ block('formEditButtons') }}
	{% endblock %}

	{{ helper_Form_end() -}}
</div>
