{#
@var ao_mediaFolder \Awyiss\Model\Entity\MediaFolder
@var ao_threadedMediaFolders \Cake\Collection\Iterator\TreeIterator
@var as_languageRealm string
@var _view \Awyiss\View\BackendView
#}

<div class="MediaFolders Form Add">
	{{ helper_Form_create(ao_mediaFolder, {method: 'post', idPrefix: 'mediaFolder'}) }}

	{% block headlineAdd %}
		<h1>{{ __('headline_add') }}</h1>
	{% endblock %}

	{% block formAddButtons %}
		{{ helper_Form_button(__('save')) }}
		{{ helper_Form_button(__('save_close'), {name: 'submit', value: 'submit_close'}) }}
	{% endblock %}

	{% block formAdd %}
		{% include('@Backend/MediaFolders/form.twig') %}
	{% endblock %}

	{% block formAddButtonsBottom %}
		{{ block('formAddButtons') }}
	{% endblock %}

	{{ helper_Form_end() -}}

</div>