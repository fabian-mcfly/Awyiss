{#
@var ao_media \Awyiss\Model\Entity\Media[]
@var _view \Awyiss\View\BackendView
#}

{% set li_selectedMediaFolderId = helper_Categories_getSelectedCategory('mediaFolder') %}

<div class="Media Overview">
	{% block buttonsOverview %}
		{% if helper_Authorization_isAccessible('create') %}
			{{ helper_Html_link(__('create'), {action: 'add', mediaFolderId: li_selectedMediaFolderId}, {class : 'Button'}) }}
		{% endif %}
	{% endblock %}

	{% block headlineOverview %}
		<h1>{{ __('headline_overview') }}</h1>
	{% endblock %}

	{% block categoriesFilterOverview %}
		{{ helper_Categories_filter('mediaFolder', null, {groupBy: 'languageShortcode', groupLabels: helper_Locale_languagesForRealm(as_languageRealm)|merge({general: 'Global'})}) }}
	{% endblock %}

	{% block tableOverview %}
		<table class="Table-Overview">
			{% block tableOverviewHead %}
				<thead>
					{% block tableOverviewHeadRow %}
						<tr>
							{% block tableOverviewHeaderName %}
								<th>{{ __('name') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderPath %}
								<th>{{ __('path') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderSystemOrder %}
								<th>{{ __('system_order') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderActions %}
								<th class="actions"></th>
							{% endblock %}
						</tr>
					{% endblock %}
				</thead>
			{% endblock %}
			{% block tableOverviewBody %}
				<tbody>
					{# @var lo_media \Awyiss\Model\Entity\Media #}
					{% for lo_media in ao_media %}
						{% block tableOverviewBodyRow %}
							<tr>
								{% block tableOverviewCellName %}
									<td>{{ lo_media.name }}</td>
								{% endblock %}

								{% block tableOverviewCellPath %}
									<td>{{ lo_media.path }}</td>
								{% endblock %}

								{% block tableOverviewCellSystemOrder %}
									<td>order {{ lo_media.systemOrder }}</td>
								{% endblock %}

								{% block tableOverviewCellActions %}
									<td class="actions">
										{% if helper_Authorization_isAccessible('update') %}
											{{ helper_Html_link(__('edit'), {action: 'edit', id: lo_media.id}) }}
										{% endif %}
										{% if helper_Authorization_isAccessible('delete') %}
											{{ helper_Html_link(__('delete'), {action: 'delete', id: lo_media.id}, {confirm: __('confirm_delete', lo_media.id) }) }}
										{% endif %}
									</td>
								{% endblock %}
							</tr>
						{% endblock %}
					{% endfor %}
				</tbody>
			{% endblock %}
		</table>
	{% endblock %}
</div>
