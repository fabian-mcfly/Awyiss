msgid "locked_message"
msgstr "<h4>Achtung!</h4>"
	"<p>Die Bearbeitung dieses Eintrags ist zur Zeit durch einen anderen Benutzer ({1}) für Sie gesperrt.<br>"
	"Diese Sperre wird in <strong class=\"Minutes\"></strong> automatisch entfernt ({0}).</p>"

msgid "lock_warning"
msgstr "<h4>Achtung!</h4>"
	"<p>Die Bearbeitung dieses Eintrags ist zur Zeit für andere Benutzer gesperrt.<br>"
	"Diese Sperre wird in <strong class=\"Minutes\"></strong> automatisch entfernt ({0}).</p>"

msgid "lock_warning_minutes_singular"
msgstr "weniger als einer Minute"

msgid "lock_warning_minutes_plural"
msgstr "{0} Minuten"

msgid "lock_warning_timed_out"
msgstr "<h4>Bearbeitung abgebrochen!</h4>"
	"<p>Die maximale Bearbeitungszeit ist abgelaufen.<br>"
	"Das Speichern der vorgenommen Änderungen ist nicht mehr möglich.</p>"

msgid "button_request_lock"
msgstr "Freigabe anfordern"

msgid "button_request_extension"
msgstr "Sperre verlängern"

msgid "button_request_renewal"
msgstr "Sperre erneuern"
