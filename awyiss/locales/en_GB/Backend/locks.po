msgid "locked_message"
msgstr "<h4>Attention!</h4>"
 "<p>Editing this entry is currently locked by another user ({1}).<br>"
 "This lock will be automatically removed in <strong class=\"Minutes\"></strong> ({0}).</p>"

msgid "lock_warning"
msgstr "<h4>Attention!</h4>"
 "<p>Editing this entry is currently locked for other users.<br>"
 "This lock will be automatically removed in <strong class=\"Minutes\"></strong> ({0}).</p>"

msgid "lock_warning_minutes_singular"
msgstr "less than a minute"

msgid "lock_warning_minutes_plural"
msgstr "{0} minutes"

msgid "lock_warning_timed_out"
msgstr "<h4>Editing aborted!</h4>"
 "<p>The maximum editing time has expired.<br>"
 "Saving your changes is no longer possible.</p>"

msgid "button_request_lock"
msgstr "Request release"

msgid "button_request_extension"
msgstr "Extend lock"

msgid "button_request_renewal"
msgstr "Renew lock"