{
	"name": "your-name-here/awyiss-bake",
	"description": "AwyissBake plugin for CakePHP",
	"type": "cakephp-plugin",
	"license": "MIT",
	"require": {
		"php": ">=7.2",
		"../../../vendor/cakephp/cakephp": "^4.0"
	},
	"require-dev": {
		"../../../vendor/phpunit/phpunit": "^8.5 || ^9.3"
	},
	"autoload": {
		"psr-4": {
			"AwyissBake\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"AwyissBake\\Test\\": "tests/",
			"Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
		}
	}
}
