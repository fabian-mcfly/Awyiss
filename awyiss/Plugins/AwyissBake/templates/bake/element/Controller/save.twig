
	/**
	* @param {{ entityClassName }} $ao_{{ singularName }}
	* @param string $as_method
	*
	* @return void
	*
	* @throws \Cake\Http\Exception\RedirectException
	*/
	protected function save ({{ entityClassName }} $ao_{{ singularName }}, string $as_method = 'add'): void {
		$la_associated = [];
		if ($this->{{ currentModelName }}->hasAttributes()) {
			$la_associated[] = $this->{{ currentModelName }}->getAttributesTable(TRUE);
			$ao_{{ singularName }}->setAccess('attributes', TRUE);
		}

		$this->{{ currentModelName }}->patchEntity($ao_{{ singularName }}, $this->request->getData(), ['associated' => $la_associated]);

		if ( ! $this->request->getData('reload_form')) { //reload_form is set when we need to reload options based on current values
			if ($this->{{ currentModelName }}->save($ao_{{ singularName }})) {
				$this->Flash->success(__('' . $as_method . '_succeeded'));

				if ($this->request->getData('submit') == 'submit_close') {
					throw new RedirectException(Router::url(['action' => 'overview'], TRUE), 302);
				}

				throw new RedirectException(Router::url(['action' => 'edit', 'id' => $ao_{{ singularName }}->id], TRUE), 302);
			}

			$this->Flash->error(__('' . $as_method . '_failed'));
			foreach ($ao_{{ singularName }}->getError('_general') AS $ls_error) {
				$this->Flash->error($ls_error);
			}
		}
	}
