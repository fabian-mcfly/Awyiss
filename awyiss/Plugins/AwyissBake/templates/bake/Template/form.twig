{% for field in fields %}
{%- if field not in primaryKey %}
{%- verbatim %}{% block formControl_{% endverbatim %}{{ field[:1]|upper ~ field[1:] }}{% verbatim %} %}
{% endverbatim %}

{%- if keyFields[field] is defined %}
	{%- set fieldData = Bake.columnData(field, schema) %}
	{%- if fieldData.null %}
			{% verbatim %}{{ helper_Form_control('{% endverbatim %}{{ field }}{% verbatim %}', {options: ao_{% endverbatim %}{{ keyFields[field] }}{% verbatim %}, empty: true}) }}{% endverbatim %}
		{{- "\n" }}
	{%- else %}
			{% verbatim %}{{ helper_Form_control('{% endverbatim %}{{ field }}{% verbatim %}', {options: ao_{% endverbatim %}{{ keyFields[field] }}{% verbatim %}}) }}{% endverbatim %}
			{{- "\n" }}
	{%- endif %}
{%- elseif field == 'parent_id' %}
	{% verbatim %}{{ helper_Categories_control('{% endverbatim %}{{ field }}{% verbatim %}') }}{% endverbatim %}
		{{- "\n" }}
{%- elseif field == 'system_order' %}
	{% verbatim %}{{ helper_SystemOrder_control('{% endverbatim %}{{ field }}{% verbatim %}', {entity: ao_{% endverbatim %}{{ singularVar }}{% verbatim %}}) }}{% endverbatim %}
		{{- "\n" }}
{%- elseif field not in ['deleted', 'created_on', 'created_by', 'changed_on', 'changed_by', 'deleted_on', 'deleted_by'] %}
	{%- set fieldData = Bake.columnData(field, schema) %}
	{%- if fieldData.type in ['date', 'datetime', 'time'] and fieldData.null %}
	{% verbatim %}{{ helper_Form_control('{% endverbatim %}{{ field }}{% verbatim %}', {empty: true}) }}{% endverbatim %}
		{{- "\n" }}
	{%- else %}
	{% verbatim %}{{ helper_Form_control('{% endverbatim %}{{ field }}{% verbatim %}') }}{% endverbatim %}
		{{- "\n" }}
	{%- endif %}
{%- endif %}
{% verbatim %}{% endblock %}
{% endverbatim -%}
{%- endif %}
{%- endfor %}

{%- if associations.BelongsToMany is defined %}
	{%- for assocName, assocData in associations.BelongsToMany %}
		{% verbatim %}{{ helper_Categories_control('{% endverbatim %}{{ assocData.property }}{% verbatim %}._ids', {options: ao_{% endverbatim %}{{ assocData.variable }}{% verbatim %}}) }}{% endverbatim %}
		{{- "\n" }}
	{%- endfor %}
{% endif %}
{% verbatim %}
{% block fieldsetPresentation %}
	<fieldset class="Fieldset-Presentation">
		<legend>{{ __('fieldset_presentation') }}</legend>

		{% block fieldsetPresentationInner %}
			{% block fieldsetPresentationAttributes %}
				{{ helper_Attributes_allControls('presentation') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

