{#
@var emailTemplate \Awyiss\Model\Entity\EmailTemplate
@var currentLanguage \Awyiss\Model\Entity\Language
@var languageShortcode string
@var languages array
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
-#}{% apply inline_css %}
<!doctype html>
<html lang="{{ languageShortcode }}">
	<head>
		<meta charset="UTF-8">
		<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
		<meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
		<meta http-equiv="X-UA-Compatible" content="ie=edge">
		{% block metaTitle %}
			<title>{{ metaTitle }}</title>
		{% endblock %}
		{%- block baseUrl -%}
			<base href="{{ baseUrl }}">
		{%- endblock -%}
	</head>
	<body>
		{% block bodyWrapper %}
			<div class="Wrapper">
				{% block bodyLogo %}
					{% if loginLogoPath or ogImage %}
						<img src="{{ loginLogoPath ?: ogImage }}" alt="{{ config.Awyiss.System.Frontend.meta.titleAppendix }}" class="Logo">
					{% endif %}
				{% endblock %}

				{% block bodyContent %}
					{{ fetch('content') }}
				{% endblock %}
			</div>
		{% endblock %}
		{%- block bodyStylesheets -%}
			{{ AssetHelper.inlineStyles('email/default.css', {
				strReplace: {
					'../font/' : baseUrl ~ 'assets/font/',
				}
			}) }}
		{%- endblock -%}
	</body>
</html>
{% endapply %}
