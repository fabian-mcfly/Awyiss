{#
@var isErrorPage bool
@var page \Awyiss\Model\Entity\Page
@var pageRoleEnum \Awyiss\Model\Enum\PageRoleEnumInterface
@var baseUrl string
@var currentLanguage \Awyiss\Model\Entity\Language
@var currentPath string
@var currentUrl string
@var folder string
@var languages \Awyiss\Model\Entity\Language[]
@var languageShortcode string
@var _view \Awyiss\View\FrontendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}
{%- block html %}
<!DOCTYPE html>
<html lang="{{ page.languageShortcode }}" id="Page{{ page.id }}">
	{% block head %}
		<head>
			{% block headInner -%}
				<title>{{ page.title }}</title>

				{% block meta %}
					{{ HtmlHelper.charset() }}
					<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
					<meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
					<meta http-equiv="X-UA-Compatible" content="ie=edge">
				{% endblock %}

				{%- block baseUrlTag -%}
					<base href="{{ baseUrl }}">
				{%- endblock -%}

				{%- block headStylesheet -%}
					{%- do AssetHelper.add(['open_graph.css', 'webfonts.css'], critical: true, priority: 0) -%}
					{%- do AssetHelper.add(['Frontend/preview.css'], {realm: 'Backend'}) %}
				{%- endblock -%}

				{%- block headAssetTags -%}
					{{- AssetHelper.createImportMap() -}}
					{{- AssetHelper.getTags('all') -}}
				{%- endblock -%}
			{%- endblock -%}
		</head>
	{% endblock %}
	{% block body %}
		<body>
			{% block wrapper %}
				<div id="Wrapper">
					{{ fetch('content') }}

					{% block awyissLogo %}
						<span class="AwyissLogo">
							Powered by <span class="Awyiss">Aw<span class="Yiss">yiss</span></span>
						</span>
					{% endblock %}
				</div>
			{% endblock %}
		</body>
	{% endblock %}
</html>
{% endblock %}