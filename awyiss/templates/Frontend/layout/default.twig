{#
@var isErrorPage bool
@var page \Awyiss\Model\Entity\Page
@var pageRoleEnum \Awyiss\Model\Enum\PageRoleEnumInterface
@var baseUrl string
@var currentLanguage \Awyiss\Model\Entity\Language
@var currentPath string
@var currentUrl string
@var folder string
@var languages \Awyiss\Model\Entity\Language[]
@var languageShortcode string
@var _view \Awyiss\View\FrontendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}
{%- block html %}
{%- set htmlClass = fetch('htmlClass') %}
{%- if htmlClass == '' %}
	{%- if page %}
		{%- set htmlClass = 'Page-' ~ page.title|trim|slug|ucparts(false) %}
		{%- set htmlClass = htmlClass ~ ' ' ~ page.slug|split('/')|map(e => e|ucparts(false))|map(e => e|prefixNumericClass)|join('-')|trim %}
		{%- set htmlClass = htmlClass ~ ' PageRole-' ~ page.pageRoleId.name|ucparts(false) %}
		{%- set htmlClass = htmlClass ~ ' ' ~ page.pageRoleId.name|ucparts(false) ~ 'Template-' ~ page.pageTemplate.fileName|ucparts(false) %}
	{%- endif %}
	{%- if environment %}
		{%- set htmlClass = htmlClass ~ ' ' ~ environment %}
	{%- endif %}
{%- endif -%}
<!DOCTYPE html>
<html lang="{{ page.language.shortcode }}" id="Page{{ page.id }}" class="NoJS {{ htmlClass }}">
	{% block head %}
		<head>
			{% block headInner -%}
				{% block meta %}
					{{ HtmlHelper.charset() }}
					<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
					<meta name="viewport" content="width=device-width, user-scalable=yes, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0">
					<meta http-equiv="X-UA-Compatible" content="ie=edge">
					{% block metaTitle -%}
						{% set metaTitle = page.metaTitle ?? fetch('metaTitle') -%}
						{% if metaTitle is empty -%}
							{% set metaTitle = page.title ~ config('Awyiss.System.Frontend.meta.titleSeparator') ~ config('Awyiss.System.Frontend.meta.titleAppendix') -%}
						{% endif -%}
						{%- block metaTitleTag %}
							<title>{{ metaTitle }}</title>
						{%- endblock %}
						{%- block metaTitleOgTag %}
							<meta property="og:title" content="{{ metaTitle }}">
						{%- endblock %}
					{% endblock %}
					{% block metaDescription %}
						{%- set metaDescription = page.metaDescription ?? fetch('metaDescription') -%}
						{%- if metaDescription is not empty -%}
							{%- block metaDescriptionTag %}
								<meta name="description" content="{{ metaDescription }}">
							{%- endblock %}
							{%- block metaDescriptionOgTag %}
								<meta property="og:description"	content="{{ metaDescription }}">
							{%- endblock %}
						{%- endif -%}
					{% endblock %}

					<style nonce="{{ AssetHelper.getStyleNonce() }}">{% verbatim %}
						:root {
							--awyissColor:{% endverbatim %}{{ config.Awyiss.System.Backend.interface.highlightColor ?? '#63d1a5' }}{% verbatim %};
						}
					{% endverbatim %}</style>

					{% block metaRobotsTag %}
						{% if designPreview %}
							<meta name="robots" content="noindex,nofollow">
						{% else %}
							<meta name="robots" content="{{ page.robotsIndex ? 'index' : 'noindex' }},{{ page.robotsFollow ? 'follow' : 'nofollow' }}">
						{% endif %}
					{% endblock %}

					{% block metaGoogleSiteVerificationTag %}
						{%- if config('Awyiss.System.Frontend.meta.googleSiteVerification') %}
							<meta name="google-site-verification" content="{{ config('Awyiss.System.Frontend.meta.googleSiteVerification') }}">
						{%- endif %}
					{% endblock %}

					{% block metaOgImageTag %}
						<meta property="og:image" content="{{ fetch('ogImage') ?: ogImage }}">
						{%- if ogImageWidth %}
							<meta property="og:image:width" content="{{ ogImageWidth }}">
						{%- endif %}
						{%- if ogImageHeight %}
							<meta property="og:image:height" content="{{ ogImageHeight }}">
						{%- endif %}
					{% endblock %}
				{% endblock %}

				{%- block baseUrlTag -%}
					<base href="{{ baseUrl }}">
				{%- endblock -%}

				{% block canonical %}
					{%- set canonical = fetch('canonical') ?: page.canonical -%}
					{%- if canonical is empty and page.duplicateOf and page.duplicate.slug != '404' -%}
						{% set canonical = UrlHelper.build({lang: page.duplicate.languageShortcode, slug: page.duplicate.slug}) -%}
					{%- endif %}

					{% block canonicalTag %}
						{%- if canonical != '' -%}
							<link rel="canonical" href="{{ canonical }}">
						{%- endif -%}
					{% endblock %}
				{% endblock %}

				{%- block favicons -%}
					<link rel="apple-touch-icon" sizes="180x180" href="{{ baseUrl }}assets/favicon/apple-touch-icon.png">
					<link rel="icon" type="image/png" sizes="32x32" href="{{ baseUrl }}assets/favicon/favicon-32x32.png">
					<link rel="icon" type="image/png" sizes="16x16" href="{{ baseUrl }}assets/favicon/favicon-16x16.png">
					<link rel="manifest" href="{{ baseUrl }}assets/favicon/site.webmanifest">
					<link rel="mask-icon" href="{{ baseUrl }}assets/favicon/safari-pinned-tab.svg" color="#63d1a5">
					<link rel="shortcut icon" href="{{ baseUrl }}assets/favicon/favicon.ico">
					<meta name="msapplication-TileColor" content="#ffffff">
					<meta name="msapplication-config" content="{{ baseUrl }}assets/favicon/browserconfig.xml">
					<meta name="theme-color" content="#ffffff">
				{%- endblock -%}

				{%- block headStylesheets -%}
					{%- block headStylesheetsFullStylesheet -%}
						{%- do AssetHelper.add('full.css', critical: true, priority: 0) -%}
					{%- endblock -%}

					{%- block headStylesheetsCssLayer -%}
						{%- do AssetHelper.addCssLayer(['reset', 'columnSystem', 'externalIcons', 'Awyiss']) -%}
					{%- endblock -%}

					{%- block headStylesheetsDesignPreview -%}
						{% if designPreview %}
							{% do AssetHelper.add('Frontend/design_preview.css', {realm: 'Backend'}) %}
						{% endif %}
					{%- endblock -%}

					{%- block headStylesheetsFrontendEditor -%}
						{% if frontendEditorConfig %}
							{% do AssetHelper.add(['Frontend/editor.css'], {realm: 'Backend'}) %}
						{% endif %}
					{%- endblock -%}

					{%- block headStylesheetsFrontendPreview -%}
						{% if frontendPreviewConfig %}
							{% do AssetHelper.add(['Frontend/preview.css'], {realm: 'Backend'}) %}
						{% endif %}
					{%- endblock -%}

					{%- block headStylesheetsLightbox -%}
						{% do AssetHelper.add(['Frontend/lightbox.css'], {realm: 'Backend'}) %}
					{%- endblock -%}

					{%- block headStylesheetsWebfont -%}
						{% if webfont is not empty %}
							{% do AssetHelper.add('webfonts.css', critical: true) %}
						{% endif %}
					{%- endblock -%}
				{%- endblock -%}

				{%- block headScripts -%}
					{{- element('scripts') -}}
					{{- element('scripts_third_party') -}}
				{%- endblock -%}

				{%- block headAssetTags -%}
					{{- AssetHelper.createImportMap() -}}
					{%- if page %}
						{{- AssetHelper.addDynamicContentsStylesheet(page.id) -}}
					{%- endif -%}
					{{- AssetHelper.getTags('all') -}}
				{%- endblock -%}
			{%- endblock -%}
		</head>
	{% endblock %}
	{% block body %}
		<body>
			{% block bodyInner %}
				{% block bodyHeader %}
					{% include '@Frontend/element/header.twig' %}
				{% endblock %}

				{% block bodyBreadcrumbs %}
					{% if isErrorPage == false %}
						{{ globalContent('breadcrumbs') }}
					{% endif %}
				{% endblock %}

				{% block bodyContent %}
					{{ fetch('content') }}
				{% endblock %}

				{% block bodyFooter %}
					{% include '@Frontend/element/footer.twig' %}
				{% endblock %}

				{%- block bodyAssetTags -%}
					{# {{- AssetHelper.getTags('all', false) -}} #}
				{%- endblock %}
			{% endblock %}

			{% block designPreview %}
				{% include '@Frontend/element/design_preview.twig' %}
			{% endblock %}
		</body>
	{% endblock %}
</html>
{% endblock %}