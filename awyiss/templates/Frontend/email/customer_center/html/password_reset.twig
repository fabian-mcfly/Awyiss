{% if customer.firstname and customer.lastname %}
	{% set greeting = __d('Customers', 'password_reset_email_greeting_name', customer.firstname, customer.lastname) %}
{% else %}
	{% set greeting = __d('Customers', 'password_reset_email_greeting_generic') %}
{% endif %}

<p>
	{{ greeting }}<br>
	<br>
	{{ __d('Customers', 'password_reset_email_text', codeValidityHours)|raw }}
</p>
<br>
<p>{{ HtmlHelper.link(__d('Customers', 'password_reset_email_link_text'), resetUrl) }}</p>
<br>
<p>
	<strong>{{ __d('Customers', 'reset_code') }}:</strong><br>
	<code style="font-family: monospace; background-color: #f0f0f0; padding: 5px; display: inline-block;">{{ resetCode }}</code>
</p>
