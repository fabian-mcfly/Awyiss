{#
@var code string|null
@var codeVerified bool
@var customer \Awyiss\Model\Entity\Customer
@var _view \Awyiss\View\FrontendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Awyiss\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% block assignHtmlClass %}
	{% do _view.assign('htmlClass', 'CustomerCenterController ResetPasswordAction') %}
{% endblock %}

{% block assignMetaTitle %}
	{% do _view.assign('metaTitle', __d('Customers', 'page_title_reset_password') ~ config('Awyiss.System.Frontend.meta.titleSeparator') ~ config('Awyiss.System.Frontend.meta.titleAppendix')) %}
{% endblock %}

{% block contentArea %}
	<main id="ContentArea">
		<section class="ContentElement Template-Section">
			<div class="ContentRow">
				<div class="ContentElement Template-Standard Column-60 ColumnIndent-20">
					{% block resetPasswordHeading %}
						<h1>{{ __d('Customers', 'page_title_reset_password') }}</h1>
					{% endblock %}

					{% block flashMessages %}
						{{ FlashHelper.render() }}
					{% endblock %}

					{% block resetPasswordForm %}
						{{ FormHelper.create(null, { class: 'CustomerCenter-Form' }) }}

						{% block resetPasswordFormFieldset %}
							<fieldset>
								{% block resetPasswordFormLegend %}
									<legend>{{ __d('Customers', 'page_title_reset_password') }}</legend>
								{% endblock %}

								{% block resetPasswordFormContent %}
									{% if codeVerified == false %}
										{% block codeVerificationSection %}
											{% block resetCodeField %}
												<div class="FormRow">
													<div class="FormElement Column-100{% if customer.error('passwordResetCode') %} FormElement-IsInvalid{% endif %}">
														{% block resetCodeLabel %}
															{{ FormHelper.label('code', __d('Customers', 'reset_code'), { class: 'FormElement-Label' }) }}
														{% endblock %}
														{% block resetCodeInput %}
															{{ FormHelper.text('code', {
																value: code,
																class: 'FormInputType-Input',
																required: true,
															}) }}
														{% endblock %}

														{% block resetCodeError %}
															{% if customer.error('passwordResetCode') %}
																<div class="FormElement-Error">{{ __d('Customers', 'error_invalid_reset_code') }}</div>
															{% endif %}
														{% endblock %}
													</div>
												</div>
											{% endblock %}

											{% block resetCodeVerificationSubmit %}
												<div class="FormRow">
													<div class="FormElement Column-100 FormElementType-Submit">
														{{ FormHelper.button(__d('Customers', 'button_verify_reset_code'), { type: 'submit', class: 'FormInputType-Button Button' }) }}
													</div>
												</div>
											{% endblock %}
										{% endblock %}
									{% else %}
										{% block passwordResetSection %}
											{% block resetCodeHidden %}
												{{ FormHelper.hidden('code', { value: code }) }}
											{% endblock %}

											{% block resetPasswordIntroduction %}
												<div class="FormRow">
													<div class="FormElement Column-100">
														{% block resetPasswordIntroductionText %}
															<p>{{ __d('Customers', 'text_enter_new_password') }}</p>
														{% endblock %}
													</div>
												</div>
											{% endblock %}

											{% block newPasswordField %}
												<div class="FormRow">
													<div class="FormElement Column-100{% if customer.error('password') %} FormElement-IsInvalid{% endif %}">
														{% block newPasswordLabel %}
															{{ FormHelper.label('password', __d('Customers', 'new_password'), { class: 'FormElement-Label' }) }}
														{% endblock %}
														{% block newPasswordInput %}
															{{ FormHelper.password('password', {
																class: 'FormInputType-Input',
																required: true,
															}) }}
														{% endblock %}

														{% block newPasswordError %}
															{% if customer.error('password') %}
																<div class="FormElement-Error">
																	{% for error in customer.error('password') %}
																		{{ error }}<br>
																	{% endfor %}
																</div>
															{% endif %}
														{% endblock %}
													</div>
												</div>
											{% endblock %}

											{% block newPasswordConfirmField %}
												<div class="FormRow">
													<div class="FormElement Column-100{% if customer.error('passwordConfirm') %} FormElement-IsInvalid{% endif %}">
														{% block newPasswordConfirmLabel %}
															{{ FormHelper.label('passwordConfirm', __d('Customers', 'password_confirm'), { class: 'FormElement-Label' }) }}
														{% endblock %}
														{% block newPasswordConfirmInput %}
															{{ FormHelper.password('passwordConfirm', {
																class: 'FormInputType-Input',
																required: true,
															}) }}
														{% endblock %}

														{% block newPasswordConfirmError %}
															{% if customer.error('passwordConfirm') %}
																<div class="FormElement-Error">{{ __d('Customers', 'error_password_mismatch') }}</div>
															{% endif %}
														{% endblock %}
													</div>
												</div>
											{% endblock %}

											{% block resetPasswordSubmit %}
												<div class="FormRow">
													<div class="FormElement Column-100 FormElementType-Submit">
														{{ FormHelper.button(__d('Customers', 'button_reset_password'), { type: 'submit', class: 'FormInputType-Button Button' }) }}
													</div>
												</div>
											{% endblock %}
										{% endblock %}
									{% endif %}
								{% endblock %}
							</fieldset>
						{% endblock %}

						{{ FormHelper.end() }}
					{% endblock %}
				</div>
			</div>
		</section>
	</main>
{% endblock %}

