{#
@var customer \Awyiss\Model\Entity\Customer
@var _view \Awyiss\View\FrontendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% block assignHtmlClass %}
	{% do _view.assign('htmlClass', 'CustomerCenterController ChangePasswordAction') %}
{% endblock %}

{% block assignMetaTitle %}
	{% do _view.assign('metaTitle', __d('Customers', 'page_title_change_password') ~ config('Awyiss.System.Frontend.meta.titleSeparator') ~ config('Awyiss.System.Frontend.meta.titleAppendix')) %}
{% endblock %}

{% block contentArea %}
	<main id="ContentArea">
		<section class="ContentElement Template-Section">
			<div class="ContentRow">
				{% include '@Frontend/CustomerCenter/navigation.twig' with {
					activeMenuItem: 'changePassword',
				} %}

				{% block changePasswordContent %}
					<div class="ContentElement Template-Standard Column-75">
						{% block changePasswordHeading %}
							<h1>{{ __d('Customers', 'page_title_change_password') }}</h1>
						{% endblock %}

						{% block flashMessages %}
							{{ FlashHelper.render() }}
						{% endblock %}

						{% block changePasswordForm %}
							{{ FormHelper.create(null, { class: 'CustomerCenter-Form' }) }}

							{% block changePasswordFormFieldset %}
								<fieldset>
									{% block changePasswordFormLegend %}
										<legend>{{ __d('Customers', 'page_title_change_password') }}</legend>
									{% endblock %}

									{% block changePasswordFormFields %}
										{% block currentPasswordField %}
											<div class="FormRow">
												<div class="FormElement Column-100{% if customer.error('currentPassword') %} FormElement-IsInvalid{% endif %}">
													{% block currentPasswordLabel %}
														{{ FormHelper.label('currentPassword', __d('Customers', 'current_password'), { class: 'FormElement-Label' }) }}
													{% endblock %}
													{% block currentPasswordInput %}
														{{ FormHelper.password('currentPassword', {
															class: 'FormInputType-Input',
															required: true,
														}) }}
													{% endblock %}

													{% block currentPasswordError %}
														{% if customer.error('currentPassword') %}
															<div class="FormElement-Error">
																{% for error in customer.error('currentPassword') %}
																	{{ error }}<br>
																{% endfor %}
															</div>
														{% endif %}
													{% endblock %}
												</div>
											</div>
										{% endblock %}

										{% block newPasswordFields %}
											<div class="FormRow">
												{% block newPasswordField %}
													<div class="FormElement Column-50{% if customer.error('password') %} FormElement-IsInvalid{% endif %}">
														{% block newPasswordLabel %}
															{{ FormHelper.label('password', __d('Customers', 'new_password'), { class: 'FormElement-Label' }) }}
														{% endblock %}
														{% block newPasswordInput %}
															{{ FormHelper.password('password', {
																class: 'FormInputType-Input',
																minlength: 8,
																maxlength: 100,
																required: true,
															}) }}
														{% endblock %}

														{% block newPasswordError %}
															{% if customer.error('password') %}
																<div class="FormElement-Error">
																	{% for error in customer.error('password') %}
																		{{ error }}<br>
																	{% endfor %}
																</div>
															{% endif %}
														{% endblock %}
													</div>
												{% endblock %}

												{% block newPasswordConfirmField %}
													<div class="FormElement Column-50">
														{% block newPasswordConfirmLabel %}
															{{ FormHelper.label('passwordConfirm', __d('Customers', 'password_confirm'), { class: 'FormElement-Label' }) }}
														{% endblock %}
														{% block newPasswordConfirmInput %}
															{{ FormHelper.password('passwordConfirm', {
																class: 'FormInputType-Input',
																minlength: 8,
																maxlength: 100,
																required: true,
															}) }}
														{% endblock %}
													</div>
												{% endblock %}
											</div>
										{% endblock %}
									{% endblock %}

									{% block changePasswordFormSubmit %}
										<div class="FormRow">
											<div class="FormElement Column-100 FormElementType-Submit">
												{% block changePasswordSubmit %}
													{{ FormHelper.button(__d('Customers', 'button_change_password'), { type: 'submit', class: 'FormInputType-Button Button' }) }}
												{% endblock %}
											</div>
										</div>
									{% endblock %}
								</fieldset>
							{% endblock %}

							{{ FormHelper.end() }}
						{% endblock %}
					</div>
				{% endblock %}
			</div>
		</section>
	</main>
{% endblock %}

