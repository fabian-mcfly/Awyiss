{#
@var _view \Awyiss\View\FrontendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Awyiss\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% block assignHtmlClass %}
	{% do _view.assign('htmlClass', 'CustomerCenterController ForgotPasswordAction') %}
{% endblock %}

{% block assignMetaTitle %}
	{% do _view.assign('metaTitle', __d('Customers', 'page_title_forgot_password') ~ config('Awyiss.System.Frontend.meta.titleSeparator') ~ config('Awyiss.System.Frontend.meta.titleAppendix')) %}
{% endblock %}

{% block contentArea %}
	<main id="ContentArea">
		<section class="ContentElement Template-Section">
			<div class="ContentRow">
				<div class="ContentElement Template-Standard Column-60 ColumnIndent-20">
					{% block forgotPasswordHeading %}
						<h1>{{ __d('Customers', 'page_title_forgot_password') }}</h1>
					{% endblock %}

					{% block flashMessages %}
						{{ FlashHelper.render() }}
					{% endblock %}

					{% block forgotPasswordForm %}
						{{ FormHelper.create(null, { class: 'CustomerCenter-Form' }) }}

						{% block forgotPasswordFormFieldset %}
							<fieldset>
								{% block forgotPasswordFormLegend %}
									<legend>{{ __d('Customers', 'page_title_forgot_password') }}</legend>
								{% endblock %}

								{% block forgotPasswordFormFields %}
									{% block emailField %}
										<div class="FormRow">
											<div class="FormElement Column-100">
												{% block emailLabel %}
													{{ FormHelper.label('email', __d('Customers', 'email'), { class: 'FormElement-Label' }) }}
												{% endblock %}
												{% block emailInput %}
													{{ FormHelper.email('email', {
														autofocus: true,
														class: 'FormInputType-Input',
														required: true,
													}) }}
												{% endblock %}
											</div>
										</div>
									{% endblock %}
								{% endblock %}

								{% block forgotPasswordFormSubmit %}
									<div class="FormRow">
										<div class="FormElement Column-100 FormElementType-Submit">
											{{ FormHelper.button(__d('Customers', 'button_forgot_password'), { type: 'submit', class: 'FormInputType-Button Button' }) }}
										</div>
									</div>
								{% endblock %}
							</fieldset>
						{% endblock %}

						{{ FormHelper.end() }}
					{% endblock %}

					{% block alternativeActionsSection %}
						{% if loginEnabled or registrationEnabled %}
							<div class="ContentRow">
								{% block loginSection %}
									{% if loginEnabled %}
										<div class="ContentElement{% if registrationEnabled %} Column-50{% endif %} CustomerCenter-AlreadyRegistered">
											{% block loginText %}
												{{ __d('Customers', 'text_already_registered') }}<br>
											{% endblock %}
											{% block loginLink %}
												{{ HtmlHelper.link(__d('Customers', 'link_login'), { _name: 'FrontendCustomerCenterLogin' ~ languageShortcode|ucparts }) }}
											{% endblock %}
										</div>
									{% endif %}
								{% endblock %}

								{% block registrationSection %}
									{% if registrationEnabled %}
										<div class="ContentElement{% if loginEnabled %} Column-50{% endif %} CustomerCenter-NotRegisteredYet">
											{% block registrationText %}
												{{ __d('Customers', 'text_not_registered_yet') }}<br>
											{% endblock %}
											{% block registrationLink %}
												{{ HtmlHelper.link(__d('Customers', 'link_register'), { _name: 'FrontendCustomerCenterRegister' ~ languageShortcode|ucparts }) }}
											{% endblock %}
										</div>
									{% endif %}
								{% endblock %}
							</div>
						{% endif %}
					{% endblock %}
				</div>
			</div>
		</section>
	</main>
{% endblock %}

