{#
@var captcha string
@var form \Awyiss\Model\Entity\Form
@var formElements \Awyiss\Model\Entity\FormElement[]
@var formElementsChecksum string
@var formData array
@var formErrors array
@var page \Awyiss\Model\Entity\Page
@var sent bool
@var submitted bool
@var _view \Awyiss\View\FrontendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% block assignHtmlClass %}
	{% do _view.assign('htmlClass', 'FormController AntiSpamAction') %}
{% endblock %}

{% block assignMetaTitle %}
	{% do _view.assign('metaTitle', 'Form Protection' ~ config('Awyiss.System.Frontend.meta.titleSeparator') ~ config('Awyiss.System.Frontend.meta.titleAppendix')) %}
{% endblock %}

{% do _view.setLayout('form_anti_spam') %}

{% block contentArea %}
	<main id="ContentArea">
		<div class="ContentElement Template-Section">
			<div class="ContentRow">
				<div class="ContentElement Template-Standard Column-60 ColumnIndent-20">
					<div class="Form">
						{% block contentAreaInner %}
							{% if form %}
								{% if sent %}
									<div class="Form Form-SuccessMessage" id="Form-{{ form.identifier|camelize }}">
										{{ form.successMessage|raw }}
									</div>
								{% else %}
									<div class="Form Form-{{ form.identifier|camelize }}">
										{% block formErrorMessage %}
											{% if formErrors %}
												<div class="Form-ErrorMessage" id="Form-{{ form.identifier|camelize }}">
													{% if formErrors._general %}
														{% for message in formErrors._general %}
															{{ message|raw }}
														{% endfor %}
													{% else %}
														<p>{{ __d('Validation', 'form_has_errors')|raw }}</p>

														{% if form.summarizeErrors and form.errors %}
															<ul>
																{% for field, messages in form.errors %}
																	<li><strong>{{ formElements[ field ].title }}:</strong> {{ messages|first }}</li>
																{% endfor %}
															</ul>
														{% endif %}
													{% endif %}
												</div>
											{% endif %}
										{% endblock %}

										<form
											{% if form.enctype %}enctype="{{ form.enctype }}"{% endif %}
											method="post"
											{% if form.errors is empty %}id="Form-{{ form.identifier|camelize }}"{% endif %}
										>

											{% block formProtectionBefore %}
												{{ FormHelper.renderFormProtection(form, 'before') }}
											{% endblock %}

											{% block formCaptcha %}
												{{ captcha|raw }}
											{% endblock %}

											{% block formBody %}
												{{ contents|raw }}
											{% endblock %}

											{% block formProtectionAfter %}
												{{ FormHelper.renderFormProtection(form, 'after') }}
											{% endblock %}

											<input type="hidden" name="_formIdentifier" value="{{ form.identifier }}">
											<input type="hidden" name="_pageId" value="{{ page.id }}">
										</form>
									</div>
								{% endif %}
							{% endif %}
						{% endblock %}
					</div>
				</div>
			</div>
		</div>
	</main>
{% endblock %}
