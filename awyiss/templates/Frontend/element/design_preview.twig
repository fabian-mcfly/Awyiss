{#
@var designPreviewWebfonts array
@var designPreview \Awyiss\Model\Entity\Design
@var page \Awyiss\Model\Entity\Page
@var baseUrl string
@var currentBackendLanguage \Awyiss\Model\Entity\Language
@var currentLanguage \Awyiss\Model\Entity\Language
@var currentPath string
@var currentUrl string
@var folder string
@var languages \Awyiss\Model\Entity\Language[]
@var languageShortcode string
@var _view \Awyiss\View\FrontendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% if designPreview %}
	{% block designPreviewLabel %}
		<div id="AwyissDesignPreview">
			<span class="AwyissDesignPreview-Title">{{ currentBackendLanguage ? __ld(currentBackendLanguage.locale, 'system', 'design_preview_mode_label'): __d('System', 'design_preview_mode_label') }}</span>
			{% if designPreview.isPreview == false %}
				<span class="AwyissDesignPreview-Subtitle">{{ designPreview.title }}</span>
			{% endif %}

			<form method="post" action="">
				<button class="AwyissDesignPreview-CloseButton" name="awyissDesignPreview" value="cancel">{{ currentBackendLanguage ? __ld(currentBackendLanguage.locale, 'system', 'design_preview_mode_cancel'): __d('System', 'design_preview_mode_cancel') }}</button>
			</form>
		</div>
	{% endblock %}

	{% block designPreviewStyles %}
		<style nonce="{{ AssetHelper.getStyleNonce() }}">
			{{ designPreview.css|replace({
				'url("../': 'url("' ~ folder ~'assets/',
				'url(\'../': 'url(\'' ~ folder ~'assets/',
				'url(../': 'url(' ~ folder ~'assets/',
			})|raw }}
		</style>
	{% endblock %}

	{#

	In the future, the webfonts in the design preview mode might be downloaded and used locally,
	but for now, they are used directly from Google Fonts.
	If you don't want to use Google Fonts, implement your own loader here.

	#}
	{% block designPreviewWebfontLoader %}
		{% if designPreviewWebfonts is not empty and config.Design.allowGoogleFonts %}
			{% set webfontFamilies = '' %}
			{% for webfont in designPreviewWebfonts %}
				{% set webfontFamilies = webfontFamilies ~ '|' ~ webfont.name %}
			{% endfor %}
			{% set webfontFamilies = webfontFamilies|trim('|') %}
			<link nonce="{{ AssetHelper.getStyleNonce() }}" rel="stylesheet" href="https://fonts.googleapis.com/css?family={{ webfontFamilies|raw }}">
		{% endif %}
	{% endblock %}
{% endif %}