{#
@var page \Awyiss\Model\Entity\Page
@var baseUrl string
@var currentLanguage \Awyiss\Model\Entity\Language
@var currentPath string
@var currentUrl string
@var folder string
@var languages \Awyiss\Model\Entity\Language[]
@var languageShortcode string
@var _view \Awyiss\View\FrontendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Awyiss\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
@var TimeHelper \Awyiss\View\Helper\TimeHelper
#}

{% block scriptsAdd %}
	{% do AssetHelper.addJsModule('Headroom/headroom.js') %}
	{% do AssetHelper.addJsModule('LazyLoad/lazyload.js') %}
	{% do AssetHelper.add('WebfontLoader/webfontloader.js') %}
	{% do AssetHelper.add('main.js', {type: 'module'}) %}
{% endblock %}

{% block script %}
	<script nonce="{{ AssetHelper.getScriptNonce() }}">
		{% block scriptBaseVars %}
			const Awyiss = {{ Awyiss|json_encode|raw }};
			const baseUrl = '{{ baseUrl }}';
			const folder = '{{ folder }}';
			const currentPath = '{{ currentPath }}';
			const currentUrl = '{{ currentUrl }}';
			const language = {{ currentLanguage|json_encode|raw }};
			const languageShortcode = '{{ languageShortcode }}';
			{% if frontendEditorConfig %}
				const frontendEditorConfig = {{ frontendEditorConfig|json_encode|raw }};
			{% endif %}
		{% endblock %}

		document.documentElement.classList.remove('NoJS');
		document.documentElement.classList.add('JS');

		{% block webFontConfig %}
			{% if webfont is not empty %}
				{% set webfontFamilies = [] %}
				{% for webfont in webfont %}
					{% set family = webfont.name %}
					{% if webfont.variants is not empty %}
						{% set family = family ~ ':' ~ webfont.variants|join(',') %}
					{% endif %}

					{% set webfontFamilies = webfontFamilies|merge([family]) %}
				{% endfor %}

				const webfonts = {{ webfont|json_encode|raw }};
				window.WebFontConfig = {
					custom: {
						families: {{ webfontFamilies|json_encode|raw }},
						urls: [baseUrl + 'assets/css/webfonts.css']
					},
				};

				{% do AssetHelper.addNoScriptAsset('webfonts.css') %}
			{% endif %}
		{% endblock %}
	</script>
{% endblock %}
