{#

The standard element (image/video + optional link/image) will use the mediaAssignments
as a basis for visible element and use additional settings in `$options['media']`, if set.

The options for the optional link/lightbox can be modified
via the `$options['lightboxMedia']` setting.

@var mediaAssignments array
@var mediaRenderOptions \Awyiss\Utility\Media\MediaRenderOptions
@var options array
@var baseUrl string
@var currentLanguage \Awyiss\Model\Entity\Language
@var currentPath string
@var currentUrl string
@var folder string
@var languages \Awyiss\Model\Entity\Language[]
@var languageShortcode string
@var _view \Awyiss\View\FrontendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Awyiss\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
@var TimeHelper \Awyiss\View\Helper\TimeHelper
#}

{% if mediaAssignments.media %}
	{% if options.media is array %}
		{% set mediaRenderOptions = mediaRenderOptions.with(options.media) %}
	{% endif %}

	{% set tag = MediaHelper.htmlTag(mediaAssignments.media, mediaRenderOptions) %}

	{% if tag is not empty %}
		<div class="Image">
			{% if options.link is defined %}
				<a href="{{ options.link }}"{{ '://' in options.link ? ' target="_blank"' : '' }}{% if (MediaHelper.isVideoLink(options.link)) %} rel="lightbox" {% endif %}>
					{{ tag }}
				</a>
			{% elseif mediaAssignments.lightboxMedia %}
				{% set media = mediaAssignments.lightboxMedia %}
				{% set link = media.path  %}
				{% if media.isImage() %}
					{% set mediaRenderOptions = MediaHelper.mediaRenderOptions.with({
						width: 1920,
						height: 1280,
					}|merge(options.lightboxMedia ?? [])) %}
					{% set resizedMediaItem = MediaHelper.resize(media, mediaRenderOptions) %}
					{% set link = resizedMediaItem and resizedMediaItem.status == enum(ProcessStatus).Success ? resizedMediaItem.path : media.path %}
				{% endif %}

				<a href="{{ link }}"{% if media.isImage() or media.isVideo()or media.isAudio() %} rel="lightbox"{% else %} target="_blank" {% endif %}>
					{{ tag }}
				</a>
			{% else %}
				{{ tag }}
			{% endif %}
		</div>
	{% endif %}
{% endif %}

