{% set logoLink = baseUrl %}
{% if languageShortcode != (languages.Frontend|first).shortcode %}
	{% set logoLink = logoLink ~ languageShortcode ~ '/' %}
{% endif %}

{% block header %}
	{% block jumpToContent %}
		<a href="#ContentArea" id="JumpToContent">
			{{ __('jump_to_content') }}
		</a>
	{% endblock %}
	{% block mainMenuTrigger %}
		<input type="checkbox" id="MainMenuTrigger">
	{% endblock %}
	{% block headerArea %}
		<header id="HeaderArea">
			{% block headerContentRow %}
				<div class="ContentRow">
					<div class="ContentElement">
						{% block logoLink %}
							<a href="{{ logoLink }}" class="Logo">
								{% block logo %}

								{% endblock %}
							</a>
						{% endblock %}

						{% block mainMenuArea %}
							<div class="MenuArea">
								{% block mainMenuTriggerLabel %}
									<label for="MainMenuTrigger" class="MainMenuTrigger-Open" tabindex="0">
										{{ __('menu_trigger_open') }}
									</label>
								{% endblock %}

								{% block mainMenu %}
									{{ menu('main') }}
								{% endblock %}
							</div>
						{% endblock %}
					</div>
				</div>
			{% endblock %}
		</header>
	{% endblock %}
{% endblock %}
