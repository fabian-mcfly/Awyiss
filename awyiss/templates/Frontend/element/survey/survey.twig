{#
@var survey \Awyiss\Model\Entity\Survey
@var currentAction \Awyiss\Model\Entity\SurveySurveyQuestion|(\Awyiss\Model\Enum\Survey\NextAction|\BackedEnum)|false|null
@var questionTypeEnum class-string<\Awyiss\Model\Enum\Survey\QuestionType>
@var nextActionEnum class-string<\Awyiss\Model\Enum\Survey\NextAction>
@var customAnswers array<string, string>
@var progress array<string, int>
@var successMessage string|null
@var mediaRenderOptions \Awyiss\Utility\Media\MediaRenderOptions
@var _view \Awyiss\View\FrontendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Awyiss\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% block surveyScript %}
	{% do AssetHelper.addJsModule({'Frontend/Survey.js': {realm: 'Backend'}}) %}
	{% do AssetHelper.add(['Frontend/survey_loader.js'], {realm: 'Backend', type: 'module'}, true) %}
{% endblock %}

{% block survey %}
	<div class="Survey" id="Survey-{{ survey.identifier|camelize }}"{# data-ajax="false"#}>
		{% if successMessage %}
			{% block surveySuccessMessage %}
				<div class="Survey-SuccessMessage">
					{{- successMessage|raw -}}
				</div>
			{% endblock %}
		{% else %}
			{% block surveyForm %}
				{% set url = UrlHelper.build() %}
				<form method="post" action="{{ url != '/' ? url : '' }}#Survey-{{ survey.identifier|camelize }}">
			{% endblock %}

				{% block surveyFailureEnding %}
					{% if currentAction == false %}
						<div class="Survey-FailureMessage">
							{{- survey.failureMessage|raw -}}
						</div>
					{% endif %}
				{% endblock %}

				{% block surveyErrorMessage %}
					{% if survey.error('_general') %}
						<div class="Survey-FailureMessage">
							{% for error in survey.error('_general') %}
								<p>{{- error -}}</p>
							{% endfor %}
						</div>
					{% endif %}
				{% endblock %}

				{% block surveyPreviousAnswers %}
					{% include '@Frontend/element/survey/progress.twig' %}
				{% endblock %}

				{% block surveyBody %}
					{{ currentQuestion|raw }}
				{% endblock %}

				{% block surveyActions %}
					<div class="Survey-Actions">
						{% block surveyActionProceed %}
							{% if hasNextAction %}
								<div class="SurveyAction-Proceed">
									<button type="submit" name="survey[{{ survey.identifier }}][action]" value="proceed" class="Button Survey-NextAction">{{ __d('Surveys', 'next') }}</button>
								</div>
							{% endif %}
						{% endblock %}

						{% block surveyActionGoBack %}
							{% if progress is not empty %}
								<div class="SurveyAction-GoBack">
									<input type="hidden" name="survey[{{ survey.identifier }}][lastAction]" value="{{ progress|keys|last }}">
									<button type="submit" name="survey[{{ survey.identifier }}][action]" value="goBack" class="Button Survey-GoBack" formnovalidate>{{ __d('Surveys', 'back') }}</button>
								</div>
							{% endif %}
						{% endblock %}
					</div>
				{% endblock %}

				{% block surveyIdentifier %}
					{% if hasNextAction %}
						<input type="hidden" name="_surveyIdentifier" value="{{ survey.identifier }}">
					{% endif %}
				{% endblock %}

				{% block surveyHash %}
					<input type="hidden" name="_surveyHash" value="{{ surveyHash }}">
				{% endblock %}

			{% block surveyFormEnd %}
				</form>
			{% endblock %}
		{% endif %}
	</div>
{% endblock %}
