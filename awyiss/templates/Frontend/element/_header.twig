{#
@var page \Awyiss\Model\Entity\Page
@var pageRoleEnum \Awyiss\Model\Enum\PageRoleEnumInterface
@var baseUrl string
@var currentLanguage \Awyiss\Model\Entity\Language
@var currentPath string
@var currentUrl string
@var folder string
@var languages \Awyiss\Model\Entity\Language[]
@var languageShortcode string
@var _view \Awyiss\View\FrontendView
#}

{% set logoLink = baseUrl %}
{% if languageShortcode != (languages.Frontend|first).shortcode %}
	{% set logoLink = logoLink ~ languageShortcode ~ '/' %}
{% endif %}

{% block header %}
	{% block mainMenuTrigger %}
		<input type="checkbox" id="MainMenuTrigger">
	{% endblock %}
	{% block headerArea %}
		<header id="HeaderArea">
			{% block headerContentRow %}
				<div class="ContentRow">
					<div class="ContentElement">
						{% block logoLink %}
							<a href="{{ logoLink }}" class="Logo">
								{% block logo %}

								{% endblock %}
							</a>
						{% endblock %}

						{% block mainMenuArea %}
							<div class="MenuArea">
								{% block mainMenuTriggerLabel %}
									<label for="MainMenuTrigger" class="MainMenuTrigger-Open">
										{{ __('menu_trigger_open') }}
									</label>
								{% endblock %}

								{% block mainMenu %}
									{{ menu('main') }}
								{% endblock %}
							</div>
						{% endblock %}
					</div>
				</div>
			{% endblock %}
		</header>
	{% endblock %}
{% endblock %}
