{#
@var formElement \Awyiss\Model\Entity\FormElement
@var children string
@var formData array
@var formErrors array
@var sent bool
@var submitted bool
@var mediaRenderOptions \Awyiss\Utility\Media\MediaRenderOptions
@var _view \Awyiss\View\FrontendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
#}

{% if formElement.type == 'fieldset' %}
	{% block formElementFieldset %}
		<fieldset class="FormRow {{ formElement.cssClass }}" id="FormElement{{ formElement.id }}">
			{% block formElementFieldsetInner %}
				{% block formElementFieldsetLegend %}
					<legend>{{ formElement.title }}</legend>
				{% endblock %}

				{% block formElementFieldsetChildren %}
					{{ children|raw }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% elseif formElement.type == 'hidden' %}
	{% block formElementHidden %}
		<input type="hidden" name="{{ formElement.identifier }}" value="{{ formElement.title }}">
	{% endblock %}
{% else %}
	{% block formElement %}
		<div class="{{ formElement.cssClass }}" id="FormElement{{ formElement.id }}">
			{% block formElementElementInner %}
				{% if formElement.type == 'text' %}

					{% block formElementText %}
						<label for="FormInput-{{ formElement.identifier|ucparts(false) }}" class="FormElement-Label">{{ formElement.title }}</label>
						<input id="FormInput-{{ formElement.identifier|ucparts(false) }}" type="text" name="{{ formElement.identifier }}"
							value="{{ submitted ? formData[ formElement.identifier ] : formElement.get('value') }}"
							{% if formElement.disabled %} disabled aria-disabled="true" {% endif %}
							{% if formElement.readonly %} readonly aria-readonly="true" {% endif %}
							{% if formElement.required %} required{% endif %}
							{% if formElement.placeholder %}placeholder="{{ formElement.placeholder }}"{% endif %}
							class="FormInputType-Input">
					{% endblock %}

				{% elseif formElement.type == 'textarea' %}

					{% block formElementTextarea %}
						<label for="FormInput-{{ formElement.identifier|ucparts(false) }}" class="FormElement-Label">{{ formElement.title }}</label>
						<textarea id="FormInput-{{ formElement.identifier|ucparts(false) }}" name="{{ formElement.identifier }}"
							{% if formElement.disabled %} disabled aria-disabled="true" {% endif %}
							{% if formElement.readonly %} readonly aria-readonly="true" {% endif %}
							{% if formElement.required %} required{% endif %}
							{% if formElement.placeholder %}placeholder="{{ formElement.placeholder }}"{% endif %}
							class="FormInputType-Textarea">{{ submitted ? formData[ formElement.identifier ] : formElement.get('value') }}</textarea>
					{% endblock %}

				{% elseif formElement.type == 'email' %}

					{% block formElementEmail %}
						<label for="FormInput-{{ formElement.identifier|ucparts(false) }}" class="FormElement-Label">{{ formElement.title }}</label>
						<input id="FormInput-{{ formElement.identifier|ucparts(false) }}" type="email" name="{{ formElement.identifier }}"
							value="{{ submitted ? formData[ formElement.identifier ] : formElement.get('value') }}"
							{% if formElement.disabled %} disabled aria-disabled="true" {% endif %}
							{% if formElement.readonly %} readonly aria-readonly="true" {% endif %}
							{% if formElement.required %} required{% endif %}
							{% if formElement.placeholder %}placeholder="{{ formElement.placeholder }}"{% endif %}
							class="FormInputType-Input">
					{% endblock %}

				{% elseif formElement.type == 'date' %}

					{% block formElementDate %}
						<label for="FormInput-{{ formElement.identifier|ucparts(false) }}" class="FormElement-Label">{{ formElement.title }}</label>
						<input id="FormInput-{{ formElement.identifier|ucparts(false) }}" type="date" name="{{ formElement.identifier }}"
							value="{{ submitted ? formData[ formElement.identifier ] : formElement.get('value') }}"
							{% if formElement.disabled %} disabled aria-disabled="true" {% endif %}
							{% if formElement.readonly %} readonly aria-readonly="true" {% endif %}
							{% if formElement.required %} required{% endif %}
							{% if formElement.placeholder %}placeholder="{{ formElement.placeholder }}"{% endif %}
							class="FormInputType-Input">
					{% endblock %}

				{% elseif formElement.type == 'time' %}

					{% block formElementTime %}
						<label for="FormInput-{{ formElement.identifier|ucparts(false) }}" class="FormElement-Label">{{ formElement.title }}</label>
						<input id="FormInput-{{ formElement.identifier|ucparts(false) }}" type="time" name="{{ formElement.identifier }}"
							value="{{ submitted ? formData[ formElement.identifier ] : formElement.get('value') }}"
							{% if formElement.disabled %} disabled aria-disabled="true" {% endif %}
							{% if formElement.readonly %} readonly aria-readonly="true" {% endif %}
							{% if formElement.required %} required{% endif %}
							{% if formElement.placeholder %}placeholder="{{ formElement.placeholder }}"{% endif %}
							class="FormInputType-Input">
					{% endblock %}

				{% elseif formElement.type == 'datetime' %}

					{% block formElementDateTime %}
						<label for="FormInput-{{ formElement.identifier|ucparts(false) }}" class="FormElement-Label">{{ formElement.title }}</label>
						<input id="FormInput-{{ formElement.identifier|ucparts(false) }}" type="datetime-local" name="{{ formElement.identifier }}"
							value="{{ submitted ? formData[ formElement.identifier ] : formElement.get('value') }}"
							{% if formElement.disabled %} disabled aria-disabled="true" {% endif %}
							{% if formElement.readonly %} readonly aria-readonly="true" {% endif %}
							{% if formElement.required %} required{% endif %}
							{% if formElement.placeholder %}placeholder="{{ formElement.placeholder }}"{% endif %}
							class="FormInputType-Input">
					{% endblock %}

				{% elseif formElement.type == 'select' or formElement.type == 'select_multiple' %}

					{% block formElementSelect %}
						<label for="FormInput-{{ formElement.identifier|ucparts(false) }}" class="FormElement-Label">{{ formElement.title }}</label>
						{% if formElement.options|length == 0 %}<input type="hidden" name="{{ formElement.identifier }}" value="">{% endif %}
						<select id="FormInput-{{ formElement.identifier|ucparts(false) }}" name="{{ formElement.identifier }}{% if formElement.type == 'select_multiple' %}[]{% endif %}" class="FormInputType-Select"
							{% if formElement.disabled and formElement.disabled is not iterable %} disabled aria-disabled="true" {% endif %}
							{% if formElement.required %} required{% endif %}
							{% if formElement.type == 'select_multiple' %} multiple{% endif %}>
							{% for key, value in formElement.options %}
								<option value="{{ key }}"
									{% if formElement.disabled is iterable and key in formElement.disabled %} disabled aria-disabled="true" {% endif %}
									{% if formElement.type == 'select_multiple' %}
										{% if formData[ formElement.identifier ] is iterable and key in formData[ formElement.identifier ] %}selected{% endif %}
									{% else %}
										{% if formData[ formElement.identifier ] == key %}selected{% endif %}
									{% endif %}>{{ value }}</option>
							{% endfor %}
						</select>
					{% endblock %}

				{% elseif formElement.type == 'checkbox' %}

					{% block formElementCheckbox %}
						<label for="FormInput-{{ formElement.identifier|ucparts(false) }}" class="FormElement-Label">{{ formElement.title }}</label>

						{% if formElement.options|length > 1 %}<span class="FormElement-Checkboxes">{% endif %}
						{% for key, value in formElement.options %}
							<span class="FormInputType-Checkbox-Item">
								{% if loop.index0 == 0 %}<input type="hidden" name="{{ formElement.identifier }}" value="{% if formElement.options|length == 1 %}0{% endif %}">{% endif %}
								{# Multiple checkboxes will not be marked as required if #}
								<input id="FormInput-{{ formElement.identifier|ucparts(false) }}-{{ key|ucparts(false) }}" type="checkbox" name="{{ formElement.identifier }}{% if formElement.options|length > 1 %}[]{% endif %}"
									value="{{ key }}"
									{% if (formElement.disabled and formElement.disabled is not iterable) or (formElement.disabled is iterable and key in formElement.disabled) %} disabled aria-disabled="true" {% endif %}
									{% if formElement.options|length > 1 %}
										{% if formData[ formElement.identifier ] is iterable and key in formData[ formElement.identifier ] %}checked{% endif %}
									{% else %}
										{% if formData[ formElement.identifier ] == key %}checked{% endif %}
									{% endif %}
									{% if formElement.options|length == 1 and formElement.required %} required{% endif %}
									class="FormInputType-Checkbox">
								<label for="FormInput-{{ formElement.identifier|ucparts(false) }}-{{ key|ucparts(false) }}" class="FormInputType-Checkbox-Label">{{ value }}</label>
							</span>
						{% endfor %}
						{% if formElement.options|length > 1 %}</span>{% endif %}
					{% endblock %}

				{% elseif formElement.type == 'radio' %}

					{% block formElementRadio %}
						<label for="FormInput-{{ formElement.identifier|ucparts(false) }}" class="FormElement-Label">{{ formElement.title }}</label>

						{% if formElement.options|length > 1 %}<span class="FormElement-Radios">{% endif %}
						{% for key, value in formElement.options %}
							<span class="FormInputType-Radio-Item">
								{% if loop.index0 == 0 %}<input type="hidden" name="{{ formElement.identifier }}" value="{% if formElement.options|length == 1 %}0{% endif %}">{% endif %}
								<input id="FormInput-{{ formElement.identifier|ucparts(false) }}-{{ key|ucparts(false) }}" type="Radio" name="{{ formElement.identifier }}"
									value="{{ key }}"
									{% if (formElement.disabled and formElement.disabled is not iterable) or (formElement.disabled is iterable and key in formElement.disabled) %} disabled aria-disabled="true" {% endif %}
									{% if formElement.required %} required{% endif %}
									{% if formData[ formElement.identifier ] == key %}checked{% endif %}
									class="FormInputType-Radio">
								<label for="FormInput-{{ formElement.identifier|ucparts(false) }}-{{ key|ucparts(false) }}" class="FormInputType-Radio-Label">{{ value }}</label>
							</span>
						{% endfor %}
						{% if formElement.options|length > 1 %}</span>{% endif %}
					{% endblock %}

				{% elseif formElement.type == 'file' %}

					{% block formElementFile %}
						<label for="FormInput-{{ formElement.identifier|ucparts(false) }}" class="FormElement-Label">{{ formElement.title }}</label>
						<input id="FormInput-{{ formElement.identifier|ucparts(false) }}" type="file" name="{{ formElement.identifier }}"
							{% if formElement.disabled %} disabled aria-disabled="true" {% endif %}
							{% if formElement.readonly %} readonly aria-readonly="true" {% endif %}
							{% if formElement.required %} required{% endif %}
							class="FormInputType-File">
					{% endblock %}

				{% elseif formElement.type == 'free_text' %}

					{% block formElementFreeText %}
						<div class="FormInputType-FreeText">{{ formElement.text|raw }}</div>
					{% endblock %}

				{% elseif formElement.type == 'submit' %}

					{% block formElementSubmit %}
						<button type="submit" name="{{ formElement.identifier }}" class="FormInputType-Button Button">{{ formElement.title }}</button>
					{% endblock %}

				{% endif %}

				{% block formElementChildren %}
					{{ children|raw }}
				{% endblock %}
			{% endblock %}

			{% block formElementError %}
				{% if formErrors[ formElement.identifier ] %}
					<div class="FormElement-Error">{{ formErrors[ formElement.identifier ]|first }}</div>
				{% endif %}
			{% endblock %}
		</div>
	{% endblock %}
{% endif %}
