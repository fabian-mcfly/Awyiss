{#
@var words array
@var word int
@var fieldName string
@var mediaRenderOptions \Awyiss\Utility\Media\MediaRenderOptions
@var _view \Awyiss\View\FrontendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% block formCaptcha %}
	<fieldset class="FormRow FormCaptcha">
		{% block formCaptchaInner %}
			{% block formCaptchaLegend %}
				<legend>{{ __d('Form', 'captcha_legend') }}</legend>
			{% endblock %}
			{% block formCaptchaFormRow %}
				<div class="FormRow">
					{% block formCaptchaWords %}
						<div class="FormElement Column-60">
							{% block formCaptchaWordsInfo %}
								<p class="FormCaptcha-Info">{{ __d('Form', 'captcha_info', word + 1)|raw }}</p>
							{% endblock %}

							{% block formCaptchaWordsList %}
								<ul class="FormCaptcha-Words" data-active-word="{{ word + 1 }}">
									{% for key, word in words %}
										{% block formCaptchaWordsListWord %}
										<li class="FormCaptcha-Word" aria-label="{{ __d('Form', 'captcha_word_number', key + 1) }}">
											{{ word|split('')|join('<span class="FormCaptcha-Word-Spacer" aria-hidden="true"> </span>')|raw }}
										</li>
										{% endblock %}
									{% endfor %}
								</ul>
							{% endblock %}
						</div>
					{% endblock %}

					{% block formCaptchaFormElement %}
						<div class="FormElement Column-40">
							{% block formCaptchaFormElementLabel %}
								<label class="FormElement-Label" for="AwyissCaptchaWord">{{ __d('Form', 'captcha_label', word + 1) }}</label>
							{% endblock %}
							{% block formCaptchaFormElementInput %}
								<input type="text" name="{{ fieldName }}" id="AwyissCaptchaWord" value="" class="FormInputType-Input">
							{% endblock %}
						</div>
					{% endblock %}
				</div>
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}
