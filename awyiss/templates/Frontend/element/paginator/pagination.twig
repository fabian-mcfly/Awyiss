{% block paginator %}
	{% block pagination %}
		<ul class="Pagination-List">
			{{ PaginatorHelper.first(__d('Pagination', 'first'))|raw }}
			{{ PaginatorHelper.prev(__d('Pagination', 'previous'))|raw }}
			{{ PaginatorHelper.numbers()|raw }}
			{{ PaginatorHelper.next(__d('Pagination', 'next'))|raw }}
			{{ PaginatorHelper.last(__d('Pagination', 'last'))|raw }}
		</ul>
	{% endblock %}
{% endblock %}
