{#
@var entity \Awyiss\Model\Entity
@var frontendLanguage \Awyiss\Model\Entity\Language
@var mediaRenderOptions \Awyiss\Utility\Media\MediaRenderOptions
@var news \Cake\Collection\Collection
@var paginate bool
@var items int|null
@var itemsPerPage int|null
@var offset int|null
@var settings array
@var _view \Awyiss\View\FrontendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Awyiss\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
@var TimeHelper \Awyiss\View\Helper\TimeHelper
#}

<div class="Module-NewsListing">
	{% if news.count %}
		<ul class="List">
			{# @var newsItem \Awyiss\Model\Entity\Page #}
			{% for newsItem in news %}
				{% set link = UrlHelper.build({lang: newsItem.languageShortcode, slug: newsItem.slug}) %}
				<li class="Item NewsItem" id="NewsItem{{ newsItem.id }}">
					{% if newsItem.mediaAssignments.titleAndTeaserImage.teaserMedia %}
						<div class="Image">
							{{ MediaHelper.htmlTag(
								newsItem.mediaAssignments.titleAndTeaserImage.teaserMedia,
								mediaRenderOptions.withColumnWidth(25).withHeight(200).withResizeStrategy('cover')
							) }}
						</div>
					{% endif %}

					{% if settings.titleTag and settings.titleTag != 'h3' %}
						<{{ settings.titleTag }} class="Title">{{ newsItem.title }}</{{ settings.titleTag }}>
					{% else %}
						<h3 class="Title">{{ newsItem.title }}</h3>
					{% endif %}

					<p class="Date">{{ newsItem.date.i18nFormat(0) }}</p>

					{% if newsItem.teaser %}
						{% if '<' in newsItem.teaser %}
							<div class="Teaser">{{ newsItem.teaser|raw }}</div>
						{% else %}
							<p class="Teaser">{{ newsItem.teaser|nl2br }}</p>
						{% endif %}
					{% endif %}

					<p class="Link">
						<a href="{{ link }}" class="Button">
							{{ __d('module', 'read_more') }}
						</a>
					</p>
				</li>
			{% endfor %}
		</ul>

		{% if paginate %}
			{% do PaginatorHelper.setPaginated(news) %}
			{{ PaginatorHelper.render()|raw }}
		{% endif %}
	{% else %}
		{{ __d('module', 'no_news') }}
	{% endif %}
</div>
