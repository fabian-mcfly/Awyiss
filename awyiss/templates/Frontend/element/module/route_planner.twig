{#
@var entity \Awyiss\Model\Entity
@var frontendLanguage \Awyiss\Model\Entity\Language
@var mediaRenderOptions \Awyiss\Utility\Media\MediaRenderOptions
@var settings array
@var _view \Awyiss\View\FrontendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% block moduleRoutePlanner %}
	{% block routePlannerScripts %}
		{% do AssetHelper.addJsModule({
			'Frontend/MapLibre/maplibre-gl.js': {realm: 'Backend'},
			('Frontend/MapLibre/locale/' ~ page.language.shortcode ~ '.js'): {
				as: 'Frontend/MapLibre/locale',
				fallback: 'Frontend/MapLibre/locale/en.js',
				realm: 'Backend'
			},
		}) %}
		{% do AssetHelper.add(['Frontend/MapLibre/maplibre-gl.css', 'Frontend/route_planner.css'], {realm: 'Backend'}) %}
		{% do AssetHelper.add(['Frontend/RoutePlanner.js'], {realm: 'Backend', type: 'module'}, true) %}
	{% endblock %}

	<div class="Module-RoutePlanner Lazyload">
		<form class="RoutePlanner-Form" data-transportation-mode="{{ settings.transportationMode ?? 'car' }}">
			{{ FormHelper.control(entity ? 'route_planner.' ~ entity.id ~ '.start' : 'route_planner.start', {
				label: __d('route', 'route_planner_start'),
				placeholder: __d('route', 'route_planner_start_placeholder'),
				required: true,
				templateVars: {
					'containerClass': 'RoutePlanner-FormInput RoutePlanner-FormInput-Start',
				},
			}) }}

			{{ FormHelper.control(entity ? 'route_planner.' ~ entity.id ~ '.end' : 'route_planner.end', {
				label: __d('route', 'route_planner_end'),
				readonly: true,
				templateVars: {
					'containerClass': 'RoutePlanner-FormInput RoutePlanner-FormInput-Destination',
				},
				value: settings.address ?: (settings.lat ~ ', ' ~ settings.lng),
			}) }}

			{% if settings.showTransportationModes %}
				{{ FormHelper.control(entity ? 'route_planner.' ~ entity.id ~ '.transportation_mode' : 'route_planner.transportation_mode', {
					label: __d('route', 'transportation_mode'),
					options: {
						car: __d('route', 'transportation_mode_car'),
						bike: __d('route', 'transportation_mode_bike'),
						foot: __d('route', 'transportation_mode_foot'),
					},
					templateVars: {
						'containerClass': 'RoutePlanner-FormInput RoutePlanner-FormInput-TransportationMode',
					},
					type: 'radio',
					val: settings.transportationMode ?? 'car',
				}) }}
			{% endif %}

			{{ FormHelper.button(__d('route', 'route_planner_calculate_route'), {
				type: 'submit',
				class: 'Button Button-RoutePlanner-CalculateRoute'
			}) }}

			<span class="RoutePlanner-Loader" aria-hidden="true" inert></span>
		</form>

		<div class="RoutePlanner-Message" aria-hidden="true" inert></div>
		<div class="RoutePlanner-StartChoices" tabindex="0" aria-hidden="true" inert>
			{{ FormHelper.button(__d('route', 'route_planner_start_choices_close'), {
				type: 'submit',
				class: 'Button Button-Close Button-RoutePlanner-StartChoices-Close'
			}) }}
		</div>

		<div class="RoutePlanner-Route" aria-hidden="true" inert>
			<template class="Template-Summary">
				<div class="RoutePlanner-Route-Summary">
					<p class="RoutePlanner-Route-Summary-Start">
						{{ __d('route', 'route_planner_route_summary_start') }}:<br>
						<strong>{% verbatim %}{{start}}{% endverbatim %}</strong><br>
						({{ FormHelper.button(__d('route', 'route_planner_reset'), {
							type: 'button',
							class: 'Button Button-Reset Button-RoutePlanner-Reset'
						}) }})
					</p>
					<p class="RoutePlanner-Route-Summary-End">
						{{ __d('route', 'route_planner_route_summary_end') }}:<br>
						<strong>{% verbatim %}{{end}}{% endverbatim %}</strong>
					</p>
					<p class="RoutePlanner-Route-Summary-Distance">
						{{ __d('route', 'route_planner_route_summary_distance') }}:
						<strong>{% verbatim %}{{distance}}{% endverbatim %}</strong>
					</p>
					<p class="RoutePlanner-Route-Summary-Duration">
						{{ __d('route', 'route_planner_route_summary_duration') }}:
						<strong>{% verbatim %}{{duration}}{% endverbatim %}</strong>
					</p>
				</div>
			</template>

			<template class="Template-List">
				<ol class="RoutePlanner-Route-List"></ol>
			</template>

			<template class="Template-ListItem">
				<li class="RoutePlanner-Route-ListItem" tabindex="0">
					<span class="RoutePlanner-Route-ListItem-Distance">
						{% verbatim %}{{distance}}{% endverbatim %}
					</span>
					<span class="RoutePlanner-Route-ListItem-Duration">
						{% verbatim %}{{duration}}{% endverbatim %}
					</span>

					{% verbatim %}{{instruction}}{% endverbatim %}
				</li>
			</template>
		</div>

		<div class="RoutePlanner-Map"
			data-lat="{{ settings.lat }}"
			data-lng="{{ settings.lng }}"
			data-end="{{ settings.address ?: (settings.lat ~ ', ' ~ settings.lng) }}">
		</div>
	</div>
{% endblock %}
