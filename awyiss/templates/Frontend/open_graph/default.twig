{% macro readingTime(contents) %}
	{% set wordCount = wordCount(contents) %}
	{% set readingTime = ((wordCount ?: 1) / 150)|round(0, 'ceil') %}
	{{ readingTime <= 1 ? '1 Minute' : readingTime ~ ' Minuten' }}
{% endmacro %}

{% block logo %}
	{% if loginLogoPath %}
		<div class="Logo">
			<img src="{{ baseUrl }}{{ (loginLogoPath)|trim('/') }}" alt="{{ config.Awyiss.System.Frontend.meta.titleAppendix }}">
		</div>
	{% endif %}
{% endblock %}

{% block title %}
	<h1>{{ page.title }}</h1>

	{{ widget('breadcrumbs', {showOnHomepage: false, path: page.languageShortcode ~ '/' ~ page.slug}) }}

	{% set contents = content('ContentArea') %}

	<p class="ReadingTime">Lesezeit: ca. {{ _self.readingTime(contents) }}</p>
{% endblock %}
