{#
@var form \Awyiss\Model\Entity\Form
@var formElements \Awyiss\Model\Entity\FormElement[]|\Cake\Collection\CollectionInterface
@var formElementsChecksum string
@var formData array
@var formErrors array
@var page \Awyiss\Model\Entity\Page
@var sent bool
@var submitted bool
@var includeWrapper bool
@var _view \Awyiss\View\FrontendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
@var TimeHelper \Cake\View\Helper\TimeHelper

All forms have a default action that will not directly
send the form data to the server, but a confirmation of all input data,
so that the user can review it before submitting the form.

This step will also require some form of proof that the user is not a robot.

The actual form action is set via the data-{{ formElementsChecksum }}-action attribute and
will be set as the action attribute of the form element via JavaScript
after a short delay to prevent spam bots from submitting the form directly.

#}

{% if form %}
	{% if sent %}
		{% block formSuccessMessage %}
			<div class="Form Form-SuccessMessage" id="Form-{{ form.identifier|ucparts(false) }}">
				{{ form.successMessage|raw }}
			</div>
		{% endblock %}
	{% else %}
		{% set now = date().timestamp %}
		{% block form %}
			{% if includeWrapper %}
				{% block formInnerIncludeWrapper %}
					<div class="Form Form-{{ form.identifier|ucparts(false) }}">
						{% block formErrorMessageIncludeWrapper %}
							{% if formErrors %}
								<div class="Form-ErrorMessage">
									{% if formErrors._general %}
										{% for message in formErrors._general %}
											{{ message|raw }}
										{% endfor %}
									{% else %}
										{{ __d('validation', 'form_has_errors')|raw }}
									{% endif %}
								</div>
							{% endif %}
						{% endblock %}

						<form
							action="{{ UrlHelper.build({lang: languageShortcode, _name: 'FrontendFormAntiSpamPost'}) }}"
							data-{{ now }}{{ formElementsChecksum }}="{{ form.action ?? currentUrl }}#Form-{{ form.identifier|ucparts(false) }}"
							{% if form.enctype %}enctype="{{ form.enctype }}"{% endif %}
							method="post"
							id="Form-{{ form.identifier|ucparts(false) }}"
						>

							{% block formBodyIncludeWrapper %}
								{{ contents|raw }}
							{% endblock %}

							<input type="hidden" name="form_identifier" value="{{ form.identifier }}">
							<input type="hidden" name="page_id" value="{{ page.id }}">
						</form>
					</div>
				{% endblock %}
			{% else %}
				{% block formInnerNoWrapper %}
					{% block formErrorMessageNoWrapper %}
						{% if formErrors %}
							<div class="Form-ErrorMessage">
								{{ __d('validation', 'form_has_errors')|raw }}
							</div>
						{% endif %}
					{% endblock %}

					<form class="Form Form-{{ form.identifier|ucparts(false) }}"
						action="{{ UrlHelper.build({lang: languageShortcode, _name: 'FrontendFormAntiSpamPost'}) }}"
						data-{{ now }}{{ formElementsChecksum }}="{{ form.action ?? currentUrl }}#Form-{{ form.identifier|ucparts(false) }}"
						{% if form.enctype %}enctype="{{ form.enctype }}"{% endif %}
						method="post"
						id="Form-{{ form.identifier|ucparts(false) }}"
					>

						{% block formBodyNoWrapper %}
							{{ contents|raw }}
						{% endblock %}

						<input type="hidden" name="form_identifier" value="{{ form.identifier }}">
						<input type="hidden" name="page_id" value="{{ page.id }}">
					</form>
				{% endblock %}
			{% endif %}

			{% block formActionJs %}
				<script nonce="{{ AssetHelper.getScriptNonce() }}">
					setTimeout(function () {
						const formElementsChecksum = '{{ now }}{{ formElementsChecksum }}';
						const form = document.getElementById('Form-{{ form.identifier|ucparts(false) }}');

						if (form) {
							const action = form.getAttribute('data-' + formElementsChecksum);
							form.removeAttribute('data-' + formElementsChecksum);

							if (action) {
								form.setAttribute('action', action);
							}
						}
					}, {{ formElements.listNested().count() * 500 }});
				</script>
			{% endblock %}
		{% endblock %}
	{% endif %}
{% endif %}
