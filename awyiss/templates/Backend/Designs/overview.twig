{#
@var design \Awyiss\Model\Entity\Design
@var designs \Cake\Datasource\Paging\PaginatedResultSet
@var fontStacks array
@var fontWeights array
@var preview \Awyiss\Model\Entity\Design|null
@var previewIdentifier string
@var units array
@var variables array
@var webfonts array
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% use '@Backend/Designs/blocks.twig' %}

<div class="Designs Overview">
	{% block headlinesOverview %}
		<div class="Headlines">
			{% block headlineOverview %}
				<h1>{{ __('headline_overview') }}</h1>
			{% endblock %}

			{% block subheadlineOverview %}
				{% if design.inUse == false %}
					<p class="Title">{{ design.isPreview == false ? design.title : __('preview') }} ({{ design.createdByUser.username }}, {{ TimeHelper.nice(design.createdOn) }})</p>
				{% else %}
					<p class="Title">{{ __('current_settings') }}</p>
				{% endif %}
			{% endblock %}
		</div>
	{% endblock %}

	{{ FormHelper.checkbox('save_as_copy', {form: 'DesignForm', id: 'SaveAsCopy', value: true, 'data-form-updater': true}) }}

	{% block buttonAreaToggle %}
		{{ FormHelper.button(__('button_area_toggle'), {class: 'Button Button-Menu', id: 'ButtonArea-Toggle', name: 'button', type: 'button'}) }}
	{% endblock %}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block overviewButtons %}
				{% block overviewButtonReset %}
					{% if design.isPreview == false and design.inUse == false %}
						{{ FormHelper.button(__('reset'), {class: 'Button Button-Error Button-Close', form: 'DesignForm', name: 'reset', value: design.identifier}) }}
					{% endif %}
				{% endblock %}

				{% block overviewButtonPreview %}
					{% if design.isPreview %}
						{% block overviewButtonPreviewUpdate %}
							{{ FormHelper.button(__('update_preview'), {class: 'Button Button-View', form: 'DesignForm', name: 'preview', value: design.identifier}) }}
						{% endblock %}

						{% block overviewButtonPreviewClose %}
							{{ FormHelper.button(__('cancel_preview'), {class: 'Button Button-Error Button-Close', form: 'DesignForm', name: 'cancel_preview', value: design.identifier}) }}
						{% endblock %}
					{% else %}
						{% block overviewButtonPreviewPreview %}
							{{ FormHelper.button(__('preview'), {class: 'Button Button-View', form: 'DesignForm', name: 'preview', value: design.identifier}) }}
						{% endblock %}
					{% endif %}
				{% endblock %}

				{% block overviewButtonUse %}
					{% if AuthorizationHelper.isAccessible('use') %}
						{{ FormHelper.button(__('confirm_apply_yes'), {
							class: 'Button Button-Success Button-Save',
							form: 'DesignForm',
							name: 'use',
							value: design.identifier,
							'data-confirm-title': __('confirm_apply_title'),
							'data-confirm-yes': __('confirm_apply_yes'),
							'data-confirm-yes-class': 'Button-Success Button-Save',
							'data-confirm-no': __('confirm_apply_no'),
							'data-confirm': __('confirm_apply', key),
						}) }}
					{% endif %}
				{% endblock %}
			{% endblock %}
		</div>
	{% endblock %}

	{{ FormHelper.create(preview ?? design, {method: 'post', id: 'DesignForm', idPrefix: 'design'}) }}

	{% block fieldsetsOverview %}
		<div class="Fieldsets">
			{% block fieldsetOverview %}
				{% for category, variables in variables %}
					<fieldset class="Overview-Fieldset Fieldset-{{ category|camelize }} Collapsible">
						<legend>{{ __('fieldset_' ~ category) }}</legend>
						{% block fieldsetOverviewInner %}
							{% for key, options in variables %}
								{% set variable = key %}
								{{ block('formControl' ~ options.type.name) }}
							{% endfor %}
						{% endblock %}
					</fieldset>
				{% endfor %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block previewOverview %}
		<iframe src="{{ baseUrl }}" id="Preview" data-allow-google-fonts="{{ config.Design.allowGoogleFonts ? 'true' : 'false' }}"></iframe>
	{% endblock %}

	{% block formInputReloadForm %}
		{{ FormHelper.hidden('reload_form', {val: 0}) }}
	{% endblock %}

	{{ FormHelper.end() }}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{% if AuthorizationHelper.isAccessible('save') %}
				{{ FormHelper.button(__('save_settings'), {class: 'Button Button-Success Button-Save Button-SaveSettings', form: 'DesignForm', name: 'save', type: 'button'}) }}
			{% endif %}

			{{ block('overviewButtons') }}
		</div>
	{% endblock %}

	{% block formSaveDialog %}
		<dialog id="SaveDialog" data-title="{{ __('save_settings_title') }}">
			{% block formSaveDialogInner %}
				{% block formControlTitle %}
					{{ FormHelper.control('title', {form: 'DesignForm', required: false}) }}
				{% endblock %}

				{% block formControlDescription %}
					{{ FormHelper.control('description', {form: 'DesignForm'}) }}
				{% endblock %}

				{% block formSaveDialogConfirm %}
					<button id="SaveDialog-Button-Yes" class="Button Button-Success Button-Save" type="submit" name="save" value="{{ design.identifier }}" form="DesignForm">{{ __('save_settings_yes') }}</button>
				{% endblock %}

				{% block formSaveDialogCancel %}
					<button id="SaveDialog-Button-No" class="Button Button-Close" style="">{{ __('save_settings_no') }}</button>
				{% endblock %}
			{% endblock %}
		</dialog>
	{% endblock %}

	{% block paginatedOverview %}
		{% if designs.count > 1 %}
			<h2>{{ __('headline_saved_designs') }}</h2>
			{% include '@Backend/Designs/overview_paginated_list.twig' with _context|merge({records: designs.items().toArray()}) %}
		{% endif %}
	{% endblock %}
</div>

<script nonce="{{ AssetHelper.getScriptNonce() }}">
	const webfonts = {{ webfonts|json_encode|raw }};
</script>
