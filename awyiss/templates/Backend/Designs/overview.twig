{#
@var design \Awyiss\Model\Entity\Design
@var fontStacks array
@var fontWeights array
@var preview \Awyiss\Model\Entity\Design|null
@var previewIdentifier string
@var units array
@var variables array
@var webfonts array
@var _view \Awyiss\View\BackendView
#}

{% use '@Backend/Designs/blocks.twig' %}

<div class="Design Overview">
	{% block headlineOverview %}
		<h1>{{ __('headline_overview') }}</h1>
	{% endblock %}

	{{ FormHelper.create(preview ?? design, {method: 'post', idPrefix: 'design'}) }}

	{{ FormHelper.checkbox('save_as_copy', {id: 'SaveAsCopy', value: true}) }}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block buttonsOverview %}
				{% if design.isPreview %}
					{{ FormHelper.button(__('cancel'), {class: 'Button Button-Cancel', name: 'cancel'}) }}
				{% endif %}

				{{ FormHelper.button(__('preview'), {class: 'Button Button-View', name: 'preview', value: design.isPreview ? design.identifier : ''}) }}

				{% if AuthorizationHelper.isAccessible('save') %}
					{{ FormHelper.button(__('apply'), {
						class: 'Button Button-Success Button-Save',
						name: 'save',
						value: design.isPreview ? design.identifier : '',
						'data-confirm-title': __('confirm_apply_title'),
						'data-confirm-yes': __('confirm_apply_yes'),
						'data-confirm-yes-class': 'Button-Success Button-Save',
						'data-confirm-no': __('confirm_apply_no'),
						'data-confirm': __('confirm_apply', key),
					}) }}
				{% endif %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block fieldsetsOverview %}
		<div class="Fieldsets">
			{% block fieldsetOverview %}
				{% for category, variables in variables %}
					<fieldset class="Overview-Fieldset Fieldset-{{ category|camelize }} Collapsible">
						<legend>{{ __('fieldset_' ~ category) }}</legend>
						{% block fieldsetOverviewInner %}
							{% for key, options in variables %}
								{% set variable = key %}
								{{ block('formControl' ~ options.type.name) }}
							{% endfor %}
						{% endblock %}
					</fieldset>
				{% endfor %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block previewOverview %}
		<iframe src="{{ baseUrl }}" id="Preview"></iframe>
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('buttonsOverview') }}
		</div>
	{% endblock %}

	{% block formInputReloadForm %}
		{{ FormHelper.hidden('reload_form', {val: 0}) }}
	{% endblock %}

	{{ FormHelper.end() }}
</div>

<script nonce="{{ AssetHelper.getScriptNonce() }}">
	const webfonts = {{ webfonts|json_encode|raw }};
</script>
