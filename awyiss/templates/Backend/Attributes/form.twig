{#
@var ao_attribute \Awyiss\Model\Entity\Attribute
@var aa_availableFieldsets array
@var aa_availableInputTypes array
@var aa_availableInputTypes array
@var aa_availableInputTypes array
@var ab_translatableDisabled bool
@var ab_requiredDisabled bool
@var _view \Awyiss\View\BackendView
#}

{% block fieldsetPresentation %}
	<fieldset class="Fieldset-Presentation">
		<legend>{{ __('fieldset_presentation') }}</legend>

		{% block fieldsetPresentationInner %}
			{% block formControlActive %}
				{{ FormHelper.control('active') }}
			{% endblock %}

			{% block formControlTranslatable %}
				{{ FormHelper.control('translatable', {disabled: ab_translatableDisabled}) }}
			{% endblock %}

			{% block formControlRequired %}
				{{ FormHelper.control('required', {disabled: ab_requiredDisabled}) }}
			{% endblock %}

			{% block formControlHasIndex %}
				{{ FormHelper.control('has_index') }}
			{% endblock %}

			{% block formControlInputType %}
				{{ FormHelper.control('input_type', {empty: false, options: combine(aa_availableInputTypes, aa_availableInputTypes)}) }}
			{% endblock %}

			{% block fieldsetPresentationAttributes %}
				{{ AttributesHelper.allControls('presentation') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetConditions %}
	<fieldset class="Fieldset-Conditions">
		<legend>{{ __('fieldset_conditions') }}</legend>

		{% block fieldsetConditionsInner %}
			{% block formControlScope %}
				{{ CategoriesHelper.control('scope', {'data-form-updater': true}) }}
			{% endblock %}

			{% block formControlFieldset %}
				{{ FormHelper.control('fieldset', {
					empty: false,
					options: combine(aa_availableFieldsets, aa_availableFieldsets),
					disabled: ao_attribute.scope == 'contents',
					'data-form-updater': true
				}) }}
			{% endblock %}

			{% block formControlSystemOrder %}
				{{ SystemOrderHelper.control('system_order', {entity: ao_attribute}) }}
			{% endblock %}

			{% block fieldsetConditionsAttributes %}
				{{ AttributesHelper.allControls('conditions') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

