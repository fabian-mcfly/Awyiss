{#
@var attribute \Awyiss\Model\Entity\Attribute
@var availableFieldsets array
@var availableInputTypes array
@var availableInputTypes array
@var availableInputTypes array
@var translatableDisabled bool
@var requiredDisabled bool
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{{ FormHelper.create(attribute, {method: 'post', id: 'AttributeForm', idPrefix: 'attribute'}) }}
<input type="hidden" name="attributes" value="">

{% set fieldsetGeneral %}
	{% block fieldsetGeneral %}
		<fieldset class="Fieldset-General">
			<legend>{{ __('fieldset_general') }}</legend>

			{% block fieldsetGeneralInner %}
				{% block formControlTitle %}
					{{ FormHelper.control('title') }}
				{% endblock %}

				{% block formControlIdentifier %}
					{{ FormHelper.control('identifier', {'data-autofill-from': 'title', 'data-camelize': 'true'}) }}
				{% endblock %}

				{% block formControlDefaultValue %}
					{{ FormHelper.control('defaultValue', {columnSpan: 6}) }}
				{% endblock %}

				{% set typeHelperFormControl %}
					{{ FormHelper.select('linkHelperOptions', {
						'datetime': 'datetime',
						'date': 'date',
						'decimal(10,2)': 'decimal(10,2)',
						'int(11)': 'int(11)',
						'text': 'text',
						'time': 'time',
						'tinyint(1)': 'tinyint(1)',
						'varchar(255)': 'varchar(255)',
					}, {
						'data-options-for': 'Attribute-Type',
					}) }}
				{% endset %}

				{% block formControlType %}
					{{ FormHelper.control('type', {
						columnSpan: 6,
						readonly: attribute.inputType in ['inputList', 'inputKeyValueList'],
						templateVars: {
							additionalContent: typeHelperFormControl
						},
					}) }}
				{% endblock %}

				{% block fieldsetGeneralAttributes %}
					{{ AttributesHelper.allControls('general') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetContent %}
	{% block fieldsetContent %}
		<fieldset class="Fieldset-Content">
			<legend>{{ __('fieldset_content') }}</legend>

			{% block fieldsetContentInner %}
				{% block fieldsetContentAttributes %}
					{{ AttributesHelper.allControls('content') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetMedia %}
	{% block fieldsetMedia %}
		<fieldset class="Fieldset-Media">
			<legend>{{ __('fieldset_media') }}</legend>

			{% block fieldsetMediaInner %}
				{{ cell('Backend/MediaElements', [attribute]) }}

				{% block fieldsetMediaAttributes %}
					{{ AttributesHelper.allControls('media') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetMediaElementAssignments %}
	{% block fieldsetMediaElementAssignments %}
		{{ cell('Backend/MediaElements::elementAssignments', [attribute]) }}
	{% endblock %}
{% endset %}

{% set fieldsetPresentation %}
	{% block fieldsetPresentation %}
		<fieldset class="Fieldset-Presentation">
			<legend>{{ __('fieldset_presentation') }}</legend>

			{% block fieldsetPresentationInner %}
				{% block formControlActive %}
					{{ FormHelper.control('active', {columnSpan: 6}) }}
				{% endblock %}

				{% block formControlTranslatable %}
					{{ FormHelper.control('translatable', {columnSpan: 6, disabled: translatableDisabled}) }}
				{% endblock %}

				{% block formControlRequired %}
					{{ FormHelper.control('required', {disabled: requiredDisabled}) }}
				{% endblock %}

				{% block formControlInputType %}
					{{ FormHelper.control('inputType', {
						columnSpan: 6,
						empty: false,
						options: combine(availableInputTypes, availableInputTypes|map(inputType => __('input_type_' ~ inputType|underscore))),
						'data-form-updater': true,
					}) }}
				{% endblock %}

				{% block formControlColumnSpan %}
					{{ FormHelper.control('columnSpan', {columnSpan: 6, disabled: columnSpanDisabled, empty: false, options: columnSpans, type: 'select'}) }}
				{% endblock %}

				{% block fieldsetPresentationAttributes %}
					{{ AttributesHelper.allControls('presentation') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetConditions %}
	{% block fieldsetConditions %}
		<fieldset class="Fieldset-Conditions">
			<legend>{{ __('fieldset_conditions') }}</legend>

			{% block fieldsetConditionsInner %}
				{% block formControlScope %}
					{{ CategoriesHelper.control('scope', {'data-form-updater': true}) }}
				{% endblock %}

				{% block formControlFieldset %}
					{{ FormHelper.control('fieldset', {
						columnSpan: 6,
						empty: false,
						options: combine(availableFieldsets, availableFieldsets|map(fieldset => __d(attribute.scope, 'fieldset_' ~ fieldset))),
						disabled: attribute.scope in ['Contents', 'GlobalContents'],
						'data-form-updater': true
					}) }}
				{% endblock %}

				{% block formControlSystemOrder %}
					{{ SystemOrderHelper.control('systemOrder', {columnSpan: 6, entity: attribute}) }}
				{% endblock %}

				{% block formControlHasIndex %}
					{{ FormHelper.control('hasIndex', {columnSpan: 6}) }}
				{% endblock %}

				{% block fieldsetConditionsAttributes %}
					{{ AttributesHelper.allControls('conditions') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetAttributes %}
	{% block fieldsetAttributes %}
		<fieldset class="Fieldset-Attributes">
			<legend>{{ __('fieldset_attributes') }}</legend>

			{% block fieldsetAttributesInner %}
				{% block fieldsetAttributesAttributes %}
					{{ AttributesHelper.allControls('attributes') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% block sidebarToggle %}
	{% if config.Awyiss.System.Backend.interface.sidebarMode == true and isOverlayForm != true %}
		{{ FormHelper.button(__('sidebar_toggle'), {class: 'Button Button-Configure', id: 'Sidebar-Toggle', name: 'button', type: 'button'}) }}
	{% endif %}
{% endblock %}

{% block fieldsets %}
	<div class="Fieldsets">
		{% if config.Awyiss.System.Backend.interface.sidebarMode != true or isOverlayForm == true %}
			{{ fieldsetPresentation }}
			{{ fieldsetConditions }}
			{{ fieldsetGeneral }}
			{{ fieldsetContent }}
			{{ fieldsetMedia }}
			{{ fieldsetMediaElementAssignments }}
			{{ fieldsetAttributes }}
		{% endif %}

		{% block mainFieldsets %}
			{% if config.Awyiss.System.Backend.interface.sidebarMode == true and isOverlayForm != true %}
				<div class="Main-Fieldsets">
					{{ fieldsetGeneral }}
					{{ fieldsetContent }}
					{{ fieldsetMedia }}
					{{ fieldsetMediaElementAssignments }}
				</div>
			{% endif %}
		{% endblock %}

		{% block sidebarFieldsets %}
			{% if config.Awyiss.System.Backend.interface.sidebarMode == true and isOverlayForm != true %}
				<div class="Sidebar-Fieldsets">
					{{ fieldsetPresentation }}
					{{ fieldsetConditions }}
					{{ fieldsetAttributes }}
				</div>
			{% endif %}
		{% endblock %}

		{% block formInputReloadForm %}
			{{ FormHelper.hidden('reloadForm', {val: 0}) }}
		{% endblock %}
	</div>
{% endblock %}

{% block lockDialog %}
	{{ element('lock_dialog', {entity: attribute}) }}
{% endblock %}

{{ FormHelper.end() }}
