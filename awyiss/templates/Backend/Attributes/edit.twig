{#
@var ao_attribute \Awyiss\Model\Entity\Attribute
@var aa_availableFieldsets array
@var aa_availableInputTypes array
@var aa_availableInputTypes array
@var aa_availableInputTypes array
@var ab_translatableDisabled bool
@var ab_requiredDisabled bool
@var _view \Awyiss\View\BackendView
#}

<div class="Attributes Form Edit">
	{% block headlineEdit %}
		<h1>{{ __('headline_edit') }}</h1>
	{% endblock %}

	{{ FormHelper.create(ao_attribute, {method: 'post', idPrefix: 'attribute'}) }}

	{{ FormHelper.checkbox('save_as_copy', {id: 'SaveAsCopy', value: true}) }}

	{% block formEditButtons %}
		<label for="SaveAsCopy">{{ __('as_copy') }}</label>
		{{ FormHelper.button(__('save')) }}
		{{ FormHelper.button(__('save_close'), {name: 'submit', value: 'submit_close'}) }}
	{% endblock %}

	{% block formEdit %}
		{% include('@Backend/Attributes/form.twig') %}
	{% endblock %}

	{% block formEditButtonsBottom %}
		{{ block('formEditButtons') }}
	{% endblock %}

	{{ FormHelper.end() -}}
</div>
