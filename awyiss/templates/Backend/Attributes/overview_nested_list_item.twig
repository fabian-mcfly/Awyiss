{% extends '@Backend/element/overview/nested_list_item.twig' %}

{% block nestedListItemDataDisplayedFieldDefaultValue %}
	{% if field == 'default_value' %}
		{{ entity.defaultValue ?? '<em>null</em>' }}
	{% elseif field == 'fieldset' %}
		{{ entity.fieldset ? __('fieldset_' ~ entity.fieldset) : '' }}
	{% elseif field == 'input_type' %}
		{{ __('input_type_' ~ entity.inputType) }}
	{% else %}
		{{ parent() }}
	{% endif %}
{% endblock %}