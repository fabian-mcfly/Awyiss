{#
@var ao_attribute \Awyiss\Model\Entity\Attribute
@var aa_availableFieldsets array
@var aa_availableInputTypes array
@var aa_availableInputTypes array
@var aa_availableInputTypes array
@var ab_translatableDisabled bool
@var ab_requiredDisabled bool
@var _view \Awyiss\View\BackendView
#}

<div class="Attributes Form Add">
	{% block headlineAdd %}
		<h1>{{ __('headline_add') }}</h1>
	{% endblock %}

	{{ FormHelper.create(ao_attribute, {method: 'post', idPrefix: 'attribute'}) }}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block formAddButtons %}
				{{ FormHelper.button(__('save'), {class: 'Button Button-Success'}) }}
				{{ FormHelper.button(__('save_close'), {class: 'Button', name: 'submit', value: 'submit_close'}) }}
			{% endblock %}
		</div>
	{% endblock %}

	{% block formAdd %}
		{% include('@Backend/Attributes/form.twig') %}
	{% endblock %}

	{% block formAddButtonsBottom %}
		{{ block('formAddButtons') }}
	{% endblock %}

	{{ FormHelper.end() }}
</div>