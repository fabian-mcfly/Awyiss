{#
@var ao_attributes \Awyiss\Model\Entity\Attribute[]
@var aa_attributesGroupedByFieldset array
@var aa_attributeScopes array
@var _view \Awyiss\View\BackendView
@var CategproesHelper \Awyiss\View\Helper\CategoriesHelper
#}

<div class="Attributes Overview">
	{% block headlineOverview %}
		<h1>{{ __('headline_overview') }}</h1>
	{% endblock %}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block categoriesFilterOverview %}
				{{ CategoriesHelper.filter('scope') }}
			{% endblock %}

			{% block buttonsOverview %}
				{% if AuthorizationHelper.isAccessible('create') %}
					{{ HtmlHelper.link(__('create'), {action: 'add', scope: as_selectedScope}, {class: 'Button'}) }}
				{% endif %}
			{% endblock %}
		</div>
	{% endblock %}

	{% from '@Backend/macro/nested_list.twig' import nestedList %}
	{% for ls_fieldset in aa_availableFieldsets %}
		{% block fieldsetOverview %}
			<fieldset class="Fieldset-Fieldsets">
				<legend>{{ __('fieldset_' ~ ls_fieldset) }}</legend>

				{% block fieldsetOverviewInner %}
					{% block listOverview %}
						{% if aa_attributesGroupedByFieldset[ ls_fieldset ] is defined %}
							{{ nestedList(aa_attributesGroupedByFieldset[ ls_fieldset ], {
								contentsEnabled: ab_contentsEnabled,
								identifier: 'Pages',
								template: '@Backend/Attributes/overview_nested_list_item.twig',
							}) }}
						{% endif %}
					{% endblock %}
				{% endblock %}
			</fieldset>
		{% endblock %}
	{% endfor %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonAreaBottom">
			{{ block('categoriesFilterOverview') }}

			{{ block('buttonsOverview') }}
		</div>
	{% endblock %}
</div>
