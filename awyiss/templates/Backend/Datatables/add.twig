{#
@var ao_datatable Awyiss\Model\Entity\Datatable
@var _view \Awyiss\View\BackendView
#}

<div class="Datatables Form Add">
	{% block headlineAdd %}
		<h1>{{ __('headline_add') }}</h1>
	{% endblock %}

	{{ helper_Form_create(ao_datatable, {method: 'post', idPrefix: 'datatable'}) }}

	{% block formAddButtons %}
		{{ helper_Form_button(__('save')) }}
		{{ helper_Form_button(__('save_close'), {name: 'submit', value: 'submit_close'}) }}
	{% endblock %}

	{% block formAdd %}
		{% include('@Backend/Datatables/form.twig') %}
	{% endblock %}

	{% block formAddButtonsBottom %}
		{{ block('formAddButtons') }}
	{% endblock %}

	{{ helper_Form_end() -}}
</div>
