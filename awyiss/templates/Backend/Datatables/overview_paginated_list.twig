{% extends '@Backend/element/overview/overview_paginated_list.twig' %}

{% block tableOverviewCellActions %}
	<td class="TableCell-Actions">
		<div class="Actions">
			{% do AuthorizationHelper.setScope(entity.identifier) %}
			{% if AuthorizationHelper.isAccessible('read') %}
				{{ HtmlHelper.link(__('view_data'), {controller: entity.identifier, action: 'overview'}, {
					class: 'Button Button-Small Button-View Button-ViewData',
					disabled: entity.active == false,
				}) }}
			{% endif %}
			{% do AuthorizationHelper.resetScope() %}

			{{ block('tableOverviewCellActionsGallery') }}

			{{ block('tableOverviewCellActionsUpdate') }}

			{{ block('tableOverviewCellActionsDelete') }}
		</div>
	</td>
{% endblock %}

