{#
@var ao_pageRole \Awyiss\Model\Entity\PageRole
@var _view \Awyiss\View\BackendView
#}

<div class="PageRoles Form Add">
	{{ helper_Form_create(ao_pageRole, {method: 'post', idPrefix: 'PageRole'}) }}

	{% block headlineAdd %}
		<h1>{{ __('headline_add') }}</h1>
	{% endblock %}

	{% block formAddButtons %}
		{{ helper_Form_button(__('save')) }}
		{{ helper_Form_button(__('save_close'), {name: 'submit', value: 'submit_close'}) }}
	{% endblock %}

	{% block formAdd %}
		{% include('@Backend/PageRoles/form.twig') %}
	{% endblock %}

	{% block formAddButtonsBottom %}
		{{ block('formAddButtons') }}
	{% endblock %}

	{{ helper_Form_end() -}}
</div>