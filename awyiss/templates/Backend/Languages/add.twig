{#
@var language \Awyiss\Model\Entity\Language
@var realms array
@var _view \Awyiss\View\BackendView
#}

{% set tempRealms = [] %}
{% for realm in realms %}
	{% set tempRealms = tempRealms|merge({(realm): __('realm_' ~ realm|underscore)}) %}
{% endfor %}
{% set realms = tempRealms %}

<div class="Languages Form Add">
	{% if AuthorizationHelper.isAccessible('read') %}
		{{ HtmlHelper.link(__('back_to_overview'), {action: 'overview'}, {class: 'BackToOverview'}) }}
	{% endif %}

	{% block headlineAdd %}
		<h1>{{ __('headline_add') }}</h1>
	{% endblock %}

	{{ FormHelper.create(language, {method: 'post', idPrefix: 'Language'}) }}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block formAddButtons %}
				{% block formAddButtonSave %}
					{{ FormHelper.button(__('save'), {class: 'Button Button-Success Button-Save'}) }}
				{% endblock %}

				{% block formAddButtonSaveClose %}
					{% if AuthorizationHelper.isAccessible('read') %}
						{{ FormHelper.button(__('save_close'), {class: 'Button Button-SaveClose', name: 'submit', value: 'submit_close'}) }}
					{% endif %}
				{% endblock %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block formAdd %}
		{% include('@Backend/Languages/form.twig') %}
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('formAddButtons') }}
		</div>
	{% endblock %}

	{{ FormHelper.end() }}
</div>
