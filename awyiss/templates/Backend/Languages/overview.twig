{#
@var ao_languages \Cake\Collection\Collection
@var aa_realms array
@var _view \Awyiss\View\BackendView
#}

{% set la_languages = ao_languages.toArray() %}

<div class="Languages Overview">
	{% block buttonsOverview %}
		{% if AuthorizationHelper.isAccessible('create') %}
			{{ HtmlHelper.link(__('create'), {action: 'add'}, {class: 'Button'}) }}
		{% endif %}
	{% endblock %}

	{% block headlineOverview %}
		<h1>{{ __('headline_overview') }}</h1>
	{% endblock %}

	{% for ls_realm in aa_realms %}
		{% block fieldsetOverview %}
			<fieldset class="Fieldset-Overview">
				<legend>{{ __('' ~ ls_realm) }}</legend>

				{% block fieldsetOverviewInner %}
					{% block tableOverview %}
						<table class="Table-Overview">
							{% block tableOverviewHead %}
								<thead>
									{% block tableOverviewHeadRow %}
										<tr>
											{% block tableOverviewHeaderTitle %}
												<th>{{ __('title') }}</th>
											{% endblock %}

											{% block tableOverviewHeaderShortcode %}
												<th>{{ __('shortcode') }}</th>
											{% endblock %}

											{% block tableOverviewHeaderTimezone %}
												<th>{{ __('timezone') }}</th>
											{% endblock %}

											{% block tableOverviewHeaderLocale %}
												<th>{{ __('locale') }}</th>
											{% endblock %}

											{% block tableOverviewHeaderActions %}
												<th class="actions"></th>
											{% endblock %}
										</tr>
									{% endblock %}
								</thead>
							{% endblock %}
							{% block tableOverviewBody %}
								<tbody>
									{# @var lo_language \Awyiss\Model\Entity\Language #}
									{% for lo_language in la_languages[ ls_realm ] %}
										{% block tableOverviewBodyRow %}
											<tr>
												{% block tableOverviewCellTitle %}
													<td>{{ lo_language.title }} ({{ lo_language.systemOrder }})</td>
												{% endblock %}

												{% block tableOverviewCellShortcode %}
													<td>{{ lo_language.shortcode }}</td>
												{% endblock %}

												{% block tableOverviewCellTimezone %}
													<td>{{ lo_language.timezone }}</td>
												{% endblock %}

												{% block tableOverviewCellLocale %}
													<td>{{ lo_language.locale }}</td>
												{% endblock %}

												{% block tableOverviewCellActions %}
													<td class="actions">
														{% if AuthorizationHelper.isAccessible('update') %}
															{{ HtmlHelper.link(__('edit'), {action: 'edit', id: lo_language.id}) }}
														{% endif %}
														{% if AuthorizationHelper.isAccessible('delete') %}
															{{ HtmlHelper.link(__('delete'), {action: 'delete', id: lo_language.id}, {
				class: 'Button Button-Small Button-Delete',
				'data-confirm-title': __('confirm_delete_title'),
				'data-confirm-yes': __('confirm_delete_yes'),
				'data-confirm-yes-class': 'Button-Delete',
				'data-confirm-no': __('confirm_delete_no'),
				'data-confirm': __('confirm_delete', lo_language.id) }) }}
														{% endif %}
													</td>
												{% endblock %}
											</tr>
										{% endblock %}
									{% endfor %}
								</tbody>
							{% endblock %}
						</table>
					{% endblock %}
				{% endblock %}
			</fieldset>
		{% endblock %}
	{% endfor %}
</div>
