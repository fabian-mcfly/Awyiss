{% extends '@Backend/element/overview/overview_paginated_list.twig' %}

{% block tableOverviewCellActions %}
	<td class="TableCell-Actions">
		<div class="Actions">
			{{ HtmlHelper.link(__('view_elements'), {controller: 'FormElements', action: 'overview', formId: entity.id}, {
				class: 'Button Button-Small Button-View Button-ViewElements',
			}) }}

			{% do AuthorizationHelper.setScope('FormEntries') %}
				{% if AuthorizationHelper.isAccessible('read') %}
					{{ HtmlHelper.link(__('view_entries'), {controller: 'FormEntries', action: 'overview', formId: entity.id}, {
						class: 'Button Button-Small Button-View Button-ViewEntries',
					}) }}
				{% endif %}
			{% do AuthorizationHelper.resetScope() %}

			{{ block('tableOverviewCellActionsUpdate') }}

			{{ block('tableOverviewCellActionsDelete') }}
		</div>
	</td>
{% endblock %}

