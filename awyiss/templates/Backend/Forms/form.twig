{#
@var form \Awyiss\Model\Entity\Form
@var emailTemplates \Awyiss\Model\Entity\EmailTemplate[]
@var formConditionalRecipientTypes array
@var formConditionalRecipientOperators array
@var pageProperties array
@var formTemplates array
@var transportProfiles array
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{{ FormHelper.create(form, {method: 'post', id: 'FormForm', idPrefix: 'form'}) }}
<input type="hidden" name="attributes" value="">

{% set fieldsetGeneral %}
	{% block fieldsetGeneral %}
		<fieldset class="Fieldset-General">
			<legend>{{ __('fieldset_general') }}</legend>

			{% block fieldsetGeneralInner %}
				{% block formControl_Title %}
					{{ FormHelper.control('title', {columnSpan: 6}) }}
				{% endblock %}

				{% block formControlIdentifier %}
					{{ FormHelper.control('identifier', {columnSpan: 6, 'data-autofill-from': 'title', 'data-camelize': 'true'}) }}
				{% endblock %}

				{% block formControlSuccessMessage %}
					{{ FormHelper.control('successMessage', {'data-editor': true}) }}
				{% endblock %}

				{% block formControlFormTemplate %}
					{% if formTemplates %}
						{{ FormHelper.control('formTemplate', {
							options: formTemplates,
						}) }}
					{% endif %}
				{% endblock %}

				{% block fieldsetGeneralAttributes %}
					{{ AttributesHelper.allControls('general') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetEmail %}
	{% block fieldsetEmail %}
		<fieldset class="Fieldset-Email">
			<legend>{{ __('fieldset_email') }}</legend>

			{% block fieldsetEmailInner %}
				{% block formControlOwnerEmail %}
					{{ FormHelper.control('ownerEmail', {columnSpan: 6}) }}
				{% endblock %}

				{% block formControlOwnerName %}
					{{ FormHelper.control('ownerName', {
						columnSpan: 6,
						placeholder: config.Awyiss.System.Frontend.meta.titleAppendix,
					}) }}
				{% endblock %}

				{% block formControlSendEmail %}
					{{ FormHelper.control('sendEmail') }}
				{% endblock %}

				{% block formControlSubject %}
					{{ FormHelper.control('subject', {columnSpan: 6}) }}
				{% endblock %}

				{% block formControlEmailTemplateId %}
					{% set emailTemplateAddButton %}
						{% if AuthorizationHelper.scopeIsAccessible('EmailTemplates', [], 'create') %}
							{{ HtmlHelper.link(__d('EmailTemplates', 'create'), {controller: 'EmailTemplates', action: 'add'}, {class: 'Button Button-Add InFieldButton OverlayForm'}) }}
						{% endif %}
					{% endset %}

					{% set emailTemplateEditButton %}
						{% if form.emailTemplateId and AuthorizationHelper.scopeIsAccessible('EmailTemplates', [], 'update') %}
							{{ HtmlHelper.link(__('edit'), {controller: 'EmailTemplates', action: 'edit', id: form.emailTemplateId}, {class: 'Button Button-Edit InFieldButton OverlayForm'}) }}
						{% endif %}
					{% endset %}

					{{ FormHelper.control('emailTemplateId', {
						columnSpan: 6,
						options: hashPrinter(emailTemplates.toArray(), 'label', 'id'),
						templateVars: {
							additionalContent: emailTemplateAddButton ~ emailTemplateEditButton
						},
						'data-form-updater': true,
					}) }}
				{% endblock %}

				{% block formAdditionalEmailSettings %}
					<details>
						{% block formAdditionalEmailSettingsSummary %}
							<summary>{{ __('additional_email_settings') }}</summary>
						{% endblock %}

						{% block formAdditionalEmailSettingsInner %}
							<fieldset class="EmailDetails Grid-12">
								{% block formControlCc %}
									<div
											class="FormInput FormInputType-List FormInputName-Cc ColumnSpan-6" data-list-item-add="{{ __('list_item_add') }}"
											data-list-item-remove="{{ __('list_item_remove') }}">
										<label class="Label">{{ __('cc') }}</label>

										{% set counter = 0 %}
										{% for cc in form.cc %}
											<div class="FormInputType-ListItem">
												{{ FormHelper.control('cc.' ~ counter ~ '.email', {
													label: __('cc_email'),
												}) }}

												{{ FormHelper.control('cc.' ~ counter ~ '.name', {
													label: __('cc_name'),
												}) }}

												{% set counter = counter + 1 %}
											</div>
										{% endfor %}

										<div class="FormInputType-ListItem FormInputType-ListItem-Default">
											{{ FormHelper.control('cc.' ~ counter ~ '.email', {
												label: __('cc_email'),
											}) }}

											{{ FormHelper.control('cc.' ~ counter ~ '.name', {
												label: __('cc_name'),
											}) }}
										</div>

										{% if form.error('cc') %}
											{% for error in form.error('cc') %}
												<div class="Error">
													{{ error }}
												</div>
											{% endfor %}
										{% endif %}
									</div>
								{% endblock %}

								{% block formControlBcc %}
									<div
											class="FormInput FormInputType-List FormInputName-Bcc ColumnSpan-6" data-list-item-add="{{ __('list_item_add') }}"
											data-list-item-remove="{{ __('list_item_remove') }}">
										<label class="Label">{{ __('bcc') }}</label>

										{% set counter = 0 %}
										{% set translatable = languages.Frontend|filter(language => language.active)|length > 1 %}
										{% for bcc in form.bcc %}
											<div class="FormInputType-ListItem">
												{{ FormHelper.control('bcc.' ~ counter ~ '.email', {
													label: __('bcc_email'),
												}) }}

												{{ FormHelper.control('bcc.' ~ counter ~ '.name', {
													label: __('bcc_name'),
												}) }}

												{% set counter = counter + 1 %}
											</div>
										{% endfor %}

										<div class="FormInputType-ListItem FormInputType-ListItem-Default">
											{{ FormHelper.control('bcc.' ~ counter ~ '.email', {
												label: __('bcc_email'),
											}) }}

											{{ FormHelper.control('bcc.' ~ counter ~ '.name', {
												label: __('bcc_name'),
											}) }}
										</div>

										{% if form.error('bcc') %}
											{% for error in form.error('bcc') %}
												<div class="Error">
													{{ error }}
												</div>
											{% endfor %}
										{% endif %}
									</div>
								{% endblock %}

								{% block formControlFormConditionalRecipients %}
									<div
											class="FormInput FormInputType-List FormInputName-FormConditionalRecipients" data-list-item-add="{{ __('list_item_add') }}"
											data-list-item-remove="{{ __('list_item_remove') }}">

										<label class="Label">{{ __('form_conditional_recipients') }}</label>

										{% set counter = 0 %}
										{% set formConditionalRecipientTypes = combine(
											formConditionalRecipientTypes,
											formConditionalRecipientTypes|map(formConditionalRecipientType => __d('FormConditionalRecipients', 'type_' ~ formConditionalRecipientType|underscore))
										) %}

										{% set formConditionalRecipientOperators = combine(
											formConditionalRecipientOperators|column('value'),
											formConditionalRecipientOperators|map(formConditionalRecipientOperator => __d('FormConditionalRecipients', 'operator_' ~ formConditionalRecipientOperator.name|underscore))
										) %}

										{% set formElements = form.formElements ? combine(
											form.formElements|column('identifier'),
											form.formElements|map(formElement => formElement.label ~ ' (' ~ formElement.identifier ~ ')')
										) : [] %}

										{% for key, conditionalRecipient in form.conditionalRecipients %}
											<div class="FormInputType-ListItem">
												{{ FormHelper.hidden('conditionalRecipients.' ~ counter ~ '.id', {
													val: conditionalRecipient.id,
												}) }}

												{{ FormHelper.control('conditionalRecipients.' ~ counter ~ '.type', {
													label: __d('FormConditionalRecipients', 'type'),
													options: formConditionalRecipientTypes,
													required: false,
												}) }}

												{% set fields = formElements %}
												{% if conditionalRecipient.type == 'currentPage' %}
													{% set fields = pageProperties %}
												{% endif %}

												{{ FormHelper.control('conditionalRecipients.' ~ counter ~ '.field', {
													label: __d('FormConditionalRecipients', 'field'),
													options: fields,
													required: false,
												}) }}

												{{ FormHelper.control('conditionalRecipients.' ~ counter ~ '.operator', {
													label: __d('FormConditionalRecipients', 'operator'),
													options: formConditionalRecipientOperators,
													required: false,
												}) }}

												{{ FormHelper.control('conditionalRecipients.' ~ counter ~ '.value', {
													label: __d('FormConditionalRecipients', 'value'),
													required: false,
												}) }}

												{{ FormHelper.control('conditionalRecipients.' ~ counter ~ '.recipient', {
													label: __d('FormConditionalRecipients', 'recipient'),
													required: false,
												}) }}

												{% set counter = counter + 1 %}
											</div>
										{% endfor %}

										<div class="FormInputType-ListItem FormInputType-ListItem-Default">
											{{ FormHelper.hidden('conditionalRecipients.' ~ counter ~ '.id', {
												val: '',
											}) }}

											{{ FormHelper.control('conditionalRecipients.' ~ counter ~ '.type', {
												label: __d('FormConditionalRecipients', 'type'),
												options: formConditionalRecipientTypes,
												required: false,
											}) }}

											{{ FormHelper.control('conditionalRecipients.' ~ counter ~ '.field', {
												disabled: true,
												label: __d('FormConditionalRecipients', 'field'),
												options: formElements,
												required: false,
											}) }}

											{{ FormHelper.control('conditionalRecipients.' ~ counter ~ '.operator', {
												label: __d('FormConditionalRecipients', 'operator'),
												options: formConditionalRecipientOperators,
												required: false,
											}) }}

											{{ FormHelper.control('conditionalRecipients.' ~ counter ~ '.value', {
												label: __d('FormConditionalRecipients', 'value'),
												required: false,
											}) }}

											{{ FormHelper.control('conditionalRecipients.' ~ counter ~ '.recipient', {
												label: __d('FormConditionalRecipients', 'recipient'),
												required: false,
											}) }}
										</div>

										<template id="FormElementOptions">
											{{ FormHelper.select('_formElementOptions', formElements) }}
										</template>

										<template id="CurrentPageOptions">
											{{ FormHelper.select('_currentPageOptions', pageProperties) }}
										</template>
									</div>
								{% endblock %}

								{% block formControlFormConditionalRecipientsStrategy %}
									{% set conditionalRecipientsStrategies = combine(
										conditionalRecipientsStrategies,
										conditionalRecipientsStrategies|map(conditionalRecipientsStrategy => __('conditional_recipients_strategy_' ~ conditionalRecipientsStrategy|underscore))
									) %}
									{{ FormHelper.control('conditionalRecipientsStrategy', {
										empty: false,
										options: conditionalRecipientsStrategies,
									}) }}
								{% endblock %}

								{% block formControlTransportProfile %}
									{{ FormHelper.control('transportProfile', {
										empty: false,
										options: transportProfiles,
									}) }}
								{% endblock %}
							</fieldset>
						{% endblock %}
					</details>
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetConfirmationEmail %}
	{% block fieldsetConfirmationEmail %}
		<fieldset class="Fieldset-ConfirmationEmail">
			<legend>{{ __('fieldset_confirmation_email') }}</legend>

			{% block fieldsetConfirmationEmailInner %}
				{% block formControlUserEmail %}
					{{ FormHelper.control('userEmail', {columnSpan: 6, placeholder: __('user_email_placeholder')}) }}
				{% endblock %}

				{% block formControlUserName %}
					{{ FormHelper.control('userName', {columnSpan: 6, placeholder: __('user_name_placeholder')}) }}
				{% endblock %}

				{% block formControlSendConfirmationEmail %}
					{{ FormHelper.control('sendConfirmationEmail') }}
				{% endblock %}

				{% block formControlSubjectConfirmation %}
					{{ FormHelper.control('subjectConfirmation', {
						columnSpan: 6,
						placeholder: __('subject_confirmation_placeholder'),
					}) }}
				{% endblock %}

				{% block formControlConfirmationEmailTemplateId %}
					{% set confirmationEmailTemplateAddButton %}
						{% if AuthorizationHelper.scopeIsAccessible('EmailTemplates', [], 'create') %}
							{{ HtmlHelper.link(__d('ConfirmationEmailTemplates', 'create'), {controller: 'EmailTemplates', action: 'add'}, {class: 'Button Button-Add InFieldButton OverlayForm'}) }}
						{% endif %}
					{% endset %}

					{% set confirmationEmailTemplateEditButton %}
						{% if form.confirmationEmailTemplateId and AuthorizationHelper.scopeIsAccessible('EmailTemplates', [], 'update') %}
							{{ HtmlHelper.link(__('edit'), {controller: 'EmailTemplates', action: 'edit', id: form.confirmationEmailTemplateId}, {class: 'Button Button-Edit InFieldButton OverlayForm'}) }}
						{% endif %}
					{% endset %}

					{{ FormHelper.control('confirmationEmailTemplateId', {
						columnSpan: 6,
						options: hashPrinter(emailTemplates.toArray(), 'label', 'id'),
						templateVars: {
							additionalContent: confirmationEmailTemplateAddButton ~ confirmationEmailTemplateEditButton
						},
						'data-form-updater': true,
					}) }}
				{% endblock %}

				{% block formControlSalutationConfirmation %}
					{{ FormHelper.control('salutationConfirmation', {
						columnSpan: 6,
						placeholder: __('salutation_confirmation_placeholder'),
					}) }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetContent %}
	{% block fieldsetContent %}
		<fieldset class="Fieldset-Content">
			<legend>{{ __('fieldset_content') }}</legend>

			{% block fieldsetContentInner %}
				{% block fieldsetContentAttributes %}
					{{ AttributesHelper.allControls('content') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetMedia %}
	{% block fieldsetMedia %}
		<fieldset class="Fieldset-Media">
			<legend>{{ __('fieldset_media') }}</legend>

			{% block fieldsetMediaInner %}
				{{ cell('Backend/MediaElements', [form]) }}

				{% block fieldsetMediaAttributes %}
					{{ AttributesHelper.allControls('media') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetMediaElementAssignments %}
	{% block fieldsetMediaElementAssignments %}
		{{ cell('Backend/MediaElements::elementAssignments', [form]) }}
	{% endblock %}
{% endset %}

{% set fieldsetPresentation %}
	{% block fieldsetPresentation %}
		<fieldset class="Fieldset-Presentation">
			<legend>{{ __('fieldset_presentation') }}</legend>

			{% block fieldsetPresentationInner %}
				{% block formControl_Active %}
					{{ FormHelper.control('active', {columnSpan: 4}) }}
				{% endblock %}

				{% block formControlSummarizeErrors %}
					{{ FormHelper.control('summarizeErrors', {columnSpan: 8}) }}
				{% endblock %}

				{# % block formControlMultistep %}
						{{ FormHelper.control('multistep', {columnSpan: 6}) }}
					{% endblock % #}

				{% block fieldsetPresentationAttributes %}
					{{ AttributesHelper.allControls('presentation') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetConditions %}
	{% block fieldsetConditions %}
		<fieldset class="Fieldset-Conditions">
			<legend>{{ __('fieldset_conditions') }}</legend>

			{% block fieldsetConditionsInner %}
				{% block fieldsetConditionsAttributes %}
					{{ AttributesHelper.allControls('conditions') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetAttributes %}
	{% block fieldsetAttributes %}
		<fieldset class="Fieldset-Attributes">
			<legend>{{ __('fieldset_attributes') }}</legend>

			{% block fieldsetAttributesInner %}
				{% block fieldsetAttributesAttributes %}
					{{ AttributesHelper.allControls('attributes') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set elementPublicationData %}
	{% block elementPublicationData %}
		{{ element('publication_data/fieldset', {fields: AttributesHelper.allControls('publication')}) }}
	{% endblock %}
{% endset %}

{% block sidebarToggle %}
	{% if config.Awyiss.System.Backend.interface.sidebarMode == true and isOverlayForm != true %}
		{{ FormHelper.button(__('sidebar_toggle'), {class: 'Button Button-Configure', id: 'Sidebar-Toggle', name: 'button', type: 'button'}) }}
	{% endif %}
{% endblock %}

{% block fieldsets %}
	<div class="Fieldsets">
		{% if config.Awyiss.System.Backend.interface.sidebarMode != true or isOverlayForm == true %}
			{{ fieldsetPresentation }}
			{{ fieldsetConditions }}
			{{ fieldsetGeneral }}
			{{ fieldsetEmail }}
			{{ fieldsetConfirmationEmail }}
			{{ fieldsetContent }}
			{{ fieldsetMedia }}
			{{ fieldsetMediaElementAssignments }}
			{{ fieldsetAttributes }}
			{{ elementPublicationData }}

			<details class="HelpText Form-PlaceholderHelp">
				{{ __('placeholder_help_text')|raw }}
			</details>
		{% endif %}

		{% block mainFieldsets %}
			{% if config.Awyiss.System.Backend.interface.sidebarMode == true and isOverlayForm != true %}
				<div class="Main-Fieldsets">
					{{ fieldsetGeneral }}
					{{ fieldsetEmail }}
					{{ fieldsetConfirmationEmail }}
					{{ fieldsetContent }}
					{{ fieldsetMedia }}
					{{ fieldsetMediaElementAssignments }}
				</div>
			{% endif %}
		{% endblock %}

		{% block sidebarFieldsets %}
			{% if config.Awyiss.System.Backend.interface.sidebarMode == true and isOverlayForm != true %}
				<div class="Sidebar-Fieldsets">
					{{ fieldsetPresentation }}
					{{ fieldsetConditions }}
					{{ fieldsetAttributes }}
					{{ elementPublicationData }}

					<details class="HelpText Form-PlaceholderHelp">
						{{ __('placeholder_help_text')|raw }}
					</details>
				</div>
			{% endif %}
		{% endblock %}

		{% block formInputReloadForm %}
			{{ FormHelper.hidden('reloadForm', {val: 0}) }}
		{% endblock %}
	</div>
{% endblock %}

{% block lockDialog %}
	{{ element('lock_dialog', {entity: form}) }}
{% endblock %}

{{ FormHelper.end() }}
