{#
@var ao_mediaFolders \Cake\Collection\Collection
@var la_mediaFolders array
@var ab_paginated bool
@var _view \Awyiss\View\BackendView
#}

{% block tableOverview %}
	<table class="Table-Overview">
		{% block tableOverviewHead %}
			<thead>
				{% block tableOverviewHeadRow %}
					<tr>
						{% block tableOverviewHeaderId %}
							<th>{{ PaginatorHelper.sort('id') }}</th>
						{% endblock %}

						{% block tableOverviewHeaderTitle %}
							<th>{{ PaginatorHelper.sort('title') }}</th>
						{% endblock %}

						{% block tableOverviewHeaderSystemOrder %}
							<th>{{ PaginatorHelper.sort('system_order') }}</th>
						{% endblock %}

						{% block tableOverviewHeaderActions %}
							<th class="actions"></th>
						{% endblock %}
					</tr>
				{% endblock %}
			</thead>
		{% endblock %}
		{% block tableOverviewBody %}
			<tbody>
				{# @var lo_mediaFolder \Awyiss\Model\Entity\MediaFolder #}
				{% for lo_mediaFolder in la_mediaFolders %}
					{% block tableOverviewBodyRow %}
						<tr>
							{% block tableOverviewCellId %}
								<td>{{ lo_mediaFolder.id }}</td>
							{% endblock %}

							{% block tableOverviewCellTitle %}
								<td>{{ lo_mediaFolder.title }} <br> {{ lo_mediaFolder.slug }}</td>
							{% endblock %}

							{% block tableOverviewCellSystemOrder %}
								<td>level {{ lo_mediaFolder.level }} - order {{ lo_mediaFolder.systemOrder }}</td>
							{% endblock %}

							{% block tableOverviewCellActions %}
								<td class="actions">
									{% do AuthorizationHelper.setScope('media') %}
									{% if AuthorizationHelper.isAccessible('read') %}
										{{ HtmlHelper.link(__('view_files'), {controller: 'media', action: 'overview', mediaFolder: lo_mediaFolder.id}) }}
									{% endif %}
									{% do AuthorizationHelper.resetScope() %}

									{% if AuthorizationHelper.isAccessible('update') %}
										{{ HtmlHelper.link(__('edit'), {action: 'edit', id: lo_mediaFolder.id}) }}
									{% endif %}

									{% if AuthorizationHelper.isAccessible('delete') %}
										{{ HtmlHelper.link(__('delete'), {action: 'delete', id: lo_mediaFolder.id}, {
				class: 'Button Button-Small Button-Delete',
				'data-confirm-title': __('confirm_delete_title'),
				'data-confirm-yes': __('confirm_delete_yes'),
				'data-confirm-yes-class': 'Button-Delete',
				'data-confirm-no': __('confirm_delete_no'),
				'data-confirm': __('confirm_delete', lo_mediaFolder.id) }) }}
									{% endif %}
								</td>
							{% endblock %}
						</tr>
					{% endblock %}
				{% endfor %}
			</tbody>
		{% endblock %}
	</table>
{% endblock %}
