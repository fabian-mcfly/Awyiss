{#
@var ao_mediaFolder \Awyiss\Model\Entity\MediaFolder
@var ao_threadedMediaFolders \Cake\Collection\Iterator\TreeIterator
@var as_languageRealm string
@var _view \Awyiss\View\BackendView
#}

<div class="MediaFolders Form Edit">
	{{ FormHelper.create(ao_mediaFolder, {method: 'post', idPrefix: 'mediaFolder'}) }}

	{{ FormHelper.checkbox('save_as_copy', {id: 'SaveAsCopy', value: true}) }}

	{% block headlineEdit %}
		<h1>{{ __('headline_edit') }}</h1>
	{% endblock %}

	{% block formEditButtons %}
		<label for="SaveAsCopy">{{ __('as_copy') }}</label>
		{{ FormHelper.button(__('save')) }}
		{{ FormHelper.button(__('save_close'), {name: 'submit', value: 'submit_close'}) }}
	{% endblock %}

	{% block formEdit %}
		{% include('@Backend/MediaFolders/form.twig') %}
	{% endblock %}

	{% block formEditButtonsBottom %}
		{{ block('formEditButtons') }}
	{% endblock %}

	{{ FormHelper.end() -}}
</div>