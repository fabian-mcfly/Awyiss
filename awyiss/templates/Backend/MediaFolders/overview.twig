{#
@var ao_mediaFolders \Cake\Collection\Collection
@var ab_paginated bool
@var _view \Awyiss\View\BackendView
#}

<div class="MediaFolders Overview">
	{% block buttonsOverview %}
		{% if AuthorizationHelper.isAccessible('create') %}
			{{ HtmlHelper.link(__('create'), {action: 'add'}, {class: 'Button' }) }}
		{% endif %}
	{% endblock %}

	{% block headlineOverview %}
		<h1>{{ __('headline_overview') }}</h1>
	{% endblock %}

	{% block categoriesFilterOverview %}
		{{ CategoriesHelper.linkSelect('language', aa_languages, {
			val: as_selectedLanguage
		}) }}
	{% endblock %}

	{% if ab_paginated %}
		{% block paginatedOverview %}
			{% include '@Backend/MediaFolders/overview_paginated.twig' with {'la_mediaFolders': ao_mediaFolders.items().toArray()} %}
		{% endblock %}
	{% else %}
		{% from '@Backend/macro/nested_list.twig' import nestedList %}
		{# @var la_mediaFolders array<string, \Awyiss\Model\Entity\MediaFolder[]> #}
		{% for ls_languageShortcode, la_mediaFolders in ao_mediaFolders %}
			{% block fieldsetOverview %}
			<fieldset class="Fieldset-Overview">
				<legend>{{ aa_languages[ ls_languageShortcode ] ?? __('global') }}</legend>

				{% block fieldsetOverviewInner %}
					{% block listOverview %}
						{{ nestedList(la_mediaFolders, {
							identifier: 'MediaFolder',

						}) }}
					{% endblock %}
				{% endblock %}
			</fieldset>
			{% endblock %}
		{% endfor %}
	{% endif %}

	{% block listControlOverview %}
		<ul class="ListControl">
			{% block listControlOverviewListPaginated %}
				<li class="ListControl-ListPaginated">
					{{ HtmlHelper.link(__('list_paginated'), {action: 'userConfiguration', identifier: 'paginate.enabled', value: 'true'}) }}
				</li>
			{% endblock %}

			{% block listControlOverviewListNested %}
				<li class="ListControl-ListNested">
					{{ HtmlHelper.link(__('list_nested'), {action: 'userConfiguration', identifier: 'paginate.enabled', value: 'false'}) }}
				</li>
			{% endblock %}

			{% block listControlOverviewPagination %}
				{% if ab_paginated %}
					{% set pagination = PaginatorHelper.render() %}
					{% if pagination is not empty %}
						<li class="ListControl-Pagination">
							{{ pagination|raw }}
						</li>
					{% endif %}
				{% endif %}
			{% endblock %}

			{% block paginationOverviewLimitControl %}
				{% if ab_paginated %}
					<li class="ListControl-ListLimit">
						{{ PaginatorHelper.limitControl() }}
					</li>
				{% endif %}
			{% endblock %}
		</ul>
	{% endblock %}
</div>
