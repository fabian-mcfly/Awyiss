<!DOCTYPE html>
<html lang="en">
	<head>
		{{ helper_Html_charset() }}
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>
			{{ fetch('title') }}
		</title>
		{{ helper_Html_meta('icon') }}

		<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">

		{{ helper_Html_css(['normalize.min', 'milligram.min', 'cake']) }}

		{{ fetch('meta') }}
		{{ fetch('css') }}
		{{ fetch('script') }}
	</head>
	<body>
		{% block sidebar %}
			<aside id="Sidebar">
				<a href="{{ helper_Url_build({controller: 'dashboard', action: 'overview'}) }}" class="Title">Aw<span>Yiss</span></a>

				{% block systemMenu %}
					{{ cell('Backend/Menu') }}
				{% endblock %}
			</aside>
		{% endblock %}
		{% block body %}
			<div id="Body">
				{% block content %}
					<main id="Content">
						{{ helper_Flash_render() }}
						{{ fetch('content') }}
					</main>
				{% endblock %}
				{% block footer %}
					<footer>
						{{ helper_Html_link(__d('users', 'logout'), {controller: 'users', action: 'logout'}) }}
					</footer>
				{% endblock %}
			</div>
		{% endblock %}
	</body>
</html>
