{#
@var ao_records Cake\Datasource\EntityInterface[]|\Cake\Datasource\Paging\PaginatedResultSet
@var ao_datatable \Awyiss\Model\Entity\Datatable
@var ab_nestable bool
@var ab_paginated bool
@var ab_sortable bool
@var ab_splitIntoLanguages bool
@var ab_translatable bool
@var _view \Awyiss\View\BackendView
#}

<div class="GenericDatatables Overview">
	{% block buttonsOverview %}
		{% if helper_Authorization_isAccessible('create') %}
			{{ helper_Html_link(__('create'), {action: 'add'}, {class: 'Button'}) }}
		{% endif %}
	{% endblock %}

	{% block headlineOverview %}
		<h1>{{ __('headline_overview') }}</h1>
	{% endblock %}

	{% if ab_paginated %}
		{% block paginatedOverview %}
			{% include '@Backend/GenericDatatables/overview_paginated.twig' with {'la_records': ao_records.items().toArray()} %}
		{% endblock %}
	{% else %}
		{% from '@Backend/macro/nested_list.twig' import nestedList %}

		{% block listOverview %}
			{{ nestedList(ao_records, {
				identifier: ao_datatable.identifier|camelize,

			}) }}
		{% endblock %}
	{% endif %}

	{% block listControlOverview %}
		<ul class="ListControl">
			{% block listControlOverviewListPaginated %}
				<li class="ListControl-ListPaginated">
					{{ helper_Html_link(__('list_paginated'), {action: 'userConfiguration', identifier: 'paginate.enabled', value: 'true'}) }}
				</li>
			{% endblock %}

			{% block listControlOverviewListNested %}
				<li class="ListControl-ListNested">
					{{ helper_Html_link(__('list_nested'), {action: 'userConfiguration', identifier: 'paginate.enabled', value: 'false'}) }}
				</li>
			{% endblock %}

			{% block listControlOverviewPagination %}
				{% if ab_paginated %}
					{% set pagination = helper_Paginator_render() %}
					{% if pagination is not empty %}
						<li class="ListControl-Pagination">
							{{ pagination|raw }}
						</li>
					{% endif %}
				{% endif %}
			{% endblock %}

			{% block paginationOverviewLimitControl %}
				{% if ab_paginated %}
					<li class="ListControl-ListLimit">
						{{ helper_Paginator_limitControl() }}
					</li>
				{% endif %}
			{% endblock %}
		</ul>
	{% endblock %}
</div>
