{#
@var records Cake\Datasource\EntityInterface[]|\Cake\Datasource\Paging\PaginatedResultSet
@var datatable \Awyiss\Model\Entity\Datatable
@var nestable bool
@var paginated bool
@var sortable bool
@var splitIntoLanguages bool
@var translatable bool
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

<div class="GenericDatatables Overview">
	{% block headlinesOverview %}
		<div class="Headlines">
			{% block headlineOverview %}
				<h1>{{ __f('headline_overview', datatable.title) }}</h1>
			{% endblock %}
		</div>
	{% endblock %}

	{% block buttonAreaToggle %}
		{{ FormHelper.button(__('button_area_toggle'), {class: 'Button Button-Menu', id: 'ButtonArea-Toggle', name: 'button', type: 'button'}) }}
	{% endblock %}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block categoriesFilterOverview %}
				{% set identifier = localConfig('categories.identifier', 'category') %}
				{% set label = __(identifier|underscore ~ '_filter_label') %}
				{% if '::' in label and attributes[ identifier ] is not empty %}
					{% set label = attributes[ identifier ].title %}
				{% endif %}
				{{ CategoriesHelper.filter(identifier, null, {
					label: label
				}) }}
			{% endblock %}

			{% block overviewButtons %}
				{% block overviewButtonSaveSystemOrder %}
					{% if sortable and paginated == false %}
						<button class="Button Button-SaveSystemOrder" disabled>{{ __('save_system_order') }}</button>
					{% endif %}
				{% endblock %}

				{% block overviewButtonAdd %}
					{% if AuthorizationHelper.isAccessible('create') %}
						{{ HtmlHelper.link(__df(datatable.identifier|pluralize, 'GenericDatatables', 'create'), {action: 'add'}, {class : 'Button Button-Add'}) }}
					{% endif %}
				{% endblock %}

				{% block overviewButtonFilter %}
					{{ element('search/filter_button', {scope: datatable.identifier}) }}
				{% endblock %}

				{% block listControlOverviewListPaginated %}
					{{ HtmlHelper.link(__d('GenericDatatables', 'list_paginated'), {action: 'userConfiguration', identifier: 'paginate.enabled', value: 'true'}, {
						class: 'Button Button-Small Button-ListView Button-ListView-PaginatedList',
						disabled: localConfig.paginate.enabled == true
					}) }}
				{% endblock %}

				{% block listControlOverviewListNested %}
					{{ HtmlHelper.link(__d('GenericDatatables', 'list_nested'), {action: 'userConfiguration', identifier: 'paginate.enabled', value: 'false'}, {
						class: 'Button Button-Small Button-ListView Button-ListView-NestedList',
						disabled: localConfig.paginate.enabled == false
					}) }}
				{% endblock %}
			{% endblock %}
		</div>
	{% endblock %}

	{% if paginated %}
		{% block paginatedOverview %}
			{% include '@Backend/element/overview/overview_paginated_list.twig' with _context|merge({
				records: records.items().toArray(),
				displayedFields: localConfig.overview.displayedFields,
			}) %}
		{% endblock %}
	{% else %}
		{% block listOverview %}
			<div class="Overview-List">
				{% from '@Backend/macro/nested_list.twig' import nestedList %}
				{{ nestedList(records, _context|merge({
					data: {
						nestable: nestable,
						sortable: sortable and _filter[ datatable.identifier ]['active'] == false,
					},
					displayedFields: localConfig.overview.displayedFields,
					identifier: datatable.identifier|camelize,
				})) }}
			</div>
		{% endblock %}
	{% endif %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('categoriesFilterOverview') }}

			{{ block('overviewButtons') }}
		</div>
	{% endblock %}

	{% block listFilter %}
		{{ element('search/filter', {scope: datatable.identifier}) }}
	{% endblock %}
</div>
