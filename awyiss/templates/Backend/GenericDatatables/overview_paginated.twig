{#
@var ao_records Cake\Datasource\EntityInterface[]
@var ao_datatable \Awyiss\Model\Entity\Datatable
@var ab_nestable bool
@var ab_paginated bool
@var ab_sortable bool
@var ab_splitIntoLanguages bool
@var ab_translatable bool
@var _view \Awyiss\View\BackendView
#}

{% block tableOverview %}
	<table>
		{% block tableOverviewHead %}
			<thead>
				{% block tableOverviewHeadRow %}
					<tr>
						{% block tableOverviewHeaderId %}
							<th>{{ PaginatorHelper.sort('id') }}</th>
						{% endblock %}

						{% block tableOverviewHeaderParentId %}
							<th>{{ PaginatorHelper.sort('parent_id') }}</th>
						{% endblock %}

						{% block tableOverviewHeaderLanguageShortcode %}
							{% if (ab_splitIntoLanguages) %}
								<th>{{ PaginatorHelper.sort('language_shortcode') }}</th>
							{% endif %}
						{% endblock %}

						{% block tableOverviewHeaderTitle %}
							<th>{{ PaginatorHelper.sort('title') }}</th>
						{% endblock %}

						{% block tableOverviewHeaderActive %}
							<th>{{ PaginatorHelper.sort('active') }}</th>
						{% endblock %}

						{% block tableOverviewHeaderActions %}
							<th class="actions"></th>
						{% endblock %}
					</tr>
				{% endblock %}
			</thead>
		{% endblock %}
		{% block tableOverviewBody %}
			<tbody>
				{# @var lo_record \Cake\Datasource\EntityInterface #}
				{% for lo_record in la_records %}
					{% block tableOverviewBodyRow %}
						<tr>
							{% block tableOverviewCellId %}
								<td>{{ lo_record.id }}</td>
							{% endblock %}

							{% block tableOverviewCellParentId %}
								<td>{{ lo_record.parent_id }}</td>
							{% endblock %}

							{% block tableOverviewCellLanguageShortcode %}
								{% if (ab_splitIntoLanguages) %}
									<td>{{ lo_record.language_shortcode }}</td>
								{% endif %}
							{% endblock %}

							{% block tableOverviewCellTitle %}
								<td>{{ lo_record.title }}</td>
							{% endblock %}

							{% block tableOverviewCellActive %}
								<td>{{ lo_record.active }}</td>
							{% endblock %}

							{% block tableOverviewCellActions %}
								<td class="actions">
									{% if AuthorizationHelper.isAccessible('update') %}
										{{ HtmlHelper.link(__('edit'), {action: 'edit', id: lo_record.id}) }}
									{% endif %}
									{% if AuthorizationHelper.isAccessible('delete') %}
										{{ HtmlHelper.link(__('delete'), {action: 'delete', id: lo_record.id}, {
				class: 'Button Button-Small Button-Delete',
				'data-confirm-title': __('confirm_delete_title'),
				'data-confirm-yes': __('confirm_delete_yes'),
				'data-confirm-yes-class': 'Button-Delete',
				'data-confirm-no': __('confirm_delete_no'),
				'data-confirm': __('confirm_delete', lo_record.id) }) }}
									{% endif %}
								</td>
							{% endblock %}
						</tr>
					{% endblock %}
				{% endfor %}
			</tbody>
		{% endblock %}
	</table>
{% endblock %}