{#
@var record \Cake\Datasource\EntityInterface
@var possibleParentRecords \Cake\Collection\Collection
@var datatable \Awyiss\Model\Entity\Datatable
@var languageRealm string
@var nestable bool
@var splitIntoLanguages bool
@var translatable bool
@var _view \Awyiss\View\BackendView
#}

<div class="GenericDatatables Form Edit">
	{% block headlinesEdit %}
		<div class="Headlines">
			{% if AuthorizationHelper.isAccessible('read') %}
				{{ HtmlHelper.link(__('back_to_overview'), {action: 'overview'}, {class: 'BackToOverview'}) }}
			{% endif %}

			{% block headlineEdit %}
				<h1>{{ __d('generic_datatables', 'headline_edit') }}</h1>
			{% endblock %}
		</div>
	{% endblock %}

	{{ FormHelper.checkbox('save_as_copy', {form: 'GenericDatatableForm', id: 'SaveAsCopy', value: true}) }}

	{% block buttonAreaToggle %}
		{{ FormHelper.button(__('button_area_toggle'), {class: 'Button Button-Menu', id: 'ButtonArea-Toggle', name: 'button', type: 'button'}) }}
	{% endblock %}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block formEditButtons %}
				{% block formEditButtonSaveAsCopy %}
					<label for="SaveAsCopy" tabindex="0" class="Button Button-SaveAsCopy Label-SaveAsCopy">{{ __('as_copy') }}</label>
				{% endblock %}

				{% block formEditButtonSave %}
					{{ FormHelper.button(__('save'), {class: 'Button Button-Success Button-Save', form: 'GenericDatatableForm'}) }}
				{% endblock %}

				{% block formEditButtonSaveClose %}
					{% if AuthorizationHelper.isAccessible('read') %}
						{{ FormHelper.button(__('save_close'), {class: 'Button Button-SaveClose', form: 'GenericDatatableForm', name: 'submit', value: 'submit_close'}) }}
					{% endif %}
				{% endblock %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block formEdit %}
		{% include('@Backend/GenericDatatables/form.twig') %}
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('formEditButtons') }}
		</div>
	{% endblock %}
</div>
