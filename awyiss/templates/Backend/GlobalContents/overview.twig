{#
@var globalContents \Awyiss\Model\Entity\GlobalContent[]
@var globalContentTemplates array
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

<div class="GlobalContents Overview">
	{% block headlinesOverview %}
		<div class="Headlines">
			{% block headlineOverview %}
				<h1>{{ __('headline_overview') }}</h1>
			{% endblock %}
		</div>
	{% endblock %}

	{% block buttonAreaToggle %}
		{{ FormHelper.button(__('button_area_toggle'), {class: 'Button Button-Menu', id: 'ButtonArea-Toggle', name: 'button', type: 'button'}) }}
	{% endblock %}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block overviewButtons %}
				{% block overviewButtonSaveSystemOrder %}
					<button class="Button Button-SaveSystemOrder" disabled>{{ __d('System', 'save_system_order') }}</button>
				{% endblock %}

				{% block overviewButtonAdd %}
					{% if AuthorizationHelper.isAccessible('create') %}
						{{ HtmlHelper.link(__('create'), {action: 'add'}, {class : 'Button Button-Add'}) }}
					{% endif %}
				{% endblock %}

				{% block overviewButtonFilter %}
					{{ element('search/filter_button', {scope: 'GlobalContents'}) }}
				{% endblock %}

				{% block listControlOverviewListWithColumns %}
					{{ HtmlHelper.link(__('overview_list_with_columns'), {
						action: 'userConfiguration',
						identifier: 'overview.columnView.enabled',
						value: 'true'
					}, {
						class: 'Button Button-Small Button-ColumnView Button-ColumnView-Enable',
						disabled: localConfig.overview.columnView.enabled == true,
					}) }}
				{% endblock %}

				{% block listControlOverviewListLinear %}
					{{ HtmlHelper.link(__('overview_list_linear'), {
						action: 'userConfiguration',
						identifier: 'overview.columnView.enabled',
						value: 'false'
					}, {
						class: 'Button Button-Small Button-ColumnView Button-ColumnView-Disable',
						disabled: localConfig.overview.columnView.enabled == false,
					}) }}
				{% endblock %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block fieldsetsOverview %}
		{% set globalContentsByIdentifier = globalContents %}
		{% for identifier, globalContents in globalContentsByIdentifier %}
			{% block fieldsetOverview %}
				<fieldset class="Overview-Fieldset" data-identifier="{{ identifier }}">
					<legend>{{ identifier }}</legend>

					{% block fieldsetOverviewInner %}
						{% block listOverview %}
							{% from '@Backend/macro/nested_list.twig' import nestedList %}
							{{ nestedList(globalContents, _context|merge({
								class: localConfig.overview.columnView.enabled == true ? 'NestedList-Compact ColumnSystem-' ~ columnSystemName : null,
								globalContentTemplates: globalContentTemplates,
								data: {
									identifier: identifier,
									sortable: _filter['globalContents']['active'] == false,
								},
								displayedFields: localConfig.overview.displayedFields,
								identifier: 'GlobalContents',
								template: '@Backend/GlobalContents/overview_nested_list_item.twig',
							})) }}
						{% endblock %}
					{% endblock %}
				</fieldset>
			{% endblock %}
		{% else %}
			{% block fieldsetOverviewEmpty %}
				<fieldset class="Overview-Fieldset">

				</fieldset>
			{% endblock %}
		{% endfor %}
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('overviewButtons') }}
		</div>
	{% endblock %}

	{% block listFilter %}
		{{ element('search/filter', {scope: 'GlobalContents'}) }}
	{% endblock %}
</div>

{% block scriptColumnSystemVars %}
	<script nonce="{{ AssetHelper.getScriptNonce() }}">
		const columnWidths = {{ columnWidths|values|jsonEncode|raw }};
		const columnIndents = {{ columnIndents|values|jsonEncode|raw }};
		const columnSystemName = '{{ columnSystemName }}';
	</script>
{% endblock %}