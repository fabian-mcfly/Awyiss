{#
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Awyiss\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}
{% block formControlActive %}
	{{ FormHelper.control('active', {
		columnSpan: globalContentTemplateElement.column.span.numerator,
		label: globalContentTemplateElement.title,
	}) }}
{% endblock %}


{% block formControlIdentifier %}
	{% set knownIdentifiers = localConfig('knownIdentifiers') %}
	{%
		set helperFormControl = knownIdentifiers is not empty ? FormHelper.select(
			'identifierHelperOptions',
			combine(knownIdentifiers|values, knownIdentifiers|values),
			{
				'data-options-for': 'GlobalContent-Identifier',
			}
		) : ''
	%}

	{{ FormHelper.control('identifier', {
		columnSpan: globalContentTemplateElement.column.span.numerator,
		label: globalContentTemplateElement.title,
		templateVars: {
			additionalContent: helperFormControl
		},
		'data-form-updater': true,
	}) }}
{% endblock %}


{% block formControlGlobalContentTemplateId %}
	{% set globalContentTemplateAddButton %}
		{% if AuthorizationHelper.scopeIsAccessible('GlobalContentTemplates', [], 'create') %}
			{{ HtmlHelper.link(__d('GlobalContentTemplates', 'create'), {controller: 'GlobalContentTemplates', action: 'add'}, {class: 'Button Button-Add InFieldButton OverlayForm'}) }}
		{% endif %}
	{% endset %}

	{% set globalContentTemplateEditButton %}
		{% if AuthorizationHelper.scopeIsAccessible('GlobalContentTemplates', [], 'update') %}
			{{ HtmlHelper.link(__('edit'), {controller: 'GlobalContentTemplates', action: 'edit', id: settings.globalContent.globalContentTemplateId}, {class: 'Button Button-Edit InFieldButton OverlayForm'}) }}
		{% endif %}
	{% endset %}

	{{ FormHelper.control('globalContentTemplateId', {
		columnSpan: globalContentTemplateElement.column.span.numerator,
		empty: false,
		label: globalContentTemplateElement.title,
		options: settings.globalContentTemplates.combine('id', 'title'),
		templateVars: {
			additionalContent: globalContentTemplateAddButton ~ globalContentTemplateEditButton
		},
		'data-form-updater': true,
	}) }}
{% endblock %}


{% block formControlLanguageShortcode %}
	{{ LocaleHelper.control('languageShortcode', {
		columnSpan: globalContentTemplateElement.column.span.numerator,
		label: globalContentTemplateElement.title,
		languageRealm: settings.languageRealm,
		val: settings.languageShortcode,
		'data-form-updater': true,
	}) }}
{% endblock %}


{% block formControlSystemOrder %}
	{{ SystemOrderHelper.control('systemOrder', {
		columnSpan: globalContentTemplateElement.column.span.numerator,
		entity: settings.globalContent,
		label: globalContentTemplateElement.title,
	}) }}
{% endblock %}


