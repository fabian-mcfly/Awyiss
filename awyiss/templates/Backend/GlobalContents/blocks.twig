		label: globalContentTemplateElement.title,
		required: globalContentTemplateElement.required,
		'data-form-updater': true,
	}) }}
{% endblock %}


{% block formControlTitle %}
	{% set titleTag = '' %}
	{% if assignedGlobalContentTemplateElements.titleTag is defined %}
		{% set titleTag %}
			{{ FormHelper.control('titleTag', {
				options: {
					'h1': 'h1',
					'h2': 'h2',
					'h3': 'h3',
					'h4': 'h4',
					'h5': 'h5',
					'h6': 'h6',
					'p': 'p',
				},
			}) }}
		{% endset %}
	{% endif %}

	{{ FormHelper.control('title', {
		columnSpan: globalContentTemplateElement.column.span.numerator,
		label: globalContentTemplateElement.title,
		required: globalContentTemplateElement.required,
		templateVars: {
			additionalContent: titleTag,
		}
	}) }}
{% endblock %}


{% block formControlTitleTag %}{% endblock %}


{% block formControlSubtitle %}
	{% set subtitleTag = '' %}
	{% if assignedGlobalContentTemplateElements.subtitleTag is defined %}
		{% set subtitleTag %}
			{{ FormHelper.control('subtitleTag', {
				options: {
					'h1': 'h1',
					'h2': 'h2',
					'h3': 'h3',
					'h4': 'h4',
					'h5': 'h5',
					'h6': 'h6',
					'p': 'p',
				},
			}) }}
		{% endset %}
	{% endif %}

	{{ FormHelper.control('subtitle', {
		columnSpan: globalContentTemplateElement.column.span.numerator,
		label: globalContentTemplateElement.title,
		required: globalContentTemplateElement.required,
		templateVars: {
			additionalContent: subtitleTag,
		}
	}) }}
{% endblock %}


{% block formControlSubtitleTag %}{% endblock %}


