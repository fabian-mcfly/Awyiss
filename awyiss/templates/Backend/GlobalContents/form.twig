{#
@var globalContent \Awyiss\Model\Entity\GlobalContent
@var globalContentTemplates \Cake\Collection\CollectionInterface
@var possibleParentGlobalContents \Cake\Collection\CollectionInterface
@var assignedAttributes array
@var globalContentElementsByFieldset GlobalContentTemplateElement[]
@var languageRealm string
@var languageShortcode string
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% use '@Backend/GlobalContents/blocks.twig' %}

{% set macroSettings = _context|merge({}) %}

{% macro renderFormControls(assignedGlobalContentTemplateElements = [], settings) %}
	{% for globalContentTemplateElement in assignedGlobalContentTemplateElements %}
		{% if globalContentTemplateElement.identifier[:11] == 'attributes.' %}
			{{ AttributesHelper.control(globalContentTemplateElement.identifier[11:], {
				columnSpan: globalContentTemplateElement.column.span.numerator,
				required: globalContentTemplateElement.required,
				label: globalContentTemplateElement.title,
			}) }}
		{% else %}
			{{ block('formControl' ~ globalContentTemplateElement.identifier|camelize) }}
		{% endif %}
	{% endfor %}
{% endmacro %}

{{ FormHelper.create(globalContent, {method: 'post', id: 'GlobalContentForm', idPrefix: 'globalContent'}) }}
<input type="hidden" name="attributes" value="">

{% set fieldsetGeneral %}
	{% block fieldsetGeneral %}
		<fieldset class="Fieldset-General">
			<legend>{{ __('fieldset_general') }}</legend>

			{% block fieldsetGeneralInner %}
				{{ _self.renderFormControls(globalContentElementsByFieldset.general ?? [], macroSettings) }}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetContent %}
	{% block fieldsetContent %}
		<fieldset class="Fieldset-Content">
			<legend>{{ __('fieldset_content') }}</legend>

			{% block fieldsetContentInner %}
				{{ _self.renderFormControls(globalContentElementsByFieldset.content ?? [], macroSettings) }}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetMedia %}
	{% block fieldsetMedia %}
		<fieldset class="Fieldset-Media">
			<legend>{{ __('fieldset_media') }}</legend>

			{% block fieldsetMediaInner %}
				{{ cell('Backend/MediaElements', [globalContent]) }}

				{{ _self.renderFormControls(globalContentElementsByFieldset.media ?? [], macroSettings) }}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetMediaElementAssignments %}
	{% block fieldsetMediaElementAssignments %}
		{{ cell('Backend/MediaElements::elementAssignments', [globalContent]) }}
	{% endblock %}
{% endset %}

{% set fieldsetPresentation %}
	{% block fieldsetPresentation %}
		<fieldset class="Fieldset-Presentation">
			<legend>{{ __('fieldset_presentation') }}</legend>

			{% block fieldsetPresentationInner %}
				{{ _self.renderFormControls(globalContentElementsByFieldset.presentation ?? [], macroSettings) }}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetConditions %}
	{% block fieldsetConditions %}
		<fieldset class="Fieldset-Conditions">
			<legend>{{ __('fieldset_conditions') }}</legend>

			{% block fieldsetConditionsInner %}
				{{ _self.renderFormControls(globalContentElementsByFieldset.conditions ?? [], macroSettings) }}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetAttributes %}
	{% block fieldsetAttributes %}
		<fieldset class="Fieldset-Attributes">
			<legend>{{ __('fieldset_attributes') }}</legend>

			{% block fieldsetAttributesInner %}
				{{ _self.renderFormControls(globalContentElementsByFieldset.attributes ?? [], macroSettings) }}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetData %}
	{% block fieldsetData %}
		<fieldset class="Fieldset-Data">
			<legend>{{ __('fieldset_data') }}</legend>

			{% block fieldsetDataInner %}
				{% block formControlData %}
					<div
							class="FormInput FormInputType-List FormInputName-Data" data-list-item-add="{{ __('list_item_add') }}"
							data-list-item-remove="{{ __('list_item_remove') }}">
						<label class="Label">{{ __('data') }}</label>

						{% set counter = 0 %}
						{% for key, value in globalContent.data %}
							<div class="FormInputType-ListItem">
								{{ FormHelper.input('data.' ~ counter ~ '.key', {val: key}) }}
								{{ FormHelper.input('data.' ~ counter ~ '.value', {val: value}) }}
								{% set counter = counter + 1 %}
							</div>
						{% endfor %}

						<div class="FormInputType-ListItem FormInputType-ListItem-Default">
							{{ FormHelper.input('data.' ~ counter ~ '.key') }}
							{{ FormHelper.input('data.' ~ counter ~ '.value') }}
						</div>
					</div>
				{% endblock %}

				{{ _self.renderFormControls(globalContentElementsByFieldset.data ?? [], macroSettings) }}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set elementCustomerGroupSettings %}
	{% block fieldsetCustomerGroupAssignments %}
		{{ cell('Backend/CustomerGroups', [globalContent]) }}
	{% endblock %}
{% endset %}

{% set elementPublicationData %}
	{% block elementPublicationData %}
		{{ element('publication_data/fieldset', {fields: AttributesHelper.allControls('publication')}) }}
	{% endblock %}
{% endset %}

{% block sidebarToggle %}
	{% if config.Awyiss.System.Backend.interface.sidebarMode == true and isOverlayForm != true %}
		{{ FormHelper.button(__('sidebar_toggle'), {class: 'Button Button-Configure', id: 'Sidebar-Toggle', name: 'button', type: 'button'}) }}
	{% endif %}
{% endblock %}

{% block fieldsets %}
	<div class="Fieldsets">
		{% if config.Awyiss.System.Backend.interface.sidebarMode != true or isOverlayForm == true %}
			{{ fieldsetPresentation }}
			{{ fieldsetConditions }}
			{{ fieldsetGeneral }}
			{{ fieldsetContent }}
			{{ fieldsetMedia }}
			{{ fieldsetMediaElementAssignments }}
			{{ fieldsetAttributes }}
			{{ fieldsetData }}
			{{ elementCustomerGroupSettings }}
			{{ elementPublicationData }}
		{% endif %}

		{% block mainFieldsets %}
			{% if config.Awyiss.System.Backend.interface.sidebarMode == true and isOverlayForm != true %}
				<div class="Main-Fieldsets">
					{{ fieldsetGeneral }}
					{{ fieldsetContent }}
					{{ fieldsetMedia }}
					{{ fieldsetMediaElementAssignments }}
					{{ elementCustomerGroupSettings }}
				</div>
			{% endif %}
		{% endblock %}

		{% block sidebarFieldsets %}
			{% if config.Awyiss.System.Backend.interface.sidebarMode == true and isOverlayForm != true %}
				<div class="Sidebar-Fieldsets">
					{{ fieldsetPresentation }}
					{{ fieldsetConditions }}
					{{ fieldsetAttributes }}
					{{ fieldsetData }}
					{{ elementPublicationData }}
				</div>
			{% endif %}
		{% endblock %}

		{% block formInputReloadForm %}
			{{ FormHelper.hidden('reloadForm', {val: 0}) }}
		{% endblock %}
	</div>
{% endblock %}

{% block lockDialog %}
	{{ element('lock_dialog', {entity: globalContent}) }}
{% endblock %}

{{ FormHelper.end() }}
