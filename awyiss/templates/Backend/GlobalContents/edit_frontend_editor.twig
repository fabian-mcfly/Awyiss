{#
@var globalContent \Awyiss\Model\Entity\GlobalContent
@var globalContentTemplates \Cake\Collection\CollectionInterface
@var possibleParentGlobalContents \Cake\Collection\CollectionInterface
@var assignedAttributes array
@var globalContentElementsByFieldset GlobalContentTemplateElement[]
@var languageRealm string
@var languageShortcode string
@var expertMode bool
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

<div class="GlobalContents Form Edit EditFrontendEditor{% if expertMode %} ExpertMode{% endif %}" data-title="{{ __('headline_edit') }}">
	{% block buttonArea %}
		<div class="ButtonArea">
			{% block formEditButtons %}
				{% block formEditButtonSave %}
					{{ FormHelper.button(__('save'), {class: 'Button Button-Success Button-Save', form: 'GlobalContentForm'}) }}
				{% endblock %}
			{% endblock %}

			{% block formEditButtonClose %}
				{{ FormHelper.button(__('close'), {class: 'Button Button-Close'}) }}
			{% endblock %}
		</div>
	{% endblock %}

	{% block flashMessages %}
		{{ FlashHelper.render() }}
	{% endblock %}

	{% block formEdit %}
		{% include('@Backend/GlobalContents/form.twig') %}
	{% endblock %}

	<input type="hidden" name="submit_type" value="submit_close" form="GlobalContentForm">

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('formEditButtons') }}

			{{ block('formEditButtonClose') }}
		</div>
	{% endblock %}
</div>
