{% extends '@Backend/element/overview/overview_paginated_list.twig' %}

{% block tableOverviewCellActions %}
	<td class="TableCell-Actions">
		<div class="Actions">
			{% if
				entity.type.value in ['singleChoice', 'multipleChoice'] and
				AuthorizationHelper.scopeIsAccessible('SurveyAnswers', [], 'read')
			%}
				{{ HtmlHelper.link(__('view_answers'), {controller: 'SurveyAnswers', action: 'overview', questionId: entity.id}, {
					class: 'Button Button-Small Button-View Button-ViewElements',
				}) }}
			{% endif %}

			{{ block('tableOverviewCellActionsUpdate') }}

			{{ block('tableOverviewCellActionsDelete') }}
		</div>
	</td>
{% endblock %}

