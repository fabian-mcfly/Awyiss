{#
@var dashboardElements array
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

<div class="Dashboard Overview">
	{% block headlinesOverview %}
		<div class="Headlines">
			{% block headlineOverview %}
				<h1>{{ __('headline_overview') }}</h1>
			{% endblock %}
		</div>
	{% endblock %}

	<div class="StatusCells">
		<fieldset class="Overview-Fieldset Fieldset-LoggedInAs">
			<p class="LoggedInAs">
				<strong>{{ __('logged_in_as', IdentityHelper.get('username'))|raw }}.</strong><br>
				{{ __('last_login', TimeHelper.nice(lastLogin)) }}
			</p>
		</fieldset>

		{% for dashboardElement in dashboardElements %}
			{% include '@Backend/element/Dashboard/element.twig' %}
		{% endfor %}
	</div>

	<fieldset class="Overview-Fieldset Fieldset-QuickActions">
		<legend>{{ __('fieldset_quick_actions') }}</legend>

		<ul class="QuickActions">
			{% do AuthorizationHelper.setScope('pages') %}
			{% if AuthorizationHelper.isAccessible('create') %}
				<li class="QuickAction QuickAction-AddPage">
					<a href="{{ UrlHelper.build({controller: 'pages', action: 'add'}) }}" class="Button Button-Add">{{ __('quick_action_add_page') }}</a>
				</li>
			{% endif %}
			{% do AuthorizationHelper.resetScope() %}
			<li class="QuickAction QuickAction-UserConfiguration">
				<a href="{{ UrlHelper.build({controller: 'user-configuration', action: 'overview', scope: 'system'}) }}" class="Button Button-Configure">{{ __('quick_action_user_configuration') }}</a>
			</li>
		</ul>
	</fieldset>
</div>
