{#
@var urlsNotFound \Cake\Collection\Collection
@var lastLogin \Cake\I18n\DateTime
@var accessible bool
@var _view \Awyiss\View\BackendView
#}

{% block fieldsetOverview %}
	{% if accessible %}
		{% set canCreateUrlHistory = AuthorizationHelper.scopeIsAccessible('urlHistory', [], 'create') %}

		<fieldset class="Overview-Fieldset Fieldset-UrlsNotFoundStatus StatusCell Collapsible">
			<legend>{{ __d('urls_not_found', 'headline_status_cell') }}</legend>

			{% block fieldsetOverviewInner %}
				<div class="Table-Overflow">
					{% block tableOverview %}
						<table class="Overview-Table">
							{% block tableOverviewHead %}
								<thead>
									<tr>
										<th class="TableHeader-Url">
											{{ __d('urls_not_found', 'url') }}
										</th>
										{% if canCreateUrlHistory %}
											<th class="TableHeader-Actions"></th>
										{% endif %}
									</tr>
								</thead>
							{% endblock %}
							{% block tableOverviewBody %}
								<tbody>
									{% for urlNotFound in urlsNotFound %}
										<tr>
											<td class="TableCell-Url" title="{{ urlNotFound.url }}">{{ urlNotFound.url }}</td>
											{% if canCreateUrlHistory %}
												<td class="TableCell-Actions">
													<form class="Actions" method="post" action="{{ UrlHelper.build({controller: 'UrlHistory', action: 'add'}) }}">
														{{ FormHelper.button(__d('urls_not_found', 'create_redirect'), {class: 'Button Button-Small Button-Add', name: 'submit', value: 'submit'}) }}
														{{ FormHelper.hidden('reload_form', {val: 1}) }}
														{{ FormHelper.hidden('url', {val: urlNotFound.url|trim('/')}) }}
													</form>
												</td>
											{% endif %}
										</tr>
									{% endfor %}
								</tbody>
							{% endblock %}
						</table>
					{% endblock %}
				</div>
			{% endblock %}
		</fieldset>
	{% endif %}
{% endblock %}
