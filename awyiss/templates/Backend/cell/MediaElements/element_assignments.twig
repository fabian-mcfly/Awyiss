{#
@var entity \Awyiss\Model\Entity
@var availableElements \Cake\Datasource\ResultSetDecorator
@var assignedElements \Awyiss\Model\Entity\MediaElementAssignment[]
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% set assignedElements = assignedElements ? combine(assignedElements|column('media_element_id'), assignedElements) : [] %}

{% if availableElements %}
	<fieldset class="Fieldset-MediaElementAssignments AssignmentLists">
		{% block formControlMediaElements %}
			{% set assignedElementIds = assignedElements|column('media_element_id') %}
			{% set elementCounter = 0 %}
			{% set fieldsetElements = {} %}

			<fieldset class="Fieldset-MediaElements-Available AssignmentList AssignmentList-Available">
				<legend>{{ __('media_elements_available') }}</legend>
				<ul class="List MediaElements-List SortableList">
					{% for availableElement in availableElements %}
						{% if availableElement.id not in assignedElementIds %}
							<li class="Item MediaElement">
								<span class="Title">
									{{ FormHelper.checkbox('media_element_assignments[' ~ loop.index0 ~ '][media_element_id]', {
										checked: false,
										hiddenField: false,
										id: 'MediaElement-Element-' ~ availableElement.identifier|camelize,
										value: availableElement.id,
									}) }}

									{{ availableElement.label }}
								</span>
							</li>
						{% endif %}
					{% endfor %}
				</ul>
			</fieldset>

			<fieldset class="Fieldset-MediaElements-Assigned AssignmentList AssignmentList-Assigned">
				<legend>{{ __('media_elements_assigned') }}</legend>

				<ul class="List MediaElements-List SortableList">
					{% for availableElement in availableElements %}
						{% if availableElement.id in assignedElementIds %}
							{% set assignedElement = assignedElements[ availableElement.id ] %}
							<li class="Item MediaElement">
								<span class="Title">
									{{ FormHelper.checkbox('media_element_assignments[' ~ loop.index0 ~ '][media_element_id]', {
										checked: true,
										id: 'MediaElement-Element-' ~ availableElement.identifier|camelize,
										value: availableElement.id,
									}) }}

									{{ FormHelper.hidden('media_element_assignments[' ~ loop.index0 ~ '][id]', {
										value: assignedElement.id,
									}) }}

									{{ availableElement.label }}
								</span>
							</li>
						{% endif %}
					{% endfor %}
				</ul>
			</fieldset>
		{% endblock %}
	</fieldset>
{% endif %}
