{#
@var formEntries \Cake\Datasource\Paging\PaginatedResultSet
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

<div class="FormEntries Overview">
	{% block headlinesOverview %}
		<div class="Headlines">
			{% block headlineOverview %}
				<h1>{{ __('headline_overview') }}</h1>
			{% endblock %}

			{% block subheadlineOverview %}
				{% if CategoriesHelper.selectedCategory('form') != 'all' %}
					<h2>{{ form.label }}</h2>
				{% endif %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block buttonAreaToggle %}
		{{ FormHelper.button(__('button_area_toggle'), {class: 'Button Button-Menu', id: 'ButtonArea-Toggle', name: 'button', type: 'button'}) }}
	{% endblock %}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block overviewExport %}
				{% if (CategoriesHelper.selectedCategory('form') != 'all') %}
					<div class="LinkSelect LinkSelect-Export" id="LinkSelect-Export">
						{% block overviewExportLabel %}
						<label class="Label" tabindex="0">{{ __('export_entries') }}</label>
						{% endblock %}

						{% block overviewExportForm %}
							{% block overviewExportFormOpen %}
								{{ FormHelper.create(null, {url: {action: 'export'}, class: 'List'}) }}
							{% endblock %}

							{% block overviewExportFormControlFormat %}
								{{ FormHelper.control('export_format', {
									empty: false,
									options: {
										csv: 'CSV',
										csv_excel: 'CSV (Excel)',
										json: 'JSON',
										xml: 'XML'
									},
									required: true,
									type: 'select',
									val: 'csv'
								}) }}
							{% endblock %}

							{% block overviewExportFormControlLanguages %}
								{{ FormHelper.control('export_languages', {
									type: 'select',
									multiple: 'checkbox',
									options: languages.Frontend|reduce((carry, language) => carry|merge({(language.shortcode): language.title}), {}),
									value: languages.Frontend|map(language => language.shortcode)
								}) }}
							{% endblock %}

							{% block overviewExportFormControlFormId %}
								{{ FormHelper.hidden('export_form_id', {val: CategoriesHelper.selectedCategory('form')}) }}
							{% endblock %}

							{% block overviewExportFormSubmit %}
								{{ FormHelper.button(__('export'), {type: 'submit', class: 'Button'}) }}
							{% endblock %}

							{% block overviewExportFormClose %}
								{{ FormHelper.end() }}
							{% endblock %}
						{% endblock %}
					</div>
				{% endif %}
			{% endblock %}

			{% block categoriesFilterOverview %}
				{{ CategoriesHelper.filter('form', naturalSort(CategoriesHelper.getCategories('form'))) }}
			{% endblock %}

			{% block overviewButtons %}
				{% block overviewButtonFilter %}
					{{ element('search/filter_button', {scope: 'form_entries'}) }}
				{% endblock %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block paginatedOverview %}
		{% include '@Backend/FormEntries/overview_paginated_list.twig' with _context|merge({
			records: formEntries.items().toArray(),
			displayedFields: localConfig.overview.displayedFields,
		}) %}
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('categoriesFilterOverview') }}

			{{ block('overviewButtons') }}
		</div>
	{% endblock %}

	{% block listFilter %}
		{{ element('search/filter', {scope: 'form_entries'}) }}
	{% endblock %}
</div>
