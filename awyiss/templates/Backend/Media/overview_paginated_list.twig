{#
@var media \Cake\Datasource\Paging\PaginatedResultSet
@var mediaFolders array
@var paginated bool
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% extends '@Backend/element/overview/overview_paginated_list.twig' %}

{% block tableOverviewFootColSpan %}{{ localConfig.overview.displayedFields|length + 5 }}{% endblock %}

{% block tableOverview %}
	<table class="Overview-Table Responsive-Table Responsive-TableGrid" style="--columns:{{ tableFootColSpan }}; --rows:{{ min(records|length, paginate.limit) }};" data-media-folder-id="{{ selectedMediaFolderId }}">
		{{ block('tableOverviewHead') }}

		{% block tableOverviewBody %}
			<tbody data-system-order-start-index="{{ media.totalCount }}">
				{# @var entity \Cake\Datasource\EntityInterface #}
				{% for entity in records %}
					{{ block('tableOverviewBodyRow') }}
				{% endfor %}
			</tbody>
		{% endblock %}

		{{ block('tableOverviewFoot') }}
	</table>
{% endblock %}

{% block tableOverviewHeaderTitle %}
	<th class="TableHeader-Preview">{{ __('preview') }}</th>
	<th class="TableHeader-Name{% if PaginatorHelper.isCurrentSortKey('name') %} Active{% endif %}">{{ PaginatorHelper.sort('name') }}</th>
{% endblock %}

{% block tableOverviewCellTitle %}
	<td class="TableCell-Preview">
		{% set preview %}
			{{ MediaHelper.preview(entity, {
				class: 'Preview',
				resize: {
					width: 275,
					height: 275,
					strategy: enum(ResizeStrategy).Cover,
				},
			}) }}
		{% endset %}
		{{ HtmlHelper.link(preview, entity.path, {
			escape: false,
			target: '_blank',
		}) }}
	</td>
	<td class="TableCell-Name">{{ entity.name }}</td>
{% endblock %}

{% block tableOverviewCellDisplayedFieldDefaultValue %}
	{% if field == 'path' and entity.path %}
		{{ HtmlHelper.link(entity.path, entity.path, {
			target: '_blank',
		}) }}
	{% elseif field == 'usage_count' %}
		{% set value = entity.has(field) ? entity.get(field) : 0 %}
		{% if value > 0 %}
			{{ HtmlHelper.link(value, {action: 'usages', id: entity.id}, {title: __('show_usages')}) }}
		{% else %}
			{{ value }}
		{% endif %}
	{% else %}
		{{ parent() }}
	{% endif %}
{% endblock %}

{% block tableOverviewBodyRow %}
	<tr>
		{% block tableOverviewBodyRowInner %}
			{{ parent() }}
		{% endblock %}
	</tr>
{% endblock %}

{% block tableOverviewCellActionsUpdate %}
	{% if AuthorizationHelper.isAccessible('create') %}
		{{ HtmlHelper.link(i18nDomain ? __df(i18nDomain, 'system', 'edit') : __('edit'), {action: 'edit', id: entity.id}, {class: 'Button Button-Small Button-Edit'}) }}
	{% endif %}
{% endblock %}

{% block tableOverviewCellActionsDelete %}
	{% if AuthorizationHelper.isAccessible('delete') %}
		{{ HtmlHelper.link(__('delete'), {action: 'delete', id: entity.id}, {
			class: 'Button Button-Small Button-Delete',
			'data-confirm-title': __('confirm_delete_title'),
			'data-confirm-yes': __('confirm_delete_yes'),
			'data-confirm-yes-class': 'Button-Delete',
			'data-confirm-no': __('confirm_delete_no'),
			'data-confirm': __('confirm_delete', entity.id),
			'data-confirm-in-use': __('confirm_in_use'),
			'data-usage-count': entity.usageCount ?? 0,
		}) }}
	{% endif %}
{% endblock %}
