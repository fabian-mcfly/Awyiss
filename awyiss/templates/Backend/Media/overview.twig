{#
@var media \Awyiss\Model\Entity\Media[]
@var mediaFolders array<string, \Awyiss\Model\Entity\MediaFolder[]>
@var isAjax bool
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% set selectedMediaFolderId = CategoriesHelper.getSelectedCategory('mediaFolder') %}

<div class="Media Overview">
	{% block headlinesOverview %}
		<div class="Headlines">
			{% block headlineOverview %}
			<h1>{{ __('headline_overview') }}</h1>
		{% endblock %}
		</div>
	{% endblock %}

	{% block buttonAreaToggle %}
		{{ FormHelper.button(__('button_area_toggle'), {class: 'Button Button-Menu', id: 'ButtonArea-Toggle', name: 'button', type: 'button'}) }}
	{% endblock %}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block categoriesFilterOverview %}
				{% if isAjax == false %}
					{{ CategoriesHelper.filter('mediaFolder', null, {
						groupBy: 'languageShortcode',
						groupLabels: {general: 'Global'}|merge(LocaleHelper.languagesForRealm(languageRealm))
					}) }}
				{% endif %}
			{% endblock %}

			{% block overviewButtonAutoOverwritePreferenceInput %}
				<input id="UploadAutoOverwrite" type="checkbox" name="upload_auto_overwrite" value="1" {% if localConfig.upload.autoOverwrite %}checked{% endif %}>
			{% endblock %}

			{% block overviewButtons %}
				{% if isAjax == false %}
					{% if paginated == false %}
						{% block overviewButtonSaveSystemOrder %}
							<button class="Button Button-SaveSystemOrder" disabled>{{ __d('system', 'save_system_order') }}</button>
						{% endblock %}

						{% block overviewButtonDelete %}
							{% if AuthorizationHelper.isAccessible('delete') %}
								<button
									class="Button Button-Delete"
									disabled
									data-confirm-title="{{ __('confirm_delete_selected_title') }}"
									data-confirm-yes="{{ __('confirm_delete_yes') }}"
									data-confirm-yes-class="Button-Delete"
									data-confirm-no="{{ __('confirm_delete_no') }}"
									data-confirm="{{ __('confirm_delete_selected', mediaItem.id) }}"
									data-confirm-multiple-in-use="{{ __('confirm_multiple_in_use') }}">{{ __('delete') }}</button>
							{% endif %}
						{% endblock %}
					{% endif %}

					{% block overviewButtonAdd %}
						{% set autoOverwritePreferenceLabel %}
							<label for="UploadAutoOverwrite"
								data-title-active="{{ __d('media', 'upload_overwrite_existing_files_active') }}"
								data-title-inactive="{{ __d('media', 'upload_overwrite_existing_files_inactive') }}"
								title="{{ __d('media', 'upload_overwrite_existing_files_' ~ (localConfig.upload.autoOverwrite ? 'active' : 'inactive')) }}">
								{{ __d('media', 'upload_overwrite_existing_files') }}
							</label>
						{% endset %}

						{% if AuthorizationHelper.isAccessible('create') %}
							{{ HtmlHelper.link(__('create') ~ autoOverwritePreferenceLabel, {action: 'add'}, {
								class : 'Button Button-Add',
								escape: false,
								title: __('create'),
							}) }}
						{% endif %}
					{% endblock %}

					{% block listControlOverviewListPaginated %}
						{{ HtmlHelper.link(__('list_paginated'), {action: 'userConfiguration', identifier: 'paginate.enabled', value: 'true'}, {
							class: 'Button Button-Small Button-ListView Button-ListView-PaginatedList',
							disabled: localConfig.paginate.enabled == true
						}) }}
					{% endblock %}

					{% block listControlOverviewListNested %}
						{{ HtmlHelper.link(__('list_nested'), {action: 'userConfiguration', identifier: 'paginate.enabled', value: 'false'}, {
							class: 'Button Button-Small Button-ListView Button-ListView-NestedList',
							disabled: localConfig.paginate.enabled == false
						}) }}
					{% endblock %}
				{% endif %}
			{% endblock %}
		</div>
	{% endblock %}

	{% do MediaHelper.storeItems(media) %}

	{% if paginated %}
		{% block uploadQueue %}
			{% block uploadQueueTable %}
				<table id="UploadQueue" class="Table">
					<thead>
						<tr>
							<th class="TableHeader-Name">{{ __('upload_queue_name') }}</th>
							<th class="TableHeader-Status">{{ __('upload_queue_status') }}</th>
							<th class="TableHeader-Actions">{{ __('upload_queue_actions') }}</th>
						</tr>
					</thead>
					<tbody></tbody>
				</table>
			{% endblock %}
			{% block uploadQueueTableItemTemplate %}
				<template id="uploadQueueItemTemplate" data-max-file-size="{{ maxFileSize }}" data-error-max-filesize="{{ __('error_max_file_size') }}">
					<tr class="UploadQueue-Item UploadQueue-Item-InProgress">
						<td class="TableCell-Name Name"></td>
						<td class="TableCell-Status Status">
							<progress value="0" max="100"></progress>
						</td>
						<td class="TableCell-Actions">
							<div class="Actions">
								<button class="Button Button-Small Button-Error Button-Cancel">{{ __('cancel_upload') }}</button>
							</div>
						</td>
					</tr>
				</template>
			{% endblock %}
		{% endblock %}
		{% block paginatedOverview %}
			{% include '@Backend/Media/overview_paginated_list.twig' with _context|merge({
				records: media.items().toArray(),
				displayedFields: localConfig.overview.displayedFields,
			}) %}
		{% endblock %}
	{% else %}
		{% if isAjax %}
			<dialog id="MediaOverlay" tabindex="-1">
				<div class="ButtonArea">
					{{ block('overviewButtonAutoOverwritePreferenceInput') }}

					<button class="Button Button-Success Button-UseFiles" disabled>{{ __d('media', 'use_files') }}</button>

					{{ block('overviewButtonSaveSystemOrder') }}

					{% if AuthorizationHelper.isAccessible('create') %}
						<div class="Button Button-Add">
							{{ __('create') }}

							<form action="{{ _view.url({action: 'add'}) }}" method="post" enctype="multipart/form-data" class="Form Form-Upload">
								<input type="file" name="files[]" multiple>
							</form>

							<label for="UploadAutoOverwrite" tabindex="0"
								data-title-active="{{ __d('media', 'upload_overwrite_existing_files_active') }}"
								data-title-inactive="{{ __d('media', 'upload_overwrite_existing_files_inactive') }}"
								title="{{ __d('media', 'upload_overwrite_existing_files_' ~ (localConfig.upload.autoOverwrite ? 'active' : 'inactive')) }}">
								{{ __d('media', 'upload_overwrite_existing_files') }}
							</label>
						</div>
					{% endif %}

					{% if AuthorizationHelper.isAccessible('delete') %}
						<button
							class="Button Button-Delete"
							disabled
							data-confirm-title="{{ __('confirm_delete_selected_title') }}"
							data-confirm-yes="{{ __('confirm_delete_yes') }}"
							data-confirm-yes-class="Button-Delete"
							data-confirm-no="{{ __('confirm_delete_no') }}"
							data-confirm="{{ __('confirm_delete_selected', mediaItem.id) }}"
							data-confirm-multiple-in-use="{{ __('confirm_multiple_in_use') }}">{{ __('delete') }}</button>
					{% endif %}

					<button class="Button Button-Close">
						{{ __('close') }}
					</button>
				</div>

				{% block mediaButtonAreaToggle %}
					{{ FormHelper.button(__('button_area_toggle'), {class: 'Button Button-Menu', id: 'MediaButtonArea-Toggle', name: 'button', type: 'button'}) }}
				{% endblock %}

				{% block mediaFoldersToggle %}
					{{ FormHelper.button(__('media_folders_toggle'), {class: 'Button Button-Folder', id: 'MediaFolders-Toggle', name: 'button', type: 'button'}) }}
				{% endblock %}
		{% endif %}

		{% block listOverview %}
			{% include '@Backend/Media/overview_list.twig' %}

			{% block listOverviewUploadQueueItemTemplate %}
				<template id="uploadQueueItemTemplate" data-max-file-size="{{ maxFileSize }}" data-error-max-filesize="{{ __('error_max_file_size') }}">
					<li class="Media-ListItem UploadQueue-Item UploadQueue-Item-InProgress">
						<button class="Button Button-Error Button-Cancel">{{ __('cancel_upload') }}</button>
						<span class="Status"><progress value="0" max="100"></progress></span>
						<span class="Name"></span>
					</li>
				</template>
			{% endblock %}
		{% endblock %}

		{% if isAjax %}
				{% from '@Backend/macro/nested_list.twig' import nestedList %}
				{% do AuthorizationHelper.setScope('MediaFolders') %}
				{% block mediaFolders %}
					<div id="MediaFolders-List"{# class="🌚" #}>
						{% set currentLanguageShortcode = languageShortcode %}
						{% for languageShortcode, mediaFolders in groupedMediaFolders %}
							{% block fieldsetOverview %}
								<fieldset
										class="Overview-Fieldset Collapsible{% if languageShortcode not in ['', 'hidden', language.shortcode] and languageShortcode != currentLanguageShortcode %} Collapsed{% endif %}"
										id="MediaFolder-List-{{ (languageShortcode ?? 'global')|camelize }}">
									<legend>
										{% if languageShortcode == '' %}
											{{ __('media_folder_global') }}
										{% elseif languageShortcode == 'hidden' %}
											{{ __('media_folder_hidden') }}
										{% else %}
											{{ languages[ languageRealm ][ languageShortcode ] ? languages[ languageRealm ][ languageShortcode ].title : languageShortcode }}
										{% endif %}
									</legend>
									{% block fieldsetOverviewInner %}
										{% block listFoldersOverview %}
											{{ nestedList(mediaFolders, _context|merge({
												data: {
													sortable: false,
													nestable: false,
												},
												identifier: 'MediaFolders',
												selectedMediaFolderId: selectedMediaFolderId,
												template: '@Backend/Media/overview_folders_nested_list_item.twig',
											})) }}
										{% endblock %}
									{% endblock %}
								</fieldset>
							{% endblock %}
						{% endfor %}
					</div>
				{% endblock %}

				{% if AuthorizationHelper.isAccessible('create') %}
					<div id="MediaFolders-AddButton">
						{{ HtmlHelper.link(__d('media_folders', 'create'), {controller: 'MediaFolders', action: 'add'}, {class: 'Button Button-Add OverlayForm'}) }}
					</div>
				{% endif %}

				{% do AuthorizationHelper.resetScope() %}

				<div id="UploadQueue-DropZone">{{ __('dropzone_drop_to_upload') }}</div>
			</dialog>
		{% endif %}
	{% endif %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('categoriesFilterOverview') }}

			{{ block('overviewButtons') }}
		</div>
	{% endblock %}

	{% if isAjax == false %}
		<div id="UploadQueue-DropZone">{{ __('dropzone_drop_to_upload') }}</div>
	{% endif %}
</div>
