{#
@var media \Awyiss\Model\Entity\Media
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{{ FormHelper.create(media, {enctype: 'multipart/form-data', method: 'post', id: 'MediaForm', idPrefix: 'media'}) }}
<input type="hidden" name="attributes" value="">

{% set fieldsetGeneral %}
	{% block fieldsetGeneral %}
		<fieldset class="Fieldset-General">
			<legend>{{ __('fieldset_general') }}</legend>

			{% block fieldsetGeneralInner %}
				{% if AuthorizationHelper.isAccessible('create') %}
					{% block formControlFile %}
						{{ FormHelper.control('file', {
							type: 'file',
						}) }}
					{% endblock %}
				{% endif %}

				{% block formControlName %}
					{{ FormHelper.control('name', {required: false, val: media.cleanName}) }}
				{% endblock %}

				{% block formControlAlt %}
					{{ FormHelper.control('alt') }}
				{% endblock %}

				{% block formControlAverageColor %}
					{{ FormHelper.control('averageColor', {
						type: 'color',
						val: (media.averageColor and media.averageColor[:1] != '#' ? '#' : '') ~ media.averageColor,
					}) }}
				{% endblock %}

				{% block fieldsetGeneralAttributes %}
					{{ AttributesHelper.allControls('general') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetCrop %}
	{% block fieldsetCrop %}
		{% if ((media.previewPath and media.preview == enum(ProcessStatus).Success)) or media.preview == enum(ProcessStatus).NotRequired %}
			{% set resizedMediaItem = MediaHelper.resize(media, null, 2560, 2560, null, enum(ResizeStrategy).Contain) %}

			{% set imagePath = resizedMediaItem and resizedMediaItem.status == enum(ProcessStatus).Success ? resizedMediaItem.path : (media.previewPath ?? media.path) %}

			<fieldset class="Fieldset-Crop" data-hideable="false">
				<legend>{{ __('fieldset_crop') }}</legend>

				{% block fieldsetCropInner %}
					{% if (media.crop) %}
						<p>{{ __('cropping_in_progress') }}</p>
					{% else %}
						<div
								class="CropArea"
								data-image-src="{{ imagePath }}?t={{ media.preview == enum(ProcessStatus).NotRequired ? media.filemtime : media.previewFilemtime }}"
								data-image-width="{{ media.width }}"
								data-image-height="{{ media.height }}">
							{% block formControlCropMeasurements %}
								<div class="Measurements">
									{% block formControlCropWidth %}
										{{ FormHelper.control('crop[width]', {
											label: __('crop_width'),
											max: media.width,
											type: 'number',
											val: '',
										}) }}
									{% endblock %}

									{% block formControlCropHeight %}
										{{ FormHelper.control('crop[height]', {
											label: __('crop_height'),
											max: media.height,
											type: 'number',
											val: '',
										}) }}
									{% endblock %}
									{% block formControlResizeWidth %}
										{{ FormHelper.control('crop[resizeWidth]', {
											label: __('resize_width'),
											max: media.width,
											type: 'number',
											val: '',
										}) }}
									{% endblock %}

									{% block formControlResizeHeight %}
										{{ FormHelper.control('crop[resizeHeight]', {
											label: __('resize_height'),
											max: media.height,
											type: 'number',
											val: '',
										}) }}
									{% endblock %}

									{% block formControlCropX %}
										{{ FormHelper.control('crop[x]', {
											type: 'hidden',
											val: '',
										}) }}
									{% endblock %}

									{% block formControlCropY %}
										{{ FormHelper.control('crop[y]', {
											type: 'hidden',
											val: '',
										}) }}
									{% endblock %}

									{{ FormHelper.hidden('focusPoint') }}
								</div>
							{% endblock %}
						</div>
					{% endif %}
				{% endblock %}
			</fieldset>
		{% endif %}
	{% endblock %}
{% endset %}

{% set fieldsetContent %}
	{% block fieldsetContent %}
		<fieldset class="Fieldset-Content">
			<legend>{{ __('fieldset_content') }}</legend>

			{% block fieldsetContentInner %}
				{% block fieldsetContentAttributes %}
					{{ AttributesHelper.allControls('content') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetPresentation %}
	{% block fieldsetPresentation %}
		<fieldset class="Fieldset-Presentation">
			<legend>{{ __('fieldset_presentation') }}</legend>

			{% block fieldsetPresentationInner %}
				{% block fieldsetPresentationAttributes %}
					{{ AttributesHelper.allControls('presentation') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetConditions %}
	{% block fieldsetConditions %}
		<fieldset class="Fieldset-Conditions">
			<legend>{{ __('fieldset_conditions') }}</legend>

			{% block fieldsetConditionsInner %}
				{% block formControlMediaFolderId %}
					{{ CategoriesHelper.control('mediaFolder', {groupBy: 'languageShortcode', groupLabels: LocaleHelper.languagesForRealm(languageRealm)|merge({general: 'Global'}), 'data-form-updater': true}) }}
				{% endblock %}

				{% block formControlSystemOrder %}
					{{ SystemOrderHelper.control('systemOrder', {entity: media}) }}
				{% endblock %}

				{% block fieldsetConditionsAttributes %}
					{{ AttributesHelper.allControls('conditions') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetAttributes %}
	{% block fieldsetAttributes %}
		<fieldset class="Fieldset-Attributes">
			<legend>{{ __('fieldset_attributes') }}</legend>

			{% block fieldsetAttributesInner %}
				{% block fieldsetAttributesAttributes %}
					{{ AttributesHelper.allControls('attributes') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% block sidebarToggle %}
	{% if config.Awyiss.System.Backend.interface.sidebarMode == true and isOverlayForm != true %}
		{{ FormHelper.button(__('sidebar_toggle'), {class: 'Button Button-Configure', id: 'Sidebar-Toggle', name: 'button', type: 'button'}) }}
	{% endif %}
{% endblock %}

{% block fieldsets %}
	<div class="Fieldsets">
		{% if config.Awyiss.System.Backend.interface.sidebarMode != true or isOverlayForm == true %}
			{{ fieldsetPresentation }}
			{{ fieldsetConditions }}
			{{ fieldsetGeneral }}
			{{ fieldsetCrop }}
			{{ fieldsetContent }}
			{{ fieldsetAttributes }}
		{% endif %}

		{% block mainFieldsets %}
			{% if config.Awyiss.System.Backend.interface.sidebarMode == true and isOverlayForm != true %}
				<div class="Main-Fieldsets">
					{{ fieldsetGeneral }}
					{{ fieldsetCrop }}
					{{ fieldsetContent }}
				</div>
			{% endif %}
		{% endblock %}

		{% block sidebarFieldsets %}
			{% if config.Awyiss.System.Backend.interface.sidebarMode == true and isOverlayForm != true %}
				<div class="Sidebar-Fieldsets">
					{{ fieldsetPresentation }}
					{{ fieldsetConditions }}
					{{ fieldsetAttributes }}
				</div>
			{% endif %}
		{% endblock %}

		{% block formInputReloadForm %}
			{{ FormHelper.hidden('reloadForm', {val: 0}) }}
		{% endblock %}
	</div>
{% endblock %}

{% block lockDialog %}
	{{ element('lock_dialog', {entity: media}) }}
{% endblock %}

{{ FormHelper.end() }}
