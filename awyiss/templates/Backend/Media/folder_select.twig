{#
@var mediaFolderId int
@var groupedMediaFolders array<string, \Awyiss\Model\Entity\MediaFolder[]>
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

<div class="Contents Form MediaFolderSelect" data-title="{{ __('headline_media_folder_select') }}">
	{% block buttonArea %}
		<div class="ButtonArea">
			{% block formMediaFolderSelectButtons %}
				{{ FormHelper.button(__('apply'), {class: 'Button Button-Success Button-Save', form: 'MediaFolderSelect'}) }}
			{% endblock %}

			{{ FormHelper.button(__('cancel'), {class: 'Button Button-Close'}) }}
		</div>
	{% endblock %}

	{% from '@Backend/macro/nested_list.twig' import nestedList %}
	{% block mediaFolders %}
		<div id="MediaFolders-List">
			{% for languageShortcode, mediaFolders in groupedMediaFolders %}
				{% block fieldsetOverview %}
					<fieldset
							class="Overview-Fieldset Collapsible{% if languageShortcode not in ['', language.shortcode] %} Collapsed{% endif %}"
							id="MediaFolder-List-{{ (languageShortcode ?? 'global')|camelize }}">
						<legend>{{ languages[ languageRealm ][ languageShortcode ] ? languages[ languageRealm ][ languageShortcode ].title : __('media_folder_global') }}</legend>

						{% block fieldsetOverviewInner %}
							{% block listFoldersOverview %}
								{{ nestedList(mediaFolders, _context|merge({
									data: {
										sortable: false,
										nestable: false,
									},
									identifier: 'MediaFolders',
									selectedMediaFolderId: mediaFolderId,
									template: '@Backend/Media/folder_select_nested_list_item.twig',
								})) }}
							{% endblock %}
						{% endblock %}
					</fieldset>
				{% endblock %}
			{% endfor %}

			{% block buttonAreaBottom %}
				<div class="ButtonArea ButtonArea-Bottom">
					{{ block('formMediaFolderSelectButtons') }}

					{{ FormHelper.button(__('cancel'), {class: 'Button Button-Close Button-Cancel'}) }}
				</div>
			{% endblock %}
		</div>
	{% endblock %}
</div>