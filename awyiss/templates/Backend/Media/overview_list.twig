{% block listOverview %}
	<ul id="Media-List" data-media-folder-id="{{ selectedMediaFolderId }}">
		{% for mediaItem in media %}
			{% block listOverviewMediaItem %}
				{% set imageSizeInfo = '' %}
				{% if mediaItem.mimeType in ['image/gif', 'image/jpeg', 'image/png', 'image/webp'] or mediaItem.preview %}
					{% set imageSizeInfo = ' / ' ~ mediaItem.width ~ 'x' ~ mediaItem.height ~ 'px' %}
				{% endif %}

				<li id="Media-ListItem{{ mediaItem.id }}" class="Media-ListItem" title="{{ mediaItem.name }} (ID: {{ mediaItem.id }}{{ imageSizeInfo }})">
					{% include '@Backend/element/Media/preview.twig' %}
					<span class="Name">{{ mediaItem.name }}</span>

					{% block listOverviewMediaItemActions %}
						<span class="Actions">
							{% block listOverviewMediaItemActionsUpdate %}
								{% if AuthorizationHelper.isAccessible('update') %}
									{{ HtmlHelper.link(__('edit'), {action: 'edit', id: mediaItem.id}, {class: 'Button Button-Small Button-Edit'}) }}
								{% endif %}
							{% endblock %}

							{% block listOverviewMediaItemActionsDelete %}
								{% if AuthorizationHelper.isAccessible('delete') %}
									{{ HtmlHelper.link(__('delete'), {action: 'delete', id: mediaItem.id}, {
										class: 'Button Button-Small Button-Delete',
										'data-confirm-title': __('confirm_delete_title'),
										'data-confirm-yes': __('confirm_delete_yes'),
										'data-confirm-yes-class': 'Button-Delete',
										'data-confirm-no': __('confirm_delete_no'),
										'data-confirm': __('confirm_delete', mediaItem.id) }) }}
								{% endif %}
							{% endblock %}
						</span>
					{% endblock %}

					<a href="{{ baseUrl }}{{ mediaItem.path }}" target="_blank" class="Link" title="{{ mediaItem.name }} (ID: {{ mediaItem.id }}{{ imageSizeInfo }})"></a>
				</li>
			{% endblock %}
		{% endfor %}
	</ul>
{% endblock %}