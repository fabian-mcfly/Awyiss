{#
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Awyiss\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}
{% block listOverview %}
	<ul id="Media-List" data-media-folder-id="{{ selectedMediaFolderId }}"
		data-can-create="{{ AuthorizationHelper.isAccessible('create') ? 1 : 0 }}"
		data-controller="media">
		{% for mediaItem in media %}
			{% block listOverviewMediaItem %}
				{% set imageSizeInfo = '' %}
				{% if mediaItem.mimeType in ['image/gif', 'image/jpeg', 'image/png', 'image/webp'] or mediaItem.preview %}
					{% set imageSizeInfo = ' / ' ~ mediaItem.width ~ 'x' ~ mediaItem.height ~ 'px' %}
				{% endif %}

				<li
					id="Media-ListItem{{ mediaItem.id }}"
					class="Media-ListItem"
					title="{{ mediaItem.name }} (ID: {{ mediaItem.id }}{{ imageSizeInfo }})"
					data-media-data="{{ {
						id: mediaItem.id,
						mediaFolderId: mediaItem.mediaFolderId,
						mimeType: mediaItem.mimeType,
						name: mediaItem.name,
						path: mediaItem.path,
						width: mediaItem.width,
						height: mediaItem.height,
						averageColor: mediaItem.averageColor,
						preview: mediaItem.preview,
						avif: mediaItem.avif,
						webp: mediaItem.webp
					}|jsonEncode }}"
				>
					{{ MediaHelper.preview(mediaItem, {
						class: 'Preview',
						resize: {
							width: 275,
							height: 275,
							strategy: enum(ResizeStrategy).Cover,
						},
					}) }}
					<span class="Name">{{ mediaItem.name }}</span>

					{% block listOverviewMediaItemActions %}
						<span class="Actions">
							{% block listOverviewMediaItemActionsUsageCount %}
								{% if (mediaItem.usageCount ?? 0) > 0 %}
									{{ HtmlHelper.link(mediaItem.usageCount, {action: 'usages', id: mediaItem.id}, {class: 'Button UsageCount', title: mediaItem.usageCount ~ ' ' ~ __d('Media', 'usage_count')}) }}
								{% else %}
									<span class="Button UsageCount" title="{{ (mediaItem.usageCount ?? 0) ~ ' ' ~ __d('Media', 'usage_count', mediaItem.usageCount ?? 0) }}">{{ mediaItem.usageCount ?? 0 }}</span>
								{% endif %}
							{% endblock %}
							{% block listOverviewMediaItemActionsUpdate %}
								{% if AuthorizationHelper.isAccessible('create') %}
									{{ HtmlHelper.link(__('edit'), {action: 'edit', id: mediaItem.id}, {class: 'Button Button-Small Button-Edit'}) }}
								{% endif %}
							{% endblock %}

							{% block listOverviewMediaItemActionsDelete %}
								{% if AuthorizationHelper.isAccessible('delete') %}
									{{ HtmlHelper.link(__('delete'), {action: 'delete', id: mediaItem.id}, {
										class: 'Button Button-Small Button-Delete',
										'data-confirm-title': __('confirm_delete_title'),
										'data-confirm-yes': __('confirm_delete_yes'),
										'data-confirm-yes-class': 'Button-Delete',
										'data-confirm-no': __('confirm_delete_no'),
										'data-confirm': __('confirm_delete', mediaItem.id),
										'data-confirm-in-use': __('confirm_in_use'),
										'data-usage-count': mediaItem.usageCount ?? 0,
									}) }}
								{% endif %}
							{% endblock %}
						</span>
					{% endblock %}

					<a href="{{ baseUrl }}{{ mediaItem.path }}" target="_blank" class="Link" title="{{ mediaItem.name }} (ID: {{ mediaItem.id }}{{ imageSizeInfo }})"></a>
				</li>
			{% endblock %}
		{% endfor %}
	</ul>
{% endblock %}