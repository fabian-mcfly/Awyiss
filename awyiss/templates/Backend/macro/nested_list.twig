{#

A macro that takes an array of entities with "children" properties
and builds a recursive list out of it

`aa_settings` is a list of settings that can be passed to the macro
- `identifier` (string) - the identifier of the entity (e.g. "category")
- `template` (string) - the template to use for each item
- `level` (int) - the current level of the list

#}

{% macro nestedList(aa_entities, aa_settings) %}
	{% if aa_settings.level is not defined %}
		{% set aa_settings = aa_settings|merge({level: 1}) %}
	{% endif -%}
	{% if aa_settings.template is not defined %}
		{% set aa_settings = aa_settings|merge({template: '@Backend/macro/nested_list_item.twig'}) %}
	{% endif -%}

	<ul class="{{ aa_settings.identifier|pluralize }}-List NestedList Level{{ aa_settings.level }}
		{%- if aa_settings.class is defined %} {{ aa_settings.class }}{% endif -%}">
		{% for lo_entity in aa_entities %}
			<li class="ListItem {{ aa_settings.identifier }}-ListItem {{ aa_settings.identifier }}-ListItem{{ lo_entity.id -}}
				{%- if lo_entity.class is defined %} {{ lo_entity.class }}{% endif -%}
				{%- if lo_entity.active is defined and lo_entity.active == false %} Inactive{% endif -%}
				{%- if lo_entity.parentsActive is defined and lo_entity.parentsActive == false %} ParentsInactive{% endif -%}
			">
				{% include aa_settings.template with {'lo_entity': lo_entity, 'settings': aa_settings} %}

				{% if lo_entity.children is not empty %}
					{{ _self.nestedList(lo_entity.children, aa_settings|merge({level: aa_settings.level + 1})) }}
				{% endif %}
			</li>
		{% endfor %}
	</ul>
{% endmacro %}