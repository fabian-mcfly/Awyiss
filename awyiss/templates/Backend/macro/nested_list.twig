{#

A macro that takes an array of entities with "children" properties
and builds a recursive list out of it

`settings` is a list of settings that can be passed to the macro
- `identifier` (string) - the identifier of the entity (e.g. "category")
- `template` (string) - the template to use for each item
- `level` (int) - the current level of the list
- `childrenProperty` (string) - the property name of the children (default: "children")

Other fields like `attributes`, `displayedFields`, `localConfig` should be passe do this macro,
so they can be passed to the template

#}

{% macro nestedList(entities, settings, childrenMethod = 'children', itemsMethod = null) %}
	{% if settings.level is not defined %}
		{% set settings = settings|merge({level: 1}) %}
	{% endif -%}
	{% if settings.template is not defined %}
		{% set settings = settings|merge({template: '@Backend/element/overview/nested_list_item.twig'}) %}
	{% endif %}
	{% if settings.class is not defined %}
		{% set settings = settings|merge({class: ''}) %}
	{% endif %}
	{% if settings.parentsActive is not defined %}
		{% set settings = settings|merge({parentsActive: true}) %}
	{% endif %}

	<ul {% if settings.level == 1 %} id="{{ settings.identifier|pluralize }}-List" data-controller="{{ settings.identifier|pluralize|dasherize }}"{% endif -%}
		class="{{ settings.identifier|pluralize }}-List NestedList Level{{ settings.level }} {{ settings.class }}"
		{%- if settings.data is defined %}
			{%- for key, value in settings.data %} data-{{ key }}="{{ value == false ? 'false' : (value is same as(true) ? 'true' : value) }}"{%- endfor %}
		{%- endif %}>

		{% for key, entity in entities %}
			{% set active = key is not numeric or (entity.active == true and settings.parentsActive == true) %}

			{% set children = attribute(entity, childrenMethod) %}
			{% set childrenList = '' %}

			{% if children is not empty %}
				{% if itemsMethod != null %}
					{% set children = attribute(children, itemsMethod) %}
				{% endif %}

				{% set childrenList = _self.nestedList(children, settings|merge({
					level: settings.level + 1,
					parentsActive: active and settings.parentsActive
				}), childrenMethod, itemsMethod) %}
			{% endif %}

			{% include settings.template with _context|merge(settings, {
				childrenList: childrenList,
				settings: settings,
			}) %}
		{% endfor %}
	</ul>
{% endmacro %}
