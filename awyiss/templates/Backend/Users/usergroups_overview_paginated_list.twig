{#
@var usergroups \Awyiss\Model\Entity\Usergroup[]
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Awyiss\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% set tableFootColSpan = displayedFields|length + 3 %}

{% block tableOverview %}
	<table class="Overview-Table Responsive-Table" style="--columns:{{ tableFootColSpan }}; --rows:{{ max(1, usergroups|length) }};">
		{% block tableOverviewHead %}
			<thead>
				{% block tableOverviewHeadRow %}
					<tr>
						{% block tableOverviewHeadRowInner %}
							{% block tableOverviewHeaderUsergroupCheckbox %}
								<th class="TableHeader-UsergroupCheckbox"></th>
							{% endblock %}

							{% block tableOverviewHeaderId %}
								<th class="TableHeader-Id">
									{{ __df('Usergroups', 'System', 'id') }}
								</th>
							{% endblock %}

							{% block tableOverviewHeaderTitle %}
								<th class="TableHeader-Title">
									{{ __df('Usergroups', 'System', 'title') }}
								</th>
							{% endblock %}

							{% block tableOverviewHeaderDefaultFields %}{% endblock %}

							{% block tableOverviewHeaderDisplayedFields %}
								{% for field in displayedFields %}
									{% block tableOverviewHeaderDisplayedField %}
										{% if field starts with 'attributes.' %}
											{% set field = field|slice(11) %}
											<th class="TableHeader-{{ field|camelize }}">
												{{ attributes[field].label }}
											</th>
										{% else %}
											{% if field ends with 'Id' and field != 'parentId' %}
												{% set associationName = field|slice(0, -2) %}
												<th class="TableHeader-{{ field|camelize }}">
													{{ __df('Usergroups', 'System', field|underscore) }}
												</th>
											{% else %}
												<th class="TableHeader-{{ field|camelize }}">
													{{ __df('Usergroups', 'System', field|underscore) }}
												</th>
											{% endif %}
										{% endif %}
									{% endblock %}
								{% endfor %}
							{% endblock %}
						{% endblock %}
					</tr>
				{% endblock %}
			</thead>
		{% endblock %}
		{% block tableOverviewBody %}
			<tbody>
				{# @var usergroup \Awyiss\Model\Entity\Usergroup #}
				{% for usergroup in usergroups %}
					{% block tableOverviewBodyRow %}
						<tr
							class="
								{%- if usergroup.active is defined and usergroup.active == false %} Inactive{% endif -%}
								{%- if usergroup.isPublished() is same as false %} NotPublished{% endif %}
							">

							{% block tableOverviewBodyRowInner %}
								{% block tableOverviewCellUsergroupCheckbox %}
									<td class="TableCell-UsergroupCheckbox">
										{{ FormHelper.control('usergroups._ids.' ~ usergroup.id, {
											hiddenField: false,
											type: 'checkbox',
											value: usergroup.id,
											label: '',
											checked: usergroup.id in (user.usergroups)|column('id'),
										}) }}
									</td>
								{% endblock %}

								{% block tableOverviewCellId %}
									<td class="TableCell-Id">{{ usergroup.id }}</td>
								{% endblock %}

								{% block tableOverviewCellTitle %}
									<td class="TableCell-Title">{{ usergroup.title }}</td>
								{% endblock %}

								{% block tableOverviewCellDefaultFields %}{% endblock %}

								{% block tableOverviewCellDisplayedFields %}
									{% for field in displayedFields %}
										{% block tableOverviewCellDisplayedField %}
											<td class="TableCell-{{ field|camelize }}">
												{% if field starts with 'attributes.' %}
													{% set field = field|slice(11) %}
													{% block tableOverviewCellDisplayedFieldAttributeValue %}
														{{ HtmlHelper.formatFieldValue(usergroup, field, isAttribute: true)|raw }}
													{% endblock %}
												{% else %}
													{% block tableOverviewCellDisplayedFieldDefaultValue %}
														{{ HtmlHelper.formatFieldValue(usergroup, field)|raw }}
													{% endblock %}
												{% endif %}
											</td>
										{% endblock %}
									{% endfor %}
								{% endblock %}
							{% endblock %}
						</tr>
					{% endblock %}
				{% endfor %}
			</tbody>
		{% endblock %}
	</table>
{% endblock %}
