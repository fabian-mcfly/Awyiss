{#
@var aa_languages \Awyiss\Model\Entity\Language[]
@var _view \Awyiss\View\BackendView
#}

<div class="Users Form Login">
	{{ FormHelper.create() }}

	{% block fieldsetLogin %}
		<fieldset class="Fieldset-Login">
			<legend>{{ __('legend_login') }}</legend>

			{% block fieldsetLoginInner %}
				{% block formControlUsername %}
					{{ FormHelper.control('username') }}
				{% endblock %}

				{% block formControlPassword %}
					{{ FormHelper.control('password') }}
				{% endblock %}

				{% block formControlLanguageShortcode %}
					{{ LocaleHelper.control('language_shortcode', {empty: false, languageRealm: as_languageRealm}) }}
				{% endblock %}

				{{ FormHelper.button(__('login'), {class: 'Submit'}) }}
			{% endblock %}
		</fieldset>
	{% endblock %}

	{{ FormHelper.end() }}
</div>