{#
@var aa_languages \Awyiss\Model\Entity\Language[]
@var _view \Awyiss\View\BackendView
#}

<div class="Users Form">
	{{ helper_Form_create() }}

	{% block fieldsetLogin %}
		<fieldset class="Fieldset-Login">
			<legend>{{ __('legend_login') }}</legend>

			{% block fieldsetLoginInner %}
				{% block formControlUsername %}
					{{ helper_Form_control('username') }}
				{% endblock %}

				{% block formControlPassword %}
					{{ helper_Form_control('password') }}
				{% endblock %}

				{% block formControlLanguageShortcode %}
					{{ helper_Locale_control('language_shortcode', {empty: false, languageRealm: as_languageRealm}) }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}

	{{ helper_Form_button(__('login')) }}

	{{ helper_Form_end() }}
</div>