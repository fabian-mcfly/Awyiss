{#
@var languages \Awyiss\Model\Entity\Language[]
@var _view \Awyiss\View\BackendView
#}

<div class="Users Form Login">
	{{ FormHelper.create() }}

	{% block fieldsetLogin %}
		<fieldset class="Fieldset-Login">
			<h1>{{ __('legend_login') }}</h1>

			{% block fieldsetLoginInner %}
				{% block formControlUsername %}
					{{ FormHelper.control('username') }}
				{% endblock %}

				{% block formControlPassword %}
					{{ FormHelper.control('password', {
						'data-show-password-label': __d('users', 'show_password'),
					}) }}
				{% endblock %}

				{% block formControlLanguageShortcode %}
					{{ LocaleHelper.control('language_shortcode', {empty: false, languageRealm: languageRealm}) }}
				{% endblock %}

				{{ FormHelper.button(__('login'), {class: 'Submit'}) }}
			{% endblock %}
		</fieldset>
	{% endblock %}

	{{ FormHelper.end() }}
</div>