{#
@var entity \Awyiss\Model\Entity\Attribute
@var attributes \Awyiss\Model\Entity\Attribute[]
@var attributesGroupedByFieldset array
@var attributeScopes array
@var _view \Awyiss\View\BackendView
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
#}

{% extends '@Backend/element/overview/overview_paginated_list.twig' %}

{% block tableOverviewHeaderTitle %}{% endblock %}
{% block tableOverviewHeaderDefaultFields %}
	<th class="TableHeader-Username{% if PaginatorHelper.isCurrentSortKey('username') %} Active{% endif %}">
		{{ PaginatorHelper.sort('username', i18nDomain ? __df(i18nDomain, 'system', 'username') : __('username')) }}
	</th>
{% endblock %}

{% block tableOverviewCellTitle %}{% endblock %}
{% block tableOverviewCellDefaultFields %}
	<td class="TableCell-Username">{{ entity.username }}</td>
{% endblock %}

{% block tableOverviewCellDisplayedFieldDefaultValue %}
	{% if field == 'last_login' %}
		{{ entity.lastLogin ? TimeHelper.nice(entity.lastLogin) : '-' }}
	{% else %}
		{{ parent() }}
	{% endif %}
{% endblock %}
