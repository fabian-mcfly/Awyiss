{% extends '@Backend/element/overview/overview_paginated_list.twig' %}

{% block tableOverviewHeaderTitle %}{% endblock %}
{% block tableOverviewCellTitle %}{% endblock %}

{% block tableOverviewHeaderDefaultFields %}
	<th class="TableHeader-Url{% if PaginatorHelper.isCurrentSortKey('url') %} Active{% endif %}">{{ PaginatorHelper.sort('url') }}</th>
	<th class="TableHeader-ForeignKey">{{ __('target') }}</th>
{% endblock %}


{% block tableOverviewBodyRow %}
	<tr>
		{{ block('tableOverviewCellId') }}

		{% block tableOverviewCellDefaultFields %}
			<td class="TableCell-Url">{{ entity.url }}</td>
			<td class="TableCell-ForeignKey">
				{% if entity.page %}
					{{ entity.page.title }}<br>
					{{ HtmlHelper.link(entity.page.languageShortcode ~ '/' ~ entity.page.slug, {
						lang: entity.page.languageShortcode,
						slug: entity.page.slug,
						_name: 'Frontend',
					}, {
						target: '_blank',
					}) }}
				{% elseif entity.media %}
					{{ entity.media.name }}<br>
					{{ HtmlHelper.link(entity.media.path, entity.media.path, {
						target: '_blank',
					}) }}
				{% elseif entity.target is not empty %}
					{{ HtmlHelper.link(entity.target, entity.target, {
						target: '_blank',
					}) }}
				{% endif %}
			</td>
		{% endblock %}

		{{ block('tableOverviewCellDisplayedFields') }}

		{{ block('tableOverviewCellAuditInfo') }}

		{{ block('tableOverviewCellActions') }}
	</tr>
{% endblock %}

{% block tableOverviewFootColSpan %}{{ localConfig.overview.displayedFields|length + 5 }}{% endblock %}
