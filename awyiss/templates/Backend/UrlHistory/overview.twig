{#
@var urlHistory Awyiss\Model\Entity\UrlHistory[]
@var paginated bool
@var _view \Awyiss\View\BackendView
#}

<div class="UrlHistory Overview">
	{% block headlineOverview %}
		<h1>{{ __('headline_overview') }}</h1>
	{% endblock %}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block buttonsOverview %}
				{% if AuthorizationHelper.isAccessible('create') %}
					{{ HtmlHelper.link(__('create'), {action: 'add'}, {class : 'Button Button-Add'}) }}
				{% endif %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block paginatedOverview %}
		{% include '@Backend/UrlHistory/overview_paginated_list.twig' with _context|merge({records: urlHistory.items().toArray()}) %}
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('buttonsOverview') }}
		</div>
	{% endblock %}
</div>
