{#
@var pageTemplate \Awyiss\Model\Entity\PageTemplate
@var contentAreas \Awyiss\Model\Entity\ContentArea[]
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{{ FormHelper.create(pageTemplate, {method: 'post', id: 'PageTemplateForm', idPrefix: 'PageTemplate'}) }}

{% block sidebarToggle %}
	{{ FormHelper.button(__('sidebar_toggle'), {class: 'Button Button-Configure', id: 'Sidebar-Toggle', name: 'button', type: 'button'}) }}
{% endblock %}

{% block fieldsets %}
	<div class="Fieldsets">
		{% block mainFieldsets %}
			<div class="Main-Fieldsets">
				{% block fieldsetGeneral %}
					<fieldset class="Fieldset-General">
						<legend>{{ __('fieldset_general') }}</legend>

						{% block fieldsetGeneralInner %}
							{% block formControlTitle %}
								{{ FormHelper.control('title') }}
							{% endblock %}

							{% block formControlFilename %}
								{{ FormHelper.control('file_name', {'data-autofill-from': 'title'}) }}
							{% endblock %}

							{% block fieldsetGeneralAttributes %}
								{{ AttributesHelper.allControls('general') }}
							{% endblock %}
						{% endblock %}
					</fieldset>
				{% endblock %}

				{% block fieldsetContentAreas %}
					{% set assignedContentAreas = pageTemplate.contentAreas ? pageTemplate.contentAreas|column('id') : [] %}
					{% set assignedContentAreasListItems = '' %}
					{% set availableContentAreasListItems = '' %}
					{% for key, contentArea in contentAreas %}
						{% set content %}
							<li>
								<label class="Title">{{ contentArea.label }} (<em>{{ contentArea.identifier }}</em>)</label>
								{{ FormHelper.control('content_areas[' ~ key ~'][id]', {
									checked: contentArea.id in assignedContentAreas,
									escape: false,
									hiddenField: false,
									label: contentArea.label ~ ' (<em>' ~ contentArea.identifier ~ '</em>)',
									id: 'ContentTemplate-ContentElements-' ~ contentArea.identifier|camelize,
									value: contentArea.id,
								}) }}
							</li>
						{% endset %}
						{% if contentArea.id in assignedContentAreas %}
							{% set assignedContentAreasListItems = assignedContentAreasListItems ~ content %}
						{% else %}
							{% set availableContentAreasListItems = availableContentAreasListItems ~ content %}
						{% endif %}
					{% endfor %}

					<fieldset class="Fieldset-ContentAreaAssignments">
						{% block fieldsetContentAreasInner %}
							{% block formControlContentAreasAvailable %}
								<fieldset class="Fieldset-ContentAreasAvailable Collapsible">
									<legend>{{ __('content_areas_available') }}</legend>

									{% block formControlContentAreasAvailableInner %}
										<ul class="NoList ContentAreas-List ContentAreas-List-Available">
											{{ availableContentAreasListItems|raw }}
										</ul>
									{% endblock %}
								</fieldset>
							{% endblock %}

							{% block formControlContentAreasAssigned %}
								<fieldset class="Fieldset-ContentAreasAssigned Collapsible">
									<legend>{{ __('content_areas_assigned') }}</legend>

									{% block formControlContentAreasAssignedInner %}
										<ul class="NoList ContentAreas-List ContentAreas-List-Assigned">
											{{ assignedContentAreasListItems|raw }}
										</ul>
									{% endblock %}

									<div
										class="FormInput FormInputType-List FormInputName-ContentAreasNew"
										data-list-item-add="{{ __('list_item_add') }}"
										data-list-item-remove="{{ __('list_item_remove') }}">
										<div class="FormInputType-ListItem">
											{{ FormHelper.control('content_areas[new][title][0]') }}
											{{ FormHelper.control('content_areas[new][identifier][0]') }}
										</div>
									</div>

									{% block fieldsetContentElementsErrors %}
										{% if contentTemplate.error('contentAreas') %}
											{{ FormHelper.error('contentAreas') }}
										{% endif %}
									{% endblock %}
								{% endblock %}
							</fieldset>
						{% endblock %}
					</fieldset>
				{% endblock %}

				{% block fieldsetContent %}
					<fieldset class="Fieldset-Content">
						<legend>{{ __('fieldset_content') }}</legend>

						{% block fieldsetContentInner %}
							{% block fieldsetContentAttributes %}
								{{ AttributesHelper.allControls('content') }}
							{% endblock %}
						{% endblock %}
					</fieldset>
				{% endblock %}

				{% block fieldsetMedia %}
					<fieldset class="Fieldset-Media">
						<legend>{{ __('fieldset_media') }}</legend>

						{% block fieldsetMediaInner %}
							{{ cell('Backend/MediaElements', [pageTemplate]) }}

							{% block fieldsetMediaAttributes %}
								{{ AttributesHelper.allControls('media') }}
							{% endblock %}
						{% endblock %}
					</fieldset>
				{% endblock %}

				{% block fieldsetMediaElementAssignments %}
					{{ cell('Backend/MediaElements::elementAssignments', [pageTemplate]) }}
				{% endblock %}
			</div>
		{% endblock %}

		{% block sidebarFieldsets %}
			<div class="Sidebar-Fieldsets">
				{% block fieldsetPresentation %}
					<fieldset class="Fieldset-Presentation">
						<legend>{{ __('fieldset_presentation') }}</legend>

						{% block fieldsetPresentationInner %}
							{% block formControlActive %}
								{{ FormHelper.control('active') }}
							{% endblock %}

							{% block fieldsetPresentationAttributes %}
								{{ AttributesHelper.allControls('presentation') }}
							{% endblock %}
						{% endblock %}
					</fieldset>
				{% endblock %}

				{% block fieldsetConditions %}
					<fieldset class="Fieldset-Conditions">
						<legend>{{ __('fieldset_conditions') }}</legend>

						{% block fieldsetConditionsInner %}
							{% block formControlPageRoleId %}
								{{ CategoriesHelper.control('page_role', {
									'data-form-updater': true,
								}) }}
							{% endblock %}

							{% block formControlSystemOrder %}
								{{ SystemOrderHelper.control('system_order', {entity: pageTemplate}) }}
							{% endblock %}

							{% block fieldsetConditionsAttributes %}
								{{ AttributesHelper.allControls('conditions') }}
							{% endblock %}
						{% endblock %}
					</fieldset>
				{% endblock %}

				{% block fieldsetAttributes %}
					<fieldset class="Fieldset-Attributes">
						<legend>{{ __('fieldset_attributes') }}</legend>

						{% block fieldsetAttributesInner %}
							{% block fieldsetAttributesAttributes %}
								{{ AttributesHelper.allControls('attributes') }}
							{% endblock %}
						{% endblock %}
					</fieldset>
				{% endblock %}
			</div>
		{% endblock %}

		{% block formInputReloadForm %}
			{{ FormHelper.hidden('reload_form', {val: 0}) }}
		{% endblock %}
	</div>
{% endblock %}

{% block lockDialog %}
	{{ element('lock_dialog', {entity: pageTemplate}) }}
{% endblock %}

{{ FormHelper.end() }}
