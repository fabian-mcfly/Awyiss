{#
@var ao_pageTemplate \Awyiss\Model\Entity\PageTemplate
@var _view \Awyiss\View\BackendView
#}

<div class="PageTemplates Form Edit">
	{{ helper_Form_create(ao_pageTemplate, {method: 'post', idPrefix: 'PageTemplate'}) }}

	{{ helper_Form_checkbox('save_as_copy', {id: 'SaveAsCopy', value: true}) }}

	{% block headlineEdit %}
		<h1>{{ __('headline_edit') }}</h1>
	{% endblock %}

	{% block formEditButtons %}
		<label for="SaveAsCopy">{{ __('as_copy') }}</label>
		{{ helper_Form_button(__('save')) }}
		{{ helper_Form_button(__('save_close'), {name: 'submit', value: 'submit_close'}) }}
	{% endblock %}

	{% block formEdit %}
		{% include('@Backend/PageTemplates/form.twig') %}
	{% endblock %}

	{% block formEditButtonsBottom %}
		{{ block('formEditButtons') }}
	{% endblock %}

	{{ helper_Form_end() -}}
</div>