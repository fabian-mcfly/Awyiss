{% extends '@Backend/element/overview/overview_paginated_list.twig' %}

{% block tableOverviewHeaderDefaultFields %}
	{% if categories.selected is not numeric %}
		<th class="TableHeader-PageRole{% if PaginatorHelper.isCurrentSortKey('pageRole.title') %} Active{% endif %}">
			{{ PaginatorHelper.sort('pageRole.title', __('page_role_title')) }}
		</th>
	{% endif %}
	<th class="TableHeader-UsedForPages{% if PaginatorHelper.isCurrentSortKey('usedForPages') %} Active{% endif %}">
		{{ PaginatorHelper.sort('usedForPages') }}
	</th>
{% endblock %}

{% block tableOverviewCellDefaultFields %}
	{% if categories.selected is not numeric %}
		<td class="TableCell-PageRole">{{ categories.simple[ entity.pageRoleId.value ] }}</td>
	{% endif %}
	<td class="TableCell-UsedForPages">{{ entity.usedForPages }}</td>
{% endblock %}

{% block tableOverviewCellActionsDelete %}
	{% if entity.usedForPages == 0 %}
		{{ parent() }}
	{% else %}
		{% if AuthorizationHelper.isAccessible('delete') %}
			<!--suppress HtmlUnknownAttribute -->
			<a class="Button Button-Small Button-Delete" disabled>{{ __('delete') }}</a>
		{% endif %}
	{% endif %}
{% endblock %}

{% block tableOverviewFootColSpan %}{{ localConfig.overview.displayedFields|length + (categories.selected is numeric ? 5 : 6) }}{% endblock %}
