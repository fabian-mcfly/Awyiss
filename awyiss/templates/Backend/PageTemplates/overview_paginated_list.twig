@var entity \Awyiss\Model\Entity\Attribute
@var attributes \Awyiss\Model\Entity\Attribute[]
@var attributesGroupedByFieldset array
@var attributeScopes array
@var _view \Awyiss\View\BackendView
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
#}

{% extends '@Backend/element/overview/overview_paginated_list.twig' %}

{% block tableOverviewHeaderDefaultFields %}
	<th class="TableHeader-PageRole{% if PaginatorHelper.isCurrentSortKey('pageRoleTitle') %} Active{% endif %}">{{ PaginatorHelper.sort('pageRoleTitle') }}</th>
	<th class="TableHeader-UsedForPages{% if PaginatorHelper.isCurrentSortKey('usedForPages') %} Active{% endif %}">{{ PaginatorHelper.sort('usedForPages') }}</th>
{% endblock %}

{% block tableOverviewCellDefaultFields %}
	<td class="TableCell-PageRole">{{ pageRoles.simple[ entity.pageRoleId.value ] }}</td>
	<td class="TableCell-UsedForPages">{{ entity.usedForPages }}</td>
{% endblock %}

{% block tableOverviewCellActionsDelete %}
	{% if entity.usedForPages == 0 %}
		{{ parent() }}
	{% else %}
		{% if AuthorizationHelper.isAccessible('delete') %}
			<!--suppress HtmlUnknownAttribute -->
			<a class="Button Button-Small Button-Delete" disabled>{{ __('delete') }}</a>
		{% endif %}
	{% endif %}
{% endblock %}

{% block tableOverviewFootColSpan %}{{ localConfig.overview.displayedFields|length + 6 }}{% endblock %}