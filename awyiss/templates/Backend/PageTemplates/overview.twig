{#
@var ao_pageTemplates \Cake\Datasource\ResultSetDecorator
@var aa_pageTemplates array
@var ai_selectedPageRoleId int
@var _view \Awyiss\View\BackendView
#}

{% set lx_selectedPageRoleId = CategoriesHelper.getSelectedCategory('pageRole') %}

<div class="PageTemplates Overview">
	{% block buttonsOverview %}
		{% if AuthorizationHelper.isAccessible('create') %}
			{{ HtmlHelper.link(__('create'), {action: 'add', pageRoleId: lx_selectedPageRoleId}, {class: 'Button'}) }}
		{% endif %}
	{% endblock %}

	{% block headlineOverview %}
		<h1>{{ __('headline_overview') }}</h1>
	{% endblock %}

	{% block categoriesFilterOverview %}
		{{ CategoriesHelper.filter('pageRole') }}
	{% endblock %}

	{% for li_pageRoleId, ls_pageRole in aa_pageRoles.simple %}
		{% block fieldsetOverview %}
			{% if aa_pageTemplates[ li_pageRoleId ] is defined or lx_selectedPageRoleId == 'all' or lx_selectedPageRoleId == li_pageRoleId %}
				<fieldset class="Fieldset-Overview">
					<legend>
						{% if AuthorizationHelper.scopeIsAccessible('PageRoles', [], ['read']) %}
							{{ HtmlHelper.link(ls_pageRole, {controller: 'PageRoles', action: 'edit', id: li_key}) }}
						{% else %}
							{{ ls_pageRole }}
						{% endif %}
					</legend>

					{% block fieldsetOverviewInner %}
						{% block tableOverview %}
							<table class="Table-Overview">
								{% block tableOverviewHead %}
									<thead>
										{% block tableOverviewHeadRow %}
											<tr>
												{% block tableOverviewHeaderTitle %}
													<th>{{ __('title') }}</th>
												{% endblock %}

												{% block tableOverviewHeaderFileName %}
													<th>{{ __('file_name') }}</th>
												{% endblock %}

												{% block tableOverviewHeaderContentAreas %}
													<th>{{ __('content_areas') }}</th>
												{% endblock %}

												{% block tableOverviewHeaderUsedForPages %}
													<th>{{ __('used_for_pages') }}</th>
												{% endblock %}

												{% block tableOverviewHeaderActions %}
													<th class="actions"></th>
												{% endblock %}
											</tr>
										{% endblock %}
									</thead>
								{% endblock %}
								{% block tableOverviewBody %}
									<tbody>
										{# @var lo_pageTemplate \Awyiss\Model\Entity\PageTemplate #}
										{% for lo_pageTemplate in aa_pageTemplates[ li_pageRoleId ] %}
											{% block tableOverviewBodyRow %}
												<tr>
													{% block tableOverviewCellTitle %}
														<td>{{ lo_pageTemplate.title }} ({{ lo_pageTemplate.systemOrder }})</td>
													{% endblock %}

													{% block tableOverviewCellFileName %}
														<td>{{ lo_pageTemplate.fileName }}</td>
													{% endblock %}

													{% block tableOverviewCellContentAreas %}
														<td>{{ lo_pageTemplate.contentAreas|column('label')|join(',<br>')|raw }}</td>
													{% endblock %}

													{% block tableOverviewCellUsedForPages %}
														<td>{{ lo_pageTemplate.usedForPages }}</td>
													{% endblock %}

													{% block tableOverviewCellActions %}
														<td class="actions">
															{% if AuthorizationHelper.isAccessible('update') %}
																{{ HtmlHelper.link(__('edit'), {action: 'edit', id: lo_pageTemplate.id}) }}
															{% endif %}
															{% if AuthorizationHelper.isAccessible('delete') %}
																{% if lo_pageTemplate.usedForPages == 0 %}
																	{{ HtmlHelper.link(__('delete'), {action: 'delete', id: lo_pageTemplate.id}, {
				class: 'Button Button-Small Button-Delete',
				'data-confirm-title': __('confirm_delete_title'),
				'data-confirm-yes': __('confirm_delete_yes'),
				'data-confirm-yes-class': 'Button-Delete',
				'data-confirm-no': __('confirm_delete_no'),
				'data-confirm': __('confirm_delete', lo_pageTemplate.id) }) }}
																{% else %}
																	<a>{{ __('delete') }}</a>
																{% endif %}
															{% endif %}
														</td>
													{% endblock %}
												</tr>
											{% endblock %}
										{% endfor %}
									</tbody>
								{% endblock %}
							</table>
						{% endblock %}
					{% endblock %}
				</fieldset>
			{% endif %}
		{% endblock %}
	{% endfor %}
</div>
