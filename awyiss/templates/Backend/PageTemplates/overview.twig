{#
@var pageTemplates \Awyiss\Model\Entity\PageTemplate[]
@var pageTemplatesGroupdByPageRole \Awyiss\Model\Entity\PageTemplate[]
@var selectedPageRoleId int
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% set selectedPageRoleId = CategoriesHelper.getSelectedCategory('pageRole') %}

<div class="PageTemplates Overview">
	{% block headlinesOverview %}
		<div class="Headlines">
			{% block headlineOverview %}
				<h1>{{ __('headline_overview') }}</h1>
			{% endblock %}
		</div>
	{% endblock %}

	{% block buttonAreaToggle %}
		{{ FormHelper.button(__('button_area_toggle'), {class: 'Button Button-Menu', id: 'ButtonArea-Toggle', name: 'button', type: 'button'}) }}
	{% endblock %}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block categoriesFilterOverview %}
				{{ CategoriesHelper.filter('pageRole') }}
			{% endblock %}

			{% block overviewButtons %}
				{% block overviewButtonSaveSystemOrder %}
					{% if paginated == false %}
						<button class="Button Button-SaveSystemOrder" disabled>{{ __d('system', 'save_system_order') }}</button>
					{% endif %}
				{% endblock %}

				{% block overviewButtonAdd %}
					{% if AuthorizationHelper.isAccessible('create') %}
						{{ HtmlHelper.link(__('create'), {action: 'add'}, {class : 'Button Button-Add'}) }}
					{% endif %}
				{% endblock %}

				{% block overviewButtonFilter %}
					{{ element('search/filter_button', {scope: 'page_templates'}) }}
				{% endblock %}

				{% block listControlOverviewListPaginated %}
					{{ HtmlHelper.link(__('list_paginated'), {action: 'userConfiguration', identifier: 'paginate.enabled', value: 'true'}, {
						class: 'Button Button-Small Button-ListView Button-ListView-PaginatedList',
						disabled: localConfig.paginate.enabled == true
					}) }}
				{% endblock %}

				{% block listControlOverviewListNested %}
					{{ HtmlHelper.link(__('list_nested'), {action: 'userConfiguration', identifier: 'paginate.enabled', value: 'false'}, {
						class: 'Button Button-Small Button-ListView Button-ListView-NestedList',
						disabled: localConfig.paginate.enabled == false
					}) }}
				{% endblock %}
			{% endblock %}
		</div>
	{% endblock %}

	{% if paginated %}
		{% block paginatedOverview %}
			{% include '@Backend/PageTemplates/overview_paginated_list.twig' with _context|merge({records: pageTemplates.items().toArray()}) %}
		{% endblock %}
	{% else %}
		{% for pageRoleId, pageRole in _categories.pageRoles.simple %}
			{% block fieldsetOverview %}
				{% if pageTemplatesGroupdByPageRole[ pageRoleId ] is defined or selectedPageRoleId == 'all' or selectedPageRoleId == pageRoleId %}
					<fieldset class="Overview-Fieldset">
						<legend>
							{% if AuthorizationHelper.scopeIsAccessible('PageRoles', [], ['read']) %}
								{{ HtmlHelper.link(pageRole, {controller: 'PageRoles', action: 'edit', id: pageRoleId}) }}
							{% else %}
								{{ pageRole }}
							{% endif %}
						</legend>

						{% block fieldsetOverviewInner %}
							{% block listOverview %}
								{% from '@Backend/macro/nested_list.twig' import nestedList %}
								{{ nestedList(pageTemplatesGroupdByPageRole[ pageRoleId ], _context|merge({
									data: {
										nestable: false,
										'page-role-id': pageRoleId,
										sortable: _filter['page_templates']['active'] == false,
										'sortable-group': pageRoleId,
									},
									displayedFields: localConfig.overview.displayedFields,
									identifier: 'PageTemplates',
									template: '@Backend/PageTemplates/overview_nested_list_item.twig',
								})) }}
							{% endblock %}
						{% endblock %}
					</fieldset>
				{% endif %}
			{% endblock %}
		{% endfor %}
	{% endif %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('categoriesFilterOverview') }}

			{{ block('overviewButtons') }}
		</div>
	{% endblock %}

	{% block listFilter %}
		{{ element('search/filter', {scope: 'page_templates'}) }}
	{% endblock %}
</div>
