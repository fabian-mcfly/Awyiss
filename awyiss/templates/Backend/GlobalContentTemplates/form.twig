{#
@var globalContentTemplate \Awyiss\Model\Entity\GlobalContentTemplate
@var availableGlobalContentElements array
@var availableGlobalContentAttributes array
@var availableFieldsets array
@var pageTemplates
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Awyiss\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{{ FormHelper.create(globalContentTemplate, {method: 'post', id: 'GlobalContentTemplateForm', idPrefix: 'GlobalContentTemplate'}) }}
<input type="hidden" name="attributes" value="">

{% set originalAvailableFieldsets = availableFieldsets %}
{% set availableFieldsets = [] %}
{% for fieldset in originalAvailableFieldsets %}
	{% set availableFieldsets = availableFieldsets|merge({(fieldset): __d(fieldset == 'publication' ? 'PublicationData' : 'GlobalContents', 'fieldset_' ~ fieldset)}) %}
{% endfor %}

{% set assignedGlobalContentElements = [] %}
{% if globalContentTemplate.globalContentTemplateElements %}
	{% set assignedGlobalContentElements = combine(globalContentTemplate.globalContentTemplateElements|column('identifier'), globalContentTemplate.globalContentTemplateElements) %}
{% endif %}

{% set elementCounter = 0 %}
{% set fieldsetElements = {} %}

{% for availableElement, assignable in availableGlobalContentElements %}
	{% set globalContentTemplateElement = assignedGlobalContentElements[ availableElement ] %}
	{% set key = globalContentTemplateElement ? globalContentTemplateElement.fieldset : 'unused' %}

	{% if assignable == false and key == 'unused' %}
		{% set key = 'conditions' %}
		{% if availableElement in ['active', 'globalContentTemplateId'] %}
			{% set key = 'presentation' %}
		{% endif %}
	{% endif %}

	{% set globalContents %}
		{% block formControlGlobalContentElement %}
			<li
				class="Item GlobalContentElement GlobalContentElement-{{ availableElement|camelize }} GlobalContentElement-Default"
				data-assignable="{{ assignable == false ? 'false' : 'true' }}">
				<span class="Title Title-Default">
					{% if assignable == false %}
						{{ FormHelper.hidden('globalContentTemplateElements.' ~ loop.index0 ~ '.identifier', {
							value: availableElement,
						}) }}
					{% endif %}
					{{ FormHelper.checkbox('globalContentTemplateElements.' ~ loop.index0 ~ '.identifier', {
						checked: assignable == false or assignedGlobalContentElements[ availableElement ],
						disabled: assignable == false,
						hiddenField: false,
						id: 'GlobalContentTemplate-GlobalContentElements-' ~ availableElement|camelize,
						readonly: true,
						value: availableElement,
					}) }}

					{{ __d('GlobalContents', availableElement|underscore) }}
				</span>

				<label for="GlobalContentTemplate-GlobalContentElements-{{ availableElement|camelize }}-Fieldset">
					{% set value = globalContentTemplateElement ? globalContentTemplateElement.fieldset : null %}
					{% if value is empty and assignable == false %}
						{% set value = 'conditions' %}
						{% if availableElement in ['active', 'globalContentTemplateId'] %}
							{% set value = 'presentation' %}
						{% endif %}
					{% endif %}

					{{ FormHelper.select('globalContentTemplateElements.' ~ loop.index0 ~ '.fieldset', availableFieldsets, {
						id: 'GlobalContentTemplate-GlobalContentElements-' ~ availableElement|camelize ~ '-Fieldset',
						required: false,
						val: value,
					}) }}

					{% if (globalContentTemplateElement) %}
						{% block globalContentElementFieldsetError %}
							{{ FormHelper.error('globalContentTemplateElements.' ~ elementCounter ~ '.fieldset') }}
						{% endblock %}
					{% endif %}
				</label>

				{% if (globalContentTemplateElement) %}
					{{ FormHelper.hidden('globalContentTemplateElements.' ~ loop.index0 ~ '.id', {
						val: globalContentTemplateElement.id,
					}) }}
				{% endif %}

				{% if availableElement != 'duplicateOf' %}
					{% set hidden %}
						{% if availableElement == 'globalContentTemplateId' %}
							{{ FormHelper.hidden('globalContentTemplateElements.' ~ loop.index0 ~ '.required', {
								value: true,
							}) }}
						{% endif %}
					{% endset %}
					{{ FormHelper.control('globalContentTemplateElements.' ~ loop.index0 ~ '.required', {
						checked: availableElement == 'globalContentTemplateId' ? true : (globalContentTemplateElement ? globalContentTemplateElement.required : false),
						disabled: availableElement == 'globalContentTemplateId',
						label: __('required'),
						hiddenField: availableElement != 'globalContentTemplateId',
						id: 'GlobalContentTemplate-GlobalContentElements-' ~ availableElement|camelize ~ '-Required',
						templateVars: {
							additionalContent: hidden,
						},
						value: true,
					}) }}
				{% endif %}

				{{ FormHelper.control('globalContentTemplateElements.' ~ loop.index0 ~ '.columnSpan', {
					empty: false,
					label: __('column_span'),
					options: columnSpans,
					id: 'GlobalContentTemplate-GlobalContentElements-' ~ availableElement|camelize ~ '-ColumnSpan',
					type: 'select',
					val: globalContentTemplateElement ? globalContentTemplateElement.columnSpan : false,
				}) }}

				{{ FormHelper.control('globalContentTemplateElements.' ~ loop.index0 ~ '.title', {
					label: __('title'),
					id: 'GlobalContentTemplate-GlobalContentElements-' ~ availableElement|camelize ~ '-Title',
					type: 'translatableText',
					templateVars: {
						dialogTitle: __d('System', 'translations_dialog_title', __('title')),
					},
					values: globalContentTemplateElement['_translations'] ?? [],
				}) }}
			</li>
		{% endblock %}

		{% if assignedGlobalContentElements[ availableElement ] %}
			{% set elementCounter = elementCounter + 1 %}
		{% endif %}
	{% endset %}

	{% if fieldsetElements[key] is not defined %}
		{% set fieldsetElements = fieldsetElements|merge({(key): {(availableElement): globalContents}}) %}
	{% else %}
		{% set fieldsetElements = fieldsetElements|merge({(key): fieldsetElements[key]|merge({(availableElement): globalContents})}) %}
	{% endif %}
{% endfor %}

{% for globalContentAttribute in availableGlobalContentAttributes %}
	{% set globalContentTemplateElement = assignedGlobalContentElements[ 'attributes.' ~ globalContentAttribute.identifier ] %}
	{% set key = globalContentTemplateElement ? globalContentTemplateElement.fieldset : 'unused' %}
	{% set globalContent %}
		{% block formControlGlobalContentAttribute %}
			<li class="Item GlobalContentElement GlobalContentElement-Attribute">
				<span class="Title Title-Attribute">
					{{ FormHelper.checkbox('globalContentTemplateElements.' ~ (loop.index0 + availableGlobalContentElements|length) ~ '.identifier', {
						checked: assignedGlobalContentElements[ 'attributes.' ~ globalContentAttribute.identifier ] ? true : false,
						hiddenField: false,
						id: 'GlobalContentTemplate-GlobalContentAttribute-' ~ globalContentAttribute.identifier|camelize,
						readonly: true,
						value: 'attributes.' ~ globalContentAttribute.identifier,
					}) }}

					{{ globalContentAttribute.label }}
				</span>

				<label for="GlobalContentTemplate-GlobalContentAttribute-{{ globalContentAttribute.identifier|camelize }}-Fieldset">
					{{ FormHelper.select('globalContentTemplateElements.' ~ (loop.index0 + availableGlobalContentElements|length) ~ '.fieldset', availableFieldsets, {
						id: 'GlobalContentTemplate-GlobalContentAttribute-' ~ globalContentAttribute.identifier|camelize ~ '-Fieldset',
						required: false,
						val: globalContentTemplateElement ? globalContentTemplateElement.fieldset : null,
					}) }}

					{% if globalContentTemplateElement %}
						{% block globalContentAttributeFieldsetError %}
							{{ FormHelper.error('globalContentTemplateElements.' ~ elementCounter ~ '.fieldset') }}
						{% endblock %}
					{% endif %}
				</label>

				{{ FormHelper.control('globalContentTemplateElements.' ~ (loop.index0 + availableGlobalContentElements|length) ~ '.required', {
					checked: globalContentTemplateElement ? globalContentTemplateElement.required : false,
					disabled: globalContentAttribute.inputType in ['inputList', 'inputKeyValueList'],
					label: __('required'),
					hiddenField: true,
					id: 'GlobalContentTemplate-GlobalContentAttribute-' ~ globalContentAttribute.identifier|camelize ~ '-Required',
					value: true,
					templateVars: {
						additionalContent: globalContentAttribute.inputType not in ['inputList', 'inputKeyValueList'] ? '' :
							FormHelper.hidden('globalContentTemplateElements.' ~ (loop.index0 + availableGlobalContentElements|length) ~ '.required'),
					},
				}) }}

				{{ FormHelper.control('globalContentTemplateElements.' ~ (loop.index0 + availableGlobalContentElements|length) ~ '.columnSpan', {
					empty: false,
					label: __('column_span'),
					options: columnSpans,
					id: 'GlobalContentTemplate-GlobalContentAttribute-' ~ globalContentAttribute.identifier|camelize ~ '-ColumnSpan',
					type: 'select',
					val: globalContentTemplateElement ? globalContentTemplateElement.columnSpan : false,
				}) }}

				{{ FormHelper.control('globalContentTemplateElements.' ~ (loop.index0 + availableGlobalContentElements|length) ~ '.title', {
					label: __('title'),
					id: 'GlobalContentTemplate-GlobalContentAttribute-' ~ globalContentAttribute.identifier|camelize ~ '-Title',
					type: 'translatableText',
					templateVars: {
						dialogTitle: __d('System', 'translations_dialog_title', __('title')),
					},
					values: globalContentTemplateElement['_translations'] ?? [],
				}) }}
			</li>
		{% endblock %}

		{% if 'attributes.' ~ assignedGlobalContentElements[ globalContentAttribute.identifier ] %}
			{% set elementCounter = elementCounter + 1 %}
		{% endif %}
	{% endset %}

	{% if fieldsetElements[key] is not defined %}
		{% set fieldsetElements = fieldsetElements|merge({(key): {('attributes.' ~ globalContentAttribute.identifier): globalContent}}) %}
	{% else %}
		{% set fieldsetElements = fieldsetElements|merge({(key): fieldsetElements[key]|merge({('attributes.' ~ globalContentAttribute.identifier): globalContent})}) %}
	{% endif %}
{% endfor %}

{% set fieldsetGeneral %}
	{% block fieldsetGeneral %}
		<fieldset class="Fieldset-General">
			<legend>{{ __('fieldset_general') }}</legend>
			{% block fieldsetGeneralInner %}
				{% block formControlTitle %}
					{{ FormHelper.control('title') }}
				{% endblock %}

				{% block formControlFileName %}
					{{ FormHelper.control('fileName', {'data-autofill-from': 'title'}) }}
				{% endblock %}

				{% block fieldsetGeneralAttributes %}
					{{ AttributesHelper.allControls('general') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetGlobalContentElementsAssigned %}
	{% block fieldsetGlobalContentElementsAssigned %}
		<fieldset class="Fieldset-GlobalContentElements-Assigned">
			<legend>{{ __('global_content_elements_assigned') }}</legend>

			{% block fieldsetGlobalContentElementsAssignedInner %}
				{% block fieldsetGlobalContentFieldsets %}
					{% for key, fieldset in availableFieldsets %}
						{% block fieldsetGlobalContentFieldset %}
							<fieldset class="Fieldset-Fieldset Fieldset-Fieldset-{{ key|camelize }} Collapsible">
								<legend>{{ fieldset }}</legend>

								{% block fieldsetGlobalContentFieldsetInner %}
									<ul class="List GlobalContentElements-List SortableList" data-fieldset="{{ key }}">
										{% for globalContentTemplateElement in globalContentTemplate.globalContentTemplateElements %}
											{% if fieldsetElements[key][ globalContentTemplateElement.identifier ] is defined %}
												{{ fieldsetElements[key][ globalContentTemplateElement.identifier ]|raw }}
											{% endif %}
										{% else %}
											{% if fieldsetElements[key] is defined %}
												{% for identifier, globalContentElement in fieldsetElements[key] %}
													{{ globalContentElement|raw }}
												{% endfor %}
											{% endif %}
										{% endfor %}
									</ul>
								{% endblock %}
							</fieldset>
						{% endblock %}
					{% endfor %}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetContent %}
	{% block fieldsetContent %}
		<fieldset class="Fieldset-Content">
			<legend>{{ __('fieldset_content') }}</legend>

			{% block fieldsetContentInner %}
				{% block fieldsetContentAttributes %}
					{{ AttributesHelper.allControls('content') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetMedia %}
	{% block fieldsetMedia %}
		<fieldset class="Fieldset-Media">
			<legend>{{ __('fieldset_media') }}</legend>

			{% block fieldsetMediaInner %}
				{{ cell('Backend/MediaElements', [globalContentTemplate]) }}

				{% block fieldsetMediaAttributes %}
					{{ AttributesHelper.allControls('media') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetMediaElementAssignments %}
	{% block fieldsetMediaElementAssignments %}
		{{ cell('Backend/MediaElements::elementAssignments', [globalContentTemplate]) }}
	{% endblock %}
{% endset %}

{% set fieldsetPresentation %}
	{% block fieldsetPresentation %}
		<fieldset class="Fieldset-Presentation">
			<legend>{{ __('fieldset_presentation') }}</legend>

			{% block fieldsetPresentationInner %}
				{% block formControlActive %}
					{{ FormHelper.control('active', {columnSpan: 6}) }}
				{% endblock %}

				{% block formControlInContentRow %}
					{{ FormHelper.control('inContentRow', {columnSpan: 6}) }}
				{% endblock %}

				{% block fieldsetPresentationAttributes %}
					{{ AttributesHelper.allControls('presentation') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetConditions %}
	{% block fieldsetConditions %}
		<fieldset class="Fieldset-Conditions">
			<legend>{{ __('fieldset_conditions') }}</legend>

			{% block fieldsetConditionsInner %}
				{% block formControlSystemOrder %}
					{{ SystemOrderHelper.control('systemOrder', {entity: globalContentTemplate}) }}
				{% endblock %}

				{% block fieldsetConditionsAttributes %}
					{{ AttributesHelper.allControls('conditions') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetAttributes %}
	{% block fieldsetAttributes %}
		<fieldset class="Fieldset-Attributes">
			<legend>{{ __('fieldset_attributes') }}</legend>

			{% block fieldsetAttributesInner %}
				{% block fieldsetAttributesAttributes %}
					{{ AttributesHelper.allControls('attributes') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetGlobalContentElementsAvailable %}
	{% block fieldsetGlobalContentElementsAvailable %}
		<fieldset class="Fieldset-GlobalContentElements-Available Collapsible">
			<legend>{{ __('global_content_elements_available') }}</legend>

			<ul class="List GlobalContentElements-List SortableList" data-fieldset="unused">
				{{ fieldsetElements.unused|join('')|raw }}
			</ul>
		</fieldset>
	{% endblock %}
{% endset %}

{% block sidebarToggle %}
	{% if config.Awyiss.System.Backend.interface.sidebarMode == true and isOverlayForm != true %}
		{{ FormHelper.button(__('sidebar_toggle'), {class: 'Button Button-Configure', id: 'Sidebar-Toggle', name: 'button', type: 'button'}) }}
	{% endif %}
{% endblock %}

{% block fieldsets %}
	<div class="Fieldsets">
		{% if config.Awyiss.System.Backend.interface.sidebarMode != true or isOverlayForm == true %}
			{{ fieldsetPresentation }}
			{{ fieldsetConditions }}
			{{ fieldsetGeneral }}

			<fieldset class="Fieldset-GlobalContentElements">
				{{ fieldsetGlobalContentElementsAvailable }}
				{{ fieldsetGlobalContentElementsAssigned }}
			</fieldset>

			{{ fieldsetContent }}
			{{ fieldsetMedia }}
			{{ fieldsetMediaElementAssignments }}
			{{ fieldsetAttributes }}
		{% endif %}

		{% block mainFieldsets %}
			{% if config.Awyiss.System.Backend.interface.sidebarMode == true and isOverlayForm != true %}
				<div class="Main-Fieldsets">
					{{ fieldsetGeneral }}
					{{ fieldsetGlobalContentElementsAssigned }}
					{{ fieldsetContent }}
					{{ fieldsetMedia }}
					{{ fieldsetMediaElementAssignments }}
				</div>
			{% endif %}
		{% endblock %}

		{% block sidebarFieldsets %}
			{% if config.Awyiss.System.Backend.interface.sidebarMode == true and isOverlayForm != true %}
				<div class="Sidebar-Fieldsets">
					{{ fieldsetPresentation }}
					{{ fieldsetConditions }}
					{{ fieldsetAttributes }}
					{{ fieldsetGlobalContentElementsAvailable }}
				</div>
			{% endif %}
		{% endblock %}

		{% block formInputReloadForm %}
			{{ FormHelper.hidden('reloadForm', {val: 0}) }}
		{% endblock %}
	</div>
{% endblock %}

{% block lockDialog %}
	{{ element('lock_dialog', {entity: globalContentTemplate}) }}
{% endblock %}

{{ FormHelper.end() }}