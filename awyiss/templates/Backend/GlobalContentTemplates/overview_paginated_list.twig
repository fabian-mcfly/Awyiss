{% extends '@Backend/element/overview/overview_paginated_list.twig' %}

{% block tableOverviewHeaderDefaultFields %}
	<th class="TableHeader-UsedForGlobalContents{% if PaginatorHelper.isCurrentSortKey('usedForGlobalContents') %} Active{% endif %}">{{ PaginatorHelper.sort('usedForGlobalContents') }}</th>
{% endblock %}

{% block tableOverviewCellDefaultFields %}
	<td class="TableCell-UsedForGlobalContents">{{ entity.usedForGlobalContents }}</td>
{% endblock %}

{% block tableOverviewCellActionsDelete %}
	{% if entity.usedForGlobalContents == 0 %}
		{{ parent() }}
	{% else %}
		{% if AuthorizationHelper.isAccessible('delete') %}
			<!--suppress HtmlUnknownAttribute -->
			<a class="Button Button-Small Button-Delete" disabled>{{ __('delete') }}</a>
		{% endif %}
	{% endif %}
{% endblock %}

{% block tableOverviewFootColSpan %}{{ displayedFields|length + 5 }}{% endblock %}
