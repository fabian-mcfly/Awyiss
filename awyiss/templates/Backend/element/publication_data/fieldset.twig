{% block fieldsetPublicationData %}
	{% if localConfig.publicationData.enabled %}
		<fieldset class="Fieldset-PublicationData">
			<legend>{{ __d('PublicationData', 'fieldset_publication') }}</legend>

			{% block fieldsetPublicationDataInner %}
				{% block formControlPublicationStart %}
					{{ FormHelper.control('_publicationData.start.dateTime', {
						columnSpan: 6,
						label: __d('PublicationData', 'date_time_start'),
						type: 'datetime',
					}) }}
				{% endblock %}

				{% block formControlPublicationEnd %}
					{{ FormHelper.control('_publicationData.end.dateTime', {
						columnSpan: 6,
						label: __d('PublicationData', 'date_time_end'),
						type: 'datetime',
					}) }}
				{% endblock %}

				{% block fieldsetPublicationDataFields %}
					{{ fields }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endif %}
{% endblock %}