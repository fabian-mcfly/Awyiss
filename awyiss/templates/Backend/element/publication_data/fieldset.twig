{% block fieldsetPublicationData %}
	{% if localConfig.publicationData.enabled %}
		<fieldset class="Fieldset-PublicationData">
			<legend>{{ __d('publication_data', 'fieldset_publication') }}</legend>

			{% block fieldsetPublicationDataInner %}
				{% block formControlPublicationStart %}
					{{ FormHelper.control('_publication_data.start.date_time', {
						columnSpan: 6,
						label: __d('publication_data', 'date_time_start'),
						type: 'datetime',
					}) }}
				{% endblock %}

				{% block formControlPublicationEnd %}
					{{ FormHelper.control('_publication_data.end.date_time', {
						columnSpan: 6,
						label: __d('publication_data', 'date_time_end'),
						type: 'datetime',
					}) }}
				{% endblock %}

				{% block fieldsetPublicationDataFields %}
					{{ fields }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endif %}
{% endblock %}