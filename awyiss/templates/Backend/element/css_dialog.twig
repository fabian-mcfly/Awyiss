{% block cssDialog %}
	<dialog id="CssDialog" data-title="{{ __('css_dialog_title') }}">
		{% block cssDialogButtonArea %}
			<div class="ButtonArea">
				{% block cssDialogClose %}
					<button class="Button Button-Close" type="button">
						{{ __('css_dialog_close') }}
					</button>
				{% endblock %}
			</div>
		{% endblock %}

		{% block cssDialogInner %}
			<div class="Inner">
				{{ FormHelper.control('css', {'data-css-editor': true}) }}

				<div class="InfoArea">
					{{ __d('contents', 'css_dialog_info')|raw }}
				</div>

				{% block cssDialogButtonAreaBottom %}
					<div class="ButtonArea ButtonArea-Bottom">
						{{ block('cssDialogClose') }}
					</div>
				{% endblock %}
			</div>
		{% endblock %}
	</dialog>
{% endblock %}