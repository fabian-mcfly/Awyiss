{#
@var string scope
@var array _filter
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Awyiss\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% set scope = scope|underscore %}

{% if _filter[ scope ]['columns'] is not empty %}
	{% set operators = combine(
		_filter.operators|column('value'),
		_filter.operators|map(operator => __d('Search', 'operator_' ~ operator.name|underscore))
	) %}

	<dialog class="SearchFilter-Form" data-title="{{ __d('Search', 'filter_headline') }}">
		<div class="ButtonArea">
			{{ FormHelper.button(__d('Search', 'filter_submit'), {class: 'Button Button-Success Button-Save', form: 'FilterForm-' ~ scope|camelize, name: 'submitType', value: 'submit' }) }}
			{{ FormHelper.button(__d('Search', 'filter_close'), {class: 'Button Button-Close', name: 'close', value: 'close' }) }}
		</div>

		<form class="Columns" method="post" id="FilterForm-{{ scope|camelize }}">
			{% for column, settings in _filter[ scope ]['columns'] %}
				{# @var settings Awyiss\Model\Behavior\Search\FilterColumnSettings #}
				<div class="Column Column-{{ column|camelize }}{% if column in _filter[ scope ]['selectedColumns'] %} Active{% endif %}" data-column="{{ column }}"
					data-list-item-remove="{{ __d('Search', 'filter_remove_column') }}">
					{{ FormHelper.label(
						'filter[' ~ scope ~ '][' ~ column ~ '][value]',
						settings.title ?? (column in ['metaTitle', 'metaDescription', 'robotsIndex', 'robotsFollow'] ?
							__d('Seo', column|underscore) :
							(i18nDomain == 'GenericPages' ? __df(scope, 'GenericPages', column|underscore) : __d(i18nDomain ?? scope, column|underscore))
						),
					) }}

					{{ FormHelper.hidden('filter[' ~ scope ~ '][' ~ column ~ '][order]') }}

					{{ FormHelper.hidden('filter[' ~ scope ~ '][' ~ column ~ '][active]', {
						val: column in _filter[ scope ]['selectedColumns'] ? 1 : 0,
					}) }}

					<div class="Operator">
						{{ FormHelper.control('filter[' ~ scope ~ '][' ~ column ~ '][operator]', {
							disabled: settings.type == 'boolean' ? true : settings.disabledOperators,
							label: __d('Search', 'filter_operator'),
							options: operators,
							required: false,
							val: settings.operator,
						}) }}
					</div>

					{% if settings.type == 'boolean' %}
						<div class="Input InputType-Boolean">
							{{ FormHelper.control('filter[' ~ scope ~ '][' ~ column ~ '][value]', {
								hiddenField: false,
								label: false,
								options: {
									'': __d('Search', 'label_boolean_all'),
									'1': __d('Search', 'label_boolean_true'),
									'0': __d('Search', 'label_boolean_false'),
								},
								type: 'radio',
								val: settings.value ?? '',
							}) }}
						</div>
					{% else %}
						<div class="Input InputType-{{ settings.type|ucparts }}">
							{% set helperFormControl %}
								{% if settings.values %}
									{{ FormHelper.select('valueHelperOptions', settings.values, {
										'data-options-for': 'Filter[' ~ scope|variable ~ '][' ~ column|variable ~ '][value]',
									}) }}
								{% endif %}
							{% endset %}

							{{ FormHelper.control('filter[' ~ scope ~ '][' ~ column ~ '][value]', {
								label: false,
								templateVars: {
									additionalContent: helperFormControl
								},
								val: settings.value,
								'data-type': settings.type,
								'data-allow-multiple-values': settings.operator in ['in', 'notIn', 'between', 'notBetween'] ? 'true' : 'false',
							}) }}
						</div>
					{% endif %}
				</div>
			{% endfor %}

			{% set fields = (_filter[ scope ]['columns'] ?? [])|keys %}
			{% set fields = combine(
				fields,
				fields|map(field => field in ['metaTitle', 'metaDescription', 'robotsIndex', 'robotsFollow'] ? __d('Seo', field|underscore) : __d(i18nDomain ?? scope, field|underscore))
			) %}

			<div class="Actions">
				{{ FormHelper.control('filterAddColumn', {
					disabled: _filter[ scope ]['selectedColumns'],
					label: __d('Search', 'filter_add_column'),
					options: fields,
				}) }}
			</div>

			<div class="ButtonArea">
				{{ FormHelper.button(__d('Search', 'filter_submit'), {class: 'Button Button-Success Button-Save', name: 'submitType', value: 'submit' }) }}
				{{ FormHelper.button(__d('Search', 'filter_reset'), {class: 'Button Button-Error Button-Delete Button-Reset', name: 'submitType', value: 'reset'}) }}
				{{ FormHelper.button(__d('Search', 'filter_close'), {class: 'Button Button-Close', name: 'close', value: 'close' }) }}
			</div>
		</form>
	</dialog>
{% endif %}