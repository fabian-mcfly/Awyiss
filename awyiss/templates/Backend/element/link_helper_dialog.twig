{% block linkHelperDialog %}
	<dialog id="LinkHelperDialog" data-title="{{ __d('System', 'link_helper_dialog_title') }}">
		<div class="FormInput FormInputType-Select FormInputName-LinkHelperController">
			<label class="Label" for="MenuEntry-LinkHelperController">{{ __d('System', 'link_helper_dialog_label_controller') }}</label>
			<select
					name="linkHelper[controller]" id="MenuEntry-LinkHelperController"
					data-filter-placeholder="{{ __d('System', 'select_filter_placeholder') }}"
					data-empty-label="{{ __d('System', 'select_empty_label') }}"
			></select>
		</div>

		<div class="FormInput FormInputType-Select FormInputName-LinkHelperMethod">
			<label class="Label" for="MenuEntry-LinkHelperMethod">{{ __d('System', 'link_helper_dialog_label_method') }}</label>
			<select
					name="linkHelper[method]" id="MenuEntry-LinkHelperMethod"
					data-filter-placeholder="{{ __d('System', 'select_filter_placeholder') }}"
					data-empty-label="{{ __d('System', 'select_empty_label') }}"
			></select>
		</div>

		<div
				class="FormInput FormInputType-List FormInputName-UrlParams" data-list-item-add="{{ __d('System', 'link_helper_dialog_label_url_param_add') }}"
				data-list-item-remove="{{ __d('System', 'link_helper_dialog_label_url_param_remove') }}">
			<label class="Label">{{ __d('System', 'link_helper_dialog_label_url_params') }}</label>

			<div class="FormInputType-ListItem FormInputType-ListItem-Default">
				{{ FormHelper.text('param.0.key') }}
				{{ FormHelper.text('param.0.value') }}
			</div>
		</div>

		<button id="LinkHelperDialog-Button-Apply" class="Button Button-Success Button-Save Button-Apply">
			{{ __d('System', 'link_helper_dialog_confirm_apply') }}
		</button>

		<button id="LinkHelperDialog-Button-Cancel" class="Button Button-Cancel Button-Close">
			{{ __d('System', 'link_helper_dialog_confirm_cancel') }}
		</button>
	</dialog>
{% endblock %}