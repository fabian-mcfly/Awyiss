{% for i, stack in trace %}
	{% set excerpt = [] %}
	{% set params = [] %}
	{% set line = null %}

	{% if stack.file and stack.line and stack.line is numeric %}
		{% set line = stack.line %}
		{% set excerpt = staticCall('\\Cake\\Error\\Debugger', 'excerpt', stack.file, line, 4)|raw %}
	{% endif %}

	{% set file = stack.file ? stack.file : '[internal function]' %}

	{% if stack.function is defined and stack.function %}
		{% for arg in stack.args %}
			{% set params = params|merge([ staticCall('\\Cake\\Error\\Debugger', 'exportVar', arg, 4)|raw ]) %}
		{% else %}
			{% set params = params|merge(['No arguments']) %}
		{% endfor %}
	{% endif %}
	<div id="stack-frame-{{ i }}" style="display:{{ i is same as 0 ? 'block' : 'none' }};" class="stack-details">
		<div class="stack-frame-header">
            <span class="stack-frame-file">
                {% if line %}
					{{ HtmlHelper.link(staticCall('\\Cake\\Error\\Debugger', 'trimPath', file), staticCall('\\Cake\\Error\\Debugger', 'editorUrl', file, line)) }}
				{% else %}
					{{ staticCall('\\Cake\\Error\\Debugger', 'trimPath', file)|raw }}
				{% endif %}
            </span>
			<a href="#" class="toggle-link stack-frame-args" data-target="stack-args-{{ i }}">Toggle Arguments</a>
		</div>

		<table class="code-excerpt" cellspacing="0" cellpadding="0">
			{% set lineno = stack.line and stack.line is numeric ? stack.line - 4 : 0 %}
			{% for l, line in excerpt %}
				<tr>
					<td class="excerpt-number" data-number="{{ lineno + l }}"></td>
					<td class="excerpt-line">{{ line|raw }}</td>
				</tr>
			{% endfor %}
		</table>

		<div id="stack-args-{{ i }}" class="cake-debug" style="display: none;">
			<h4>Arguments</h4>
			{% for param in params %}
				<div class="cake-debug">{{ param|raw }}</div>
			{% endfor %}
		</div>
	</div>
{% endfor %}
