{#
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Awyiss\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}
{% set metaTitlePlaceholder = page.title ~ config.Awyiss.System.Frontend.meta.titleSeparator ~ config.Awyiss.System.Frontend.meta.titleAppendix %}
<div class="ColumnSpan-6 Grid-12">
	{% block formControlMetaTitle %}
		{{ FormHelper.control('metaTitle', {
			label: __d('Seo', 'meta_title'),
			placeholder: metaTitlePlaceholder,
			templateVars: {
				additionalContent: '<span data-charcounter-name="metaTitle" class="CharCounter">' ~ page.metaTitle|length ~ '</span>',
			},
			'data-charcounter-name': 'metaTitle',
			'data-appendix': config.Awyiss.System.Frontend.meta.titleAppendix,
			'data-separator': config.Awyiss.System.Frontend.meta.titleSeparator,
		}) }}
	{% endblock %}

	{% block formControlMetaDescription %}
		{{ FormHelper.control('metaDescription', {
			label: __d('Seo', 'meta_description'),
			templateVars: {
				additionalContent: '<span data-charcounter-name="metaDescription" class="CharCounter">' ~ page.metaDescription|length ~ '</span>',
			},
			'data-charcounter-name': 'metaDescription',
		}) }}
	{% endblock %}

	{% block formControlRobotsIndex %}
		{{ FormHelper.control('robotsIndex', {columnSpan: 6, label: __d('Seo', 'robots_index')}) }}
	{% endblock %}

	{% block formControlRobotsFollow %}
		{{ FormHelper.control('robotsFollow', {columnSpan: 6, label: __d('Seo', 'robots_follow')}) }}
	{% endblock %}
</div>

<div class="SeoSnippet ColumnSpan-6">
	<div class="SearchData">
		<input name="searchTerm" class="SearchTerm">
	</div>

	<div class="LiveData">
		<div class="SnippetFavicon">
			{% set favicon = baseUrl ~ '/awyiss/assets/favicon/favicon-32x32.png' %}
			{% if 'assets/favicon/favicon-96x96.png' is file %}
				{% set favicon = baseUrl ~ '/assets/favicon/favicon-96x96.png' %}
			{% elseif 'assets/favicon/apple-touch-icon.png' is file %}
				{% set favicon = baseUrl ~ '/assets/favicon/apple-touch-icon.png' %}
			{% elseif 'assets/favicon/favicon.svg' is file %}
				{% set favicon = baseUrl ~ '/assets/favicon/favicon.svg' %}
			{% endif %}
			<img src="{{ favicon }}" alt="Favicon">
		</div>
		<span class="SnippetTitle">{{ config.Awyiss.System.Frontend.meta.titleAppendix }}</span>
		<span class="SnippetUrl" data-base-url="{{ baseUrl }}">{{ baseUrl }} ›
			{%- if parentRecord.slug %} ... › {% endif -%} {{ page.title ?? page.slug }}

		</span>
		<span class="SnippetMetaTitle" data-default="{{ __d('Seo', 'title_empty') }}">
			{{ page.metaTitle ?? __d('Seo', 'title_empty') }}
		</span>
		<p class="SnippetMetaDescription" data-default="{{ __d('Seo', 'description_empty') }}">{{ page.metaDescription ?? __d('Seo', 'description_empty') }}</p>
	</div>
</div>