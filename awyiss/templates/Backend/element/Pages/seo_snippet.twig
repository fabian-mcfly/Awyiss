{% set metaTitlePlaceholder = page.title ~ config.Awyiss.System.Frontend.meta.titleSeparator ~ config.Awyiss.System.Frontend.meta.titleAppendix %}
<div class="ColumnSpan-6 Grid-12">
	{% block formControlMetaTitle %}
		{{ FormHelper.control('meta_title', {
			placeholder: metaTitlePlaceholder,
			templateVars: {
				additionalContent: '<span data-charcounter-name="meta_title" class="CharCounter">' ~ page.metaTitle|length ~ '</span>',
			},
			'data-charcounter-name': 'meta_title',
			'data-appendix': config.Awyiss.System.Frontend.meta.titleAppendix,
			'data-separator': config.Awyiss.System.Frontend.meta.titleSeparator,
		}) }}
	{% endblock %}

	{% block formControlMetaDescription %}
		{{ FormHelper.control('meta_description', {
			templateVars: {
				additionalContent: '<span data-charcounter-name="meta_description" class="CharCounter">' ~ page.metaDescription|length ~ '</span>',
			},
			'data-charcounter-name': 'meta_description',
		}) }}
	{% endblock %}

	{% block formControlRobotsIndex %}
		{{ FormHelper.control('robots_index', {columnSpan: 4}) }}
	{% endblock %}

	{% block formControlRobotsFollow %}
		{{ FormHelper.control('robots_follow', {columnSpan: 4}) }}
	{% endblock %}
</div>

<div class="SeoSnippet ColumnSpan-6">
	<div class="SearchData">
		<input name="search_term" class="SearchTerm">
	</div>

	<div class="LiveData">
		<output class="SnippetSearchTerm"></output>
		<div class="SnippetFavicon">
			<img src="/awyiss/assets/favicons/favicon-32x32.png" alt="Favicon">
		</div>
		<span class="SnippetTitle">{{ config.Awyiss.System.Frontend.meta.titleAppendix }}</span>
		<span class="SnippetUrl" data-base-url="{{ baseUrl }}">{{ baseUrl }} ›
			{%- if parentRecord.slug %} ... › {% endif -%} {{ page.title ?? page.slug }}

		</span>
		<span class="SnippetMetaTitle" data-default="{{ __d('seo', 'title_empty') }}">
			{{ page.meta_title ?? metaTitlePlaceholder ?? __d('seo', 'title_empty') }}
		</span>
		<p class="SnippetMetaDescription" data-default="{{ __d('seo', 'description_empty') }}">{{ page.metaDescription ?? __d('seo', 'description_empty') }}</p>
	</div>
</div>