{#
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}
{% block scriptBaseVars %}
	<script nonce="{{ AssetHelper.getScriptNonce() }}">
		const Awyiss = {{ Awyiss|json_encode|raw }};
		const baseUrl = '{{ baseUrl }}';
		const designVariables = {{ designVariables|json_encode|raw }};
		const editor = '{{ config.Awyiss.System.Backend.interface.editor }}';
		const folder = '{{ folder }}';
		const currentPath = '{{ currentPath }}';
		const currentUrl = '{{ currentUrl }}';
		const language = {{ currentLanguage|json_encode|raw }};
		const languageShortcode = '{{ languageShortcode }}';
		const userLanguage = {{ userLanguage|json_encode|raw }};
		window.exports = window.exports || {};
	</script>
{% endblock %}

{% block scriptsAdd %}
	{% do AssetHelper.addJsModule([
		'modules/AssignableTemplateElements.js',
		'modules/Audit/Audit.js',
		'modules/Audit/History.js',
		'modules/Audit/HistoryTables.js',
		'modules/Audit/Info.js',
		'modules/ButtonArea.js',
		'modules/ButtonHandler.js',
		'modules/CustomMouseEvent.js',
		'modules/DetailsHandler.js',
		'modules/DraggableSidebarToggle.js',
		'modules/EventHandler.js',
		'modules/FieldsetManager.js',
		'modules/FooterReveal.js',
		'modules/Form/BatchTextArea.js',
		'modules/Form/ColorPicker.js',
		'modules/Form/DatePicker.js',
		'modules/Form/FormLeaveConfirmation.js',
		'modules/Form/FormLock.js',
		'modules/Form/FormUpdater.js',
		'modules/Form/IdentifierAutofill.js',
		'modules/Form/InputListManager.js',
		'modules/Form/OverlayForm.js',
		'modules/Form/PasswordReveal.js',
		'modules/Form/TranslatableTexts.js',
		'modules/Media/Crop.js',
		'modules/Media/Elements.js',
		'modules/Media/Overlay.js',
		'modules/Media/Selectors.js',
		'modules/Media/Sortable.js',
		'modules/Media/ProgressChecker.js',
		'modules/Media/Upload.js',
		'modules/MultiSelect.js',
		'modules/NestedListHandler.js',
		'modules/Observer.js',
		'modules/OverflowMenu.js',
		'modules/ResizableContents.js',
		'modules/Search.js',
		'modules/SeoSnippet.js',
		'modules/TitleSetter.js',
		'Controller/' ~ controller ~ '.js',
		'Coloris/Coloris.js',
		'SortableJS/sortable.js',
	]) %}

	{% if config.Awyiss.System.Backend.interface.editor == 'jodit' %}
		<link nonce="{{ AssetHelper.getStyleNonce() }}" href="{{ baseUrl }}awyiss/assets/js/Jodit/jodit/jodit.min.css" rel="stylesheet" type="text/css">
		<script nonce="{{ AssetHelper.getScriptNonce() }}" src="{{ baseUrl }}awyiss/assets/js/Jodit/jodit/jodit.min.js"></script>
		{% do AssetHelper.addJsModule([
			'Jodit/awyiss_module.js',
			'Jodit/CustomSettings.js',
			'Jodit/Loader.js',
		]) %}
		{% do AssetHelper.add('element/jodit.css') %}
	{% elseif config.Awyiss.System.Backend.interface.editor == 'tinymce' %}
		{% do AssetHelper.addJsModule([
			'TinyMCE/CustomSettings.js',
			'TinyMCE/Loader.js',
		]) %}
		<script nonce="{{ AssetHelper.getScriptNonce() }}" src="{{ baseUrl }}awyiss/assets/js/TinyMCE/tinymce/tinymce.min.js"></script>
		{% do AssetHelper.add('element/tinymce.css') %}
	{% endif %}

	{% if isGenericPage and controller != 'Pages' %}
		{% do AssetHelper.addJsModule([
			'Controller/Pages.js',
		]) %}
	{% endif %}

	<link nonce="{{ AssetHelper.getStyleNonce() }}" href="{{ baseUrl }}awyiss/assets/js/AirDatepicker/air-datepicker.css" rel="stylesheet" type="text/css">
	<script nonce="{{ AssetHelper.getScriptNonce() }}" src="{{ baseUrl }}awyiss/assets/js/AirDatepicker/locale/{{ userLanguage.shortcode }}.js"></script>
	<script nonce="{{ AssetHelper.getScriptNonce() }}" src="{{ baseUrl }}awyiss/assets/js/AirDatepicker/air-datepicker.js"></script>
	<script nonce="{{ AssetHelper.getScriptNonce() }}">
		const AirDatepicker = window.exports.AirDatepicker;
		const airDatepickerLocale = window.exports.default;
	</script>


	{% do AssetHelper.add('main.js', {type: 'module'}) %}
{% endblock %}