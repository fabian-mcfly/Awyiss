{#
@var columnSpan string
@var element \Awyiss\Model\Entity\MediaElement
@var elementSelector \Awyiss\Model\Entity\MediaElementSelector
@var entity \Awyiss\Model\Entity
@var label string
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Awyiss\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

<div class="FormInput FormInputType-MediaSelector MediaSelector MediaSelector-Folder ColumnSpan-{{ columnSpan }}">
	<label class="Label">{{ label }}</label>

	{{ FormHelper.input('mediaAssignments.' ~ element.id ~ '.' ~ elementSelector.identifier ~ '.mediaFolderId', {
		required: false,
		type: 'text',
		value: entity.mediaAssignments[ element.identifier|variable ][ elementSelector.identifier|variable ].mediaFolderId,
	}) }}

	{{ FormHelper.hidden('mediaAssignments.' ~ element.id ~ '.' ~ elementSelector.identifier ~ '.id', {
		value: entity.mediaAssignments[ element.identifier|variable ][ elementSelector.identifier|variable ].id,
	}) }}

	<output>{{ entity.mediaAssignments[ element.identifier|variable ][ elementSelector.identifier|variable ].mediaFolder.label ?: '&nbsp;' }}</output>

	{{ FormHelper.error('mediaAssignments.' ~ element.identifier|variable ~ '.' ~ elementSelector.identifier|variable ~ '.mediaFolderId') }}
</div>