{#
@var columnSpan string
@var element \Awyiss\Model\Entity\MediaElement
@var elementSelector \Awyiss\Model\Entity\MediaElementSelector
@var entity \Awyiss\Model\Entity
@var label string
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

<div class="FormInput FormInputType-MediaSelector MediaSelector MediaSelector-MultiFile ColumnSpan-{{ columnSpan }}">
	<label class="Label">{{ label }}</label>

	<div class="MediaSelector-Preview">
		{% set mediaAssignments = entity.mediaAssignments[ element.identifier|variable ][ elementSelector.identifier|variable ] ?? [] %}
		{% for mediaAssignment in mediaAssignments %}
			{% set mediaItem = mediaAssignment.media %}
			{% set imageSizeInfo = '' %}
			{% if mediaItem.mimeType in ['image/gif', 'image/jpeg', 'image/png', 'image/webp'] or mediaItem.preview %}
				{% set imageSizeInfo = ' / ' ~ mediaItem.width ~ 'x' ~ mediaItem.height ~ 'px' %}
			{% endif %}

			<div class="Media-ListItem" title="{{ mediaItem.name }} (ID: {{ mediaItem.id }}{{ imageSizeInfo }})">
				{{ MediaHelper.preview(mediaItem, {
					class: 'Preview',
					resize: {
						width: 275,
						height: 275,
						strategy: enum(ResizeStrategy).Cover,
					},
				}) }}
				<span class="Name">{{ mediaItem.name }}</span>

				<button class="Button Button-Delete Button-Small MediaSelector-Remove" type="button">{{ __d('media', 'remove_file') }}</button>

				{{ FormHelper.hidden('media_assignments.' ~ element.id ~ '.' ~ elementSelector.identifier ~ '[]', {
					value: mediaAssignment.mediaId,
				}) }}
			</div>
		{% endfor %}

		<span class="MediaSelector-MediaSelect">{{ __d('media', 'add_files') }}</span>
	</div>

	<template>
		<button class="Button Button-Delete Button-Small MediaSelector-Remove" type="button">{{ __d('media', 'remove_file') }}</button>

		{{ FormHelper.hidden('media_assignments.' ~ element.id ~ '.' ~ elementSelector.identifier ~ '[]', {
			value: '',
		}) }}
	</template>
</div>