{#
@var columnSpan string
@var element \Awyiss\Model\Entity\MediaElement
@var elementSelector \Awyiss\Model\Entity\MediaElementSelector
@var entity \Awyiss\Model\Entity
@var label string
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{# @var mediaItem \Awyiss\Model\Entity\Media #}
{% set mediaItem = entity.mediaAssignments[ element.identifier|variable ][ elementSelector.identifier|variable ].media ?? null %}
{% set mediaFolderId = mediaItem.mediaFolderId ?? null %}
{% if entity.mediaAssignments.hiddenFolder.hiddenFolder.mediaFolderId %}
	{% set mediaFolderId = entity.mediaAssignments.hiddenFolder.hiddenFolder.mediaFolderId %}
{% endif %}

{% if entity is instanceOf('\\Awyiss\\Model\\Entity\\Content') and entity.page.mediaAssignments.hiddenFolder.hiddenFolder.mediaFolderId %}
	{% set mediaFolderId = entity.page.mediaAssignments.hiddenFolder.hiddenFolder.mediaFolderId %}
{% endif %}

<div class="FormInput FormInputType-MediaSelector MediaSelector MediaSelector-SingleFile ColumnSpan-{{ columnSpan }}">
	<label class="Label">{{ label }}</label>

	<div class="MediaSelector-Preview"{% if mediaFolderId %} data-media-folder-id="{{ mediaFolderId }}"{% endif %}>
		<span class="MediaSelector-MediaSelect">{{ __d('media', 'select_file') }}</span>

		{% if mediaItem %}
			{% set imageSizeInfo = '' %}
			{% if mediaItem.mimeType in ['image/gif', 'image/jpeg', 'image/png', 'image/webp'] or mediaItem.preview %}
				{% set imageSizeInfo = ' / ' ~ mediaItem.width ~ 'x' ~ mediaItem.height ~ 'px' %}
			{% endif %}

			<div class="Media-ListItem" title="{{ mediaItem.name }} (ID: {{ mediaItem.id }}{{ imageSizeInfo }})">
				{{ MediaHelper.preview(mediaItem, {
					class: 'Preview',
					resize: {
						width: 275,
						height: 275,
						strategy: enum(ResizeStrategy).Cover,
					},
				}) }}
				<span class="Name">{{ mediaItem.name }}</span>
			</div>
		{% endif %}
	</div>

	<button class="Button Button-Delete Button-Small MediaSelector-Remove" type="button">{{ __d('media', 'remove_file') }}</button>

	{{ FormHelper.input('media_assignments.' ~ element.id ~ '.' ~ elementSelector.identifier ~ '.media_id', {
		required: false,
		type: 'text',
		value: entity.mediaAssignments[ element.identifier|variable ][ elementSelector.identifier|variable ].mediaId,
		'data-form-updater': true,
	}) }}

	{{ FormHelper.hidden('media_assignments.' ~ element.id ~ '.' ~ elementSelector.identifier ~ '.id', {
		value: entity.mediaAssignments[ element.identifier|variable ][ elementSelector.identifier|variable ].id,
	}) }}

	{{ FormHelper.error('media_assignments.' ~ element.identifier|variable ~ '.' ~ elementSelector.identifier|variable ~ '.media_id') }}
</div>