{#
@var mediaItem \Awyiss\Model\Entity\Media
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Awyiss\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% block mediaPreview %}
	<div class="{{ class }}"{% if id is defined %} id="{{ id }}"{% endif %}>
		{% if mediaItem.preview == enum(ProcessStatus).Fail %}
			<span class="FileType-Icon FileType-Icon-{{ mediaItem.extension|camelize('/') }}" data-extension="{{ mediaItem.extension }}"></span>
		{% elseif mediaItem.mimeType == 'image/svg+xml' %}
			<img src="{{ baseUrl }}{{ mediaItem.path }}?t={{ mediaItem.filemtime }}" alt="{{ mediaItem.name }}">
		{% else %}
			{% if resize.width is defined or resize.height is defined %}
				{% set resizedMediaItem = MediaHelper.resize(mediaItem, null, resize.width, resize.height, null, resize.strategy) %}
			{% endif %}

			{# @var resizedMediaItem \Awyiss\Model\Entity\MediaResizedImage #}
			{% if resizedMediaItem %}
				{% if resizedMediaItem.status == enum(ProcessStatus).Success %}
					<img src="{{ baseUrl }}{{ resizedMediaItem.path }}?t={{ resizedMediaItem.filemtime }}" alt="{{ resizedMediaItem.media.name }}">
				{% else %}
					<span
						class="FileType-Icon FileType-Icon-{{ resizedMediaItem.media.extension|camelize('/') }}
						{%- if resizedMediaItem.status != enum(ProcessStatus).Fail %} AwaitingResize{% endif %}" data-extension="{{ resizedMediaItem.media.extension }}">
						{% block mediaPreviewNoImageAwaitingResize %}
							{%- if resizedMediaItem.status != enum(ProcessStatus).Fail %}
								<img data-src="{{ baseUrl }}{{ resizedMediaItem.path }}?t={{ resizedMediaItem.filemtime }}" alt="{{ resizedMediaItem.media.name }}" id="AwaitingResize{{ resizedMediaItem.id }}">
							{% endif %}
						{% endblock %}
					</span>
				{% endif %}
			{% else %}
				{% if mediaItem.isImage() %}
					{% block mediaPreviewNativeImage %}
						<img src="{{ baseUrl }}{{ mediaItem.path }}?t={{ mediaItem.filemtime }}" alt="{{ mediaItem.name }}">
					{% endblock %}
				{% elseif mediaItem.preview == enum(ProcessStatus).Success %}
					{% block mediaPreviewPreviewImage %}
						<img src="{{ baseUrl }}{{ mediaItem.previewPath }}?t={{ mediaItem.previewFilemtime }}" alt="{{ mediaItem.name }}">
					{% endblock %}
				{% else %}
					{% block mediaPreviewNoImage %}
						<span class="FileType-Icon FileType-Icon-{{ mediaItem.extension|camelize('/') }}
							{%- if mediaItem.preview != enum(ProcessStatus).Fail %} AwaitingPreview{% endif %}" data-extension="{{ mediaItem.extension }}">
							{% block mediaPreviewNoImageAwaitingPreview %}
								{%- if mediaItem.preview != enum(ProcessStatus).Fail %}
									<img data-src="{{ baseUrl }}{{ mediaItem.previewPath }}?t={{ mediaItem.previewFilemtime }}" alt="{{ mediaItem.name }}" id="AwaitingPreview{{ mediaItem.id }}">
								{% endif %}
							{% endblock %}
						</span>
					{% endblock %}
				{% endif %}

			{% endif %}
		{% endif %}
	</div>
{% endblock %}