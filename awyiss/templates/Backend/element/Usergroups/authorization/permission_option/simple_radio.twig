{#
@var permission \Awyiss\Authorization\PermissionOptions\SimplePermissionOption
@var entity \Awyiss\Model\Entity\Usergroup|null
@var identifier string
@var scope string
@var _view \Awyiss\View\BackendView
#}

{% block permissionOptions %}
	{% set fieldName = 'permissions[' ~ scope ~ '][' ~ identifier ~ ']' %}
	{% set label = 'Permissions-' ~ scope|camelize ~ '-' ~ identifier|camelize %}
	{% set value = entity.usergroup_permissions[ scope ][ identifier ].access ?? null %}
	{% set options = permission.getOptions %}

	<span class="Options SimpleRadio">
		{% block optionGranted %}
			<input type="radio" name="{{ fieldName }}" value="{{ options.granted.value }}"
				{{ value is same as (options.granted) ? 'checked="checked"' : '' }}
				id="{{ label ~ '-' ~ options.granted.value }}">
		{% endblock %}

		{% block optionIndifferent %}
			<input type="radio" name="{{ fieldName }}" value="{{ options.indifferent }}"
				{{ value is same as (options.indifferent) ? 'checked="checked"' : '' }}
				id="{{ label }}">
		{% endblock %}

		{% block optionDenied %}
			<input type="radio" name="{{ fieldName }}" value="{{ options.denied.value }}"
				{{ value is same as (options.denied) ? 'checked="checked"' : '' }}
				id="{{ label ~ '-' ~ options.denied.value }}">
		{% endblock %}

		{% block optionsLabels %}
			<span class="Labels">
				{% block optionsLabelsInner %}
					{% block optionGrantedLabel %}
						<label for="{{ label ~ '-' ~ options.granted.value }}">
							{{ __d('authorization', 'simple_permission_option_granted') }}
						</label>
					{% endblock %}

					{% block optionIndifferentLabel %}
						<label for="{{ label }}">
							{{ __d('authorization', 'simple_permission_option_indifferent') }}
						</label>
					{% endblock %}

					{% block optionDeniedLabel %}
						<label for="{{ label ~ '-' ~ options.denied.value }}">
							{{ __d('authorization', 'simple_permission_option_denied') }}
						</label>
					{% endblock %}
				{% endblock %}
			</span>
		{% endblock %}
	</span>
{% endblock %}
