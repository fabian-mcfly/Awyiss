{#
@var permission \Awyiss\Authorization\PermissionOptions\SimplePermissionOption
@var entity \Awyiss\Model\Entity\Usergroup|null
@var identifier string
@var scope string
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% block permissionOptions %}
	{% set fieldName = 'permissions[' ~ scope ~ '][' ~ identifier ~ ']' %}
	{% set label = 'Permissions-' ~ scope|camelize ~ '-' ~ identifier|camelize %}
	{% set value = entity.usergroup_permissions[ scope ][ identifier ].access ?? null %}
	{% set options = permission.getOptions %}

	<span class="Options SimpleRadio">
		{% block optionDenied %}
			<input type="radio" name="{{ fieldName }}" value="{{ options.denied.value }}"
				{{ value is same as (options.denied) ? 'checked="checked"' : '' }}
				id="{{ label ~ '-' ~ options.denied.value }}">
		{% endblock %}

		{% block optionIndifferent %}
			<input type="radio" name="{{ fieldName }}" value="{{ options.indifferent }}"
				{{ value is same as (options.indifferent) ? 'checked="checked"' : '' }}
				id="{{ label }}">
		{% endblock %}

		{% block optionGranted %}
			<input type="radio" name="{{ fieldName }}" value="{{ options.granted.value }}"
				{{ value is same as (options.granted) ? 'checked="checked"' : '' }}
				id="{{ label ~ '-' ~ options.granted.value }}">
		{% endblock %}

		{% block optionsLabels %}
			<span class="Labels">
				{% block optionsLabelsInner %}
					{% block optionDeniedLabel %}
						<label for="{{ label ~ '-' ~ options.denied.value }}" title="{{ __d('authorization', 'simple_permission_option_denied') }}">
							{{ __d('authorization', 'simple_permission_option_denied') }}
						</label>
					{% endblock %}

					{% block optionIndifferentLabel %}
						<label for="{{ label }}" title="{{ __d('authorization', 'simple_permission_option_indifferent') }}">
							{{ __d('authorization', 'simple_permission_option_indifferent') }}
						</label>
					{% endblock %}

					{% block optionGrantedLabel %}
						<label for="{{ label ~ '-' ~ options.granted.value }}" title="{{ __d('authorization', 'simple_permission_option_granted') }}">
							{{ __d('authorization', 'simple_permission_option_granted') }}
						</label>
					{% endblock %}
				{% endblock %}
			</span>
		{% endblock %}
	</span>
{% endblock %}
