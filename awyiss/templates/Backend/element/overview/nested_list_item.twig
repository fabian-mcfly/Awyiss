{#
@var entity \Awyiss\Model\Entity
@var childrenList string
@var settings array
@var _view \Awyiss\View\BackendView
@var TimeHelper \Cake\View\Helper\TimeHelper
#}

{% set categories = [] %}
{% if _categoriesIdentifier is defined and _categories[ _categoriesIdentifier|pluralize|variable ] is defined %}
	{% set categories = _categories[ _categoriesIdentifier|pluralize|variable ] %}
{% endif %}

{% block nestedListItem %}
	<li
		{% block nestedListItemId -%}
			id="{{ settings.identifier|pluralize }}-ListItem{{ entity.id }}"
		{%- endblock %}
		{% block nestedListItemClass -%}
			class="ListItem {{ settings.identifier }}-ListItem {{ settings.identifier }}-ListItem{{ entity.id -}}
				{%- if entity.class is defined %} {{ entity.class }}{% endif -%}
				{%- if entity.active is defined and entity.active == false %} Inactive{% endif -%}

				{%- if entity.parentsActive is defined and entity.parentsActive == false %} ParentsInactive
				{%- elseif settings.parentsActive is defined and settings.parentsActive == false %} ParentsInactive{% endif -%}
				{%- if entity.isPublished() is same as false %} NotPublished{% endif %}
			"
		{%- endblock %}
		{% block nestedListItemTitle -%}
			title="{{ entity.title }}"
		{%- endblock %}
		>
		{% block nestedListItemInner %}
			<div {% block nestedListItemInnerClass %}class="{{ settings.identifier }}-ListItem-Inner ListItem-Inner"{% endblock %}>
				{% block nestedListItemData %}
					<ul class="Data">
						{% block nestedListItemDataTitle %}
							<li class="Title">{{ entity.title }}</li>
						{% endblock %}

						{% block nestedListItemDataDefaultFields %}{% endblock %}

						{% block nestedListItemDataDisplayedFields %}
							{% for field in displayedFields %}
								{% if field == 'system_order' %}
								{% else %}
									{% block nestedListItemDataDisplayedField %}
										<li class="DataItem DataItem-{{ field|camelize }}">
											{% if field starts with 'attributes.' %}
												{% set field = field|slice(11)|underscore %}
												{% block nestedListItemDataDisplayedFieldAttribute %}
													{% block nestedListItemDataDisplayedFieldAttributeLabel %}
														<span class="Label">{{ attributes[field].label }}:</span>
													{% endblock %}
													{% block nestedListItemDataDisplayedFieldAttributeValue %}
														{% if attributes[field].inputType in ['date', 'datetime', 'time'] and entity.has('attributes') and entity.attributes.has(field) %}
															{% if attributes[field].inputType == 'datetime' %}
																{{ TimeHelper.nice(entity.attributes.get(field)) }}
															{% else %}
																{{ TimeHelper.i18nFormat(entity.attributes.get(field), attributes[field].inputType == 'date' ? dateFormat : timeFormat) }}
															{% endif %}
														{% else %}
															{{ entity.attributes.get(field) ?: '-' }}
														{% endif %}
													{% endblock %}
												{% endblock %}
											{% else %}
												{% set field = field|underscore %}
												{% block nestedListItemDataDisplayedFieldDefault %}
													{% block nestedListItemDataDisplayedFieldDefaultLabel %}
														<span class="Label">{{ i18nDomain ? __df(i18nDomain, 'system', field) :	__(field) }}:</span>
													{% endblock %}
													{% block nestedListItemDataDisplayedFieldDefaultValue %}
														{% if field == 'language_shortcode' %}
															{{ entity.get(field) ? languages.Frontend[ entity.get(field) ].title : '-' }}
														{% elseif field == 'content_template_id' %}
															{% if entity.contentTemplate is defined  %}
																{{ entity.contentTemplate.label }}
															{% elseif contentTemplates[ entity.get(field) ] is defined %}
																{{ contentTemplates[ entity.get(field) ].label}}
															{% else %}
																-
															{% endif %}
														{% elseif field == 'email_template_id' %}
															{% if entity.emailTemplate is defined  %}
																{{ entity.emailTemplate.label }}
															{% elseif emailTemplates[ entity.get(field) ] is defined %}
																{{ emailTemplates[ entity.get(field) ].label}}
															{% else %}
																-
															{% endif %}
														{% elseif field == 'page_template_id' %}
															{% if entity.pageTemplate is defined  %}
																{{ entity.pageTemplate.label }}
															{% elseif pageTemplates[ entity.get(field) ] is defined %}
																{{ pageTemplates[ entity.get(field) ].label}}
															{% else %}
																-
															{% endif %}
														{% elseif field == 'widget_template_id' %}
															{% if entity.widgetTemplate is defined  %}
																{{ entity.widgetTemplate.label }}
															{% elseif widgetTemplates[ entity.get(field) ] is defined %}
																{{ widgetTemplates[ entity.get(field) ].label}}
															{% else %}
																-
															{% endif %}
														{% elseif field in ['created_on', 'changed_on'] %}
															{{ entity.has(field) ? TimeHelper.nice(entity.get(field)) ?: '-' }}
														{% elseif categories.config.field and field == categories.config.field|underscore %}
															{{ entity.has(field) ? (categories.simple[ entity.get(field) ] ?? '-') : '-' }}
														{% else %}
															{% set value = entity.has(field) ? entity.get(field) : '-' %}

															{% if value is same as true or value is same as 'true' %}
																<i class="las la-check">{{ __('true') }}</i>
															{% elseif value is same as false or value is same as 'false' %}
																<i class="las la-times">{{ __('false') }}</i>
															{% else %}
																{{ value }}
															{% endif %}
														{% endif %}
													{% endblock %}
												{% endblock %}
											{% endif %}
										</li>
									{% endblock %}
								{% endif %}
							{% endfor %}
						{% endblock %}
					</ul>
				{% endblock %}

				{% block nestedListItemAuditInfo %}
					<div class="AuditInfo" data-id="{{ entity.id }}" title="">
						{% block nestedListItemAuditInfoList %}
							<ul class="AuditInfoList">
								<li><strong>ID:</strong> {{ entity.id }}</li>
							</ul>
						{% endblock %}
					</div>
				{% endblock %}

				{% block nestedListActions %}
					<span class="Actions">
						{% block nestedListActionsGallery %}
							{% if entity.mediaAssignments.hiddenFolder.hiddenFolder %}
								{{ HtmlHelper.link(__('view_gallery'), {controller: 'media', action: 'overview', mediaFolderId: entity.mediaAssignments.hiddenFolder.hiddenFolder.mediaFolderId}, {
									class: 'Button Button-Small Button-View',
									'data-media-folder-id': entity.mediaAssignments.hiddenFolder.hiddenFolder.mediaFolderId,
								}) }}
							{% endif %}
						{% endblock %}

						{% block nestedListActionsEdit %}
							{% if AuthorizationHelper.isAccessible('update') %}
								{{ HtmlHelper.link(__('edit'), {action: 'edit', id: entity.id}, {class: 'Button Button-Small Button-Edit'}) }}
							{% endif %}
						{% endblock %}

						{% block nestedListActionsDelete %}
							{% if AuthorizationHelper.isAccessible('delete') %}
								{{ HtmlHelper.link(i18nDomain ? __df(i18nDomain, 'system', 'delete') : __('delete'), {action: 'delete', id: entity.id}, {
									class: 'Button Button-Small Button-Delete',
									'data-confirm-title': i18nDomain ? __df(i18nDomain, 'system', 'confirm_delete_title') : __('confirm_delete_title'),
									'data-confirm-yes': i18nDomain ? __df(i18nDomain, 'system', 'confirm_delete_yes') : __('confirm_delete_yes'),
									'data-confirm-yes-class': 'Button-Delete',
									'data-confirm-no': i18nDomain ? __df(i18nDomain, 'system', 'confirm_delete_no') : __('confirm_delete_no'),
									'data-confirm': i18nDomain ? __df(i18nDomain, 'system', 'confirm_delete', entity.id) : __('confirm_delete', entity.id) }) }}
							{% endif %}
						{% endblock %}
					</span>
				{% endblock %}
			</div>
		{% endblock %}

		{% block nestedListChildren %}
			{{ childrenList }}
		{% endblock %}
	</li>
{% endblock %}
