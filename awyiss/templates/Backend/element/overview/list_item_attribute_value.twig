{#
@var records Cake\Datasource\EntityInterface[]
@var entity Cake\Datasource\EntityInterface
@var field string
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% if attributes[field].inputType in ['date', 'datetime', 'time'] and entity.has('attributes') and entity.attributes.has(field) %}
	{% if attributes[field].inputType == 'datetime' %}
		{{ TimeHelper.nice(entity.attributes.get(field)) }}
	{% else %}
		{{ TimeHelper.i18nFormat(entity.attributes.get(field), attributes[field].inputType == 'date' ? dateFormat : timeFormat) }}
	{% endif %}
{% elseif _categoriesIdentifier is defined and _categoriesIdentifier|underscore == field %}
	{{ entity.attributes.has(field) ? (categories.simple[ entity.get(field) ] ?? '-') : '-' }}
{% else %}
	{% set value = entity.attributes.has(field) ? entity.attributes.get(field) : '-' %}

	{% if if attributes[field].inputType == 'checkbox' and (value is same as true or value is same as 'true') %}
		<i class="las la-check">{{ __('true') }}</i>
	{% elseif if attributes[field].inputType == 'checkbox' and (value is same as false or value is same as 'false') %}
		<i class="las la-times">{{ __('false') }}</i>
	{% elseif (value is enum) %}
		{{ value.name }}
	{% else %}
		{{ value }}
	{% endif %}
{% endif %}