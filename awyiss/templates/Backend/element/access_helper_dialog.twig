{% block accessHelperDialog %}
	<dialog id="AccessHelperDialog" data-title="{{ __d('System', 'access_helper_dialog_title') }}">
		<div class="FormInput FormInputType-Select FormInputName-AccessHelperScope">
			<label class="Label" for="DashboardElement-AccessHelperScope">{{ __d('System', 'access_helper_dialog_label_scope') }}</label>
			<select
					name="accessHelper[scope]" id="DashboardElement-AccessHelperScope"
					data-filter-placeholder="{{ __d('System', 'select_filter_placeholder') }}"
					data-empty-label="{{ __d('System', 'select_empty_label') }}"
			></select>
		</div>

		<div class="FormInput FormInputType-Select FormInputName-AccessHelperPermission">
			<label class="Label" for="DashboardElement-AccessHelperPermission">{{ __d('System', 'access_helper_dialog_label_permission') }}</label>
			<select
					name="accessHelper[permission]" id="DashboardElement-AccessHelperPermission"
					data-filter-placeholder="{{ __d('System', 'select_filter_placeholder') }}"
					data-empty-label="{{ __d('System', 'select_empty_label') }}"
			></select>
		</div>

		<button id="AccessHelperDialog-Button-Apply" class="Button Button-Success Button-Save Button-Apply">
			{{ __d('System', 'access_helper_dialog_confirm_apply') }}
		</button>

		<button id="AccessHelperDialog-Button-Cancel" class="Button Button-Cancel Button-Close">
			{{ __d('System', 'access_helper_dialog_confirm_cancel') }}
		</button>
	</dialog>
{% endblock %}