{% extends '@Backend/element/overview/overview_paginated_list.twig' %}

{% block tableOverviewHeaderDefaultFields %}
	<th class="TableHeader-UsedForWidgets{% if PaginatorHelper.isCurrentSortKey('usedForWidgets') %} Active{% endif %}">{{ PaginatorHelper.sort('usedForWidgets') }}</th>
{% endblock %}

{% block tableOverviewCellDefaultFields %}
	<td class="TableCell-UsedForWidgets">{{ entity.usedForWidgets }}</td>
{% endblock %}

{% block tableOverviewCellActionsDelete %}
	{% if entity.usedForWidgets == 0 %}
		{{ parent() }}
	{% else %}
		{% if AuthorizationHelper.isAccessible('delete') %}
			<!--suppress HtmlUnknownAttribute -->
			<a class="Button Button-Small Button-Delete" disabled>{{ __('delete') }}</a>
		{% endif %}
	{% endif %}
{% endblock %}

{% block tableOverviewFootColSpan %}{{ localConfig.overview.displayedFields|length + 5 }}{% endblock %}
