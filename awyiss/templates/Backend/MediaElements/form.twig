{#
@var mediaElement \Awyiss\Model\Entity\MediaElement
@var mediaSelectors \Awyiss\Model\Entity\MediaSelector[]
@var assignableModels array
@var columnSpans array
@var languageRealm string
@var systemOrderField string
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% set entities = combine(assignableModels|keys, assignableModels|map(assignableModel => assignableModel.entities)) %}

{{ FormHelper.create(mediaElement, {method: 'post', id: 'MediaElementForm', idPrefix: 'mediaElement'}) }}
<input type="hidden" name="attributes" value="">

{% set fieldsetGeneral %}
	{% block fieldsetGeneral %}
		<fieldset class="Fieldset-General">
			<legend>{{ __('fieldset_general') }}</legend>

			{% block fieldsetGeneralInner %}
				{% block formControlTitle %}
					{{ FormHelper.control('title') }}
				{% endblock %}

				{% block formControlIdentifier %}
					{{ FormHelper.control('identifier', {'data-autofill-from': 'title'}) }}
				{% endblock %}

				{% block fieldsetGeneralAttributes %}
					{{ AttributesHelper.allControls('general') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetMediaSelectors %}
	{% block fieldsetMediaSelectors %}
		<fieldset class="Fieldset-MediaSelectors">
			<legend>{{ __('fieldset_media_selectors') }}</legend>
			{% block fieldsetMediaSelectorsInner %}
				{% block formControlMediaSelectors %}
					<div
							class="FormInput FormInputType-List FormInputName-MediaElementSelectors" data-list-item-add="{{ __('list_item_add') }}"
							data-list-item-remove="{{ __('list_item_remove') }}">

						{% set mediaSelectors = combine(mediaSelectors|keys, mediaSelectors|map(mediaSelector => mediaSelector.label)) %}

						{% set counter = 0 %}
						{% for key, mediaElementSelector in mediaElement.mediaElementSelectors %}
							<div class="FormInputType-ListItem">
								{{ FormHelper.hidden('media_element_selectors.' ~ counter ~ '.id', {
									val: mediaElementSelector.id,
								}) }}
								{{ FormHelper.control('media_element_selectors.' ~ counter ~ '.media_selector_id', {
									options: mediaSelectors,
									required: true,
								}) }}

								{{ FormHelper.control('media_element_selectors.' ~ counter ~ '.title', {
									required: true,
									type: languages.Backend|filter(language => language.active)|length > 1 ? 'translatableText' : null,
									templateVars: {
										dialogTitle: __d('system', 'translations_dialog_title', __('title')),
									},
								}) }}

								{{ FormHelper.control('media_element_selectors.' ~ counter ~ '.identifier', {
									required: true,
									'data-autofill-from': 'title',
								}) }}

								{{ FormHelper.control('media_element_selectors.' ~ counter ~ '.column_span', {
									options: columnSpans,
									required: true,
								}) }}

								<div class="AdditionalOptions">
									{{ FormHelper.control('media_element_selectors.' ~ counter ~ '.required', {
										checked: mediaElementSelector.required,
										type: checkbox,
									}) }}
								</div>
								{% set counter = counter + 1 %}
							</div>
						{% endfor %}

						<div class="FormInputType-ListItem FormInputType-ListItem-Default">
							{{ FormHelper.hidden('media_element_selectors.' ~ counter ~ '.id', {
								val: '',
							}) }}
							{{ FormHelper.control('media_element_selectors.' ~ counter ~ '.media_selector_id', {
								options: mediaSelectors,
								required: false,
								val: '',
							}) }}

							{{ FormHelper.control('media_element_selectors.' ~ counter ~ '.title', {
								required: false,
								type: languages.Backend|filter(language => language.active)|length > 1 ? 'translatableText' : null,
							}) }}

							{{ FormHelper.control('media_element_selectors.' ~ counter ~ '.identifier', {
								required: false,
								'data-autofill-from': 'title',
							}) }}

							{{ FormHelper.control('media_element_selectors.' ~ counter ~ '.column_span', {
								options: columnSpans,
								required: false,
								val: '',
							}) }}

							<div class="AdditionalOptions">
								{{ FormHelper.control('media_element_selectors.' ~ counter ~ '.required', {
									type: checkbox,
								}) }}
							</div>
						</div>
					</div>
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetAssignableModels %}
	{% block fieldsetAssignableModels %}
		<fieldset class="Fieldset-AssignableModels">
			<legend>{{ __('fieldset_assignable_models') }}</legend>
			{% block fieldsetAssignableModelsInner %}
				{% block formControlAssignableModels %}
					<div
							class="FormInput FormInputType-List FormInputName-MediaCompAssignableModels" data-list-item-add="{{ __('list_item_add') }}"
							data-list-item-remove="{{ __('list_item_remove') }}">

						{% set models = combine(assignableModels|keys, assignableModels|map(assignableModel => assignableModel.label)) %}

						{% set counter = 0 %}
						{% for key, mediaElementAssignment in mediaElement.mediaElementAssignments %}
							<div class="FormInputType-ListItem">
								{{ FormHelper.hidden('media_element_assignments.' ~ counter ~ '.id', {
									val: mediaElementAssignment.id,
								}) }}

								{{ FormHelper.control('media_element_assignments.' ~ counter ~ '.scope', {
									options: models,
									required: false,
								}) }}

								{{ FormHelper.control('media_element_assignments.' ~ counter ~ '.foreign_key', {
									disabled: entities[ mediaElementAssignment.scope ]|length == 0,
									options: entities[ mediaElementAssignment.scope ],
									required: false,
								}) }}
							</div>
							{% set counter = counter + 1 %}
						{% endfor %}

						<div class="FormInputType-ListItem FormInputType-ListItem-Default">
							{{ FormHelper.hidden('media_element_assignments.' ~ counter ~ '.id', {
								val: '',
							}) }}

							{{ FormHelper.control('media_element_assignments.' ~ counter ~ '.scope', {
								options: models,
								required: false,
								val: '',
							}) }}

							{{ FormHelper.control('media_element_assignments.' ~ counter ~ '.foreign_key', {
								disabled: true,
								options: [],
								required: false,
								val: '',
							}) }}
						</div>
					</div>
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetContent %}
	{% block fieldsetContent %}
		<fieldset class="Fieldset-Content">
			<legend>{{ __('fieldset_content') }}</legend>

			{% block fieldsetContentInner %}
				{% block fieldsetContentAttributes %}
					{{ AttributesHelper.allControls('content') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetPresentation %}
	{% block fieldsetPresentation %}
		<fieldset class="Fieldset-Presentation">
			<legend>{{ __('fieldset_presentation') }}</legend>

			{% block fieldsetPresentationInner %}
				{% block formControlActive %}
					{{ FormHelper.control('active') }}
				{% endblock %}

				{% block formControlColumnSpan %}
					{{ FormHelper.control('column_span', {disabled: columnSpanDisabled, empty: false, options: columnSpans, type: 'select'}) }}
				{% endblock %}

				{% block fieldsetPresentationAttributes %}
					{{ AttributesHelper.allControls('presentation') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetConditions %}
	{% block fieldsetConditions %}
		<fieldset class="Fieldset-Conditions">
			<legend>{{ __('fieldset_conditions') }}</legend>

			{% block fieldsetConditionsInner %}
				{% block formControlSystemOrder %}
					{% if systemOrderField|variable == 'systemOrder' %}
						{{ SystemOrderHelper.control('system_order') }}
					{% endif %}
				{% endblock %}

				{% block fieldsetConditionsAttributes %}
					{{ AttributesHelper.allControls('conditions') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetAttributes %}
	{% block fieldsetAttributes %}
		<fieldset class="Fieldset-Attributes">
			<legend>{{ __('fieldset_attributes') }}</legend>

			{% block fieldsetAttributesInner %}
				{% block fieldsetAttributesAttributes %}
					{{ AttributesHelper.allControls('attributes') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% block sidebarToggle %}
	{% if config.Awyiss.System.Backend.interface.sidebarMode == true and isOverlayForm != true %}
		{{ FormHelper.button(__('sidebar_toggle'), {class: 'Button Button-Configure', id: 'Sidebar-Toggle', name: 'button', type: 'button'}) }}
	{% endif %}
{% endblock %}

{% block fieldsets %}
	<div class="Fieldsets">
		{% if config.Awyiss.System.Backend.interface.sidebarMode != true or isOverlayForm == true %}
			{{ fieldsetPresentation }}
			{{ fieldsetConditions }}
			{{ fieldsetGeneral }}
			{{ fieldsetMediaSelectors }}
			{{ fieldsetAssignableModels }}
			{{ fieldsetContent }}
			{{ fieldsetAttributes }}
		{% endif %}

		{% block mainFieldsets %}
			{% if config.Awyiss.System.Backend.interface.sidebarMode == true and isOverlayForm != true %}
				<div class="Main-Fieldsets">
					{{ fieldsetGeneral }}
					{{ fieldsetMediaSelectors }}
					{{ fieldsetAssignableModels }}
					{{ fieldsetContent }}
				</div>
			{% endif %}
		{% endblock %}

		{% block sidebarFieldsets %}
			{% if config.Awyiss.System.Backend.interface.sidebarMode == true and isOverlayForm != true %}
				<div class="Sidebar-Fieldsets">
					{{ fieldsetPresentation }}
					{{ fieldsetConditions }}
					{{ fieldsetAttributes }}
				</div>
			{% endif %}
		{% endblock %}

		{% block formInputReloadForm %}
			{{ FormHelper.hidden('reload_form', {val: 0}) }}
		{% endblock %}
	</div>
{% endblock %}

{% block lockDialog %}
	{{ element('lock_dialog', {entity: mediaElement}) }}
{% endblock %}

{{ FormHelper.end() }}

{% block scriptAssignableModelVars %}
	<script nonce="{{ AssetHelper.getScriptNonce() }}">
		const assignableModelEntities = {{ entities|jsonEncode|raw }};
	</script>
{% endblock %}