{% extends '@Backend/element/overview/overview_paginated_list.twig' %}

{% block tableOverviewCellActions %}
	<td class="TableCell-Actions">
		<div class="Actions">
			{% block tableOverviewCellActionsAnalyze %}
				{{ HtmlHelper.link(i18nDomain ? __df(i18nDomain, 'System', 'analyze') : __('analyze'), {action: 'analyze', id: entity.id}, {class: 'Button Button-Small Button-Analyze'}) }}
			{% endblock %}

			{% block tableOverviewCellActionsDiagram %}
				{{ HtmlHelper.link(i18nDomain ? __df(i18nDomain, 'System', 'show_diagram') : __('show_diagram'), {action: 'diagram', id: entity.id}, {class: 'Button Button-Small Button-Diagram Button-ShowDiagram'}) }}
			{% endblock %}

			{{ block('tableOverviewCellActionsGallery') }}

			{{ block('tableOverviewCellActionsUpdate') }}

			{{ block('tableOverviewCellActionsDelete') }}
		</div>
	</td>
{% endblock %}