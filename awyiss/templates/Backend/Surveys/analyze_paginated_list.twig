{% extends '@Backend/element/overview/overview_paginated_list.twig' %}

{% block tableOverviewHeaderTitle %}{% endblock %}
{% block tableOverviewHeaderDisplayedFields %}
	<th class="TableHeader-CreatedOn{% if PaginatorHelper.isCurrentSortKey('createdOn') %} Active{% endif %}">
		{{ PaginatorHelper.sort('createdOn', i18nDomain ? __df(i18nDomain, 'system', 'created_on') : __('created_on')) }}
	</th>
{% endblock %}
{% block tableOverviewHeaderAuditInfo %}{% endblock %}

{% block tableOverviewCellTitle %}
	<td class="TableCell-CreatedOn">{{ entity.has('createdOn') ? TimeHelper.nice(entity.get('createdOn')) ?: '-' }}</td>
{% endblock %}

{% block tableOverviewCellDisplayedFields %}{% endblock %}
{% block tableOverviewCellAuditInfo %}{% endblock %}
{% block listControlListLimitInner %}{% endblock %}

{% block tableOverviewFootColSpan %}3{% endblock %}

{% block tableOverviewCellActions %}
	<td class="TableCell-Actions">
		<div class="Actions">
			{% block tableAnalyzeCellActionsDiagram %}
				{{ HtmlHelper.link(i18nDomain ? __df(i18nDomain, 'system', 'show_diagram') : __('show_diagram'), {
					action: 'diagram',
					id: entity.surveyId,
					entryId: entity.id,
				}, {class: 'Button Button-Small Button-Diagram Button-ShowDiagram'}) }}
			{% endblock %}
		</div>
	</td>
{% endblock %}