{% block answersListItemCustomAnswer %}
	{% if entity.allowCustomAnswer is defined or answerType == 'available' %}
		<li class="Answers-ListItem Answers-ListItem-CustomAnswer">
			{% block answersListItemCustomAnswerInner %}
				<div class="Answers-ListItem-Inner">
					{% block answersListItemCustomAnswerLabel %}
						<span class="Label">{{ __('allow_custom_answer') }}</span>
					{% endblock %}

					{% block answersListItemActions %}
						<span class="Actions">
							{% block answersListItemRemove %}
								{{ FormHelper.button(__('remove_answer'), {
									class: 'Button Button-Small Button-Delete',
									type: 'button',
									'data-confirm-title': __d('SurveyAnswers', 'confirm_delete_title'),
									'data-confirm-yes': __d('SurveyAnswers', 'confirm_delete_yes'),
									'data-confirm-yes-class': 'Button-Delete',
									'data-confirm-no': __d('SurveyAnswers', 'confirm_delete_no'),
									'data-confirm': __d('SurveyAnswers', 'confirm_delete', entity.id)
								}) }}
							{% endblock %}
						</span>
					{% endblock %}

					{% block answersListItemInputs %}
						{{ FormHelper.control('surveySurveyQuestions[' ~ index ~'][allowCustomAnswer]', {
							checked: entity.allowCustomAnswer == true,
							disabled: answerType == 'available',
							type: 'checkbox',
						}) }}
					{% endblock %}
				</div>
			{% endblock %}
		</li>
	{% endif %}
{% endblock %}
