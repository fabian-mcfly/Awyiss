{#
@var survey \Awyiss\Model\Entity\Survey
@var availableActions \Awyiss\Model\Enum\Survey\NextAction[]
@var availableForms \Awyiss\Model\Entity\Form[]
@var availableQuestions \Awyiss\Model\Entity\SurveyQuestion[]
@var nextActionEnum class-string<\Awyiss\Model\Enum\Survey\NextAction>
@var finalActions array<string, string>
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Awyiss\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{{ FormHelper.create(survey, {id: 'SurveyForm', idPrefix: 'survey', method: 'post'}) }}
<input type="hidden" name="attributes" value="">

{% set fieldsetGeneral %}
	{% block fieldsetGeneral %}
		<fieldset class="Fieldset-General">
			<legend>{{ __('fieldset_general') }}</legend>

			{% block fieldsetGeneralInner %}
				{% block formControlTitle %}
					{{ FormHelper.control('title', {columnSpan: 6}) }}
				{% endblock %}

				{% block formControlIdentifier %}
					{{ FormHelper.control('identifier', {columnSpan: 6, 'data-autofill-from': 'title'}) }}
				{% endblock %}

				{% block formControlSuccessMessage %}
					{{ FormHelper.control('successMessage', {'data-editor': true}) }}
				{% endblock %}

				{% block formControlFailureMessage %}
					{{ FormHelper.control('failureMessage', {'data-editor': true}) }}
				{% endblock %}

				{% block fieldsetGeneralAttributes %}
					{{ AttributesHelper.allControls('general') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetContent %}
	{% block fieldsetContent %}
		<fieldset class="Fieldset-Content">
			<legend>{{ __('fieldset_content') }}</legend>

			{% block fieldsetContentInner %}
				{% block fieldsetContentAttributes %}
					{{ AttributesHelper.allControls('content') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetQuestionsAssigned %}
	{% block fieldsetQuestionsAssigned %}
		<fieldset class="Fieldset-Questions-Assigned">
			<legend>{{ __('fieldset_questions_assigned') }}</legend>

			{% block fieldsetQuestionsAssignedInner %}
				{% from '@Backend/macro/nested_list.twig' import nestedList %}
				{{ nestedList(survey.surveySurveyQuestions, _context|merge({
					identifier: 'AssignedQuestions',
					template: '@Backend/Surveys/form_question_list_item_assigned.twig',
					data: {
						nestable: false,
						'next-index': availableQuestions|length + survey.surveySurveyQuestions|length,
						'repeated-questions': survey.type == enum('Awyiss\\Model\\Enum\\Survey\\Type').Configurator,
					},
				})) }}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetMedia %}
	{% block fieldsetMedia %}
		<fieldset class="Fieldset-Media">
			<legend>{{ __('fieldset_media') }}</legend>

			{% block fieldsetMediaInner %}
				{{ cell('Backend/MediaElements', [survey]) }}

				{% block fieldsetMediaAttributes %}
					{{ AttributesHelper.allControls('media') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetMediaElementAssignments %}
	{% block fieldsetMediaElementAssignments %}
		{{ cell('Backend/MediaElements::elementAssignments', [survey]) }}
	{% endblock %}
{% endset %}

{% set fieldsetPresentation %}
	{% block fieldsetPresentation %}
		<fieldset class="Fieldset-Presentation">
			<legend>{{ __('fieldset_presentation') }}</legend>

			{% block fieldsetPresentationInner %}
				{% block formControlActive %}
					{{ FormHelper.control('active') }}
				{% endblock %}

				{% block fieldsetPresentationAttributes %}
					{{ AttributesHelper.allControls('presentation') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetConditions %}
	{% block fieldsetConditions %}
		<fieldset class="Fieldset-Conditions">
			<legend>{{ __('fieldset_conditions') }}</legend>

			{% block formControlType %}
				{{ FormHelper.control('type', {
					empty: false,
					'data-form-updater': true,
				}) }}
			{% endblock %}

			{% block formControlFinalAction %}
				{{ FormHelper.control('finalAction', {
					empty: false,
					options: finalActions,
					'data-form-updater': true,
				}) }}
			{% endblock %}

			{% block formControlFormId %}
				{{ FormHelper.control('formId', {
					options: availableForms,
				}) }}
			{% endblock %}

			{% block fieldsetConditionsInner %}
				{% block fieldsetConditionsAttributes %}
					{{ AttributesHelper.allControls('conditions') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetAttributes %}
	{% block fieldsetAttributes %}
		<fieldset class="Fieldset-Attributes">
			<legend>{{ __('fieldset_attributes') }}</legend>

			{% block fieldsetAttributesInner %}
				{% block fieldsetAttributesAttributes %}
					{{ AttributesHelper.allControls('attributes') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetQuestionsAvailable %}
	{% block fieldsetQuestionsAvailable %}
		<fieldset class="Fieldset-Questions-Available">
			<legend>{{ __('fieldset_questions_available') }}</legend>

			{% block fieldsetQuestionsAvailableInner %}
				{% from '@Backend/macro/nested_list.twig' import nestedList %}
				{{ nestedList(availableQuestions, _context|merge({
					identifier: 'AvailableQuestions',
					template: '@Backend/Surveys/form_question_list_item_available.twig',
					data: {
						nestable: false,
						sortable: false,
					},
					assignedQuestionIds: survey.surveySurveyQuestions and survey.type == enum('Awyiss\\Model\\Enum\\Survey\\Type').Linear ? survey.surveySurveyQuestions|column('surveyQuestionId') : [],
				})) }}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% block sidebarToggle %}
	{% if config.Awyiss.System.Backend.interface.sidebarMode == true and isOverlayForm != true %}
		{{ FormHelper.button(__('sidebar_toggle'), {class: 'Button Button-Configure', id: 'Sidebar-Toggle', name: 'button', type: 'button'}) }}
	{% endif %}
{% endblock %}

{% block fieldsets %}
	<div class="Fieldsets">
		{% if config.Awyiss.System.Backend.interface.sidebarMode != true or isOverlayForm == true %}
			{{ fieldsetPresentation }}
			{{ fieldsetConditions }}
			{{ fieldsetGeneral }}
			{{ fieldsetContent }}

			<fieldset class="Fieldset-Questions">
				{{ fieldsetQuestionsAvailable }}
				{{ fieldsetQuestionsAssigned }}
			</fieldset>

			{{ fieldsetMedia }}
			{{ fieldsetMediaElementAssignments }}
			{{ fieldsetAttributes }}
		{% endif %}

		{% block mainFieldsets %}
			{% if config.Awyiss.System.Backend.interface.sidebarMode == true and isOverlayForm != true %}
				<div class="Main-Fieldsets">
					{{ fieldsetGeneral }}
					{{ fieldsetContent }}
					{{ fieldsetQuestionsAssigned }}
					{{ fieldsetMedia }}
					{{ fieldsetMediaElementAssignments }}
				</div>
			{% endif %}
		{% endblock %}

		{% block sidebarFieldsets %}
			{% if config.Awyiss.System.Backend.interface.sidebarMode == true and isOverlayForm != true %}
				<div class="Sidebar-Fieldsets">
					{{ fieldsetPresentation }}
					{{ fieldsetConditions }}
					{{ fieldsetAttributes }}
					{{ fieldsetQuestionsAvailable }}
				</div>
			{% endif %}
		{% endblock %}

		{% block formInputReloadForm %}
			{{ FormHelper.hidden('reloadForm', {val: 0}) }}
		{% endblock %}

		{% block questionsDiagram %}
			{% include '@Backend/Surveys/mermaid_flowchart.twig' %}
		{% endblock %}

		{% block phpResult %}
			{% if survey.surveySurveyQuestions %}
				<details>
					<summary>{{ __('php_array') }}</summary>
					{% set questionsByIdentifier = survey.surveySurveyQuestions ? survey.surveySurveyQuestions|column(null, 'identifier') : [] %}
				<code class="ResultsArray">// Results array for the survey {{ survey.identifier }}
$paths = [
{%~ for path in survey.buildResultsArray() %}
	/**
	{%~ for questionIdentifier, answerId in path %}
		{%~ set question = questionsByIdentifier[ questionIdentifier ] %}
		{%~ set answers = question.surveySurveyAnswers ? question.surveySurveyAnswers|column(null, 'id') : [] %}
	 * {{ question.surveyQuestion.title }}
		{%- if question.surveyQuestion.type != enum(questionTypeEnum).InfoText %}
		{%- if answerId is array %}
			{%- for realAnswerId in answerId %}

	 *        {{ ' -> ' }}{{ realAnswerId == '*' ? '*' : (realAnswerId != 'custom' ? answers[ realAnswerId ].surveyAnswer.title : 'custom') }}
			{%- endfor %}
		{%- else %}
			{{- ' -> ' }}{{- answerId != 'custom' ? answers[ answerId ].surveyAnswer.title : 'custom' }}{% endif %}{% endif %}

	{%~ endfor %}
	 */
	'{{ survey.buildResultPath(path) }}' => '',
{% endfor %}
];</code>
				</details>
			{% endif %}
		{% endblock %}
	</div>
{% endblock %}

{% block lockDialog %}
	{{ element('lock_dialog', {entity: survey}) }}
{% endblock %}

{{ FormHelper.end() }}

