{#
@var survey \Awyiss\Model\Entity\Survey
@var assignedQuestionIds array<int>
@var entity \Awyiss\Model\Entity\SurveySurveyQuestion
@var answerType string
@var availableActions \Awyiss\Model\Enum\Survey\NextAction[]
@var availableForms \Awyiss\Model\Entity\Form[]
@var availableQuestions \Awyiss\Model\Entity\SurveyQuestion[]
@var nextActionEnum class-string<\Awyiss\Model\Enum\Survey\NextAction>
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% block answersListItem %}
	{% if entity.surveySurveyAnswers[ answer.id ] is defined or answerType == 'available' %}
		<li class="Answers-ListItem">
			{% block answersListItemInner %}
				<div class="Answers-ListItem-Inner">
					{% block answersListItemLabel %}
						<span class="Label">{{ answer.label }}</span>
					{% endblock %}

					{% block answersListItemActions %}
						<span class="Actions">
							{% block answersListItemRemove %}
								{{ FormHelper.button(__('remove_answer'), {
									class: 'Button Button-Small Button-Delete',
									type: 'button',
									'data-confirm-title': __d('survey_answers', 'confirm_delete_title'),
									'data-confirm-yes': __d('survey_answers', 'confirm_delete_yes'),
									'data-confirm-yes-class': 'Button-Delete',
									'data-confirm-no': __d('survey_answers', 'confirm_delete_no'),
									'data-confirm': __d('survey_answers', 'confirm_delete', entity.id)
								}) }}
							{% endblock %}
						</span>
					{% endblock %}

					{% block answersListItemInputs %}
						{{ FormHelper.hidden('survey_survey_questions[' ~ index ~'][survey_survey_answers][' ~ loop.index0 ~ '][survey_answer_id]', {
							disabled: answerType == 'available',
							val: answer.id
						}) }}

						{{ FormHelper.control('survey_survey_questions[' ~ index ~'][survey_survey_answers][' ~ loop.index0 ~ '][active]', {
							checked: entity.surveySurveyAnswers[ answer.id ].active or answerType == 'available',
							disabled: answerType == 'available',
							type: 'checkbox',
						}) }}

						{% if answerType == 'assigned' %}
							{{ FormHelper.hidden('survey_survey_questions[' ~ index ~'][survey_survey_answers][' ~ loop.index0 ~ '][id]', {
								val: entity.surveySurveyAnswers[ answer.id ].id
							}) }}
						{% endif %}
					{% endblock %}
				</div>

				{% block answerListItemSettings %}
					{% if survey.type != enum('Awyiss\\Model\\Enum\\Survey\\Type').Linear and entity.surveyQuestion.type != enum('Awyiss\\Model\\Enum\\Survey\\QuestionType').MultiChoice %}
						<div class="Settings">
							{% block answerListItemNextAction %}
								<div class="NextAction">
									{{ FormHelper.control('survey_survey_questions[' ~ index ~'][survey_survey_answers][' ~ loop.index0 ~ '][next_action]', {
										label: __('next_action'),
										options: availableActions,
										type: 'select',
										val: entity.surveySurveyAnswers[ answer.id ].nextAction,
										'data-form-updater': true,
									}) }}

									{% if entity.surveySurveyAnswers[ answer.id ].nextAction == enum(nextActionEnum).SpecificQuestion %}
										{{ FormHelper.control('survey_survey_questions[' ~ index ~'][survey_survey_answers][' ~ loop.index0 ~ '][next_action_target]', {
											disabled: [entity.identifier],
											empty: false,
											label: __('next_action_question'),
											options: specifyQuestionOptions,
											type: 'select',
											val: entity.surveySurveyAnswers[ answer.id ].nextActionTarget,
										}) }}

										{{ FormHelper.button(__('pick_question'), {
											class: 'Button Button-Small Button-Target Button-PickQuestion',
											type: 'button',
										}) }}
									{% elseif entity.surveySurveyAnswers[ answer.id ].nextAction in [
										enum(nextActionEnum).ShowForm,
										enum(nextActionEnum).SaveAndShowForm,
										enum(nextActionEnum).ShowFormAndSave,
									] %}
										{{ FormHelper.control('survey_survey_questions[' ~ index ~'][survey_survey_answers][' ~ loop.index0 ~ '][next_action_target]', {
											empty: __('next_action_inherit_form'),
											label: __('next_action_form'),
											options: availableForms,
											type: 'select',
											val: entity.surveySurveyAnswers[ answer.id ].nextActionTarget,
										}) }}
									{% endif %}
								</div>
							{% endblock %}
						</div>
					{% endif %}
				{% endblock %}
			{% endblock %}
		</li>
	{% endif %}
{% endblock %}
