{#
@var ao_slugHistory Awyiss\Model\Entity\SlugHistory[]
@var _view \Awyiss\View\BackendView
#}

<div class="SlugHistory Overview">
	{% block buttonsOverview %}
		{% if helper_Authorization_isAccessible('create') %}
			{{ helper_Html_link(__('create'), {action: 'add'}, {class: 'Button'}) }}
		{% endif %}
	{% endblock %}

	{% block headlineOverview %}
		<h1>{{ __('headline_overview') }}</h1>
	{% endblock %}

	{% block tableOverview %}
		<table>
			{% block tableOverviewHead %}
				<thead>
					{% block tableOverviewHeadRow %}
						<tr>
							{% block tableOverviewHeaderId %}
								<th>{{ helper_Paginator_sort('id') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderSlug %}
								<th>{{ helper_Paginator_sort('slug') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderPageId %}
								<th>{{ helper_Paginator_sort('page_id') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderActions %}
								<th class="actions"></th>
							{% endblock %}
						</tr>
					{% endblock %}
				</thead>
			{% endblock %}
			{% block tableOverviewBody %}
				<tbody>
					{# @var lo_slugHistory \Awyiss\Model\Entity\SlugHistory #}
					{% for lo_slugHistory in ao_slugHistory %}
						{% block tableOverviewBodyRow %}
							<tr>
								{% block tableOverviewCellId %}
									<td>{{ helper_Number_format(lo_slugHistory.id) }}</td>
								{% endblock %}

								{% block tableOverviewCellSlug %}
									<td>{{ lo_slugHistory.slug }}</td>
								{% endblock %}

								{% block tableOverviewCellPageId %}
									<td>
										{% if lo_slugHistory.has('page') %}
											{{ lo_slugHistory.page.title }}
										{% endif %}
									</td>
								{% endblock %}

								{% block tableOverviewCellActions %}
									<td class="actions">
										{% if helper_Authorization_isAccessible('update') %}
											{{ helper_Html_link(__('edit'), {action: 'edit', id: lo_slugHistory.id}) }}
										{% endif %}
										{% if helper_Authorization_isAccessible('delete') %}
											{{ helper_Html_link(__('delete'), {action: 'delete', id: lo_slugHistory.id}, {confirm: __('confirm_delete', lo_slugHistory.id) }) }}
										{% endif %}
									</td>
								{% endblock %}
							</tr>
						{% endblock %}
					{% endfor %}
				</tbody>
			{% endblock %}
		</table>
	{% endblock %}

	{{ helper_Paginator_render() }}
</div>
