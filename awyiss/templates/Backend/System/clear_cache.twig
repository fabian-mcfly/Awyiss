<div class="System ClearCache">
	{% block headlinesClearCache %}
		<div class="Headlines">
			{{ HtmlHelper.link(__('back_to_overview'), {controller: 'System', action: 'analyze'}, {class: 'BackToOverview'}) }}

			{% block headlineClearCache %}
				<h1>{{ __('headline_clear_cache') }}</h1>
			{% endblock %}
		</div>
	{% endblock %}

	{% if runningJob.completed is empty	%}
		<p class="FlashMessage FlashMessage-">{{ __('clear_cache_running') }}</p>

		<meta http-equiv="refresh" content="1">
	{% else %}
		<p class="FlashMessage Success">{{ __('clear_cache_completed') }}</p>
	{% endif %}
</div>