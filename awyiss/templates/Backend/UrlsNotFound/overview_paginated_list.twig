{% extends '@Backend/element/overview/overview_paginated_list.twig' %}

{% set canCreateUrlHistory = AuthorizationHelper.scopeIsAccessible('UrlHistory', [], 'create') %}

{% block tableOverviewHeaderTitle %}{% endblock %}
{% block tableOverviewHeaderDefaultFields %}
	<th class="TableHeader-Url{% if PaginatorHelper.isCurrentSortKey('url') %} Active{% endif %}">
		{{ PaginatorHelper.sort('url', i18nDomain ? __df(i18nDomain, 'System', 'url') : __('url')) }}
	</th>
	{% if grouped == false %}
		<th class="TableHeader-Referrer{% if PaginatorHelper.isCurrentSortKey('referrer') %} Active{% endif %}">
			{{ PaginatorHelper.sort('referrer', i18nDomain ? __df(i18nDomain, 'System', 'referrer') : __('referrer')) }}
		</th>
		<th class="TableHeader-IsRobot{% if PaginatorHelper.isCurrentSortKey('isRobot') %} Active{% endif %}">
			{{ PaginatorHelper.sort('isRobot', i18nDomain ? __df(i18nDomain, 'System', 'is_robot') : __('is_robot')) }}
		</th>
		<th class="TableHeader-CreatedOn{% if PaginatorHelper.isCurrentSortKey('createdOn') %} Active{% endif %}">
			{{ PaginatorHelper.sort('createdOn', i18nDomain ? __df(i18nDomain, 'System', 'created_on') : __('created_on')) }}
		</th>
	{% else %}
		<th class="TableHeader-Occurrences{% if PaginatorHelper.isCurrentSortKey('occurrences') %} Active{% endif %}">
			{{ PaginatorHelper.sort('occurrences', i18nDomain ? __df(i18nDomain, 'System', 'is_robot') : __('occurrences')) }}
		</th>
		<th class="TableHeader-FirstOccurrence{% if PaginatorHelper.isCurrentSortKey('firstOccurrence') %} Active{% endif %}">
			{{ PaginatorHelper.sort('firstOccurrence', i18nDomain ? __df(i18nDomain, 'System', 'created_on') : __('first_occurrence')) }}
		</th>
		<th class="TableHeader-LastOccurrence{% if PaginatorHelper.isCurrentSortKey('lastOccurrence') %} Active{% endif %}">
			{{ PaginatorHelper.sort('lastOccurrence', i18nDomain ? __df(i18nDomain, 'System', 'created_on') : __('last_occurrence')) }}
		</th>
	{% endif %}
{% endblock %}
{% block tableOverviewHeaderAuditInfo %}{% endblock %}
{% block tableOverviewHeaderActions %}
	{% if canCreateUrlHistory %}
		<th class="TableHeader-Actions"></th>
	{% endif %}
{% endblock %}

{% block tableOverviewCellTitle %}{% endblock %}
{% block tableOverviewCellDefaultFields %}
	<td class="TableCell-Url" title="{{ entity.url }}">{{ entity.url }}</td>
	{% if grouped == false %}
		<td class="TableCell-Referrer">
			{% if entity.referrer %}
				{% set linkText = entity.referrer %}
				{% if linkText|length > 50 %}
					{% set linkText = linkText|slice(0, 50) ~ '...' %}
				{% endif %}

				{{ HtmlHelper.link(linkText, entity.referrer, {rel: 'noreferrer', target: '_blank', title: entity.referrer}) }}
			{% endif %}
		</td>
		<td class="TableCell-IsRobot">
			{% if entity.isRobot %}
				<i class="las la-check">{{ __('true') }}</i>
			{% else %}
				<i class="las la-times">{{ __('false') }}</i>
			{% endif %}
		</td>
		<td class="TableCell-CreatedOn">{{ TimeHelper.nice(entity.createdOn) }}</td>
	{% else %}
		<td class="TableCell-Occurrences">{{ entity.occurrences }}</td>
		<td class="TableCell-FirstOccurrence">{{ TimeHelper.nice(entity.firstOccurrence) }}</td>
		<td class="TableCell-LastOccurrence">{{ TimeHelper.nice(entity.lastOccurrence) }}</td>
	{% endif %}
{% endblock %}
{% block tableOverviewCellAuditInfo %}{% endblock %}
{% block tableOverviewCellActions %}
	{% if canCreateUrlHistory or grouped == false %}
		<td class="TableCell-Actions">
			<div class="Actions">
				{% if canCreateUrlHistory %}
					<form method="post" action="{{ UrlHelper.build({controller: 'UrlHistory', action: 'add'}) }}">
						{{ FormHelper.button(__('create_redirect'), {class: 'Button Button-Small Button-Add', name: 'submitType', value: 'submit'}) }}
						{{ FormHelper.hidden('reloadForm', {val: 1}) }}
						{{ FormHelper.hidden('url', {val: entity.url|trim('/')}) }}
					</form>
				{% endif %}
				{% if grouped == false %}
					{% block tableOverviewCellActionsDelete %}
						{{ parent() }}
					{% endblock %}
				{% endif %}
			</div>
		</td>
	{% endif %}
{% endblock %}

{% block tableOverviewFootColSpan %}{{ displayedFields|length + 5 + (canCreateUrlHistory ? 1 : 0) }}{% endblock %}
