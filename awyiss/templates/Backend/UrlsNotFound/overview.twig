{#
@var urlsNotFound Awyiss\Model\Entity\UrlsNotFound[]
@var grouped bool
@var _view \Awyiss\View\BackendView
#}

<div class="UrlsNotFound Overview">
	{% block headlinesOverview %}
		<div class="Headlines">
			{% block headlineOverview %}
				<h1>{{ __('headline_overview') }}</h1>
			{% endblock %}
		</div>
	{% endblock %}

	{% block buttonAreaToggle %}
		{{ FormHelper.button(__('button_area_toggle'), {class: 'Button Button-Menu', id: 'ButtonArea-Toggle', name: 'button', type: 'button'}) }}
	{% endblock %}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block overviewButtons %}
				{% block overviewButtonGroupEntries %}
					{{ HtmlHelper.link(__('group_entries'), {grouped: grouped ? false : 'true'}, {class: 'Button Button-Toggle' ~ (grouped ? ' Button-Toggle-Active' : '')}) }}
				{% endblock %}

				{% block overviewButtonFilter %}
					{{ element('search/filter_button', {scope: 'urls_not_found'}) }}
				{% endblock %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block paginatedOverview %}
		{% include '@Backend/UrlsNotFound/overview_paginated_list.twig' with _context|merge({records: urlsNotFound.items().toArray()}) %}
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('overviewButtons') }}
		</div>
	{% endblock %}

	{% block listFilter %}
		{{ element('search/filter', {scope: 'urls_not_found'}) }}
	{% endblock %}
</div>
