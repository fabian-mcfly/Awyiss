{#
@var urlsNotFound Awyiss\Model\Entity\UrlsNotFound[]
@var grouped bool
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Awyiss\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

<div class="UrlsNotFound Overview">
	{% block headlinesOverview %}
		<div class="Headlines">
			{% block headlineOverview %}
				<h1>{{ __('headline_overview') }}</h1>
			{% endblock %}
		</div>
	{% endblock %}

	{% block buttonAreaToggle %}
		{{ FormHelper.button(__('button_area_toggle'), {class: 'Button Button-Menu', id: 'ButtonArea-Toggle', name: 'button', type: 'button'}) }}
	{% endblock %}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block overviewButtons %}
				{% block overviewButtonGroupEntries %}
					{{ HtmlHelper.link(__('group_entries'), {grouped: grouped ? false : 'true'}, {class: 'Button Button-Toggle' ~ (grouped ? ' Button-Toggle-Active' : '')}) }}
				{% endblock %}

				{{ FormHelper.linkSelect(__('delete_older_than'), [
					HtmlHelper.link(__('delete_older_than_one_week'), {action: 'delete-old', olderThan: 'oneWeek'}, {class: 'Button Button-Delete'}),
					HtmlHelper.link(__('delete_older_than_one_month'), {action: 'delete-old', olderThan: 'oneMonth'}, {class: 'Button Button-Delete'}),
					HtmlHelper.link(__('delete_older_than_one_year'), {action: 'delete-old', olderThan: 'oneYear'}, {class: 'Button Button-Delete'}),
					HtmlHelper.link(__('delete_older_all'), {action: 'delete-old', olderThan: 'all'}, {class: 'Button Button-Delete'}),
				]) }}

				{% block overviewButtonFilter %}
					{{ element('search/filter_button', {scope: 'urls_not_found'}) }}
				{% endblock %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block paginatedOverview %}
		{% include '@Backend/UrlsNotFound/overview_paginated_list.twig' with _context|merge({
			records: urlsNotFound.items().toArray(),
			displayedFields: localConfig.overview.displayedFields,
		}) %}
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('overviewButtons') }}
		</div>
	{% endblock %}

	{% block listFilter %}
		{{ element('search/filter', {scope: 'urls_not_found'}) }}
	{% endblock %}
</div>
