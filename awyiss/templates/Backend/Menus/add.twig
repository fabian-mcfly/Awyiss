{#
@var ao_menu Awyiss\Model\Entity\Menu
@var _view \Awyiss\View\BackendView
#}

<div class="Menus Form Add">
	{% block headlineAdd %}
		<h1>{{ __('headline_add') }}</h1>
	{% endblock %}

	{{ helper_Form_create(ao_menu, {method: 'post', idPrefix: 'menu'}) }}

	{% block formAddButtons %}
		{{ helper_Form_button(__('save')) }}
		{{ helper_Form_button(__('save_close'), {name: 'submit', value: 'submit_close'}) }}
	{% endblock %}

	{% block formAdd %}
		{% include('@Backend/Menus/form.twig') %}
	{% endblock %}

	{% block formAddButtonsBottom %}
		{{ block('formAddButtons') }}
	{% endblock %}

	{{ helper_Form_end() -}}
	
</div>