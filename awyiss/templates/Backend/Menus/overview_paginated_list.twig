{% extends '@Backend/element/overview/overview_paginated_list.twig' %}

{% block tableOverviewCellActions %}
	<td class="TableCell-Actions">
		<div class="Actions">
			{% block tableOverviewCellActionsViewFiles %}
				{% if AuthorizationHelper.isAccessible('read') %}
					{{ HtmlHelper.link(__('view_entries'), {controller: 'menuEntries', action: 'overview', menuId: entity.id}, {class: 'Button Button-Small Button-View Button-ViewMenuEntries'}) }}
				{% endif %}
			{% endblock %}

			{{ block('tableOverviewCellActionsGallery') }}

			{{ block('tableOverviewCellActionsUpdate') }}

			{{ block('tableOverviewCellActionsDelete') }}
		</div>
	</td>
{% endblock %}