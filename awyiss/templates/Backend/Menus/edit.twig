{#
@var ao_menu Awyiss\Model\Entity\Menu
@var _view \Awyiss\View\BackendView
#}

{{ dump(ao_menu) }}

<div class="Menus Form Edit">
	{{ helper_Form_create(ao_menu, {method: 'post', idPrefix: 'menu'}) }}

	{{ helper_Form_checkbox('save_as_copy', {id: 'SaveAsCopy', value: true}) }}

	{% block headlineEdit %}
		<h1>{{ __('headline_edit') }}</h1>
	{% endblock %}

	{% block formEditButtons %}
		<label for="SaveAsCopy">{{ __('as_copy') }}</label>
		{{ helper_Form_button(__('save')) }}
		{{ helper_Form_button(__('save_close'), {name: 'submit', value: 'submit_close'}) }}
	{% endblock %}

	{% block formEdit %}
		{% include('@Backend/Menus/form.twig') %}
	{% endblock %}

	{% block formEditButtonsBottom %}
		{{ block('formEditButtons') }}
	{% endblock %}

	{{ helper_Form_end() -}}
</div>