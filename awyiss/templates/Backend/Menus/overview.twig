{#
@var ao_menus Awyiss\Model\Entity\Menu[]
@var _view \Awyiss\View\BackendView
#}

<div class="Menus Overview">
	{% block buttonsOverview %}
		{% if helper_Authorization_isAccessible('create') %}
			{{ helper_Html_link(__('create'), {action: 'add'}, {class: 'Button'}) }}
		{% endif %}
	{% endblock %}

	{% block headlineOverview %}
		<h1>{{ __('headline_overview') }}</h1>
	{% endblock %}

	{% block tableOverview %}
		<table class="Table-Overview">
			{% block tableOverviewHead %}
				<thead>
					{% block tableOverviewHeadRow %}
						<tr>
							{% block tableOverviewHeaderId %}
								<th>{{ helper_Paginator_sort('id') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderTitle %}
								<th>{{ helper_Paginator_sort('title') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderIdentifier %}
								<th>{{ helper_Paginator_sort('identifier') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderActive %}
								<th>{{ helper_Paginator_sort('active') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderActions %}
								<th class="actions"></th>
							{% endblock %}
						</tr>
					{% endblock %}
				</thead>
			{% endblock %}
			{% block tableOverviewBody %}
				<tbody>
					{# @var lo_menu \Awyiss\Model\Entity\Menu #}
					{% for lo_menu in ao_menus %}
						{% block tableOverviewBodyRow %}
							<tr>
								{% block tableOverviewCellId %}
									<td>{{ lo_menu.id }}</td>
								{% endblock %}

								{% block tableOverviewCellTitle %}
									<td>{{ lo_menu.title }}</td>
								{% endblock %}

								{% block tableOverviewCellIdentifier %}
									<td>{{ lo_menu.identifier }}</td>
								{% endblock %}

								{% block tableOverviewCellActive %}
									<td>{{ lo_menu.active }}</td>
								{% endblock %}

								{% block tableOverviewCellActions %}
									<td class="actions">
										{% if helper_Authorization_scopeIsAccessible('MenuEntries', [], ['read']) %}
											{{ helper_Html_link(__('view_entries'), {controller: 'MenuEntries', action: 'overview', menu_id: lo_menu.id}) }}
										{% endif %}

										{% if helper_Authorization_isAccessible('update') %}
											{{ helper_Html_link(__('edit'), {action: 'edit', id: lo_menu.id}) }}
										{% endif %}

										{% if helper_Authorization_isAccessible('delete') %}
											{{ helper_Html_link(__('delete'), {action: 'delete', id: lo_menu.id}, {confirm: __('confirm_delete', lo_menu.id) }) }}
										{% endif %}
									</td>
								{% endblock %}
							</tr>
						{% endblock %}
					{% endfor %}
				</tbody>
			{% endblock %}
		</table>
	{% endblock %}

	{% block paginationOverview %}
		{{ helper_Paginator_render() }}
	{% endblock %}
</div>
