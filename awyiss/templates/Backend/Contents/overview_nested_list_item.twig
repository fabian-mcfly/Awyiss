{#
@var lo_entity \Awyiss\Model\Entity\Content
@var settings array
#}

<div class="{{ settings.identifier }}-ListItem-Inner ListItem-Inner">
	<span class="Id">{{ lo_entity.id }}</span>
	<span class="Title">
		{{ lo_entity.forcedTitle|raw }}
		<br>
		{{ lo_entity.column.width.label }}
		{% if lo_entity.column.indent %}
			/ {{ lo_entity.column.indent.label }}
		{% endif %}
	</span>
	<span class="Actions">
		{% if helper_Authorization_isAccessible('update') %}
			{{ helper_Html_link(__('edit'), {action: 'edit', id: lo_entity.id}) }}
		{% endif %}

		{% if helper_Authorization_isAccessible('delete') %}
			{{ helper_Html_link(__('delete'), {action: 'delete', id: lo_entity.id}, {confirm: __('confirm_delete', lo_entity.id) }) }}
		{% endif %}
	</span>
</div>