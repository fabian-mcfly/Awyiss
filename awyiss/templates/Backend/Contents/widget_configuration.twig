{#
@var widget_identifier string
@var frontendLanguage \Awyiss\Model\Entity\Language
@var userLanguage \Awyiss\Model\Entity\Language
@var widgets array
@var widgetClass class-string<\Awyiss\Widget\WidgetInterface>
@var settings array
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

<div class="Contents Form WidgetConfiguration" data-title="{{ __('headline_widget_configuration') }}">
	{% block buttonArea %}
		<div class="ButtonArea">
			{% block formWidgetConfigurationButtons %}
				{{ FormHelper.button(__('apply'), {class: 'Button Button-Success Button-Save', form: 'WidgetConfiguration'}) }}
			{% endblock %}

			{{ FormHelper.button(__('cancel'), {class: 'Button Button-Close'}) }}
		</div>
	{% endblock %}

	{{ FormHelper.create(null, {method: 'post', id: 'WidgetConfiguration', idPrefix: 'widgetConfiguration'}) }}

	{% block flashMessages %}
		{{ FlashHelper.render() }}
	{% endblock %}

	<fieldset class="Fieldsets">
		{{ FormHelper.control('widget_identifier', {
			type: 'select',
			options: widgets,
			value: widget_identifier,
			'data-form-updater': true,
		}) }}

		{% block formWidgetConfiguration %}
			{% if widgetClass %}
				{{ staticCall(widgetClass, 'renderForm', _view, frontendLanguage, userLanguage, settings)|raw }}
			{% endif %}
		{% endblock %}
	</fieldset>

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('formWidgetConfigurationButtons') }}

			{{ FormHelper.button(__('cancel'), {class: 'Button Button-Close Button-Cancel'}) }}
		</div>
	{% endblock %}

	{% block formInputReloadForm %}
		{{ FormHelper.hidden('reload_form', {val: 0}) }}
	{% endblock %}

	{{ FormHelper.end() }}
</div>
