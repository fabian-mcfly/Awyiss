{#
@var ao_content \Awyiss\Model\Entity\Content
@var ao_contentTemplates \Cake\Collection\CollectionInterface
@var ao_possibleParentContents \Cake\Collection\CollectionInterface
@var ao_page \Awyiss\Model\Entity\Page
@var aa_assignedAttributes array
@var aa_contentAreas array
@var aa_contentElementsByFieldset ContentTemplateElement[]
@var as_forScope string
@var as_languageRealm string
@var as_languageShortcode string
@var _view \Awyiss\View\BackendView
#}

{% use '@Backend/Contents/blocks.twig' %}

{% set macroSettings = {
	columnWidths: aa_columnWidths,
	columnIndents: aa_columnIndents,
	content: ao_content,
	contentAreas: aa_contentAreas,
	contentTemplates: ao_contentTemplates,
	languageRealm: as_languageRealm,
	languageShortcode: as_languageShortcode,
	possibleParentContents: ao_possibleParentContents,
} %}

{% macro renderFormControls(aa_assignedContentTemplateElements = [], settings) %}
	{% for lo_contentTemplateElement in aa_assignedContentTemplateElements %}
		{% if lo_contentTemplateElement.identifier[:11] == 'attributes.' %}
			{{ AttributesHelper.control(lo_contentTemplateElement.identifier[11:], {required: lo_contentTemplateElement.required}) }}
		{% else %}
			{{ block('formControl' ~ lo_contentTemplateElement.identifier|camelize) }}
		{% endif %}
	{% endfor %}
{% endmacro %}

<div class="Fieldsets">
	{% block fieldsetPresentation %}
		<fieldset class="Fieldset-Presentation">
			<legend>{{ __('fieldset_presentation') }}</legend>

			{% block fieldsetPresentationInner %}
				{{ _self.renderFormControls(aa_contentElementsByFieldset.presentation ?? [], macroSettings) }}
			{% endblock %}
		</fieldset>
	{% endblock %}

	{% block fieldsetConditions %}
		<fieldset class="Fieldset-Conditions">
			<legend>{{ __('fieldset_conditions') }}</legend>

			{% block fieldsetConditionsInner %}
				{{ _self.renderFormControls(aa_contentElementsByFieldset.conditions ?? [], macroSettings) }}
			{% endblock %}
		</fieldset>
	{% endblock %}

	{% block fieldsetGeneral %}
		<fieldset class="Fieldset-General">
			<legend>{{ __('fieldset_general') }}</legend>

			{% block fieldsetGeneralInner %}
				{{ _self.renderFormControls(aa_contentElementsByFieldset.general ?? [], macroSettings) }}
			{% endblock %}
		</fieldset>
	{% endblock %}

	{% block fieldsetContent %}
		<fieldset class="Fieldset-Content">
			<legend>{{ __('fieldset_content') }}</legend>

			{% block fieldsetContentInner %}
				{{ _self.renderFormControls(aa_contentElementsByFieldset.content ?? [], macroSettings) }}
			{% endblock %}
		</fieldset>
	{% endblock %}

	{% block fieldsetMedia %}
		<fieldset class="Fieldset-Media">
			<legend>{{ __('fieldset_media') }}</legend>

			{% block fieldsetMediaInner %}
				{{ _self.renderFormControls(aa_contentElementsByFieldset.media ?? [], macroSettings) }}
			{% endblock %}
		</fieldset>
	{% endblock %}

	{% block fieldsetAttributes %}
		<fieldset class="Fieldset-Attributes">
			<legend>{{ __('fieldset_attributes') }}</legend>

			{% block fieldsetAttributesInner %}
				{{ _self.renderFormControls(aa_contentElementsByFieldset.attributes ?? [], macroSettings) }}
			{% endblock %}
		</fieldset>
	{% endblock %}

	{% block fieldsetData %}
		<fieldset class="Fieldset-Data">
			<legend>{{ __('fieldset_data') }}</legend>

			{% block fieldsetDataInner %}
				{% block formControlData %}
					{% set li_counter = 0 %}
					{% for ls_key, lx_value in ao_content.data %}
						{{ FormHelper.control('data.' ~ li_counter ~ '.key', {val: ls_key}) }}
						{{ FormHelper.control('data.' ~ li_counter ~ '.value', {val: lx_value}) }}
						{% set li_counter = li_counter + 1 %}
					{% endfor %}

					{{ FormHelper.control('data.' ~ li_counter ~ '.key') }}
					{{ FormHelper.control('data.' ~ li_counter ~ '.value') }}
				{% endblock %}

				{{ _self.renderFormControls(aa_contentElementsByFieldset.data ?? [], macroSettings) }}
			{% endblock %}
		</fieldset>
	{% endblock %}

	{% block elementPublicationData %}
		{{ element('publication_data/fieldset') }}
	{% endblock %}
</div>

{% block formInputReloadForm %}
	{{ FormHelper.hidden('reload_form', {val: 0}) }}
{% endblock %}
