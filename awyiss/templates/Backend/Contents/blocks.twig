{% block formControlActive %}
	{{ FormHelper.control('active') }}
{% endblock %}


{% block formControlContentTemplateId %}
	{{ FormHelper.control('content_template_id', {
		empty: false,
		options: settings.contentTemplates.combine('id', 'title')
	}) }}
{% endblock %}


{% block formControlLanguageShortcode %}
	{{ LocaleHelper.control('language_shortcode', {languageRealm: settings.languageRealm, val: settings.languageShortcode}) }}
{% endblock %}


{% block formControlSystemOrder %}
	{{ SystemOrderHelper.control('system_order', {entity: settings.content}) }}
{% endblock %}


{% block formControlPage %}
	{{ CategoriesHelper.control('page') }}
{% endblock %}


{% block formControlContentAreaId %}
	{{ FormHelper.control('content_area_id', {
		disabled: settings.contentAreas.unavailable|column('id'),
		empty: false,
		options: combine(settings.contentAreas.all|column('id'), settings.contentAreas.all|column('label'))
	}) }}
{% endblock %}


{% block formControlColumnWidth %}
	{{ FormHelper.control('column_width', {empty: false, options: settings.columnWidths, required: lo_contentTemplateElement.required, type: 'select'}) }}
{% endblock %}


{% block formControlColumnIndent %}
	{{ FormHelper.control('column_indent', {options: settings.columnIndents, required: lo_contentTemplateElement.required, type: 'select'}) }}
{% endblock %}


{% block formControlColumnLast %}
	{{ FormHelper.control('column_last') }}
{% endblock %}


{% block formControlColumnRtl %}
	{{ FormHelper.control('column_rtl') }}
{% endblock %}



{% block formControlParentId %}
	{{ FormHelper.control('parent_id', {options: hashPrinter(settings.possibleParentContents, 'label', 'id', '- '), required: lo_contentTemplateElement.required}) }}
{% endblock %}


{% block formControlTitle %}
	{{ FormHelper.control('title', {required: lo_contentTemplateElement.required}) }}
{% endblock %}


{% block formControlSubtitle %}
	{{ FormHelper.control('subtitle', {required: lo_contentTemplateElement.required}) }}
{% endblock %}


{% block formControlText %}
	{{ FormHelper.control('text', {required: lo_contentTemplateElement.required}) }}
{% endblock %}


{% block formControlDuplicateOf %}
	{{ FormHelper.control('duplicate_of', {disabled: [ao_content.id], required: lo_contentTemplateElement.required}) }}
{% endblock %}


{% block formControlLink %}
	{{ FormHelper.control('link', {required: lo_contentTemplateElement.required}) }}
{% endblock %}


{% block formControlCssClass %}
	{{ FormHelper.control('css_class', {required: lo_contentTemplateElement.required}) }}
{% endblock %}