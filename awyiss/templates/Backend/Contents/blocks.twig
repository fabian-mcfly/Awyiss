{% block formControlActive %}
	{{ FormHelper.control('active') }}
{% endblock %}


{% block formControlContentTemplateId %}
	{{ FormHelper.control('content_template_id', {
		empty: false,
		options: settings.contentTemplates.combine('id', 'title'),
		'data-form-updater': true,
	}) }}
{% endblock %}


{% block formControlLanguageShortcode %}
	{{ LocaleHelper.control('language_shortcode', {
		languageRealm: settings.languageRealm,
		val: settings.languageShortcode,
		'data-form-updater': true,
	}) }}
{% endblock %}


{% block formControlSystemOrder %}
	{{ SystemOrderHelper.control('system_order', {entity: settings.content}) }}
{% endblock %}


{% block formControlPageId %}
	{{ CategoriesHelper.control('page', {'data-form-updater': true}) }}
{% endblock %}


{% block formControlContentAreaId %}
	{{ FormHelper.control('content_area_id', {
		disabled: settings.contentAreas.unavailable|column('id'),
		empty: false,
		options: combine(settings.contentAreas.all|column('id'), settings.contentAreas.all|column('label')),
		'data-form-updater': true,
	}) }}
{% endblock %}


{% block formControlColumnWidth %}
	{{ FormHelper.control('column_width', {columnSpan: 6, empty: false, options: settings.columnWidths, required: contentTemplateElement.required, type: 'select'}) }}
{% endblock %}


{% block formControlColumnIndent %}
	{{ FormHelper.control('column_indent', {columnSpan: 6, options: settings.columnIndents, required: contentTemplateElement.required, type: 'select'}) }}
{% endblock %}


{% block formControlColumnLast %}
	{{ FormHelper.control('column_last', {columnSpan: 6}) }}
{% endblock %}


{% block formControlColumnRtl %}
	{{ FormHelper.control('column_rtl', {columnSpan: 6}) }}
{% endblock %}



{% block formControlParentId %}
	{{ FormHelper.control('parent_id', {
		options: hashPrinter(settings.possibleParentContents, 'label', 'id', '- '),
		required: contentTemplateElement.required,
		'data-form-updater': true,
	}) }}
{% endblock %}


{% block formControlTitle %}
	{{ FormHelper.control('title', {required: contentTemplateElement.required}) }}
{% endblock %}


{% block formControlSubtitle %}
	{{ FormHelper.control('subtitle', {required: contentTemplateElement.required}) }}
{% endblock %}


{% block formControlText %}
	{{ FormHelper.control('text', {required: contentTemplateElement.required}) }}
{% endblock %}


{% block formControlDuplicateOf %}
	{{ FormHelper.control('duplicate_of', {disabled: [content.id], required: contentTemplateElement.required}) }}
{% endblock %}


{% block formControlLink %}
	{{ FormHelper.control('link', {required: contentTemplateElement.required}) }}
{% endblock %}


{% block formControlCssClass %}
	{{ FormHelper.control('css_class', {required: contentTemplateElement.required}) }}
{% endblock %}