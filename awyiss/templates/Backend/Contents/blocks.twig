{#
@var content \Awyiss\Model\Entity\Content
@var contentTemplates \Cake\Collection\CollectionInterface
@var possibleParentContents \Cake\Collection\CollectionInterface
@var page \Awyiss\Model\Entity\Page
@var assignedAttributes array
@var contentAreas array
@var contentElementsByFieldset ContentTemplateElement[]
@var allowedKeys array
@var currentPageRole string
@var languageRealm string
@var languageShortcode string
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% block formControlActive %}
	{{ FormHelper.control('active', {
		columnSpan: contentTemplateElement.column.span.numerator,
		label: contentTemplateElement.title,
	}) }}
{% endblock %}


{% block formControlContentTemplateId %}
	{% set contentTemplateAddButton %}
		{% if AuthorizationHelper.scopeIsAccessible('ContentTemplates', [], 'create') %}
			{{ HtmlHelper.link(__d('content_templates', 'create'), {controller: 'ContentTemplates', action: 'add'}, {class: 'Button Button-Add InFieldButton OverlayForm'}) }}
		{% endif %}
	{% endset %}

	{% set contentTemplateEditButton %}
		{% if AuthorizationHelper.scopeIsAccessible('ContentTemplates', [], 'update') %}
			{{ HtmlHelper.link(__('edit'), {controller: 'ContentTemplates', action: 'edit', id: settings.content.contentTemplateId}, {class: 'Button Button-Edit InFieldButton OverlayForm'}) }}
		{% endif %}
	{% endset %}

	{{ FormHelper.control('content_template_id', {
		columnSpan: contentTemplateElement.column.span.numerator,
		empty: false,
		label: contentTemplateElement.title,
		options: settings.contentTemplates.combine('id', 'title'),
		templateVars: {
			additionalContent: contentTemplateAddButton ~ contentTemplateEditButton
		},
		'data-form-updater': true,
	}) }}
{% endblock %}


{% block formControlLanguageShortcode %}
	{{ LocaleHelper.control('language_shortcode', {
		columnSpan: contentTemplateElement.column.span.numerator,
		label: contentTemplateElement.title,
		languageRealm: settings.languageRealm,
		val: settings.languageShortcode,
		'data-form-updater': true,
	}) }}
{% endblock %}


{% block formControlSystemOrder %}
	{{ SystemOrderHelper.control('system_order', {
		columnSpan: contentTemplateElement.column.span.numerator,
		entity: settings.content,
		label: contentTemplateElement.title,
	}) }}
{% endblock %}


{% block formControlPageId %}
	{{ CategoriesHelper.control('page', {
		columnSpan: contentTemplateElement.column.span.numerator,
		label: contentTemplateElement.title,
		'data-form-updater': true,
	}) }}
{% endblock %}


{% block formControlContentAreaId %}
	{{ FormHelper.control('content_area_id', {
		columnSpan: contentTemplateElement.column.span.numerator,
		disabled: settings.contentAreas.unavailable|column('id'),
		empty: false,
		label: contentTemplateElement.title,
		options: combine(settings.contentAreas.all|column('id'), settings.contentAreas.all|column('label')),
		'data-form-updater': true,
	}) }}
{% endblock %}


{% block formControlColumnWidth %}
	{{ FormHelper.control('column_width', {
		columnSpan: contentTemplateElement.column.span.numerator,
		empty: false,
		label: contentTemplateElement.title,
		options: settings.columnWidths,
		required: contentTemplateElement.required,
		type: 'select'}
	) }}
{% endblock %}


{% block formControlColumnIndent %}
	{{ FormHelper.control('column_indent', {
		columnSpan: contentTemplateElement.column.span.numerator,
		label: contentTemplateElement.title,
		options: settings.columnIndents,
		required: contentTemplateElement.required,
		type: 'select'}) }}
{% endblock %}


{% block formControlColumnLast %}
	{{ FormHelper.control('column_last', {
		columnSpan: contentTemplateElement.column.span.numerator,
		label: contentTemplateElement.title,
		required: contentTemplateElement.required,
	}) }}
{% endblock %}


{% block formControlColumnRtl %}
	{{ FormHelper.control('column_rtl', {
		columnSpan: contentTemplateElement.column.span.numerator,
		label: contentTemplateElement.title,
		required: contentTemplateElement.required,
	}) }}
{% endblock %}


{% block formControlParentId %}
	{{ FormHelper.control('parent_id', {
		columnSpan: contentTemplateElement.column.span.numerator,
		label: contentTemplateElement.title,
		options: hashPrinter(settings.possibleParentContents, 'label', 'id', '- '),
		required: contentTemplateElement.required,
		'data-form-updater': true,
	}) }}
{% endblock %}


{% block formControlTitle %}
	{% set titleTag = '' %}
	{% if assignedContentTemplateElements.titleTag is defined %}
		{% set titleTag %}
			{{ FormHelper.control('title_tag', {
				options: {
					'h1': 'h1',
					'h2': 'h2',
					'h3': 'h3',
					'h4': 'h4',
					'h5': 'h5',
					'h6': 'h6',
					'p': 'p',
				},
			}) }}
		{% endset %}
	{% endif %}

	{{ FormHelper.control('title', {
		columnSpan: contentTemplateElement.column.span.numerator,
		label: contentTemplateElement.title,
		required: contentTemplateElement.required,
		templateVars: {
			additionalContent: titleTag,
		}
	}) }}
{% endblock %}


{% block formControlTitleTag %}{% endblock %}


{% block formControlSubtitle %}
	{% set subtitleTag = '' %}
	{% if assignedContentTemplateElements.subtitleTag is defined %}
		{% set subtitleTag %}
			{{ FormHelper.control('subtitle_tag', {
				options: {
					'h1': 'h1',
					'h2': 'h2',
					'h3': 'h3',
					'h4': 'h4',
					'h5': 'h5',
					'h6': 'h6',
					'p': 'p',
				},
			}) }}
		{% endset %}
	{% endif %}

	{{ FormHelper.control('subtitle', {
		columnSpan: contentTemplateElement.column.span.numerator,
		label: contentTemplateElement.title,
		required: contentTemplateElement.required,
		templateVars: {
			additionalContent: subtitleTag,
		}
	}) }}
{% endblock %}


{% block formControlSubtitleTag %}{% endblock %}


{% block formControlText %}
	{{ FormHelper.control('text', {
		columnSpan: contentTemplateElement.column.span.numerator,
		label: contentTemplateElement.title,
		required: contentTemplateElement.required,
		'data-editor': true,
	}) }}
{% endblock %}


{% block formControlDuplicateOf %}
	{% if settings.isDuplicated != true %}
		{% set output %}
			<output>{{ settings.content.duplicateOfContent.label ?: '&nbsp;' }}</output>
			{% if settings.content.duplicateOfContent %}
				{{ HtmlHelper.link(__('edit'), {action: 'edit', id: settings.content.duplicateOfContent.id}, {class: 'Button Button-Edit Button-Medium'}) }}
			{% endif %}
		{% endset %}

		{{ FormHelper.control('duplicate_of', {
			columnSpan: contentTemplateElement.column.span.numerator,
			label: contentTemplateElement.title,
			required: contentTemplateElement.required,
			templateVars: {
				additionalContent: output,
			},
			type: 'text',
			'data-form-updater': true,
			'data-duplicate-of-page-id': settings.content.duplicateOfContent.pageId,
			'data-page-id': settings.content.pageId,
			'data-content-template-id': settings.content.contentTemplateId,
		}) }}
	{% endif %}
{% endblock %}


{% block formControlLink %}
	{{ FormHelper.control('link', {
