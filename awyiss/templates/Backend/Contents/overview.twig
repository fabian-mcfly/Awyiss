{#
@var contents Collection[]
@var contentAreas array
@var unknownContentAreas array
@var page \Awyiss\Model\Entity\Page
@var contentTemplates array
@var currentPageRole string
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% do AuthorizationHelper.setScope(currentPageRole) %}
<div class="Contents Overview">
	{% block headlinesOverview %}
		<div class="Headlines">
			{{ HtmlHelper.link(__('back_to_overview'), {controller: page.pageRoleId.name|pluralize, action: 'overview'}, {class: 'BackToOverview'}) }}

			{% block headlineOverview %}
				<h1>{{ __('headline_overview') }}</h1>
			{% endblock %}

			{% block subheadlineOverview %}
				<h2>
					<div class="Buttons">
						{% block buttonSeoAnalysis %}
							{% if AuthorizationHelper.scopeIsAccessible('seo', [], 'analyze') %}
								{{ FormHelper.button(__d('pages', 'seo_analyze'), {class: 'Button Button-Subtle Button-Loading', id: 'SeoAnalyzeDialogButton', name: 'button', type: 'button', inert: true}) }}
							{% endif %}
						{% endblock %}

						{% block buttonPreview %}
							{{ HtmlHelper.link(__('preview'), {controller: page.pageRoleId.name|pluralize, action: 'preview', id: page.id}, {class: 'Button Button-Preview Button-Small Button-Subtle'}) }}
						{% endblock %}

						{% block buttonEdit %}
							{% if AuthorizationHelper.isAccessible('update') %}
								{{ HtmlHelper.link(__('edit'), {controller: page.pageRoleId.name|pluralize, action: 'edit', id: page.id}, {class: 'Button Button-Edit Button-Small Button-Subtle'}) }}
							{% endif %}
						{% endblock %}
					</div>

					{{ page.title }}
				</h2>
			{% endblock %}
		</div>
	{% endblock %}

	{% block buttonAreaToggle %}
		{{ FormHelper.button(__('button_area_toggle'), {class: 'Button Button-Menu', id: 'ButtonArea-Toggle', name: 'button', type: 'button'}) }}
	{% endblock %}

	{% block buttonArea %}
		<div class="ButtonArea">

			{% block categoriesFilterOverview %}
				{{ CategoriesHelper.filter('page') }}
			{% endblock %}

			{% block overviewButtons %}
				{% block overviewButtonSaveSystemOrder %}
					<button class="Button Button-SaveSystemOrder" disabled>{{ __d('system', 'save_system_order') }}</button>
				{% endblock %}

				{% block overviewButtonAdd %}
					{% if AuthorizationHelper.isAccessible('create') %}
						{{ HtmlHelper.link(__('create'), {action: 'add', pageId: page.id}, {class : 'Button Button-Add'}) }}
					{% endif %}
				{% endblock %}

				{% block overviewButtonFilter %}
					{{ element('search/filter_button', {scope: 'contents'}) }}
				{% endblock %}

				{% block listControlOverviewListWithColumns %}
					{{ HtmlHelper.link(__('overview_list_with_columns'), {
						action: 'userConfiguration',
						identifier: 'overview.columnView.enabled',
						value: 'true'
					}, {
						class: 'Button Button-Small Button-ColumnView Button-ColumnView-Enable',
						disabled: localConfig.overview.columnView.enabled == true,
					}) }}
				{% endblock %}

				{% block listControlOverviewListLinear %}
					{{ HtmlHelper.link(__('overview_list_linear'), {
						action: 'userConfiguration',
						identifier: 'overview.columnView.enabled',
						value: 'false'
					}, {
						class: 'Button Button-Small Button-ColumnView Button-ColumnView-Disable',
						disabled: localConfig.overview.columnView.enabled == false,
					}) }}
				{% endblock %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block fieldsetsOverview %}
		{% for contentAreaId, contentArea in contentAreas %}
			{% block fieldsetOverview %}
				<fieldset class="Overview-Fieldset{% if contentArea is null %} Overview-Fieldset-Unknown{% endif %}" data-content-area-id="{{ contentAreaId }}">
					{% if contentArea is null %}
						<legend>{{ __('unknown_content_area') }}</legend>
					{% else %}
						<legend>{{ contentArea }}</legend>
					{% endif %}

					{% block fieldsetOverviewInner %}
						{% block listOverview %}
							{% from '@Backend/macro/nested_list.twig' import nestedList %}
							{{ nestedList(contents[ contentAreaId ], _context|merge({
								class: localConfig.overview.columnView.enabled == true ? 'NestedList-Compact ColumnSystem-' ~ columnSystemName : null,
								contentTemplates: contentTemplates,
								data: {
									'content-area': contentAreaId,
									receivable: contentArea is null ? false : true,
									sortable: _filter['contents']['active'] == false,
								},
								displayedFields: localConfig.overview.displayedFields,
								identifier: 'Contents',
								template: '@Backend/Contents/overview_nested_list_item.twig',
							})) }}
						{% endblock %}
					{% endblock %}
				</fieldset>
			{% endblock %}
		{% endfor %}
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('categoriesFilterOverview') }}

			{{ block('overviewButtons') }}
		</div>
	{% endblock %}

	{% block listFilter %}
		{{ element('search/filter', {scope: 'contents'}) }}
	{% endblock %}
</div>

{% block seoAnalyzeDialog %}
	{% if AuthorizationHelper.scopeIsAccessible('seo', [], 'analyze') %}
		<dialog id="SeoAnalyzeDialog" data-title="{{ __d('pages', 'seo_analyze') }}" data-page-id="{{ page.id }}">
			{% block seoAnalyzeDialogButtonArea %}
				<div class="ButtonArea">
					{% block seoAnalyzeDialogCancel %}
						<button id="SeoAnalyzeDialog-Button-Close" class="Button Button-Close" style="">{{ __('close') }}</button>
					{% endblock %}
				</div>
			{% endblock %}

			{% block seoAnalyzeDialogInner %}
				<div class="Inner">
					{% block seoAnalyzeDialogTextLengthInfo %}
						<span class="SeoInfo SeoInfo-TextLength">
							<span class="Icon Loading"></span>

							<span class="Title"><strong>{{ __d('seo', 'text_length') }}</strong></span>
						</span>
					{% endblock %}

					{% block seoAnalyzeDialogHeadlineStructureInfo %}
						<span class="SeoInfo SeoInfo-HeadlineStructure">
							<span class="Icon Loading"></span>

							<span class="Title"><strong>{{ __d('seo', 'headline_structure') }}</strong></span>
						</span>
					{% endblock %}

					{% block seoAnalyzeDialogMetaTitleInfo %}
						<span class="SeoInfo SeoInfo-MetaTitle">
							<span class="Icon Loading"></span>

							<span class="Title"><strong>{{ __d('seo', 'meta_title') }}</strong></span>
						</span>
					{% endblock %}

					{% block seoAnalyzeDialogMetaDescriptionInfo %}
						<span class="SeoInfo SeoInfo-MetaDescription">
							<span class="Icon Loading"></span>

							<span class="Title"><strong>{{ __d('seo', 'meta_description') }}</strong></span>
						</span>
					{% endblock %}

					{% block seoAnalyzeDialogRobotsFollowInfo %}
						<span class="SeoInfo SeoInfo-RobotsFollow SeoInfoStatus-{{ page.robotsFollow ? 'Ok' : 'Error' }}">
							<span class="Icon">
								{% if page.robotsFollow %}
									<i class="las la-check"></i>
								{% else %}
									<i class="las la-times"></i>
								{% endif %}
							</span>

							<span class="Title">{{ __d('seo', page.robotsFollow ? 'robots_follow' : 'robots_no_follow') }}</span>
						</span>
					{% endblock %}

					{% block seoAnalyzeDialogRobotsIndexInfo %}
						<span class="SeoInfo SeoInfo-RobotsIndex SeoInfoStatus-{{ page.robotsIndex ? 'Ok' : 'Error' }}">
							<span class="Icon">
								{% if page.robotsIndex %}
									<i class="las la-check"></i>
								{% else %}
									<i class="las la-times"></i>
								{% endif %}
							</span>

							<span class="Title">{{ __d('seo', page.robotsIndex ? 'robots_index' : 'robots_no_index') }}</span>
						</span>
					{% endblock %}

					{% block seoAnalyzeDialogMostlyUsedWordsInfo %}
						<span class="SeoInfo SeoInfo-MostlyUsedWords">
							<span class="Title"><strong>{{ __d('seo', 'mostly_used_words') }}</strong></span>
						</span>
					{% endblock %}

					{% block seoAnalyzeDialogButtonAreaBottom %}
						<div class="ButtonArea ButtonArea-Bottom">
							{{ block('seoAnalyzeDialogCancel') }}
						</div>
					{% endblock %}
				</div>
			{% endblock %}
		</dialog>
	{% endif %}
{% endblock %}

{% block scriptColumnSystemVars %}
	<script nonce="{{ AssetHelper.getScriptNonce() }}">
		const columnWidths = {{ columnWidths|values|json_encode|raw }};
		const columnIndents = {{ columnIndents|values|json_encode|raw }};
		const columnSystemName = '{{ columnSystemName }}';
	</script>
{% endblock %}