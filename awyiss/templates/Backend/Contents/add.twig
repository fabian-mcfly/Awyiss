{#
@var content \Awyiss\Model\Entity\Content
@var contentTemplates \Cake\Collection\CollectionInterface
@var possibleParentContents \Cake\Collection\CollectionInterface
@var page \Awyiss\Model\Entity\Page
@var assignedAttributes array
@var contentAreas array
@var contentElementsByFieldset ContentTemplateElement[]
@var allowedKeys array
@var currentPageRole string
@var languageRealm string
@var languageShortcode string
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% do AuthorizationHelper.setScope(currentPageRole) %}

<div class="Contents Form Add">
	{% block headlinesAdd %}
		<div class="Headlines">
			{% if AuthorizationHelper.isAccessible('read') %}
				{{ HtmlHelper.link(__('back_to_overview'), {action: 'overview', pageId: content.getOriginal('pageId', true) }, {class: 'BackToOverview'}) }}
			{% endif %}

			{% block headlineAdd %}
				<h1>{{ __('headline_add') }}</h1>
			{% endblock %}
		</div>
	{% endblock %}

	{% block buttonAreaToggle %}
		{{ FormHelper.button(__('button_area_toggle'), {class: 'Button Button-Menu', id: 'ButtonArea-Toggle', name: 'button', type: 'button'}) }}
	{% endblock %}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block formAddButtons %}
				{% block formAddButtonSave %}
					{{ FormHelper.button(__('save'), {class: 'Button Button-Success Button-Save', form: 'ContentForm'}) }}
				{% endblock %}

				{% block formAddButtonSaveClose %}
					{% if AuthorizationHelper.isAccessible('read') %}
						{{ FormHelper.button(__('save_close'), {class: 'Button Button-SaveClose', form: 'ContentForm', name: 'submit', value: 'submit_close'}) }}
					{% endif %}
				{% endblock %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block formAdd %}
		{% include('@Backend/Contents/form.twig') %}
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('formAddButtons') }}
		</div>
	{% endblock %}
</div>
