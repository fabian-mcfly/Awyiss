{#
@var ao_contentTemplates \Awyiss\Model\Entity\ContentTemplate[]
@var _view \Awyiss\View\BackendView
#}

<div class="ContentTemplates Overview">
	{% block buttonsOverview %}
		{% if AuthorizationHelper.isAccessible('create') %}
			{{ HtmlHelper.link(__('create'), {action: 'add'}, {class: 'Button'}) }}
		{% endif %}
	{% endblock %}

	{% block headlineOverview %}
		<h1>{{ __('headline_overview') }}</h1>
	{% endblock %}

	{% block tableOverview %}
		<table class="Table-Overview">
			{% block tableOverviewHead %}
				<thead>
					{% block tableOverviewHeadRow %}
						<tr>
							{% block tableOverviewHeaderTitle %}
								<th>{{ __('title') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderFileName %}
								<th>{{ __('file_name') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderUsedForContents %}
								<th>{{ __('used_for_contents') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderActions %}
								<th class="actions"></th>
							{% endblock %}
						</tr>
					{% endblock %}
				</thead>
			{% endblock %}
			{% block tableOverviewBody %}
				<tbody>
					{# @var lo_contentTemplate \Awyiss\Model\Entity\ContentTemplate #}
					{% for lo_contentTemplate in ao_contentTemplates %}
						{% block tableOverviewBodyRow %}
							<tr>
								{% block tableOverviewCellTitle %}
									<td>{{ lo_contentTemplate.title }} ({{ lo_contentTemplate.systemOrder }})</td>
								{% endblock %}

								{% block tableOverviewCellFileName %}
									<td>{{ lo_contentTemplate.fileName }}</td>
								{% endblock %}

								{% block tableOverviewCellUsedForContents %}
									<td>{{ lo_contentTemplate.usedForContents }}</td>
								{% endblock %}

								{% block tableOverviewCellActions %}
									<td class="actions">
										{% if AuthorizationHelper.isAccessible('update') %}
											{{ HtmlHelper.link(__('edit'), {action: 'edit', id: lo_contentTemplate.id}) }}
										{% endif %}
										{% if AuthorizationHelper.isAccessible('delete') %}
											{% if lo_contentTemplate.usedForContents == 0 %}
												{{ HtmlHelper.link(__('delete'), {action: 'delete', id: lo_contentTemplate.id}, {
				class: 'Button Button-Small Button-Delete',
				'data-confirm-title': __('confirm_delete_title'),
				'data-confirm-yes': __('confirm_delete_yes'),
				'data-confirm-yes-class': 'Button-Delete',
				'data-confirm-no': __('confirm_delete_no'),
				'data-confirm': __('confirm_delete', lo_contentTemplate.id) }) }}
											{% else %}
												<a>{{ __('delete') }}</a>
											{% endif %}
										{% endif %}
									</td>
								{% endblock %}
							</tr>
						{% endblock %}
					{% endfor %}
				</tbody>
			{% endblock %}
		</table>
	{% endblock %}
</div>
