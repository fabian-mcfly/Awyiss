{#
@var ao_contentTemplate \Awyiss\Model\Entity\ContentTemplate
@var aa_availableContentElements array
@var aa_availableContentAttributes array
@var aa_availableFieldsets array
@var aa_pageTemplates
@var _view \Awyiss\View\BackendView
#}

{% set la_availableFieldsets = [] %}
{% for ls_fieldset in aa_availableFieldsets %}
	{% set la_availableFieldsets = la_availableFieldsets|merge({(ls_fieldset): __d('contents', 'fieldset_' ~ ls_fieldset)}) %}
{% endfor %}

{% set la_assignedContentAreas = [] %}
{% for lo_contentTemplateContentArea in ao_contentTemplate.contentAreas %}
	{% set ls_key = lo_contentTemplateContentArea._joinData.pageTemplateId ~ '_' ~ lo_contentTemplateContentArea.id %}
	{% set la_assignedContentAreas = la_assignedContentAreas|merge([ls_key]) %}
{% endfor %}

{% block fieldsetPresentation %}
	<fieldset class="Fieldset-Presentation">
		<legend>{{ __('fieldset_presentation') }}</legend>

		{% block fieldsetPresentationInner %}
			{% block formControlActive %}
				{{ FormHelper.control('active') }}
			{% endblock %}

			{% block fieldsetPresentationAttributes %}
				{{ AttributesHelper.allControls('presentation') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetConditions %}
	<fieldset class="Fieldset-Conditions">
		<legend>{{ __('fieldset_conditions') }}</legend>

		{% block fieldsetConditionsInner %}
			{% block formControlSystemOrder %}
				{{ SystemOrderHelper.control('system_order', {entity: ao_contentTemplate}) }}
			{% endblock %}

			{% block fieldsetConditionsAttributes %}
				{{ AttributesHelper.allControls('conditions') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetGeneral %}
	<fieldset class="Fieldset-General">
		<legend>{{ __('fieldset_general') }}</legend>

		{% block fieldsetGeneralInner %}
			{% block formControlTitle %}
				{{ FormHelper.control('title') }}
			{% endblock %}

			{% block formControlFileName %}
				{{ FormHelper.control('file_name') }}
			{% endblock %}

			{% block fieldsetGeneralAttributes %}
				{{ AttributesHelper.allControls('general') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetContentElements %}
	<fieldset class="Fieldset-ContentElements">
		<legend>{{ __('content_elements') }}</legend>

		{% block fieldsetContentElementsInner %}
			{% block formControlContentElements %}
				{% set la_assignedContentElements = (ao_contentTemplate.contentTemplateElements ?? [])|column('identifier') %}

				<ul class="NoList ContentElements">
					{% set li_elementCounter = 0 %}
					{% for ls_availableElement, lb_assignable in aa_availableContentElements %}
						{% set lo_contentTemplateElement = ls_availableElement in la_assignedContentElements ? ao_contentTemplate.contentTemplateElements[ li_elementCounter ] : null %}

						{% block formControlContentElement %}
							<li>
								<label for="ContentTemplate-ContentElements-{{ ls_availableElement|camelize }}">
									{% if lb_assignable == false %}
										{{ FormHelper.hidden('content_template_elements[' ~ loop.index0 ~ '][identifier]', {
											value: ls_availableElement,
										}) }}
									{% endif %}
									{{ FormHelper.checkbox('content_template_elements[' ~ loop.index0 ~ '][identifier]', {
										checked: lb_assignable == false or ls_availableElement in la_assignedContentElements,
										disabled: lb_assignable == false,
										hiddenField: false,
										id: 'ContentTemplate-ContentElements-' ~ ls_availableElement|camelize,
										value: ls_availableElement,
									}) }}

									{{ __d('contents', ls_availableElement) }}
								</label>

								<label for="ContentTemplate-ContentElements-{{ ls_availableElement|camelize }}-Fieldset">
									Fieldset
									{{ FormHelper.select('content_template_elements[' ~ loop.index0 ~ '][fieldset]', la_availableFieldsets, {
										id: 'ContentTemplate-ContentElements-' ~ ls_availableElement|camelize ~ '-Fieldset',
										val: lo_contentTemplateElement ? lo_contentTemplateElement.fieldset : null,
									}) }}

									{% if (lo_contentTemplateElement) %}
										{% block contentElementFieldsetError %}
											{{ FormHelper.error('content_template_elements.' ~ li_elementCounter ~ '.fieldset') }}
										{% endblock %}
									{% endif %}
								</label>

								{% if ls_availableElement != 'duplicate_of' %}
									<label for="ContentTemplate-ContentElements-{{ ls_availableElement|camelize }}-Required">
										{{ FormHelper.checkbox('content_template_elements[' ~ loop.index0 ~ '][required]', {
											checked: lo_contentTemplateElement ? lo_contentTemplateElement.required : false,
											hiddenField: true,
											id: 'ContentTemplate-ContentElements-' ~ ls_availableElement|camelize ~ '-Required',
											value: true,
										}) }}

										solls auch pflichtfeld sein?
									</label>
								{% endif %}
							</li>
						{% endblock %}

						{% if ls_availableElement in la_assignedContentElements %}
							{% set li_elementCounter = li_elementCounter + 1 %}
						{% endif %}
					{% endfor %}

					{% for la_contentAttribute in aa_availableContentAttributes %}
						{% set lo_contentTemplateElement = 'attributes.' ~ la_contentAttribute.identifier in la_assignedContentElements ? ao_contentTemplate.contentTemplateElements[ li_elementCounter ] : null %}

						{% block formControlContentAttribute %}
							<li>
								<label for="ContentTemplate-ContentAttribute-{{ la_contentAttribute.identifier|camelize }}">
									{{ FormHelper.checkbox('content_template_elements[' ~ (loop.index0 + aa_availableContentElements|length) ~ '][identifier]', {
										checked: 'attributes.' ~ la_contentAttribute.identifier in la_assignedContentElements,
										hiddenField: false,
										id: 'ContentTemplate-ContentAttribute-' ~ la_contentAttribute.identifier|camelize,
										value: 'attributes.' ~ la_contentAttribute.identifier,
									}) }}

									{{ la_contentAttribute.label }}
								</label>

								<label for="ContentTemplate-ContentAttribute-{{ la_contentAttribute.identifier|camelize }}-Fieldset">
									Fieldset

									{{ FormHelper.select('content_template_elements[' ~ (loop.index0 + aa_availableContentElements|length) ~ '][fieldset]', la_availableFieldsets, {
										id: 'ContentTemplate-ContentAttribute-' ~ la_contentAttribute.identifier|camelize ~ '-Fieldset',
										required: true,
										val: lo_contentTemplateElement ? lo_contentTemplateElement.fieldset : null,
									}) }}

									{% if lo_contentTemplateElement %}
										{% block contentAttributeFieldsetError %}
											{{ FormHelper.error('content_template_elements.' ~ li_elementCounter ~ '.fieldset') }}
										{% endblock %}
									{% endif %}
								</label>

								{% if la_contentAttribute.active %}
									<label for="ContentTemplate-ContentAttribute-{{ la_contentAttribute.identifier|camelize }}-Required">
										{{ FormHelper.checkbox('content_template_elements[' ~ (loop.index0 + aa_availableContentElements|length) ~ '][required]', {
											checked: lo_contentTemplateElement ? lo_contentTemplateElement.required : false,
											hiddenField: true,
											id: 'ContentTemplate-ContentAttribute-' ~ la_contentAttribute.identifier|camelize ~ '-Required',
											value: true,
										}) }}

										solls auch pflichtfeld sein?
									</label>
								{% endif %}
							</li>
						{% endblock %}

						{% if ls_availableElement in la_assignedContentElements %}
							{% set li_elementCounter = li_elementCounter + 1 %}
						{% endif %}
					{% endfor %}
				</ul>
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetContentAreas %}
	<fieldset class="Fieldset-PageTemplates">
		<legend>{{ __('page_templates') }}</legend>

		{% block fieldsetContentAreasErrors %}
			{% if ao_contentTemplate.error('contentTemplateContentAreas') %}
				{% for li_key, lo_contentTemplateContentArea in ao_contentTemplate.contentTemplateContentAreas %}
					{% for ls_key, ls_error in lo_contentTemplateContentArea.errors %}
						{{ FormHelper.error('contentTemplateContentAreas.' ~ li_key ~ '.' ~ ls_key) }}
					{% endfor %}
				{% endfor %}
			{% endif %}
		{% endblock %}

		{% block fieldsetContentAreaInner %}
			{% for ls_pageRole, la_pageTemplates in aa_pageTemplates %}
				{% block fieldsetPageRole %}
					<fieldset class="Fieldset-PageRoles">
						{% block fieldsetPageRoleInner %}
							<legend>{{ ls_pageRole }}</legend>

							{% block formControlPageTemplates %}
								<table class="PageTemplates">
									<thead>
										<tr>
											<th>
												{{ __d('page_templates', 'title') }}
											</th>
											<th>
												{{ __d('page_templates', 'content_areas') }}
											</th>
										</tr>
									</thead>
									<tbody>
										{# @var lo_pageTemplate \Awyiss\Model\Entity\PageTemplate #}
										{% for lo_pageTemplate in la_pageTemplates %}
											{% block formControlPageTemplate %}
												<tr>
													<td>
														<strong>{{ lo_pageTemplate.label  }}</strong>
													</td>
													<td>
														{% for li_key, lo_contentArea in lo_pageTemplate.contentAreas %}
															{% set li_key = loop.parent.loop.parent.loop.index0 ~ loop.parent.loop.index0 ~ li_key %}

															{{ FormHelper.control('content_areas[' ~ li_key ~ '][content_area_id]', {
																checked: (lo_pageTemplate.id ~ '_' ~ lo_contentArea.id) in la_assignedContentAreas,
																hiddenField: false,
																id: 'ContentTemplate-ContentAreas-' ~ lo_pageTemplate.fileName|camelize ~'-' ~ lo_contentArea.identifier|camelize,
																label: lo_contentArea.label,
																type: 'checkbox',
																value: lo_contentArea.id,
															}) }}

															{{ FormHelper.hidden('content_areas[' ~ li_key ~'][page_template_id]', {
																value: lo_pageTemplate.id
															}) }}
														{% endfor %}
													</td>
												</tr>
											{% endblock %}
										{% endfor %}
									</tbody>
								</table>
							{% endblock %}
						{% endblock %}
					</fieldset>
				{% endblock %}
			{% endfor %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetContent %}
	<fieldset class="Fieldset-Content">
		<legend>{{ __('fieldset_content') }}</legend>

		{% block fieldsetContentInner %}
			{% block fieldsetContentAttributes %}
				{{ AttributesHelper.allControls('content') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetMedia %}
	<fieldset class="Fieldset-Media">
		<legend>{{ __('fieldset_media') }}</legend>

		{% block fieldsetMediaInner %}
			{% block fieldsetMediaAttributes %}
				{{ AttributesHelper.allControls('media') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetAttributes %}
	<fieldset class="Fieldset-Attributes">
		<legend>{{ __('fieldset_attributes') }}</legend>

		{% block fieldsetAttributesInner %}
			{% block fieldsetAttributesAttributes %}
				{{ AttributesHelper.allControls('attributes') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block formInputReloadForm %}
	{{ FormHelper.hidden('reload_form', {val: 0}) }}
{% endblock %}
