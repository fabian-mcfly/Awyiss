{#
@var ao_contentTemplate \Awyiss\Model\Entity\ContentTemplate
@var aa_availableContentElements array
@var aa_availableContentAttributes array
@var aa_availableFieldsets array
@var aa_pageTemplates
@var _view \Awyiss\View\BackendView
#}

<div class="ContentTemplates Form Edit">
	{{ helper_Form_create(ao_contentTemplate, {method: 'post', idPrefix: 'ContentTemplate'}) }}

	{% block headlineEdit %}
		<h1>{{ __('headline_edit') }}</h1>
	{% endblock %}

	{% block formEditButtons %}
		{{ helper_Form_button(__('save')) }}
		{{ helper_Form_button(__('save_close'), {name: 'submit', value: 'submit_close'}) }}
	{% endblock %}

	{% block formEdit %}
		{% include('@Backend/ContentTemplates/form.twig') %}
	{% endblock %}

	{% block formEditButtonsBottom %}
		{{ block('formEditButtons') }}
	{% endblock %}

	{{ helper_Form_end() -}}
</div>
