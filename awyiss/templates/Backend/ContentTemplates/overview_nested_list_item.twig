{% extends '@Backend/element/overview/nested_list_item.twig' %}

{% block nestedListItemDataDefaultFields %}
	<li class="DataItem DataItem-UsedForContents">
		<span class="Label">{{ __('used_for_contents') }}:</span>
		{{ entity.usedForContents }}
	</li>
{% endblock %}

{% block nestedListActionsDelete %}
	{% if entity.usedForContents == 0 %}
		{{ parent() }}
	{% else %}
		{% if AuthorizationHelper.isAccessible('delete') %}
			<!--suppress HtmlUnknownAttribute -->
			<a class="Button Button-Small Button-Delete" disabled>{{ __('delete') }}</a>
		{% endif %}
	{% endif %}
{% endblock %}