{% extends '@Backend/element/overview/overview_paginated_list.twig' %}

{% block tableOverviewHeaderDefaultFields %}
	<th class="TableHeader-UsedForEmails{% if PaginatorHelper.isCurrentSortKey('usedForEmails') %} Active{% endif %}">{{ PaginatorHelper.sort('usedForEmails') }}</th>
	<th class="TableHeader-UsedForConfirmationEmails{% if PaginatorHelper.isCurrentSortKey('usedForConfirmationEmails') %} Active{% endif %}">{{ PaginatorHelper.sort('usedForConfirmationEmails') }}</th>
{% endblock %}

{% block tableOverviewCellDefaultFields %}
	<td class="TableCell-UsedForEmails">{{ entity.usedForEmails }}</td>
	<td class="TableCell-UsedForConfirmationEmails">{{ entity.usedForConfirmationEmails }}</td>
{% endblock %}

{% block tableOverviewCellActions %}
	<td class="TableCell-Actions">
		<div class="Actions">
			{% block tableOverviewCellActionsPreview %}
				{{ HtmlHelper.link(__('preview'), {action: 'preview', id: entity.id}, {class: 'Button Button-Small Button-Preview'}) }}
			{% endblock %}

			{{ block('tableOverviewCellActionsUpdate') }}

			{% block tableOverviewCellActionsDelete %}
				{% if entity.usedForEmails == 0 and entity.usedForConfirmationEmails == 0 %}
					{{ parent() }}
				{% else %}
					{% if AuthorizationHelper.isAccessible('delete') %}
						<!--suppress HtmlUnknownAttribute -->
						<a class="Button Button-Small Button-Delete" disabled>{{ __('delete') }}</a>
					{% endif %}
				{% endif %}
			{% endblock %}
		</div>
	</td>
{% endblock %}

{% block tableOverviewFootColSpan %}{{ localConfig.overview.displayedFields|length + 6 }}{% endblock %}
