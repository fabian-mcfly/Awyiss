{#
@var menuEntry \Awyiss\Model\Entity\MenuEntry
@var possibleParentMenuEntries \Cake\Collection\Iterator\TreeIterator
@var languageRealm string
@var _view \Awyiss\View\BackendView
#}

{% do AuthorizationHelper.setScope('menus') %}

<div class="MenuEntries Form Add">
	{% if AuthorizationHelper.isAccessible('read') %}
		{{ HtmlHelper.link(__('back_to_overview'), {action: 'overview'}, {class: 'BackToOverview'}) }}
	{% endif %}

	{% block headlineAdd %}
		<h1>{{ __('headline_add') }}</h1>
	{% endblock %}

	{{ FormHelper.create(menuEntry, {method: 'post', idPrefix: 'menuEntry'}) }}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block formAddButtons %}
				{% block formAddButtonSave %}
					{{ FormHelper.button(__('save'), {class: 'Button Button-Success Button-Save'}) }}
				{% endblock %}

				{% block formAddButtonSaveClose %}
					{% if AuthorizationHelper.isAccessible('read') %}
						{{ FormHelper.button(__('save_close'), {class: 'Button Button-SaveClose', name: 'submit', value: 'submit_close'}) }}
					{% endif %}
				{% endblock %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block formAdd %}
		{% include('@Backend/MenuEntries/form.twig') %}
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('formAddButtons') }}
		</div>
	{% endblock %}

	{{ FormHelper.end() }}
</div>