{#
@var menuEntries \Awyiss\Model\Entity\MenuEntry[]|Cake\Datasource\Paging\PaginatedResultSet
@var menu \Awyiss\Model\Entity\Menu
@var paginated bool
@var pages \Cake\Collection\CollectionInterface
@var _view \Awyiss\View\BackendView
#}

{% do AuthorizationHelper.setScope('menus') %}
{% set selectedMenuId = CategoriesHelper.getSelectedCategory('menu') %}

<div class="MenuEntries Overview">
	{% if AuthorizationHelper.isAccessible('read') %}
		{{ HtmlHelper.link(__('menus_overview'), {controller: 'menus', action: 'overview'}, {class: 'BackToOverview'}) }}
	{% endif %}

	{% block headlineOverview %}
		<h1>{{ __('headline_overview') }}</h1>
		<h2>
			{{ menu.title }}

			{% block buttonEdit %}
				{% if AuthorizationHelper.isAccessible('update') %}
					{{ HtmlHelper.link(__('edit'), {controller: 'menus', action: 'edit', id: menu.id}, {class: 'Button Button-Edit Button-Small Button-Subtle'}) }}
				{% endif %}
			{% endblock %}
		</h2>
	{% endblock %}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block categoriesFilterOverview %}
				{{ CategoriesHelper.filter('menu', naturalSort(CategoriesHelper.getCategories('menu'))) }}
			{% endblock %}

			{% block overviewButtons %}
				{% block overviewButtonSaveSystemOrder %}
					{% if paginated == false %}
						<button class="Button Button-SaveSystemOrder" disabled>{{ __d('system', 'save_system_order') }}</button>
					{% endif %}
				{% endblock %}

				{% block overviewButtonAdd %}
					{% if AuthorizationHelper.isAccessible('create') %}
						{{ HtmlHelper.link(__('create'), {action: 'add', menuId: selectedMenuId}, {class : 'Button Button-Add'}) }}
					{% endif %}
				{% endblock %}

				{% block listControlOverviewListPaginated %}
					{{ HtmlHelper.link(__('list_paginated'), {action: 'userConfiguration', identifier: 'paginate.enabled', value: 'true'}, {
						class: 'Button Button-Small Button-ListView Button-ListView-PaginatedList',
						disabled: localConfig.paginate.enabled == true
					}) }}
				{% endblock %}

				{% block listControlOverviewListNested %}
					{{ HtmlHelper.link(__('list_nested'), {action: 'userConfiguration', identifier: 'paginate.enabled', value: 'false'}, {
						class: 'Button Button-Small Button-ListView Button-ListView-NestedList',
						disabled: localConfig.paginate.enabled == false
					}) }}
				{% endblock %}
			{% endblock %}
		</div>
	{% endblock %}

	{% if paginated %}
		{% block paginatedOverview %}
			{% include '@Backend/element/overview/overview_paginated_list.twig' with _context|merge({records: menuEntries.items().toArray()}) %}
		{% endblock %}
	{% else %}
		{% block listPages %}
			<div class="Overview-List Pages-List">
				{% from '@Backend/macro/nested_list.twig' import nestedList %}
				{{ nestedList(pages, _context|merge({
					identifier: 'Page',
					template: '@Backend/MenuEntries/overview_nested_list_page_item.twig',
					data: {
						nestable: false,
						sortable: false,
					},
				})) }}
			</div>
		{% endblock %}
		{% block listOverview %}
			<div class="Overview-List">
				{% from '@Backend/macro/nested_list.twig' import nestedList %}
				{{ nestedList(menuEntries, _context|merge({
					data: {
						'menu-id': selectedMenuId,
					},
					displayedFields: localConfig.overview.displayedFields,
					identifier: 'MenuEntry',
				})) }}
			</div>
		{% endblock %}
	{% endif %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('categoriesFilterOverview') }}

			{{ block('overviewButtons') }}
		</div>
	{% endblock %}
</div>
