{#
@var ao_menuEntries \Awyiss\Model\Entity\MenuEntry[]
@var _view \Awyiss\View\BackendView
#}

{% set li_selectedMenuId = helper_Categories_getSelectedCategory('menu') %}

<div class="MenuEntries Overview">
	{% block buttonsOverview %}
		{% if helper_Authorization_isAccessible('create') %}
			{{ helper_Html_link(__('create'), {action: 'add', menuId: li_selectedMenuId}, {class : 'Button'}) }}
		{% endif %}
	{% endblock %}

	{% block headlineOverview %}
		<h1>{{ __('headline_overview') }}</h1>
	{% endblock %}

	{% block categoriesFilterOverview %}
		{{ helper_Categories_filter('menu') }}
	{% endblock %}

	{% block tableOverview %}
		<table class="Table-Overview">
			{% block tableOverviewHead %}
				<thead>
					{% block tableOverviewHeadRow %}
						<tr>
							{% block tableOverviewHeaderTitle %}
								<th>{{ __('title') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderLink %}
								<th>{{ __('link') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderExternal %}
								<th>{{ __('external') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderSystemOrder %}
								<th>{{ __('system_order') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderActions %}
								<th class="actions"></th>
							{% endblock %}
						</tr>
					{% endblock %}
				</thead>
			{% endblock %}
			{% block tableOverviewBody %}
				<tbody>
					{# @var lo_menuEntry \Awyiss\Model\Entity\MenuEntry #}
					{% for lo_menuEntry in ao_menuEntries %}
						{% block tableOverviewBodyRow %}
							<tr>
								{% block tableOverviewCellTitle %}
									<td>{{ lo_menuEntry.title }}</td>
								{% endblock %}

								{% block tableOverviewCellLink %}
									<td>{{ lo_menuEntry.link }}</td>
								{% endblock %}

								{% block tableOverviewCellExternal %}
									<td>{{ lo_menuEntry.external }}</td>
								{% endblock %}

								{% block tableOverviewCellSystemOrder %}
									<td>level {{ lo_menuEntry.level }} - order {{ lo_menuEntry.systemOrder }}</td>
								{% endblock %}

								{% block tableOverviewCellActions %}
									<td class="actions">
										{% if helper_Authorization_isAccessible('update') %}
											{{ helper_Html_link(__('edit'), {action: 'edit', id: lo_menuEntry.id}) }}
										{% endif %}
										{% if helper_Authorization_isAccessible('delete') %}
											{{ helper_Html_link(__('delete'), {action: 'delete', id: lo_menuEntry.id}, {confirm: __('confirm_delete', lo_menuEntry.id) }) }}
										{% endif %}
									</td>
								{% endblock %}
							</tr>
						{% endblock %}
					{% endfor %}
				</tbody>
			{% endblock %}
		</table>
	{% endblock %}
</div>
