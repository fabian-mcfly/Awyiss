{#
@var la_menuEntries \Awyiss\Model\Entity\MenuEntry[]
@var ab_paginated bool
@var _view \Awyiss\View\BackendView
#}

{% block tableOverview %}
	<table class="Table-Overview">
		{% block tableOverviewHead %}
			<thead>
				{% block tableOverviewHeadRow %}
					<tr>
						{% block tableOverviewHeaderTitle %}
							<th>{{ PaginatorHelper.sort('title') }}</th>
						{% endblock %}

						{% block tableOverviewHeaderLink %}
							<th>{{ PaginatorHelper.sort('link') }}</th>
						{% endblock %}

						{% block tableOverviewHeaderExternal %}
							<th>{{ PaginatorHelper.sort('external') }}</th>
						{% endblock %}

						{% block tableOverviewHeaderSystemOrder %}
							<th>{{ PaginatorHelper.sort('system_order') }}</th>
						{% endblock %}

						{% block tableOverviewHeaderActions %}
							<th class="actions"></th>
						{% endblock %}
					</tr>
				{% endblock %}
			</thead>
		{% endblock %}
		{% block tableOverviewBody %}
			<tbody>
				{# @var lo_menuEntry \Awyiss\Model\Entity\MenuEntry #}
				{% for lo_menuEntry in la_menuEntries %}
					{% block tableOverviewBodyRow %}
						<tr>
							{% block tableOverviewCellTitle %}
								<td>{{ lo_menuEntry.title }}</td>
							{% endblock %}

							{% block tableOverviewCellLink %}
								<td>{{ lo_menuEntry.link }}</td>
							{% endblock %}

							{% block tableOverviewCellExternal %}
								<td>{{ lo_menuEntry.external }}</td>
							{% endblock %}

							{% block tableOverviewCellSystemOrder %}
								<td>level {{ lo_menuEntry.level }} - order {{ lo_menuEntry.systemOrder }}</td>
							{% endblock %}

							{% block tableOverviewCellActions %}
								<td class="actions">
									{% if AuthorizationHelper.isAccessible('update') %}
										{{ HtmlHelper.link(__('edit'), {action: 'edit', id: lo_menuEntry.id}) }}
									{% endif %}
									{% if AuthorizationHelper.isAccessible('delete') %}
										{{ HtmlHelper.link(__('delete'), {action: 'delete', id: lo_menuEntry.id}, {
				class: 'Button Button-Small Button-Delete',
				'data-confirm-title': __('confirm_delete_title'),
				'data-confirm-yes': __('confirm_delete_yes'),
				'data-confirm-yes-class': 'Button-Delete',
				'data-confirm-no': __('confirm_delete_no'),
				'data-confirm': __('confirm_delete', lo_menuEntry.id) }) }}
									{% endif %}
								</td>
							{% endblock %}
						</tr>
					{% endblock %}
				{% endfor %}
			</tbody>
		{% endblock %}
	</table>
{% endblock %}