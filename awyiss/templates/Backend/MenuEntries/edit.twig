{#
@var ao_menuEntry \Awyiss\Model\Entity\MenuEntry
@var ao_possibleParentMenuEntries \Cake\Collection\Iterator\TreeIterator
@var as_languageRealm string
@var _view \Awyiss\View\BackendView
#}

<div class="MenuEntries Form Edit">
	{{ FormHelper.create(ao_menuEntry, {method: 'post', idPrefix: 'menuEntry'}) }}

	{{ FormHelper.checkbox('save_as_copy', {id: 'SaveAsCopy', value: true}) }}

	{% block headlineEdit %}
		<h1>{{ __('headline_edit') }}</h1>
	{% endblock %}

	{% block formEditButtons %}
		<label for="SaveAsCopy">{{ __('as_copy') }}</label>
		{{ FormHelper.button(__('save')) }}
		{{ FormHelper.button(__('save_close'), {name: 'submit', value: 'submit_close'}) }}
	{% endblock %}

	{% block formEdit %}
		{% include('@Backend/MenuEntries/form.twig') %}
	{% endblock %}

	{% block formEditButtonsBottom %}
		{{ block('formEditButtons') }}
	{% endblock %}

	{{ FormHelper.end() -}}
</div>