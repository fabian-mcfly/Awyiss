{#
@var menuEntry \Awyiss\Model\Entity\MenuEntry
@var possibleParentMenuEntries \Cake\Collection\Iterator\TreeIterator
@var languageRealm string
@var _view \Awyiss\View\BackendView
#}

{% do AuthorizationHelper.setScope('menus') %}

<div class="MenuEntries Form Edit">
	{% block headlinesEdit %}
		<div class="Headlines">
			{% if AuthorizationHelper.isAccessible('read') %}
				{{ HtmlHelper.link(__('back_to_overview'), {action: 'overview'}, {class: 'BackToOverview'}) }}
			{% endif %}

			{% block headlineEdit %}
				<h1>{{ __('headline_edit') }}</h1>
			{% endblock %}
		</div>
	{% endblock %}

	{{ FormHelper.checkbox('save_as_copy', {form: 'MenuEntryForm', id: 'SaveAsCopy', value: true}) }}

	{% block buttonAreaToggle %}
		{{ FormHelper.button(__('button_area_toggle'), {class: 'Button Button-Menu', id: 'ButtonArea-Toggle', name: 'button', type: 'button'}) }}
	{% endblock %}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block formEditButtons %}
				{% block formEditButtonSaveAsCopy %}
					<label for="SaveAsCopy" tabindex="0" class="Button Button-SaveAsCopy Label-SaveAsCopy">{{ __('as_copy') }}</label>
				{% endblock %}

				{% block formEditButtonSave %}
					{{ FormHelper.button(__('save'), {class: 'Button Button-Success Button-Save', form: 'MenuEntryForm'}) }}
				{% endblock %}

				{% block formEditButtonSaveClose %}
					{% if AuthorizationHelper.isAccessible('read') %}
						{{ FormHelper.button(__('save_close'), {class: 'Button Button-SaveClose', form: 'MenuEntryForm', name: 'submit', value: 'submit_close'}) }}
					{% endif %}
				{% endblock %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block formEdit %}
		{% include('@Backend/MenuEntries/form.twig') %}
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('formEditButtons') }}
		</div>
	{% endblock %}
</div>