<!DOCTYPE html>
<html lang="en">
	<head>
		{% block head %}
			{{ HtmlHelper.charset() }}
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>{{ fetch('title') }}</title>

		{{ helper_Html_meta('icon') }}

			{% block headStylesheets %}
				{% do AssetHelper.add('main.css', [], true) %}
			{% endblock %}

			{% block headScripts %}
				{{ element('scripts', {controller: controller}) }}
			{% endblock %}

			{% block headAssetTags %}
				{{ AssetHelper.createImportMap() }}
				{{ AssetHelper.getTags() }}
			{% endblock %}
		{% endblock %}
	</head>
	<body>
		{% block body %}
			{% block header %}
				<header id="Header">
					{% block title %}
						<a href="{{ UrlHelper.build({controller: 'dashboard', action: 'overview'}) }}" class="Title">
							Aw<span class="Yiss">Yiss</span>
							<span class="Version">
								<span class="VersionNo">v{{ Awyiss.VERSION }}</span>
								<span class="VersionName">{{ Awyiss.VERSION_NAME }}</span>
							</span>
						</a>
					{% endblock %}

					{% block systemMenu %}
						{{ cell('Backend/Menu') }}
					{% endblock %}

					{% block logout %}
						<a href="{{ UrlHelper.build({controller: 'users', action: 'logout'}) }}" class="Logout">{{ __d('users', 'logout') }}</a>
					{% endblock %}

					{% block loginLogo %}
						{% if loginLogoPath %}
							<img src="{{ UrlHelper.build(loginLogoPath) }}" alt="{{ __d('users', 'loginLogo') }}" class="LoginLogo">
						{% endif %}
					{% endblock %}
				</header>
			{% endblock %}

			{% block content %}
				<main id="Content">
					{% block flashMessages %}
						{{ FlashHelper.render() }}
					{% endblock %}

					{{ fetch('content') }}
				</main>
			{% endblock %}
		{% endblock %}
	</body>
</html>
