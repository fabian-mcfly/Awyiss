{#
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}{% set controller = fetch('controllerName') ?: _view.getRequest().getParam('controller') -%}
<!DOCTYPE html>
<html
	lang="{{ currentLanguage.shortcode }}"
	class="
		{%- if config.Awyiss.System.Backend.interface.darkMode == true %} 🌚{% endif -%}
		{%- if config.Awyiss.System.Backend.interface.disctractionFreeMode == true %} 👀{% endif -%}
		{%- if config.Awyiss.System.Backend.interface.scale and config.Awyiss.System.Backend.interface.scale != 'regular' %} Scale-{{ config.Awyiss.System.Backend.interface.scale|camelize }}{% endif -%}
	">
	<head>
		{% block head %}
			{{ HtmlHelper.charset() }}
			<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
			<meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
			<base href="{{ baseUrl }}">

			{% set metaTitle = fetch('metaTitle') %}
			{% if metaTitle == '' %}
				{% set identifier = 'meta_title_' ~ _view.getRequest().getParam('action')|underscore %}
				{% set metaTitle = __(identifier) %}
				{% if metaTitle ends with identifier and (isGenericPage or isGenericDatatable) %}
					{% set metaTitle = __d(isGenericDatatable ? 'generic_datatables' : 'generic_pages', identifier, isGenericDatatable ? datatables.title : pageRole.title) %}
				{% endif %}

				{% set metaTitle = metaTitle ~ config('Awyiss.System.Backend.meta.titleSeparator') ~ config('Awyiss.System.Backend.meta.titleAppendix') %}
			{% endif %}
			<title>{{ metaTitle }}</title>

			{% block favicons %}
				<link rel="apple-touch-icon" sizes="180x180" href="{{ baseUrl }}awyiss/assets/favicon/apple-touch-icon.png">
				<link rel="icon" type="image/png" sizes="32x32" href="{{ baseUrl }}awyiss/assets/favicon/favicon-32x32.png">
				<link rel="icon" type="image/png" sizes="16x16" href="{{ baseUrl }}awyiss/assets/favicon/favicon-16x16.png">
				<link rel="manifest" href="{{ baseUrl }}awyiss/assets/favicon/site.webmanifest">
				<link rel="mask-icon" href="{{ baseUrl }}awyiss/assets/favicon/safari-pinned-tab.svg" color="#63d1a5">
				<link rel="shortcut icon" href="{{ baseUrl }}awyiss/assets/favicon/favicon.ico">
				<meta name="msapplication-TileColor" content="#ffffff">
				<meta name="msapplication-config" content="{{ baseUrl }}awyiss/assets/favicon/browserconfig.xml">
				<meta name="theme-color" content="#ffffff">
			{% endblock %}

			{% block paginatorLinks %}
				{{ PaginatorHelper.meta({first: true, last: true}) }}
			{% endblock %}

			{% block headStylesheets %}
				{%- do AssetHelper.addCssLayer(['reset']) -%}
				{% do AssetHelper.add('line-awesome/line-awesome.css', critical: false, minified: true) %}
				{% do AssetHelper.add('element/air_datepicker.css', critical: true) %}
				{% do AssetHelper.add('element/coloris.css', critical: true) %}
				{% do AssetHelper.add('main.css', critical: true) %}
				{% do AssetHelper.add('webfonts.css', attributes: {realm: 'Frontend'}) %}
			{% endblock %}

			{% block headScripts %}
				{{ element('scripts', {controller: controller}) }}
			{% endblock %}

			{% block headAssetTags %}
				{{ AssetHelper.createImportMap() }}
				{{ AssetHelper.getTags() }}
			{% endblock %}
			{% if config.Awyiss.System.Backend.interface.highlightColor %}
				<style nonce="{{ AssetHelper.getStyleNonce() }}">
					:root {
						--colorSuccess:{{ config.Awyiss.System.Backend.interface.highlightColor }};
					}
				</style>
			{% endif %}
		{% endblock %}
	</head>
	<body class="
		{{- controller }}Controller {{ _view.getRequest().getParam('action')|camelize }}Action
		{%- if isGenericPage %}	IsGenericPage{%- endif -%}
		{%- if isGenericDatatable %} IsGenericDatatable{%- endif -%}
	">
		{% block body %}
			{% block jumpToContent %}
				<a href="{{ UrlHelper.build({controller: 'dashboard', action: 'overview'}) }}#Content" id="JumpToContent">
					{{ __d('system', 'jump_to_content') }}
				</a>
			{% endblock %}

			{% block header %}
				<header id="Header">
					{% block title %}
						<a href="{{ UrlHelper.build({controller: 'dashboard', action: 'overview'}) }}" class="Title">
							Aw<span class="Yiss">Yiss</span>
							<span class="Version">
								<span class="VersionNo">v{{ Awyiss.VERSION }}</span>
								<span class="VersionName">{{ Awyiss.VERSION_NAME }}</span>
							</span>
						</a>
					{% endblock %}

					{% block systemMenu %}
						{{ cell('Backend/Menu', [currentPageRole]) }}
					{% endblock %}

					{% block languageSwitcher %}
						{% set languages = LocaleHelper.languagesForRealm('Frontend', true)|filter(language => language.active) %}
						{% if languages|length > 1 %}
							{{ element('language_switcher', {languages: languages}) }}
						{% endif %}
					{% endblock %}

					{% block logout %}
						<a href="{{ UrlHelper.build({controller: 'users', action: 'logout'}) }}" class="Logout" title="{{ __d('users', 'logout') }}">{{ __d('users', 'logout') }}</a>
					{% endblock %}

					{% block loginLogo %}
						{% if loginLogoPath %}
							<img src="{{ UrlHelper.build(loginLogoPath) }}" alt="{{ __d('system', 'login_logo') }}" class="LoginLogo">
						{% endif %}
					{% endblock %}
				</header>
			{% endblock %}

			{% block content %}
				<main id="Content">
					{% block flashMessages %}
						{{ FlashHelper.render() }}
					{% endblock %}

					{{ fetch('content') }}
				</main>
			{% endblock %}

			{% block footer %}
				<footer id="Footer">
					<ul id="DarkModeSwitch">
						{% block darkModeSwitch %}
							<li class="DarkModeSwitch-Item DarkModeSwitch-Item-Off{% if config.Awyiss.System.Backend.interface.darkMode == false %} Active{% endif %}">
								<a href="{{ UrlHelper.build({controller: 'dashboard', action: 'userConfiguration', identifier: 'interface.darkMode', value: 'false'}) }}"
									{% if config.Awyiss.System.Backend.interface.darkMode == false %} tabindex="-1"{% endif %}
									class="DarkModeSwitch-Link DarkModeSwitch-Link-Off" title="{{ __d('system', 'dark_mode_switch_off') }}">
									{{ __d('system', 'dark_mode_switch_off') }}
								</a>
							</li>
							<li class="DarkModeSwitch-Item DarkModeSwitch-Item-On{% if config.Awyiss.System.Backend.interface.darkMode == true %} Active{% endif %}">
								<a href="{{ UrlHelper.build({controller: 'dashboard', action: 'userConfiguration', identifier: 'interface.darkMode', value: 'true'}) }}"
									{% if config.Awyiss.System.Backend.interface.darkMode == true %} tabindex="-1"{% endif %}
									class="DarkModeSwitch-Link DarkModeSwitch-Link-On" title="{{ __d('system', 'dark_mode_switch_on') }}">
									{{ __d('system', 'dark_mode_switch_on') }}
								</a>
							</li>
						{% endblock %}
					</ul>
				</footer>
			{% endblock %}

			{% block hiddenFooter %}
				<footer id="HiddenFooter">
					{% block footerContent %}
						{% block logo2fMedia %}
							<div class="Logo">
								<img src="{{ UrlHelper.build('/awyiss/assets/img/logo-2f-media.png') }}" srcset="{{ UrlHelper.build('/awyiss/assets/img/logo-2f-media@2x.png') }} 2x"
									alt="2f Media">
							</div>
						{% endblock %}
					{% endblock %}
				</footer>
			{% endblock %}
		{% endblock %}

		{% block overlayForm %}
			{{ element('overlay_form') }}
		{% endblock %}

		{% block leaveConfirmationDialog %}
			{{ element('form_leave_confirmation_dialog') }}
		{% endblock %}
	</body>
</html>
