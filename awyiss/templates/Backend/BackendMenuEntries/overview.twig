{#
@var menu \Awyiss\Utility\Menu\BackendMenu
@var _view \Awyiss\View\BackendView
#}

<div class="MenuEntries Overview">
	{% block headlineOverview %}
		<h1>{{ __('headline_overview') }}</h1>
	{% endblock %}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block overviewButtons %}
				{% block overviewButtonSaveSystemOrder %}
					<button class="Button Button-SaveSystemOrder" disabled>{{ __d('system', 'save_system_order') }}</button>
				{% endblock %}

				{% block overviewButtonAdd %}
					{% if AuthorizationHelper.isAccessible('create') %}
						{{ HtmlHelper.link(__('create'), {action: 'add'}, {class : 'Button Button-Add'}) }}
					{% endif %}
				{% endblock %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block listOverview %}
		<div class="Overview-List">
			{% from '@Backend/macro/nested_list.twig' import nestedList %}
			{{ nestedList(menu.getDynamicMenu().getItems(), _context|merge({
				data: {

				},
				displayedFields: localConfig.overview.displayedFields,
				identifier: 'BackendMenuEntries',
				template: '@Backend/BackendMenuEntries/overview_nested_list_item.twig',
			}), 'getChildren', 'getItems') }}
		</div>
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('overviewButtons') }}
		</div>
	{% endblock %}
</div>
