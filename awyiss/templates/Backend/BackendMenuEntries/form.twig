{#
@var backendMenuEntry \Awyiss\Model\Entity\BackendMenuEntry
@var menu \Awyiss\Utility\Menu
@var possibleParentMenuEntries \Cake\Collection\CollectionInterface
@var insertAfterOptions array
@var controllers array
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{{ FormHelper.create(backendMenuEntry, {method: 'post', id: 'MenuEntryForm', idPrefix: 'menuEntry'}) }}

{% block sidebarToggle %}
	{{ FormHelper.button(__('sidebar_toggle'), {class: 'Button Button-Configure', id: 'Sidebar-Toggle', name: 'button', type: 'button'}) }}
{% endblock %}

{% block fieldsets %}
	<div class="Fieldsets">
		{% block mainFieldsets %}
			<div class="Main-Fieldsets">
				{% block fieldsetGeneral %}
					<fieldset class="Fieldset-General">
						<legend>{{ __('fieldset_general') }}</legend>

						{% block fieldsetGeneralInner %}
							{% block formControlTitle %}
								{{ FormHelper.control('title') }}
							{% endblock %}

							{% set helperFormControl %}
								<div class="LinkHelper">
									{{ FormHelper.select('link_helper_options', controllers) }}
								</div>
							{% endset %}

							{% block formControlLink %}
								{{ FormHelper.control('link', {
									columnSpan: 6,
									templateVars: {
										additionalContent: helperFormControl
									},
									'data-link-helper-button-text': __('link_helper_button_text'),
								}) }}
							{% endblock %}

							{% set helperFormControl %}
								<div class="AccessHelper">
									{{ FormHelper.select('access_helper_options', policies) }}
								</div>
							{% endset %}

							{% block formControlAccess %}
								{{ FormHelper.control('access', {
									columnSpan: 6,
									templateVars: {
										additionalContent: helperFormControl
									},
									val: backendMenuEntry.access ? backendMenuEntry.access|json_encode : '',
									'data-access-helper-button-text': __('access_helper_button_text'),
								}) }}
							{% endblock %}

							{% block fieldsetGeneralAttributes %}
								{{ AttributesHelper.allControls('general') }}
							{% endblock %}
						{% endblock %}
					</fieldset>
				{% endblock %}

				{% block fieldsetContent %}
					<fieldset class="Fieldset-Content">
						<legend>{{ __('fieldset_content') }}</legend>

						{% block fieldsetContentInner %}
							{% block fieldsetContentAttributes %}
								{{ AttributesHelper.allControls('content') }}
							{% endblock %}
						{% endblock %}
					</fieldset>
				{% endblock %}

				{% block fieldsetMedia %}
					<fieldset class="Fieldset-Media">
						<legend>{{ __('fieldset_media') }}</legend>

						{% block fieldsetMediaInner %}
							{{ cell('Backend/MediaElements', [backendMenuEntry]) }}

							{% block fieldsetMediaAttributes %}
								{{ AttributesHelper.allControls('media') }}
							{% endblock %}
						{% endblock %}
					</fieldset>
				{% endblock %}

				{% block fieldsetMediaElementAssignments %}
					{{ cell('Backend/MediaElements::elementAssignments', [backendMenuEntry]) }}
				{% endblock %}
			</div>
		{% endblock %}

		{% block sidebarFieldsets %}
			<div class="Sidebar-Fieldsets">
				{% block fieldsetPresentation %}
					<fieldset class="Fieldset-Presentation">
						<legend>{{ __('fieldset_presentation') }}</legend>

						{% block fieldsetPresentationInner %}
							{% block formControlActive %}
								{{ FormHelper.control('active', {columnSpan: 6}) }}
							{% endblock %}

							{% block formControlExternal %}
								{{ FormHelper.control('external', {columnSpan: 6}) }}
							{% endblock %}

							{% block fieldsetPresentationAttributes %}
								{{ AttributesHelper.allControls('presentation') }}
							{% endblock %}
						{% endblock %}
					</fieldset>
				{% endblock %}

				{% block fieldsetConditions %}
					<fieldset class="Fieldset-Conditions">
						<legend>{{ __('fieldset_conditions') }}</legend>

						{% block fieldsetConditionsInner %}
							{% block formControlParentId %}
								{{ FormHelper.control('parent_id', {columnSpan: 6, options: hashPrinter(possibleParentMenuEntries.toArray(), 'label', 'key', '- ', 1), required: false, 'data-form-updater': true}) }}
							{% endblock %}

							{% block formControlInsertAfterId %}
								{{ FormHelper.control('insert_after_id', {columnSpan: 6, options: insertAfterOptions, required: false, 'data-form-updater': true}) }}
							{% endblock %}

							{% block formControlSystemOrder %}
								{{ SystemOrderHelper.control('system_order', {entity: backendMenuEntry}) }}
							{% endblock %}

							{% block fieldsetConditionsAttributes %}
								{{ AttributesHelper.allControls('conditions') }}
							{% endblock %}
						{% endblock %}
					</fieldset>
				{% endblock %}

				{% block fieldsetAttributes %}
					<fieldset class="Fieldset-Attributes">
						<legend>{{ __('fieldset_attributes') }}</legend>

						{% block fieldsetAttributesInner %}
							{% block fieldsetAttributesAttributes %}
								{{ AttributesHelper.allControls('attributes') }}
							{% endblock %}
						{% endblock %}
					</fieldset>
				{% endblock %}
			</div>
		{% endblock %}

		{% block formInputReloadForm %}
			{{ FormHelper.hidden('reload_form', {val: 0}) }}
		{% endblock %}
	</div>
{% endblock %}

{% block lockDialog %}
	{{ element('lock_dialog', {entity: backendMenuEntry}) }}
{% endblock %}

{{ FormHelper.end() }}

{% block linkHelperDialog %}
	<dialog id="LinkHelperDialog" data-title="{{ __('link_helper_dialog_title') }}">
		<div class="FormInput FormInputType-Select FormInputName-LinkHelperController">
			<label class="Label" for="MenuEntry-LinkHelperController">{{ __('link_helper_dialog_label_controller') }}</label>
			<select name="link_helper[controller]" id="MenuEntry-LinkHelperController"></select>
		</div>

		<div class="FormInput FormInputType-Select FormInputName-LinkHelperMethod">
			<label class="Label" for="MenuEntry-LinkHelperMethod">{{ __('link_helper_dialog_label_method') }}</label>
			<select name="link_helper[method]" id="MenuEntry-LinkHelperMethod"></select>
		</div>

		<div class="FormInput FormInputType-List FormInputName-UrlParams" data-list-item-add="{{ __('link_helper_dialog_label_url_param_add') }}" data-list-item-remove="{{ __('link_helper_dialog_label_url_param_remove') }}">
			<label class="Label">{{ __('link_helper_dialog_label_url_params') }}</label>

			<div class="FormInputType-ListItem FormInputType-ListItem-Default">
				{{ FormHelper.input('param.0.key') }}
				{{ FormHelper.input('param.0.value') }}
			</div>
		</div>

		<button id="LinkHelperDialog-Button-Apply" class="Button Button-Success Button-Save Button-Apply">
			{{ __('link_helper_dialog_confirm_apply') }}
		</button>

		<button id="LinkHelperDialog-Button-Cancel" class="Button Button-Cancel Button-Close">
			{{ __('link_helper_dialog_confirm_cancel') }}
		</button>
	</dialog>
{% endblock %}

{% block accessHelperDialog %}
	<dialog id="AccessHelperDialog" data-title="{{ __('access_helper_dialog_title') }}">
		<div class="FormInput FormInputType-Select FormInputName-AccessHelperScope">
			<label class="Label" for="MenuEntry-AccessHelperScope">{{ __('access_helper_dialog_label_scope') }}</label>
			<select name="access_helper[scope]" id="MenuEntry-AccessHelperScope"></select>
		</div>

		<div class="FormInput FormInputType-Select FormInputName-AccessHelperPermission">
			<label class="Label" for="MenuEntry-AccessHelperPermission">{{ __('access_helper_dialog_label_permission') }}</label>
			<select name="access_helper[permission]" id="MenuEntry-AccessHelperPermission"></select>
		</div>

		<button id="AccessHelperDialog-Button-Apply" class="Button Button-Success Button-Save Button-Apply">
			{{ __('access_helper_dialog_confirm_apply') }}
		</button>

		<button id="AccessHelperDialog-Button-Cancel" class="Button Button-Cancel Button-Close">
			{{ __('access_helper_dialog_confirm_cancel') }}
		</button>
	</dialog>
{% endblock %}
