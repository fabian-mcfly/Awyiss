{#
@var pages \Awyiss\Model\Entity\Page[]|\Cake\Datasource\Paging\PaginatedResultSet
@var localConfig array
@var pageTemplates array
@var contentsEnabled bool
@var nestable bool
@var paginated bool
@var sortable bool
@var _view \Awyiss\View\BackendView
#}

{% extends '@Backend/element/overview/overview_paginated_list.twig' %}

{% block tableOverviewCellAuditInfo %}
	<td class="TableCell-AuditInfo">
		<div class="AuditInfo" data-id="{{ entity.id }}" title="">
			<ul class="AuditInfoList">
				<li><strong>ID:</strong> {{ entity.id }}</li>
			</ul>
		</div>

		{{ HtmlHelper.link(__('preview'), {action: 'preview', id: entity.id}, {class: 'Button Button-Small Button-Subtle Button-Preview'}) }}
	</td>
{% endblock %}

{% block tableOverviewCellTitle %}
	<td class="TableCell-Title">
		{{ entity.title }}
		<br>
		<span class="Slug">{{ HtmlHelper.link(entity.languageShortcode ~ '/' ~ entity.slug, {
			lang: entity.languageShortcode,
			slug: entity.slug,
			_name: 'Frontend',
		}, {
			target: '_blank',
		}) }}</span>
	</td>
{% endblock %}

{% block tableOverviewCellActions %}
	<td class="TableCell-Actions">
		<div class="Actions">
			{% block tableOverviewCellActionsViewContents %}
				{% if entity.hasContentTemplate() and entity.duplicate_of is empty and AuthorizationHelper.isAccessible('contents') and contentsEnabled == true %}
					{{ HtmlHelper.link(__('view_contents'), {controller: 'contents', action: 'overview', pageId: entity.id}, {class: 'Button Button-Small Button-View Button-ViewContents'}) }}
				{% endif %}
			{% endblock %}

			{{ block('tableOverviewCellActionsGallery') }}

			{{ block('tableOverviewCellActionsUpdate') }}

			{{ block('tableOverviewCellActionsDelete') }}
		</div>
	</td>
{% endblock %}
