{#
@var page \Awyiss\Model\Entity\Page
@var parentRecord \Awyiss\Model\Entity\Page
@var pageTemplates \Cake\Collection\CollectionInterface
@var threadedPages \Cake\Collection\CollectionInterface
@var possibleParentPages \Cake\Collection\CollectionInterface
@var languageRealm string
@var localConfig array
@var nestable bool
@var pageRoleName string
@var _view \Awyiss\View\BackendView
#}

{% use '@Backend/Pages/form.twig' %}

{% block formControlDuplicateOf %}{% endblock %}
{% block formControlTitle %}{% endblock %}
{% block formControlSlug %}{% endblock %}
{% block formControlMetaTitle %}{% endblock %}
{% block formControlMetaDescription %}{% endblock %}
{% block formControlRedirectLink %}{% endblock %}

<div class="Pages Form AddBatch">
	{% if AuthorizationHelper.isAccessible('read') %}
		{{ HtmlHelper.link(__('back_to_overview'), {action: 'overview', pageId: page.id}, {class: 'BackToOverview'}) }}
	{% endif %}

	{% block headlineAddBatch %}
		<h1>{{ __('headline_add_batch') }}</h1>
	{% endblock %}

	{{ FormHelper.create(page, {method: 'post', idPrefix: 'page'}) }}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block formAddButtons %}
				{% if AuthorizationHelper.isAccessible('read') %}
					{{ FormHelper.button(__('save_close'), {class: 'Button Button-SaveClose', name: 'submit', value: 'submit_close'}) }}
				{% endif %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block fieldsets %}
		<div class="Fieldsets">
			{% block formAddBatch %}
				{{ block("fieldsetPresentation") }}

				{{ block("fieldsetConditions") }}

				{% block fieldsetGeneral %}
					<fieldset class="Fieldset-General">
						<legend>{{ __('fieldset_general') }}</legend>

						{% block fieldsetGeneralInner %}
							{% block formControlPages %}
								{{ FormHelper.control('pages', {type: 'textarea'}) }}
							{% endblock %}

							{{ parent() }}
						{% endblock %}
					</fieldset>
				{% endblock %}

				{{ block("fieldsetContent") }}

				{{ block("fieldsetAttributes") }}

				{{ block("formInputReloadForm") }}
			{% endblock %}
		</div>
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('formAddButtons') }}
		</div>
	{% endblock %}

	{{ FormHelper.end() }}
</div>
