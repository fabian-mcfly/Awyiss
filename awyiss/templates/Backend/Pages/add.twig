{#
@var ao_page \Awyiss\Model\Entity\Page
@var ao_pageTemplates \Cake\Collection\CollectionInterface
@var ao_threadedPages \Cake\Collection\CollectionInterface
@var ao_parentPages \Cake\Collection\CollectionInterface
@var as_languageRealm string
@var localConfig array
@var ab_nestingEnabled bool
@var _view \Awyiss\View\BackendView
#}

<div class="Pages Form Add">
	{{ helper_Form_create(ao_page, {method: 'post', idPrefix: 'page'}) }}

	{% block headlineAdd %}
		<h1>{{ __('headline_add') }}</h1>
	{% endblock %}

	{% block formAddButtons %}
		{{ helper_Form_button(__('save')) }}
		{{ helper_Form_button(__('save_close'), {name: 'submit', value: 'submit_close'}) }}
	{% endblock %}

	{% block formAdd %}
		{% include('@Backend/Pages/form.twig') %}
	{% endblock %}

	{% block formAddButtonsBottom %}
		{{ block('formAddButtons') }}
	{% endblock %}

	{{ helper_Form_end() -}}

</div>