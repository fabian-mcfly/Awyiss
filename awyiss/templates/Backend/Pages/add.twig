{#
@var page \Awyiss\Model\Entity\Page
@var parentRecord \Awyiss\Model\Entity\Page
@var pageTemplates \Cake\Collection\CollectionInterface
@var threadedPages \Cake\Collection\CollectionInterface
@var possibleParentPages \Cake\Collection\CollectionInterface
@var languageRealm string
@var localConfig array
@var nestable bool
@var _view \Awyiss\View\BackendView
#}

<div class="Pages Form Add">
	{% if AuthorizationHelper.isAccessible('read') %}
		{{ HtmlHelper.link(__('overview'), {action: 'overview', pageId: page.id}, {class: 'BackToOverview'}) }}
	{% endif %}

	{% block headlineAdd %}
		<h1>{{ __('headline_add') }}</h1>
	{% endblock %}

	{{ FormHelper.create(page, {method: 'post', idPrefix: 'page'}) }}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block formAddButtons %}
				{{ FormHelper.button(__('save'), {class: 'Button Button-Success Button-Save'}) }}

				{% if AuthorizationHelper.isAccessible('read') %}
					{{ FormHelper.button(__('save_close'), {class: 'Button Button-SaveClose', name: 'submit', value: 'submit_close'}) }}
				{% endif %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block formAdd %}
		{% include('@Backend/Pages/form.twig') %}
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('formAddButtons') }}
		</div>
	{% endblock %}

	{{ FormHelper.end() }}
</div>
