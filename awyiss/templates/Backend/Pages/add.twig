<div class="Pages Form Add">
	{{ FormHelper.create(ao_page, {method: 'post', idPrefix: 'page'}) }}

	{% block headlineAdd %}
		<h1>{{ __('headline_add') }}</h1>
	{% endblock %}

	{% block formAddButtons %}
		{{ FormHelper.button(__('save')) }}
		{{ FormHelper.button(__('save_close'), {name: 'submit', value: 'submit_close'}) }}
	{% endblock %}

	{% block formAdd %}
		{% include('@Backend/Pages/form.twig') %}
	{% endblock %}

	{% block formAddButtonsBottom %}
		{{ block('formAddButtons') }}
	{% endblock %}

	{{ FormHelper.end() -}}

</div>