{% block fieldsetMenus %}
	<fieldset class="Fieldset-Menus">
		<legend>{{ __('fieldset_menus') }}</legend>

		{# @var lo_menu \Awyiss\Model\Entity\Menu #}
		{% for lo_menu in ao_menus %}
			{{ FormHelper.control('add_menu_entry[]', {hiddenField: false, label: lo_menu.label, type: 'checkbox', value: lo_menu.id}) }}
		{% endfor %}
	</fieldset>
{% endblock %}

{% block elementPublicationData %}
	{{ element('publication_data/fieldset') }}
{% endblock %}

{% block formInputReloadForm %}
	{{ FormHelper.hidden('reload_form', {val: 0}) }}
{% endblock %}
