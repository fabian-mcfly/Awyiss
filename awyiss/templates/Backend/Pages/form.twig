{#
@var ao_page \Awyiss\Model\Entity\Page
@var ao_pageTemplates \Cake\Collection\CollectionInterface
@var ao_threadedPages \Cake\Collection\CollectionInterface
@var ao_possibleParentPages \Cake\Collection\CollectionInterface
@var as_languageRealm string
@var localConfig array
@var ab_nestable bool
@var ab_sortable bool
@var ao_menus \Cake\Collection\CollectionInterface
@var _view \Awyiss\View\BackendView
#}

{% block fieldsetPresentation %}
	<fieldset class="Fieldset-Presentation">
		<legend>{{ __('fieldset_presentation') }}</legend>

		{% block fieldsetPresentationInner %}
			{% block formControlActive %}
				{{ FormHelper.control('active') }}
			{% endblock %}

			{% block formControlPageTemplateId %}
				{{ FormHelper.control('page_template_id', {empty: false, options: ao_pageTemplates.combine('id', 'label')}) }}
			{% endblock %}

			{% block fieldsetPresentationAttributes %}
				{{ AttributesHelper.allControls('presentation') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetConditions %}
	<fieldset class="Fieldset-Conditions">
		<legend>{{ __('fieldset_conditions') }}</legend>

		{% block fieldsetConditionsInner %}
			{% block formControlLanguageShortcode %}
				{{ LocaleHelper.control('language_shortcode', {languageRealm: as_languageRealm}) }}
			{% endblock %}

			{% block formControlParentId %}
				{% if (as_categoriesIdentifier is defined) %}
					{{ CategoriesHelper.control(as_categoriesIdentifier) }}
				{% endif %}

				{% if ab_nestable and ao_possibleParentPages is not null %}
					{{ FormHelper.control('parent_id', {options: hashPrinter(ao_possibleParentPages, 'label', 'id', '- ')}) }}
				{% endif %}
			{% endblock %}

			{% block formControlSystemOrder %}
				{% if ab_sortable %}
					{{ SystemOrderHelper.control('system_order') }}
				{% endif %}
			{% endblock %}

			{% block formControlDuplicateOf %}
				{{ FormHelper.control('duplicate_of', {disabled: [ao_page.id], options: ao_threadedPages.printer('label', 'id', '- ')}) }}
			{% endblock %}

			{% block fieldsetConditionsAttributes %}
				{{ AttributesHelper.allControls('conditions') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetGeneral %}
	<fieldset class="Fieldset-General">
		<legend>{{ __('fieldset_general') }}</legend>

		{% block fieldsetGeneralInner %}
			{% block formControlTitle %}
				{{ FormHelper.control('title') }}
			{% endblock %}

			{% block formControlSlug %}
				{{ FormHelper.control('slug', {required: false}) }}
			{% endblock %}

			{% block fieldsetGeneralAttributes %}
				{{ AttributesHelper.allControls('general') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

