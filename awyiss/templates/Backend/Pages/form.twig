{#
@var page \Awyiss\Model\Entity\Page
@var parentRecord \Awyiss\Model\Entity\Page
@var pageTemplates \Cake\Collection\CollectionInterface
@var threadedPages \Cake\Collection\CollectionInterface
@var possibleParentPages \Cake\Collection\CollectionInterface
@var languageRealm string
@var localConfig array
@var nestable bool
@var pageRoleName string
@var isDuplicated bool|null
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% block formOpen %}
	{{ FormHelper.create(page, {method: 'post', id: 'PageForm', idPrefix: 'page'}) }}
{% endblock %}

{% block sidebarToggle %}
	{{ FormHelper.button(__('sidebar_toggle'), {class: 'Button Button-Configure', id: 'Sidebar-Toggle', name: 'button', type: 'button'}) }}
{% endblock %}

{% block fieldsets %}
	<div class="Fieldsets">
		{% if hasDescendantsWithDifferentPageRole %}
			{{ FormHelper.control('copy_descendants_with_different_page_role', {
				escape: false,
				label: __('copy_descendants_with_different_page_role'),
				options: {
					0: __('copy_descendants_with_different_page_role_no'),
					1: __('copy_descendants_with_different_page_role_yes'),
				},
				templateVars: {
					containerClass: 'InfoArea',
				},
				type: 'radio',
			}) }}
		{% endif %}

		{% block mainFieldsets %}
			<div class="Main-Fieldsets">
				{% block fieldsetGeneral %}
					<fieldset class="Fieldset-General">
						<legend>{{ __('fieldset_general') }}</legend>

						{% block fieldsetGeneralInner %}
							{% block formControlTitle %}
								{{ FormHelper.control('title') }}
							{% endblock %}

							{% block formControlSlug %}
								{{ FormHelper.control('slug', {
									required: false,
									templateVars: {
										additionalContent: (config.Route.includeLanguageShortcode or parentRecord.slug)
											? '<span class="PrePath">' ~ (config.Route.includeLanguageShortcode ? page.languageShortcode ~ '/' : null) ~ (parentRecord.slug ? (parentRecord.slug ~ '/') : '') ~ '</span>'
											: '',
									},
									'data-autofill-from': 'title',
									'data-replacement-char': '-',
								}) }}
							{% endblock %}

							{% block fieldsetGeneralAttributes %}
								{{ AttributesHelper.allControls('general') }}
							{% endblock %}
						{% endblock %}
					</fieldset>
				{% endblock %}

				{% block fieldsetContent %}
					<fieldset class="Fieldset-Content">
						<legend>{{ __('fieldset_content') }}</legend>

						{% block fieldsetContentInner %}
							{% block fieldsetContentAttributes %}
								{{ AttributesHelper.allControls('content') }}
							{% endblock %}
						{% endblock %}
					</fieldset>
				{% endblock %}

				{% block fieldsetMedia %}
					<fieldset class="Fieldset-Media">
						<legend>{{ __('fieldset_media') }}</legend>

						{% block fieldsetMediaInner %}
							{{ cell('Backend/MediaElements', [page]) }}

							{% block fieldsetMediaAttributes %}
								{{ AttributesHelper.allControls('media') }}
							{% endblock %}
						{% endblock %}
					</fieldset>
				{% endblock %}

				{% block fieldsetMediaElementAssignments %}
					{{ cell('Backend/MediaElements::elementAssignments', [page]) }}
				{% endblock %}

				{% block fieldsetSeo %}
					<fieldset class="Fieldset-Seo">
						<legend>{{ __d('seo', 'fieldset_seo') }}</legend>

						{% block fieldsetSeoInner %}
							{{ element('Pages/seo_snippet') }}

							{% block fieldsetSeoAttributes %}
								{{ AttributesHelper.allControls('seo') }}
							{% endblock %}
						{% endblock %}
					</fieldset>
				{% endblock %}
			</div>
		{% endblock %}

		{% block sidebarFieldsets %}
			<div class="Sidebar-Fieldsets">
				{% block fieldsetPresentation %}
					<fieldset class="Fieldset-Presentation">
						<legend>{{ __('fieldset_presentation') }}</legend>

						{% block fieldsetPresentationInner %}
							{% block formControlActive %}
								{{ FormHelper.control('active') }}
							{% endblock %}

							{% block formControlPageTemplateId %}
								{{ FormHelper.control('page_template_id', {empty: false, options: pageTemplates.combine('id', 'label')}) }}
							{% endblock %}

							{% block fieldsetPresentationAttributes %}
								{{ AttributesHelper.allControls('presentation') }}
							{% endblock %}
						{% endblock %}
					</fieldset>
				{% endblock %}

				{% block fieldsetConditions %}
					<fieldset class="Fieldset-Conditions">
						<legend>{{ __('fieldset_conditions') }}</legend>

						{% block fieldsetConditionsInner %}
							{% block formControlLanguageShortcode %}
								{{ LocaleHelper.control('language_shortcode', {languageRealm: languageRealm, 'data-form-updater': true}) }}
							{% endblock %}

							{% block formControlParentId %}
								{% if (_categoriesIdentifier is defined) %}
									{{ CategoriesHelper.control(_categoriesIdentifier, {'data-form-updater': true}) }}
								{% endif %}

								{% if nestable and possibleParentPages is not null %}
									{{ FormHelper.control('parent_id', {options: hashPrinter(possibleParentPages, 'label', 'id', '- '), 'data-form-updater': true}) }}
								{% endif %}
							{% endblock %}

							{% block formControlSystemOrder %}
								{% if sortable %}
									{{ SystemOrderHelper.control('system_order') }}
								{% endif %}
							{% endblock %}

							{% block formControlDuplicateOf %}
								{{ FormHelper.control('duplicate_of', {columnSpan: 6, disabled: isDuplicated ? true : [page.id], options: threadedPages.printer('label', 'id', '- ')}) }}
							{% endblock %}

							{% block formControlRedirectLink %}
								{{ FormHelper.control('redirect_link', {columnSpan: 6}) }}
							{% endblock %}

							{% block fieldsetConditionsAttributes %}
								{{ AttributesHelper.allControls('conditions') }}
							{% endblock %}
						{% endblock %}
					</fieldset>
				{% endblock %}

				{% block fieldsetAttributes %}
					<fieldset class="Fieldset-Attributes">
						<legend>{{ __('fieldset_attributes') }}</legend>

						{% block fieldsetAttributesInner %}
							{% block fieldsetAttributesAttributes %}
								{{ AttributesHelper.allControls('attributes') }}
							{% endblock %}
						{% endblock %}
					</fieldset>
				{% endblock %}

				{% block fieldsetAddPageToMenus %}
					<fieldset class="Fieldset-AddPageToMenus">
						<legend>{{ __('fieldset_menus') }}</legend>

						{# @var menu \Awyiss\Model\Entity\Menu #}
						{% for key, menu in menus %}
							{{ FormHelper.control('add_menu_entry[' ~ key ~ ']', {columnSpan: 3, hiddenField: false, label: menu.label, type: 'checkbox', value: menu.id}) }}
						{% endfor %}
					</fieldset>
				{% endblock %}

				{% block elementPublicationData %}
					{{ element('publication_data/fieldset', {fields: AttributesHelper.allControls('publication')}) }}
				{% endblock %}
			</div>
		{% endblock %}

		{% block formInputReloadForm %}
			{{ FormHelper.hidden('reload_form', {val: 0}) }}
		{% endblock %}
	</div>
{% endblock %}

{% block lockDialog %}
	{{ element('lock_dialog', {entity: page}) }}
{% endblock %}

{% block formClose %}
	{{ FormHelper.end() }}
{% endblock %}
