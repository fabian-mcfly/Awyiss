{#
@var surveyAnswer Awyiss\Model\Entity\SurveyAnswer
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Awyiss\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

<div class="SurveyAnswers Form Edit">
	{% block headlinesEdit %}
		<div class="Headlines">
			{% if AuthorizationHelper.isAccessible('read') %}
				{{ HtmlHelper.link(__('back_to_overview'), {action: 'overview'}, {class: 'BackToOverview'}) }}
			{% endif %}

			{% block headlineEdit %}
				<h1>{{ __('headline_edit') }}</h1>
			{% endblock %}
		</div>
	{% endblock %}

	{{ FormHelper.checkbox('saveAsCopy', {form: 'SurveyAnswerForm', id: 'SaveAsCopy', value: true, 'data-form-updater': true}) }}

	{% block buttonAreaToggle %}
		{{ FormHelper.button(__('button_area_toggle'), {class: 'Button Button-Menu', id: 'ButtonArea-Toggle', name: 'button', type: 'button'}) }}
	{% endblock %}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block formEditButtons %}
				{% block formEditButtonSaveAsCopy %}
					<label for="SaveAsCopy" tabindex="0" class="Button Button-SaveAsCopy Label-SaveAsCopy">{{ __('as_copy') }}</label>
				{% endblock %}

				{% block formEditButtonSave %}
					{{ FormHelper.button(__('save'), {class: 'Button Button-Success Button-Save', form: 'SurveyAnswerForm'}) }}
				{% endblock %}

				{% block formEditButtonSaveClose %}
					{% if isOverlayForm != true and AuthorizationHelper.isAccessible('read') %}
						{{ FormHelper.button(__('save_close'), {class: 'Button Button-SaveClose', form: 'SurveyAnswerForm', name: 'submitType', value: 'submitClose'}) }}
					{% endif %}
				{% endblock %}

				{% block overlayFormButtonClose %}
					{% if isOverlayForm == true %}
						{{ FormHelper.button(__('close'), {class: 'Button Button-Close'}) }}
					{% endif %}
				{% endblock %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block formEdit %}
		{% include('@Backend/SurveyAnswers/form.twig') %}
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('formEditButtons') }}
		</div>
	{% endblock %}
</div>
