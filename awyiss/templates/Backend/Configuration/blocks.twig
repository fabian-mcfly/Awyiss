{#
@var configuration \Awyiss\Model\Entity\Configuration
@var configOptions array
@var realms array
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% block formControlTypeBool %}
	{{ FormHelper.control('value', {
		label: __('input_type_bool_label'),
		type: 'checkbox',
		val: configuration.get('value'),
	}) }}
{% endblock %}

{% block formControlTypeColor %}
	{{ FormHelper.control('value', {type: 'color'}) }}
{% endblock %}

{% block formControlTypeEnum %}
	{{ FormHelper.control('value', {options: configuration.configOption.values(true, configuration.languageShortcode), type: 'select'}) }}
{% endblock %}

{% block formControlTypeFloat %}
	{{ FormHelper.control('value', {placeholder: configuration.configOption.defaultValue, step: 0.01, type: 'number'}) }}
{% endblock %}

{% block formControlTypeInteger %}
	{{ FormHelper.control('value', {placeholder: configuration.configOption.defaultValue, step: 1, type: 'number'}) }}
{% endblock %}

{% block formControlTypeList %}
	<div class="FormInput FormInputType-List FormInputName-Value" data-list-item-add="{{ __('list_item_add') }}" data-list-item-remove="{{ __('list_item_remove') }}">
		<label class="Label">{{ __('value') }}</label>

		{% set counter = 0 %}
		{% set value = configuration.hasValue('value') ? configuration.get('value') : configuration.configOption.defaultValue %}

		{% if value is not empty and value is not array %}
			{% set decodedValue = value|jsonDecode %}
			{% if decodedValue is not null %}
				{% set value = decodedValue %}
			{% else %}
				{% set value = [value] %}
			{% endif %}
		{% endif %}

		{% for key, value in value %}
			<div class="FormInputType-ListItem">
				{{ FormHelper.text('value.' ~ counter, {val: value}) }}
			</div>
			{% set counter = counter + 1 %}
		{% endfor %}

		<div class="FormInputType-ListItem FormInputType-ListItem-Default">
			{{ FormHelper.text('value.' ~ counter) }}
		</div>
	</div>
{% endblock %}

{% block formControlTypeListKey %}
	{% set options = configuration.configOption.values(true, configuration.languageShortcode) %}
	{{ FormHelper.control('value', {
		options: options,
		empty: '' not in options|keys,
		type: 'select',
	}) }}
{% endblock %}

{% block formControlTypeJson %}
	{{ FormHelper.control('value', {placeholder: configuration.configOption.defaultValue|jsonEncode, type: 'textarea'}) }}
{% endblock %}

{% block formControlTypeString %}
	{{ FormHelper.control('value', {placeholder: configuration.configOption.defaultValue}) }}
{% endblock %}

{% block formControlTypeValueCollection %}
	<div class="FormInput FormInputType-ValueCollection FormInputName-Value">
		<label class="Label">{{ __('value') }}</label>
		{% set currentValue = configuration.hasValue('value') ? configuration.get('value')|jsonDecode :
			(configuration.isNew() ? configuration.configOption.defaultValue : []) %}
		<input type="hidden" name="value" value="">

		{% for key, value in configuration.configOption.values(true, configuration.languageShortcode) %}
			{{ FormHelper.control('value[]', {
				checked: key in currentValue,
				hiddenField: false,
				id: 'Configuration-Value-' ~ key|camelize,
				label: value,
				type: 'checkbox',
				value: key,
			}) }}
		{% endfor %}
	</div>
{% endblock %}