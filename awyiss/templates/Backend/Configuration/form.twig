{#
@var configuration \Awyiss\Model\Entity\Configuration
@var configOptions array
@var realms array
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% use '@Backend/Configuration/blocks.twig' %}

{{ FormHelper.create(configuration, {method: 'post', id: 'ConfigurationForm', idPrefix: 'Configuration'}) }}
<input type="hidden" name="attributes" value="">

{% macro recursiveConfigOptions(items, level = 0, parent = []) %}
	{% for key, configuration in items %}
		{% if configuration is iterable %}
			{% if level == 0 %}
				<optgroup label="{{ key }}">
					{{ _self.recursiveConfigOptions(configuration, level + 1, parent|merge([key])) }}
				</optgroup>
			{% else %}
				{{ _self.recursiveConfigOptions(configuration, level + 1, parent|merge([key])) }}
			{% endif %}
		{% else %}
			<option value="{{ parent|length > 0 ? parent|join('.') ~ '.' : '' }}{{ key }}">
				{{- parent|length > 1 ? parent|slice(1)|join('.') ~ '.' : '' -}}
				{{- key -}}
			</option>
		{% endif %}
	{% endfor %}
{% endmacro %}

{% set fieldsetGeneral %}
	{% block fieldsetGeneral %}
		<fieldset class="Fieldset-General">
			<legend>{{ __('fieldset_general') }}</legend>

			{% block fieldsetGeneralInner %}
				{% block formControlScope %}
					{{ CategoriesHelper.control('scope', {columnSpan: 6, 'data-form-updater': true}) }}
				{% endblock %}

				{% block formControlRealm %}
					{{ FormHelper.control('realm', {columnSpan: 6, empty: false, options: combine(realms, realms), 'data-form-updater': true}) }}
				{% endblock %}

				{% block formControlIdentifier %}
					<div class="FormInput FormInputType-Text FormInputName-Identifier ColumnSpan-6{% if FormHelper.isFieldError('identifier') %} Error{% endif %}">
						<label class="Label" for="Configuration-Identifier">{{ __('identifier') }}</label>

						{{ FormHelper.text('identifier', {
							id: 'Configuration-Identifier',
							val: configuration.identifier ? configuration.identifier|variable : '',
							'data-allowed-characters': '.',
							'data-camelize': true,
							'data-form-updater': true
						}) }}

						{% block formControlIdentifierSelect %}
							<!--suppress HtmlFormInputWithoutLabel -->
							<select id="Configuration-Identifier-Options" name="" data-options-for="Configuration-Identifier">
								<option value=""></option>
								{{ _self.recursiveConfigOptions(configOptions) }}
							</select>
						{% endblock %}

						{% if FormHelper.isFieldError('identifier') %}
							{{ FormHelper.error('identifier') }}
						{% endif %}
					</div>
				{% endblock %}

				{% block formControlLanguageShortcode %}
					{{ LocaleHelper.control('languageShortcode', {
						disabled: configuration.configOption is defined and configuration.configOption.isLocalizable() == false,
						columnSpan: 6,
						languageRealm: configuration.realm,
						'data-form-updater': true,
					}) }}
				{% endblock %}

				{% block formControlValue %}
					{% if configuration.configOption %}
						{{ block('formControlType' ~ configuration.configOption.type.name) }}
					{% else %}
						{{ FormHelper.control('value') }}
					{% endif %}
				{% endblock %}

				{% block formControlDescription %}
					{{ FormHelper.control('description', {placeholder: configuration.configOption.description}) }}
				{% endblock %}

				{% block fieldsetGeneralAttributes %}
					{{ AttributesHelper.allControls('general') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetContent %}
	{% block fieldsetContent %}
		<fieldset class="Fieldset-Content">
			<legend>{{ __('fieldset_content') }}</legend>

			{% block fieldsetContentInner %}
				{% block fieldsetContentAttributes %}
					{{ AttributesHelper.allControls('content') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetMedia %}
	{% block fieldsetMedia %}
		<fieldset class="Fieldset-Media">
			<legend>{{ __('fieldset_media') }}</legend>

			{% block fieldsetMediaInner %}
				{{ cell('Backend/MediaElements', [configuration]) }}

				{% block fieldsetMediaAttributes %}
					{{ AttributesHelper.allControls('media') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetMediaElementAssignments %}
	{% block fieldsetMediaElementAssignments %}
		{{ cell('Backend/MediaElements::elementAssignments', [configuration]) }}
	{% endblock %}
{% endset %}

{% set fieldsetPresentation %}
	{% block fieldsetPresentation %}
		<fieldset class="Fieldset-Presentation">
			<legend>{{ __('fieldset_presentation') }}</legend>

			{% block fieldsetPresentationInner %}
				{% block fieldsetPresentationAttributes %}
					{{ AttributesHelper.allControls('presentation') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

{% set fieldsetConditions %}
	{% block fieldsetConditions %}
		<fieldset class="Fieldset-Conditions">
