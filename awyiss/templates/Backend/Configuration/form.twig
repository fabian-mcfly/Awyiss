{% endblock %}

{% block fieldsetAttributes %}
	<fieldset class="Fieldset-Attributes">
		<legend>{{ __('fieldset_attributes') }}</legend>

		{% block fieldsetAttributesInner %}
			{% block fieldsetAttributesAttributes %}
				{{ helper_Attributes_allControls('attributes') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block formInputReloadForm %}
	{{ helper_Form_hidden('reload_form', {val: 0}) }}
{% endblock %}

<script>
	document.body.addEventListener('change', (event) => {
		if (event.target.matches('select[data-options-for]')) {
			const targetInputId = event.target.getAttribute('data-options-for');
			const targetInput = document.getElementById(targetInputId);
			if (targetInput) {
				targetInput.value = event.target.value;
				event.target.value = ''; // reset the select dropdown

				//Create a new 'change' event
				const changeEvent = new Event('change');

				//Dispatch the 'change' event on the target input
				targetInput.dispatchEvent(changeEvent);
			}
		}
	});


	/**
	async function loadClass (className, newPath, originalPath) {
		let ClassToUse;

		try {
			// Try to import the new class
			const ImportedClass = await import(`${newPath}/${className}.js`);
			ClassToUse = ImportedClass.default;
		} catch (error) {
			// If the import fails, use the original class
			const OriginalClass = await import(`${originalPath}/${className}.js`);
			ClassToUse = OriginalClass.default;
		}

		return ClassToUse;
	}

	// Usage
	loadClass('FormUpdater', './path/to/new', './path/to/original')
	.then(FormUpdater => {
		const formUpdaterInstance = new FormUpdater('data-form-updater');
		// ...
	});
	*/


	/**
	 * FormUpdater class
	 * This class is used to handle form updates and reloads.
	 */
	class FormUpdater {
		/**
		 * @private
		 * @type {string}
		 * The data attribute used to select elements.
		 */
		#dataAttribute;

		/**
		 * @constructor
		 * @param {string} dataAttribute - The data attribute used to select elements.
		 */
		constructor (dataAttribute) {
			this.#dataAttribute = dataAttribute;
			this.#attachEventListeners();
		}

		/**
		 * @private
		 * Attaches event listeners to all elements with the data attribute.
		 */
		#attachEventListeners () {
			document.querySelectorAll(`[${this.#dataAttribute}]`).forEach((element) => {
				element.addEventListener('change', this.#handleEvent.bind(this));
			});
		}

		/**
		 * @private
		 * @param {Event} event - The event object.
		 * Handles the input event by sending a request if the event target is within a form.
		 */
		#handleEvent (event) {
			const form = this.#getForm(event.target);
			const dataAttributeValue = event.target.getAttribute(this.#dataAttribute);
			if (form && dataAttributeValue && dataAttributeValue !== '0' && dataAttributeValue.toLowerCase() !== 'false') {
				this.#sendRequest(form);
			}
		}

		/**
		 * @private
		 * @param {HTMLElement} element - The element to start the search from.
		 * @returns {HTMLFormElement|null} The closest form element, or null if none is found.
		 * Finds the closest form element to the given element.
		 */
		#getForm (element) {
			while (element && element.nodeName.toLowerCase() !== 'form') {
				element = element.parentNode;
			}
			return element;
		}

		/**
		 * @private
		 * @param {HTMLFormElement} form - The form to send the request from.
		 * Sends a request with the form data, then replaces the form with the new form from the server response.
		 * Re-attaches event listeners to the new form and re-enables the form inputs.
		 */
		#sendRequest (form) {
			const formData = new FormData(form);
			formData.append('reload_form', '1'); // append "reload_form" key with value "1"
			form.querySelectorAll('input, select, textarea').forEach(input => input.disabled = true);

			fetch(form.action, {
				method: form.method,
				body: formData
			})
			.then(response => response.text())
			.then(html => {
				const newForm = new DOMParser().parseFromString(html, 'text/html').querySelector('form');
				form.parentNode.replaceChild(newForm, form);
				this.#attachEventListeners();
			})
			.catch(error => console.error('Error:', error))
			.finally(() => form.querySelectorAll('input, select, textarea').forEach(input => input.disabled = false));
		}
	}

	new FormUpdater('data-form-updater');
</script>
