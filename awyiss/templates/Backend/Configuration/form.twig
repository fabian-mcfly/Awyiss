{#
@var ao_configuration \Awyiss\Model\Entity\Configuration
@var aa_configOptions array
@var aa_realms array
@var _view \Awyiss\View\BackendView
#}

{% use '@Backend/Configuration/blocks.twig' %}

{% macro recursiveConfigOptions(aa_items, ai_level = 0, aa_parent = []) %}
	{% for ls_key, lx_configuration in aa_items %}
		{% if lx_configuration is iterable %}
			{% if ai_level == 0 %}
				<optgroup label="{{ ls_key }}">
					{{ _self.recursiveConfigOptions(lx_configuration, ai_level + 1, aa_parent|merge([ls_key])) }}
				</optgroup>
			{% else %}
				{{ _self.recursiveConfigOptions(lx_configuration, ai_level + 1, aa_parent|merge([ls_key])) }}
			{% endif %}
		{% else %}
			<option value="{{ aa_parent|length > 0 ? aa_parent|join('.') ~ '.' : '' }}{{ ls_key }}">{{ ls_key }}</option>
		{% endif %}
	{% endfor %}
{% endmacro %}

{% block fieldsetPresentation %}
	<fieldset class="Fieldset-Presentation">
		<legend>{{ __('fieldset_presentation') }}</legend>

		{% block fieldsetPresentationInner %}
			{% block fieldsetPresentationAttributes %}
				{{ helper_Attributes_allControls('presentation') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetConditions %}
	<fieldset class="Fieldset-Conditions">
		<legend>{{ __('fieldset_conditions') }}</legend>

		{% block fieldsetConditionsInner %}
			{% block formControlScope %}
				{{ helper_Categories_control('scope', {'data-form-updater': true}) }}
			{% endblock %}

			{% block formControlRealm %}
				{{ helper_Form_control('realm', {options: combine(aa_realms, aa_realms), 'data-form-updater': true}) }}
			{% endblock %}

			{% block formControlLanguageShortcode %}
				{{ helper_Locale_control('language_shortcode', {languageRealm: ao_configuration.realm, 'data-form-updater': true}) }}
			{% endblock %}

			{% block fieldsetConditionsAttributes %}
				{{ helper_Attributes_allControls('conditions') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetGeneral %}
	<fieldset class="Fieldset-General">
		<legend>{{ __('fieldset_general') }}</legend>

		{% block fieldsetGeneralInner %}
			{% block formControlIdentifier %}
				<div class="Input InputType-Text InputName-Identifier">
					<label for="Configuration-Identifier">{{ __('identifier') }}</label>

					{{ helper_Form_text('identifier', {
						id: 'Configuration-Identifier',
						val: ao_configuration.identifier ? ao_configuration.identifier|variable : '',
						'data-form-updater': true
					}) }}

					{% block formControlIdentifierSelect %}
						<select id="Configuration-Identifier-Options" name="" data-options-for="Configuration-Identifier">
							<option value=""></option>
							{{ _self.recursiveConfigOptions(aa_configOptions) }}
						</select>
					{% endblock %}
				</div>
			{% endblock %}

			{% block formControlValue %}
				{% if ao_configuration.configOption %}
					{{ block('formControlType' ~ ao_configuration.configOption.type.name) }}
				{% else %}
					{{ helper_Form_control('value') }}
				{% endif %}
			{% endblock %}

			{% block formControlDescription %}
				{{ helper_Form_control('description', {placeholder: ao_configuration.configOption.description}) }}
			{% endblock %}

			{% block fieldsetGeneralAttributes %}
				{{ helper_Attributes_allControls('general') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetContent %}
	<fieldset class="Fieldset-Content">
		<legend>{{ __('fieldset_content') }}</legend>

		{% block fieldsetContentInner %}
			{% block fieldsetContentAttributes %}
				{{ helper_Attributes_allControls('content') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetMedia %}
	<fieldset class="Fieldset-Media">
