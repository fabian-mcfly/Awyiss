{#
@var configuration \Awyiss\Model\Entity\Configuration
@var configOptions array
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% do AuthorizationHelper.setAdditionalData({scope: configuration.scope}) %}

<div class="Configuration Form Edit">
	{% block headlinesEdit %}
		<div class="Headlines">
			{% if AuthorizationHelper.isAccessible('read') %}
				{{ HtmlHelper.link(__('back_to_overview'), {action: 'overview'}, {class: 'BackToOverview'}) }}
			{% endif %}

			{% block headlineEdit %}
				<h1>{{ __('headline_edit') }}</h1>
			{% endblock %}
		</div>
	{% endblock %}

	{{ FormHelper.checkbox('save_as_copy', {form: 'ConfigurationForm', id: 'SaveAsCopy', value: true}) }}

	{% block buttonAreaToggle %}
		{{ FormHelper.button(__('button_area_toggle'), {class: 'Button Button-Menu', id: 'ButtonArea-Toggle', name: 'button', type: 'button'}) }}
	{% endblock %}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block formEditButtons %}
				{% block formEditButtonSaveAsCopy %}
					<label for="SaveAsCopy" tabindex="0" class="Button Button-SaveAsCopy Label-SaveAsCopy">{{ __('as_copy') }}</label>
				{% endblock %}

				{% block formEditButtonSave %}
					{{ FormHelper.button(__('save'), {class: 'Button Button-Success Button-Save', form: 'ConfigurationForm'}) }}
				{% endblock %}

				{% block formEditButtonSaveClose %}
					{% if AuthorizationHelper.isAccessible('read') %}
						{{ FormHelper.button(__('save_close'), {class: 'Button Button-SaveClose', form: 'ConfigurationForm', name: 'submit_type', value: 'submit_close'}) }}
					{% endif %}
				{% endblock %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block formEdit %}
		{% include('@Backend/UserConfiguration/form.twig') %}
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
		{{ block('formEditButtons') }}
		</div>
	{% endblock %}
</div>

{% do AuthorizationHelper.resetAdditionalData() %}
