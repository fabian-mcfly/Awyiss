{#
@var configuration \Awyiss\Model\Entity\Configuration
@var configOptions array
@var _view \Awyiss\View\BackendView
#}

{% do AuthorizationHelper.setAdditionalData({scope: configuration.scope}) %}

<div class="Configuration Form Add">
	{% if AuthorizationHelper.isAccessible('read') %}
		{{ HtmlHelper.link(__('back_to_overview'), {action: 'overview'}, {class: 'BackToOverview'}) }}
	{% endif %}

	{% block headlineAdd %}
		<h1>{{ __('headline_add') }}</h1>
	{% endblock %}

	{{ FormHelper.create(configuration, {method: 'post', idPrefix: 'Configuration'}) }}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block formAddButtons %}
				{{ FormHelper.button(__('save'), {class: 'Button Button-Success Button-Save'}) }}
				{% if AuthorizationHelper.isAccessible('read') %}
					{{ FormHelper.button(__('save_close'), {class: 'Button Button-SaveClose', name: 'submit', value: 'submit_close'}) }}
				{% endif %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block formAdd %}
		{% include('@Backend/UserConfiguration/form.twig') %}
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('formAddButtons') }}
		</div>
	{% endblock %}

	{{ FormHelper.end() }}
</div>

{% do AuthorizationHelper.resetAdditionalData() %}
