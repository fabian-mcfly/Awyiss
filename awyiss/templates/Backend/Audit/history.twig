{#
@var entity \Awyiss\Model\Entity
@var audits \Awyiss\Model\Entity\Audit[]
@var historyFields array<string>
@var schema \Cake\Database\Schema\TableSchemaInterface
@var scope string
@var attributes array<string, \Awyiss\Model\Entity\Attribute>
@var attributeOptionsCollection \Awyiss\Attribute\AttributeOptionsCollection
@var attributesSchema \Cake\Database\Schema\TableSchemaInterface
@var associations array<string, array{name: string, property: string}>
@var media Awyiss\Model\Entity\Media[]
@var mediaElements Awyiss\Model\Entity\MediaElement[]
@var isAjax bool
@var isPageRole bool
@var publicationDataEnabled bool
@var languages Awyiss\Model\Entity\Language[]
@var translatableFields array
@var translatableAttributes array
@var datatables array
@var pageRoles array
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% macro tableHistoryBodyMediaRow(entity, audit, mediaElement, settings) %}
	{#
	Macro to render a table row for media elements in history data.
	@var entity \Awyiss\Model\Entity
	@var audit \Awyiss\Model\Entity\Audit
	@var mediaElement \Awyiss\Model\Entity\MediaElement
	@var settings array
	#}

	{% set oldData = audit.dataOld %}
	{% set newData = audit.dataNew %}
	{% set identifier = mediaElement.identifier|variable %}

	<tr>
		<td colspan="3" class="TableCell-MediaElement-Label">
			{{ mediaElement.label }}
		</td>
	</tr>
	{% for mediaSelector in mediaElement.mediaElementSelectors %}
		{% set oldValue = oldData.mediaAssignments[ identifier ][ mediaSelector.identifier|variable ].mediaId %}
		{% set newValue = newData.mediaAssignments[ identifier ][ mediaSelector.identifier|variable ].mediaId %}
		{% set currentValue = entity.mediaAssignments[ identifier ][ mediaSelector.identifier|variable ].mediaId %}
		{% set inputName = 'mediaAssignments[' ~ mediaElement.id ~ '][' ~ mediaSelector.identifier ~ ']' %}

		{% if mediaSelector.mediaSelector.identifier == 'multiFile' %}
			{% set inputName = inputName ~ '[]' %}
			{% set currentValue = entity.mediaAssignments[ identifier ][ mediaSelector.identifier|variable ] %}
			{% set currentValue = currentValue ? currentValue|column('mediaId') : null %}

			{% set oldValue = oldData.mediaAssignments[ identifier ][ mediaSelector.identifier|variable ] %}
			{% set oldValue = oldValue ? oldValue|column('mediaId') : null %}
		{% else %}
			{% set inputName = inputName ~ '[mediaId]' %}
		{% endif %}

		{% set oldDiffersFromCurrent = oldValue != currentValue %}
		{% set oldDiffersFromNew = oldValue != newValue %}
		{% set newDiffersFromCurrent = newValue != currentValue %}

		<tr
			class="
				{%- if oldDiffersFromCurrent %} OldValueDiffersFromCurrent{% endif -%}
				{%- if oldDiffersFromNew %} OldValueDiffersFromNew{% endif -%}
				{%- if newDiffersFromCurrent %} NewValueDiffersFromCurrent{% endif -%}
			"
			data-field="{{ inputName }}">
			<td class="TableCell-Field">
				{{ mediaSelector.label }}
			</td>
			<td class="TableCell-OldValue">
				{% if oldValue is array %}
					{% set revertable = false %}
					{% for mediaId in oldValue %}
						{% if settings.media[ mediaId ] is defined %}
							{% set revertable = true %}
							<a href="{{ baseUrl }}{{ settings.media[ mediaId ].path }}" target="_blank">{{ settings.media[ mediaId ].path }}</a> (ID: {{ mediaId }})<br>

							<input type="text" value="{{ mediaId }}" name="mediaAssignments[{{ mediaElement.id }}][{{ mediaSelector.identifier }}][]">
						{% else %}
							{{ __('unknown_file') }} (ID: {{ mediaId }})<br>
						{% endif %}
					{% else %}
						{% set revertable = true %}
					{% endfor %}

					{% if revertable and oldDiffersFromCurrent and settings.isAjax %}
						<button type="button" class="Button Button-Revert">{{ __('revert_value') }}</button>
					{% endif %}
				{% else %}
					{% set revertable = true %}
					{% if oldValue is not null %}
						{% if settings.media[ oldValue ] is defined %}
							<a href="{{ baseUrl }}{{ settings.media[ oldValue ].path }}" target="_blank">{{ settings.media[ oldValue ].path }}</a> (ID: {{ oldValue }})
						{% else %}
							{% set revertable = false %}
							{{ __('unknown_file') }} (ID: {{ oldValue }})
						{% endif %}
					{% endif %}

					{% if revertable %}
						<input type="text" value="{{ oldValue is array ? oldValue|jsonEncode : oldValue }}" name="mediaAssignments[{{ mediaElement.id }}][{{ mediaSelector.identifier }}][mediaId]">

						{% if oldDiffersFromCurrent and settings.isAjax %}
							<button type="button" class="Button Button-Revert">{{ __('revert_value') }}</button>
						{% endif %}
					{% endif %}
				{% endif %}
			</td>
			<td class="TableCell-NewValue">
				{{ _self.formatMediaEntities(newValue, settings) }}
			</td>
			<td class="TableCell-CurrentValue">
				{{ _self.formatMediaEntities(currentValue, settings) }}
			</td>
		</tr>
	{% endfor %}
{% endmacro %}

{% macro formatMediaEntities(value, settings) %}
	{% if value is array %}
		{% for mediaId in value %}
			{% if settings.media[ mediaId ] is defined %}
				<a href="{{ baseUrl }}{{ settings.media[ mediaId ].path }}" target="_blank">{{ settings.media[ mediaId ].path }}</a> (ID: {{ mediaId }})<br>
			{% else %}
				{{ __('unknown_file') }} (ID: {{ mediaId }})<br>
			{% endif %}
		{% endfor %}
	{% elseif value is not null %}
		{% if settings.media[ value ] is defined %}
			<a href="{{ baseUrl }}{{ settings.media[ value ].path }}" target="_blank">{{ settings.media[ value ].path }}</a> (ID: {{ value }})
		{% else %}
			{{ __('unknown_file') }} (ID: {{ value }})
		{% endif %}
	{% endif %}
{% endmacro %}

{% macro formatUsergroupPermissions(entities, settings) %}
	{#
	Macro to format usergroup permissions grouped by scope.
	@var entities array<\Awyiss\Model\Entity>
	@var settings array
	#}
	{%- set entitiesGroupedByScope = {} %}
	{%- for entity in entities %}
		{%- set labelData = entity.labelData %}
		{%- set entityScope = labelData.scope %}
		{%- if entitiesGroupedByScope[ entityScope ] is not defined %}
			{%- set entitiesGroupedByScope = entitiesGroupedByScope|merge({ (entityScope): [] }) %}
		{%- endif %}
		{%- set entitiesGroupedByScope = entitiesGroupedByScope|merge({ (entityScope): entitiesGroupedByScope[ entityScope ]|merge([entity]) }) %}
	{%- endfor %}

	{%- set entitiesGroupedByScope = naturalSort(entitiesGroupedByScope, true) %}

	{%- for scopeTitle, groupEntities in entitiesGroupedByScope %}
		{%- set groupEntities = naturalSort(groupEntities, 'label') %}

		{%- if loop.index > 1 %}
			<br><hr><br>
		{%- endif %}

		<strong>{{ scopeTitle }}:</strong>
		<ul>
			{%- for entity in groupEntities %}
				{%- set labelData = entity.labelData %}
				<li class="PermissionAccess-{{ entity.access.name }}">
					{{ labelData.identifier }} (ID: {{ entity.id }})
				</li>
			{%- endfor %}
		</ul>
	{%- endfor %}
{% endmacro %}

{% macro tableHistoryBodyRow(entity, schema, scope, field, audit, associations, attribute, language, settings) %}
	{#
	Macro to render a table row for history data.
	@var entity \Awyiss\Model\Entity
	@var schema \Cake\Database\Schema\TableSchemaInterface
	@var scope string
	@var field string
	@var audit \Awyiss\Model\Entity\Audit
	@var associations array<string, array{name: string, property: string}>
	@var attribute \Awyiss\Model\Entity\Attribute|null
	@var language \Awyiss\Model\Entity\Language|null
	@var settings array
	#}

	{% set isAttribute = attribute != null %}
	{% set columnType = schema.columnType(field) %}
	{% set isLanguage = language is not empty %}

	{% set field = field|variable %}
	{% set inputName = field|underscore %}
	{% if isAttribute %}
		{% set inputName = 'attributes[' ~ inputName ~ ']' %}
	{% endif %}

	{% set oldData = isAttribute ? (audit.dataOld['attributes'] ?? []) : audit.dataOld %}
	{% set newData = isAttribute ? (audit.dataNew['attributes'] ?? []) : audit.dataNew %}

	{% if isLanguage %}
		{% set oldData = oldData['_translations'][ language.shortcode ] %}
		{% set newData = newData['_translations'][ language.shortcode ] %}
		{% set entity = isAttribute ? (entity.get('attributes').get('_translations')[ language.shortcode ] ?? null) : (entity.get('_translations')[ language.shortcode ] ?? null) %}

		{% set inputName = '_translations[' ~ language.shortcode ~ '][' ~ inputName ~']' %}

		{% if isAttribute %}
			{% set inputName = 'attributes[_translations][' ~ language.shortcode ~ '][' ~ inputName ~']' %}
		{% endif %}
	{% endif %}

	{%- set isHtml = (field in ['text', 'textHtml', 'successMessage']) or (isAttribute and attribute.inputType == 'texteditor') %}

	{%- set oldDiffersFromCurrent = oldData[ field ] != entity.get(field) %}
	{%- set oldDiffersFromNew = oldData[ field ] != newData[ field ] %}
	{%- set newDiffersFromCurrent = newData[ field ] != entity.get(field) %}

	{%- if entity.get(field) is enum %}
		{%- set oldDiffersFromCurrent = oldData[ field ] != entity.get(field).value %}
		{%- set newDiffersFromCurrent = newData[ field ] != entity.get(field).value %}
	{%- elseif columnType == 'date' %}
		{%- set oldDiffersFromCurrent = (oldData[ field ] ? TimeHelper.i18nFormat(oldData[ field ], dateFormat) : '') != (entity.get(field) ? TimeHelper.i18nFormat(entity.get(field), dateFormat) : '') %}
		{%- set oldDiffersFromNew = (oldData[ field ] ? TimeHelper.i18nFormat(oldData[ field ], dateFormat) : '') != (newData[ field ] ? TimeHelper.i18nFormat(newData[ field ], dateFormat) : '') %}
		{%- set newDiffersFromCurrent = (newData[ field ] ? TimeHelper.i18nFormat(newData[ field ], dateFormat) : '') != (entity.get(field) ? TimeHelper.i18nFormat(entity.get(field), dateFormat) : '') %}
	{%- elseif columnType == 'datetime' %}
		{%- set oldDiffersFromCurrent = (oldData[ field ] ? TimeHelper.nice(oldData[ field ]) : '') != (entity.get(field) ? TimeHelper.nice(entity.get(field)) : '') %}
		{%- set oldDiffersFromNew = (oldData[ field ] ? TimeHelper.nice(oldData[ field ]) : '') != (newData[ field ] ? TimeHelper.nice(newData[ field ]) : '') %}
		{%- set newDiffersFromCurrent = (newData[ field ] ? TimeHelper.nice(newData[ field ]) : '') != (entity.get(field) ? TimeHelper.nice(entity.get(field)) : '') %}
	{%- elseif columnType == 'time' %}
		{%- set oldDiffersFromCurrent = (oldData[ field ] ? TimeHelper.i18nFormat(oldData[ field ], timeFormat) : '') != (entity.get(field) ? TimeHelper.i18nFormat(entity.get(field), timeFormat) : '') %}
		{%- set oldDiffersFromNew = (oldData[ field ] ? TimeHelper.i18nFormat(oldData[ field ], timeFormat) : '') != (newData[ field ] ? TimeHelper.i18nFormat(newData[ field ], timeFormat) : '') %}
		{%- set newDiffersFromCurrent = (newData[ field ] ? TimeHelper.i18nFormat(newData[ field ], timeFormat) : '') != (entity.get(field) ? TimeHelper.i18nFormat(entity.get(field), timeFormat) : '') %}
	{%- elseif associations[ field ] is defined and associations[ field ].type == 'manyToMany' %}
		{%- set oldIds = oldData[ field ] is not empty ? oldData[ field ]|column('id') : [] %}
		{%- set newIds = newData[ field ] is not empty ? newData[ field ]|column('id') : [] %}
		{%- set currentIds = entity.get(associations[ field ]['property']) is not empty ? entity.get(associations[ field ]['property'])|column('id') : [] %}

		{%- set oldDiffersFromCurrent = oldIds|sort != currentIds|sort %}
		{%- set oldDiffersFromNew = oldIds|sort != newIds|sort %}
		{%- set newDiffersFromCurrent = newIds|sort != currentIds|sort %}
	{%- elseif isAttribute %}
		{% if oldData[ field ] is empty and entity.get(field) is empty %}
			{% set oldDiffersFromCurrent = false %}
		{% endif %}

		{% if newData[ field ] is empty and entity.get(field) is empty %}
			{% set newDiffersFromCurrent = false %}
		{% endif %}
	{%- endif %}

	{% set attributeOptions = isAttribute ? (settings.attributeOptionsCollection.getAttributeOption(field).getOptions(field) ?? []) : null %}

	{%- set oldValue = _self.formatOldValue(field, oldData, entity, scope, associations, columnType, oldDiffersFromCurrent, attribute, attributeOptions, settings) %}
	{%- set newValue = _self.formatOldValue(field, newData, entity, scope, associations, columnType, oldDiffersFromCurrent, attribute, attributeOptions, settings) %}

	{% set realOldValue = oldData[ field ] %}
	{% set realNewValue = newData[ field ] %}

	{%- set currentValue %}
		{%- if associations[ field ] is defined %}
			{%- set associationField = associations[ field ]['property'] %}
			{%- if associations[ field ].type in ['oneToMany', 'manyToMany'] %}
				{%- if entity.get(associationField) is not empty %}
					{%- if associations[ field ].name == 'UsergroupPermissions' %}
						{{- _self.formatUsergroupPermissions(entity.get(associationField), settings) }}
					{%- else %}
						<ul>
							{%- set associatedEntities = naturalSort(entity.get(associationField), 'label')  %}
							{%- for associatedEntity in associatedEntities %}
								<li>
									{{- associatedEntity ? associatedEntity.label|raw : __('unknown_entity') }}
									{%- if associatedEntity %} (ID: {{ associatedEntity.id }}){% endif %}
								</li>
							{%- endfor %}
						</ul>
					{%- endif %}
				{%- endif %}
			{%- else %}
				{{- entity.get(associationField).label }}
				{%- if entity.get(associationField) %} (ID: {{ entity.get(associationField).id }}){% endif %}
			{%- endif %}
		{%- elseif columnType == 'boolean' %}
			{{- entity.get(field) ? '<i class="las la-check"></i>' : '<i class="las la-times"></i>' }}
		{%- elseif columnType == 'date' %}
			{{- entity.get(field) ? TimeHelper.i18nFormat(entity.get(field), dateFormat) : '' }}
		{%- elseif columnType == 'datetime' %}
			{{- entity.get(field) ? TimeHelper.nice(entity.get(field)) : '' }}
		{%- elseif columnType == 'time' %}
			{{- entity.get(field) ? TimeHelper.i18nFormat(entity.get(field), timeFormat) : '' }}
		{%- elseif columnType == 'json' %}
			{{- entity.get(field) is not empty ? entity.get(field)|jsonEncode : '' }}
		{%- elseif field == 'fieldset' %}
			{{- entity.get(field) is not empty ? __d(scope, 'fieldset_' ~ entity.get(field)|underscore) : '' }}
		{%- elseif field == 'inputType' %}
			{{- entity.get(field) is not empty ? __d(scope, 'input_type_' ~ entity.get(field)|underscore) : '' }}
		{%- elseif field == 'columnWidth' %}
			{{- entity.column.width.label }}
		{%- elseif field == 'columnIndent' %}
			{{- entity.column.indent.label }}
		{%- elseif (field in ['text', 'textHtml', 'successMessage']) or (isAttribute and attribute.inputType == 'texteditor') -%}
			<code>{{- MediaHelper.rebuildSimpleImageTagsInText(entity.get(field), settings.media)|escape }}</code>
		{%- elseif (field == 'css') -%}
			<textarea data-readonly="1" data-css-editor="1">{{ entity.get(field) }}</textarea>
		{%- elseif attributeOptions != null %}
			{{- attributeOptions[ entity.get(field) ] ?? '' }}
		{%- elseif field == 'password' or (isAttribute and attribute.inputType == 'password') %}
			{{- entity.get(field) ? '********' : '' }}
		{%- else %}
			{{- entity.get(field) }}
		{%- endif %}
	{%- endset %}

	<tr class="
			{%- if oldDiffersFromCurrent %} OldValueDiffersFromCurrent{% endif -%}
			{%- if oldDiffersFromNew %} OldValueDiffersFromNew{% endif -%}
			{%- if newDiffersFromCurrent %} NewValueDiffersFromCurrent{% endif -%}
			{%- if isHtml %} ValueIsHtml{% endif -%}
			{%- if field == 'css' %} ViewCode{% endif -%}
		"
		data-field="{{ inputName }}">
		<td class="TableCell-Field">
			{% if field in ['metaTitle', 'metaDescription', 'robotsIndex', 'robotsFollow'] %}
				{{ __d('Seo', field|underscore) }}
			{% elseif isLanguage %}
				{{ language.label }}
			{% elseif isAttribute %}
				{{ attribute.label }}
			{% elseif settings.isPageRole %}
				{% set label = __df(scope, 'Pages', field|underscore) %}
				{% if '::' in label %}
					{% set label = __d('Pages', field|underscore) %}
				{% endif %}
				{{ label }}
			{% else %}
				{{ __d(scope, field|underscore) }}
			{% endif %}
		</td>
		<td class="TableCell-OldValue">
			{{ oldValue }}

			{% if realOldValue is array %}
				{% for key, value in realOldValue %}
					<input type="text" value="{{ key }}" name="{% if isAttribute %}attributes[{{ field|underscore }}]{% else %}{{ field|underscore }}[{{ loop.index0 }}][key]{% endif %}">
					<input type="text" value="{{ value }}" name="{% if isAttribute %}attributes[{{ field|underscore }}]{% else %}{{ field|underscore }}[{{ loop.index0 }}][value]{% endif %}">
				{% endfor %}
			{% else %}
				<input type="text" value="{{ realOldValue }}" name="{% if isAttribute %}attributes[{{ field|underscore }}]{% else %}{{ field|underscore }}{% endif %}">
			{% endif %}
			{% if oldDiffersFromCurrent and settings.isAjax %}
				<button type="button" class="Button Button-Revert">{{ __('revert_value') }}</button>
			{% endif %}
		</td>
		<td class="TableCell-NewValue">
			{{ newValue }}
		</td>
		<td class="TableCell-CurrentValue">
			{{ currentValue }}
		</td>
	</tr>
{% endmacro %}

{% macro formatOldValue(field, oldData, entity, scope, associations, columnType, oldDiffersFromCurrent, attribute, attributeOptions, settings) %}
	{#
	@var field string
	@var oldData array
	@var entity \Awyiss\Model\Entity
	@var scope string
	@var associations array<string, array{name: string, property: string}>
	@var columnType string
	@var oldDiffersFromCurrent bool
	@var attribute \Awyiss\Model\Entity\Attribute|null
	@var attributeOptions array
	@var settings array
	#}

	{% set isAttribute = attribute != null %}

	{%- if associations[ field ] is defined %}
		{%- set associationField = associations[ field ]['property'] %}
		{%- if associations[ field ].type in ['oneToMany', 'manyToMany'] %}
			{%- if oldData[ field ] is not empty %}
				{%- if associations[ field ].name == 'UsergroupPermissions' %}
					{{ _self.formatUsergroupPermissions(oldData[ field ], settings) }}
				{%- else %}
					<ul>
						{%- for associatedEntity in oldData[ field ] %}
							<li>
								{{- associatedEntity ? associatedEntity.label|raw : __('unknown_entity') }}
								{%- if associatedEntity %} (ID: {{ associatedEntity.id }}){% endif %}
							</li>
						{%- endfor %}
					</ul>
				{%- endif %}
			{%- endif %}
		{%- elseif oldData[ field ] is not empty and oldDiffersFromCurrent == false %}
			{{- entity.get(associationField).label }}
			{%- if entity.get( associationField) %} (ID: {{ entity.get(associationField).id }}){% endif %}
		{%- elseif oldData[ field ] %}
			{%- if oldData[ associationField ] is defined %}
				{{- oldData[ associationField ].label ?? __('unknown_entity') }}
				{%- if oldData[ associationField ] %} (ID: {{ oldData[ associationField ].id }}){% endif %}
			{%- else %}
				{{- __('unknown_entity') }} (ID: {{ oldData[ field ] }})
			{%- endif %}
		{%- endif %}
	{%- elseif columnType == 'boolean' %}
		{{- oldData[ field ] ? '<i class="las la-check"></i>' : '<i class="las la-times"></i>' }}
	{%- elseif columnType == 'date' %}
		{{- oldData[ field ] ? TimeHelper.i18nFormat(oldData[ field ], dateFormat) : '' }}
	{%- elseif columnType == 'datetime' %}
		{{- oldData[ field ] ? TimeHelper.nice(oldData[ field ]) : '' }}
	{%- elseif columnType == 'time' %}
		{{- oldData[ field ] ? TimeHelper.i18nFormat(oldData[ field ], timeFormat) : '' }}
	{%- elseif columnType == 'json' %}
		{{- oldData[ field ] is not empty ? oldData[ field ]|jsonEncode : '' }}
	{%- elseif columnType == 'string' and field == 'languageShortcode' %}
		{{- oldData[ field ] ? languages.Frontend[ oldData[ field ] ].title : '' }}
	{%- elseif field == 'fieldset' %}
		{{- oldData[ field ] is not empty ? __d(scope, 'fieldset_' ~ oldData[ field ]|underscore) : '' }}
	{%- elseif field == 'inputType' %}
		{{- oldData[ field ] is not empty ? __d(scope, 'input_type_' ~ oldData[ field ]|underscore) : '' }}
	{%- elseif field == 'columnWidth' %}
		{{- oldData['column'].width.label }}
	{%- elseif field == 'columnIndent' %}
		{{- oldData['column'].indent.label }}
	{%- elseif (field in ['text', 'textHtml', 'successMessage']) or (isAttribute and attribute.inputType == 'texteditor') -%}
		<code>{{- MediaHelper.rebuildSimpleImageTagsInText(oldData[ field ], settings.media)|escape }}</code>
	{%- elseif (field == 'css') -%}
		<textarea data-readonly="1" data-css-editor="1">{{ oldData[ field ] }}</textarea>
	{%- elseif attributeOptions != null %}
		{{- attributeOptions[ oldData[ field ] ] ?? '' }}
	{%- elseif field == 'password' or (isAttribute and attribute.inputType == 'password') %}
		{{- oldData[ field ] ? '********' : '' }}
	{%- else %}
		{{- oldData[ field ] ?? '' }}
	{%- endif %}
{% endmacro %}

<div class="Contents History">
	{% block headlinesHistory %}
		<div class="Headlines">
			{% if isAjax == false %}
				{{ HtmlHelper.link(__('back_to_overview'), {controller: scope, action: 'overview'}, {class: 'BackToOverview'}) }}
			{% endif %}

			{% block headlineHistory %}
				<h1>{{ __('headline_history') }}</h1>
			{% endblock %}

			{% block subheadlineHistory %}
				<h2>{{ entity.label }}</h2>
			{% endblock %}
		</div>
	{% endblock %}

	{% if isAjax %}
		<div class="Inner" data-title="{{ __('headline_history') }} - {{ entity.label }}">
			{% block buttonArea %}
				<div class="ButtonArea">
					{{ FormHelper.button(__('close'), {class: 'Button Button-Close'}) }}
				</div>
			{% endblock %}
	{% endif %}

	{% block tablesHistory %}
		<div class="AuditHistory-Tables"
			data-show-columns-label="{{ __('show_columns') }}"
			data-old-value-label="{{ __('old_value') }}"
			data-new-value-label="{{ __('new_value') }}"
			data-current-value-label="{{ __('current_value') }}"
			data-reference-column-label="{{ __('reference_column') }}"
			data-show-old-value="1"
			data-show-new-value="0"
			data-show-current-value="1"
		>
			{% for audit in audits %}
				{% set tableBodyRows = 0 %}
				{% set tableBody %}
					{% block tableHistoryBodyRow %}
						{% for field in historyFields %}
							{% if field in translatableFields and languages|length > 1 %}
								<tr>
									<td colspan="3" class="TableCell-Translation-Label">
										{% if isPageRole %}
											{{ __d(scope, 'pages', field|underscore) }}
										{% else %}
											{{ __d(scope, field|underscore) }}
										{% endif %}
									</td>
								</tr>
								{% for language in languages %}
									{{ _self.tableHistoryBodyRow(entity, schema, scope, field, audit, associations, null, language, _context) }}
								{% endfor %}
							{% else %}
								{{ _self.tableHistoryBodyRow(entity, schema, scope, field, audit, associations, null, null, _context) }}
							{% endif %}
						{% endfor %}

						{% for field, attribute in attributes %}
							{% if field in translatableAttributes and languages|length > 1 %}
								<tr>
									<td colspan="3" class="TableCell-Translation-Label">
										{{ attribute.label }}
									</td>
								</tr>
								{% for language in languages %}
									{{ _self.tableHistoryBodyRow(entity, attributesSchema, scope, field|variable, audit, associations, attribute, language, _context) }}
								{% endfor %}
							{% else %}
								{{ _self.tableHistoryBodyRow(entity, attributesSchema, scope, field|variable, audit, associations, attribute, null, _context) }}
							{% endif %}
						{% endfor %}

						{% if publicationDataEnabled %}
							<tr>
								<td colspan="3" class="TableCell-PublicationData-Label">
									{{ __d('PublicationData', 'fieldset_publication') }}
								</td>
							</tr>

							{% set oldData = audit.dataOld %}
							{% set newData = audit.dataNew %}

							{% set oldValue = oldData._publicationData.start.dateTime %}
							{% set newValue = newData._publicationData.start.dateTime %}
							{% set currentValue = entity.publicationStart ? entity.publicationStart.format('Y-m-d H:i:s') : null %}

							{% set oldDiffersFromCurrent = oldValue != currentValue %}
							{% set oldDiffersFromNew = oldValue != newValue %}
							{% set newDiffersFromCurrent = newValue != currentValue %}

							<tr
								class="
									{%- if oldDiffersFromCurrent %} OldValueDiffersFromCurrent{% endif -%}
									{%- if oldDiffersFromNew %} OldValueDiffersFromNew{% endif -%}
									{%- if newDiffersFromCurrent %} NewValueDiffersFromCurrent{% endif -%}
								"
								data-field="_publicationData[start][date_time]">
								<td class="TableCell-Field">{{ __d('PublicationData', 'date_time_start') }}</td>
								<td class="TableCell-OldValue">
									{{ oldValue ? TimeHelper.nice(oldValue) : '' }}

									<input type="text" value="{{ oldValue }}" name="_publicationData[start][date_time]">

									{% if oldDiffersFromCurrent and isAjax %}
										<button type="button" class="Button Button-Revert">{{ __('revert_value') }}</button>
									{% endif %}
								</td>
								<td class="TableCell-NewValue">
									{{ newValue ? TimeHelper.nice(newValue) : '' }}
								</td>
								<td class="TableCell-CurrentValue">
									{{ entity.publicationStart ? TimeHelper.nice(entity.publicationStart) : '' }}
								</td>
							</tr>

							{% set oldValue = oldData._publicationData.end.dateTime %}
							{% set newValue = newData._publicationData.end.dateTime %}
							{% set currentValue = entity.publicationEnd ? entity.publicationEnd.format('Y-m-d H:i:s') : null %}

							{% set oldDiffersFromCurrent = oldValue != currentValue %}
							{% set oldDiffersFromNew = oldValue != newValue %}
							{% set newDiffersFromCurrent = newValue != currentValue %}

							<tr
								class="
									{%- if oldDiffersFromCurrent %} OldValueDiffersFromCurrent{% endif -%}
									{%- if oldDiffersFromNew %} OldValueDiffersFromNew{% endif -%}
									{%- if newDiffersFromCurrent %} NewValueDiffersFromCurrent{% endif -%}
								"
								data-field="_publicationData[end][date_time]">
								<td class="TableCell-Field">{{ __d('PublicationData', 'date_time_end') }}</td>
								<td class="TableCell-OldValue">
									{{ oldValue ? TimeHelper.nice(oldValue) : '' }}

									<input type="text" value="{{ oldValue }}" name="_publicationData[end][date_time]">

									{% if oldDiffersFromCurrent and isAjax %}
										<button type="button" class="Button Button-Revert">{{ __('revert_value') }}</button>
									{% endif %}
								</td>
								<td class="TableCell-NewValue">
									{{ newValue ? TimeHelper.nice(newValue) : '' }}
								</td>
								<td class="TableCell-CurrentValue">
									{{ entity.publicationEnd ? TimeHelper.nice(entity.publicationEnd) : '' }}
								</td>
							</tr>
						{% endif %}

						{% for mediaElement in mediaElements %}
							{% if mediaElement.identifier != 'inlineImgTag' %}
								{{ _self.tableHistoryBodyMediaRow(entity, audit, mediaElement, _context) }}
							{% endif %}
						{% endfor %}
					{% endblock %}
				{% endset %}

				{% set tableBodyRows = tableBody|split('</tr>')|length - 1 %}

				{% block tableHistory %}
					<table class="Overview-Table AuditHistory-Table"
						style="--rows:{{ max(1, tableBodyRows) }}; --columns: 3;"
						data-date-time="{{ TimeHelper.nice(audit.createdOn) }}" data-timestamp="{{ audit.createdOn.timestamp }}">
						{% block tableHistoryHead %}
							<thead>
								{% block tableHistoryHeadRow %}
									<tr>
										{% block tableHistoryHeadRowInner %}
											{% block tableHistoryHeaderField %}
												<th class="TableHeader-Field">{{ __('field') }}</th>
											{% endblock %}

											{% block tableHistoryHeaderOldValue %}
												<th class="TableHeader-OldValue">{{ __('old_value') }}</th>
											{% endblock %}

											{% block tableHistoryHeaderNewValue %}
												<th class="TableHeader-NewValue">{{ __('new_value') }}</th>
											{% endblock %}

											{% block tableHistoryHeaderCurrentValue %}
												<th class="TableHeader-CurrentValue">
													{{ __('current_value') }}
												</th>
											{% endblock %}
										{% endblock %}
									</tr>
								{% endblock %}
							</thead>
						{% endblock %}
						{% block tableHistoryBody %}
							<tbody>
								{{ tableBody }}
							</tbody>
						{% endblock %}
						{% block tableHistoryFoot %}
							<tfoot>
								{% block tableHistoryFootRow %}
									<tr>
										{% block tableHistoryFooterInfo %}
											<td colspan="3" class="TableFooter-Info">
												{{ __('history_entry_info', TimeHelper.nice(audit.createdOn), audit.user ? audit.user.username : (audit.createdBy ? __('user_unknown') : __('user_system'))) }}
											</td>
										{% endblock %}
									</tr>
								{% endblock %}
							</tfoot>
						{% endblock %}
					</table>
				{% endblock %}
			{% else %}
				<h3>{{ __('no_audit_entries') }}</h3>
			{% endfor %}
		</div>
	{% endblock %}

	{% if isAjax %}</div>{% endif %}
</div>