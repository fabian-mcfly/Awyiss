{#
@var widget \Awyiss\Model\Entity\Widget
@var widgetTemplates \Cake\Collection\CollectionInterface
@var possibleParentWidgets \Cake\Collection\CollectionInterface
@var assignedAttributes array
@var widgetElementsByFieldset WidgetTemplateElement[]
@var languageRealm string
@var languageShortcode string
@var _view \Awyiss\View\BackendView
#}

<div class="Widgets Form Edit">
	{% if AuthorizationHelper.isAccessible('read') %}
		{{ HtmlHelper.link(__('back_to_overview'), {action: 'overview'}, {class: 'BackToOverview'}) }}
	{% endif %}

	{% block headlineEdit %}
		<h1>{{ __('headline_edit') }}</h1>
	{% endblock %}

	{{ FormHelper.create(widget, {method: 'post', idPrefix: 'widget'}) }}

	{{ FormHelper.checkbox('save_as_copy', {id: 'SaveAsCopy', value: true}) }}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block formEditButtons %}
				{{ element('audit/audit_history_button', {entity: widget}) }}

				<label for="SaveAsCopy" class="Button Button-SaveAsCopy Label-SaveAsCopy">{{ __('as_copy') }}</label>

				{{ FormHelper.button(__('save'), {class: 'Button Button-Success Button-Save'}) }}

				{% if AuthorizationHelper.isAccessible('read') %}
					{{ FormHelper.button(__('save_close'), {class: 'Button Button-SaveClose', name: 'submit', value: 'submit_close'}) }}
				{% endif %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block formEdit %}
		{% include('@Backend/Widgets/form.twig') %}
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('formEditButtons') }}
		</div>
	{% endblock %}

	{{ FormHelper.end() }}
</div>
