{#
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}
{% block formControlActive %}
	{{ FormHelper.control('active', {
		columnSpan: widgetTemplateElement.column.span.numerator,
		label: widgetTemplateElement.title,
	}) }}
{% endblock %}


{% block formControlIdentifier %}
	{% set knownIdentifiers = localConfig('knownIdentifiers') %}
	{%
		set helperFormControl = knownIdentifiers is not empty ? FormHelper.select(
			'identifier_helper_options',
			combine(knownIdentifiers|values, knownIdentifiers|values),
			{
				'data-options-for': 'Widget-Identifier',
			}
		) : ''
	%}

	{{ FormHelper.control('identifier', {
		columnSpan: widgetTemplateElement.column.span.numerator,
		label: widgetTemplateElement.title,
		templateVars: {
			additionalContent: helperFormControl
		},
		'data-form-updater': true,
	}) }}
{% endblock %}


{% block formControlWidgetTemplateId %}
	{% set widgetTemplateAddButton %}
		{% if AuthorizationHelper.scopeIsAccessible('WidgetTemplates', [], 'create') %}
			{{ HtmlHelper.link(__d('widget_templates', 'create'), {controller: 'WidgetTemplates', action: 'add'}, {class: 'Button Button-Add InFieldButton OverlayForm'}) }}
		{% endif %}
	{% endset %}

	{% set widgetTemplateEditButton %}
		{% if AuthorizationHelper.scopeIsAccessible('WidgetTemplates', [], 'update') %}
			{{ HtmlHelper.link(__('edit'), {controller: 'WidgetTemplates', action: 'edit', id: settings.widget.widgetTemplateId}, {class: 'Button Button-Edit InFieldButton OverlayForm'}) }}
		{% endif %}
	{% endset %}

	{{ FormHelper.control('widget_template_id', {
		columnSpan: widgetTemplateElement.column.span.numerator,
		empty: false,
		label: widgetTemplateElement.title,
		options: settings.widgetTemplates.combine('id', 'title'),
		templateVars: {
			additionalContent: widgetTemplateAddButton ~ widgetTemplateEditButton
		},
		'data-form-updater': true,
	}) }}
{% endblock %}


{% block formControlLanguageShortcode %}
	{{ LocaleHelper.control('language_shortcode', {
		columnSpan: widgetTemplateElement.column.span.numerator,
		label: widgetTemplateElement.title,
		languageRealm: settings.languageRealm,
		val: settings.languageShortcode,
		'data-form-updater': true,
	}) }}
{% endblock %}


{% block formControlSystemOrder %}
	{{ SystemOrderHelper.control('system_order', {
		columnSpan: widgetTemplateElement.column.span.numerator,
		entity: settings.widget,
		label: widgetTemplateElement.title,
	}) }}
{% endblock %}


{% block formControlColumnWidth %}
	{{ FormHelper.control('column_width', {
		columnSpan: widgetTemplateElement.column.span.numerator,
		empty: false,
		label: widgetTemplateElement.title,
		options: settings.columnWidths,
		required: widgetTemplateElement.required,
		type: 'select'}
	) }}
{% endblock %}


