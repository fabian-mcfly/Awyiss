{#
@var widget \Awyiss\Model\Entity\Widget
@var widgetTemplates \Cake\Collection\CollectionInterface
@var possibleParentWidgets \Cake\Collection\CollectionInterface
@var assignedAttributes array
@var widgetElementsByFieldset WidgetTemplateElement[]
@var languageRealm string
@var languageShortcode string
@var expertMode bool
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

<div class="Widgets Form Edit EditFrontendEditor{% if expertMode %} ExpertMode{% endif %}" data-title="{{ __('headline_edit') }}">
	{% block buttonArea %}
		<div class="ButtonArea">
			{% block formEditButtons %}
				{% block formEditButtonSave %}
					{{ FormHelper.button(__('save'), {class: 'Button Button-Success Button-Save', form: 'EditFrontendEditor'}) }}
				{% endblock %}
			{% endblock %}

			{% block formEditButtonClose %}
				{{ FormHelper.button(__('close'), {class: 'Button Button-Close'}) }}
			{% endblock %}
		</div>
	{% endblock %}

	{{ FormHelper.create(widget, {method: 'post', id: 'EditFrontendEditor', idPrefix: 'widget'}) }}

	{% block flashMessages %}
		{{ FlashHelper.render() }}
	{% endblock %}

	{% block formEdit %}
		{% include('@Backend/Widgets/form.twig') %}
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('formEditButtons') }}
		</div>
	{% endblock %}

	{% block lockDialog %}
		{{ element('lock_dialog', {entity: widget}) }}
	{% endblock %}

	{{ FormHelper.end() }}
</div>
