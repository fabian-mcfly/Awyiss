{% extends '@Backend/element/overview/nested_list_item.twig' %}

{% block nestedListItemAuditInfo %}
	<div class="Audit-Preview">
		{{ parent() }}

		{{ HtmlHelper.link(__('preview'), {action: 'preview', id: entity.id}, {class: 'Button Button-Small Button-Subtle Button-Preview'}) }}
	</div>
{% endblock %}

{% block nestedListItemDataDefaultFields %}
	<li class="DataItem DataItem-Slug">
		<span class="Label">{{ __df(pageRoleName, 'GenericPages', 'slug') }}:</span>
		{{ HtmlHelper.link((config.Route.includeLanguageShortcode ? entity.languageShortcode ~ '/' : null) ~ entity.slug, {
			lang: config.Route.includeLanguageShortcode ? entity.languageShortcode : null,
			slug: entity.slug,
			_name: 'Frontend',
		}, {
			target: '_blank',
		}) }}
	</li>
{% endblock %}

{% block nestedListItemDataDisplayedFields %}
	{% for field in displayedFields %}
		{% if field == 'slug' %}
		{% else %}
			{% block nestedListItemDataDisplayedField %}
				{{ parent() }}
			{% endblock %}
		{% endif %}
	{% endfor %}
{% endblock %}

{% block nestedListActions %}
	<span class="Actions">
		{% block nestedListActionsViewContents %}
			{% if entity.hasContentTemplate() and entity.duplicateOf is empty and AuthorizationHelper.isAccessible('contents') and settings.contentsEnabled == true %}
				{{ HtmlHelper.link(__df(pageRoleName, 'GenericPages', 'view_contents'), {controller: 'contents', action: 'overview', pageId: entity.id}, {class: 'Button Button-Small Button-View Button-ViewContents'}) }}
			{% endif %}
		{% endblock %}

		{{ block('nestedListActionsGallery') }}

		{{ block('nestedListActionsEdit') }}

		{{ block('nestedListActionsDelete') }}
	</span>
{% endblock %}
