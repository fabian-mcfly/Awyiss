{#
@var lo_entity \Awyiss\Model\Entity\Page
@var settings array
#}

<div class="{{ settings.identifier }}-ListItem-Inner ListItem-Inner">
	<span class="Id">{{ lo_entity.id }}</span>
	<ul class="Data">
		<li class="Title">{{ lo_entity.title }}</li>
		<li class="Slug">
			{{ helper_Html_link(lo_entity.languageShortcode ~ '/' ~ lo_entity.slug, {
				lang: lo_entity.languageShortcode,
				slug: lo_entity.slug,
				_name: 'Frontend',
			}, {
				target: '_blank',
			}) }}
		</li>
	</ul>
	<span class="Actions">
		{% if lo_entity.duplicate_of is empty and helper_Authorization_isAccessible('contents') and settings.contentsEnabled == true %}
			{{ helper_Html_link(__('view_contents'), {controller: 'contents', action: 'overview', page_id: lo_entity.id}) }}
		{% endif %}

		{% if helper_Authorization_isAccessible('update') %}
			{{ helper_Html_link(__('edit'), {action: 'edit', id: lo_entity.id}) }}
		{% endif %}

		{% if helper_Authorization_isAccessible('delete') %}
			{{ helper_Html_link(__('delete'), {action: 'delete', id: lo_entity.id}, {confirm: __('confirm_delete', lo_entity.id) }) }}
		{% endif %}
	</span>
</div>