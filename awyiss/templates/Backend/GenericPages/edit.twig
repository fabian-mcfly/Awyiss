{#
@var page \Awyiss\Model\Entity\Page
@var parentRecord \Awyiss\Model\Entity\Page
@var pageTemplates \Cake\Collection\CollectionInterface
@var threadedPages \Cake\Collection\CollectionInterface
@var possibleParentPages \Cake\Collection\CollectionInterface
@var languageRealm string
@var localConfig array
@var nestable bool
@var pageRole \Awyiss\Model\Entity\PageRole
@var pageRoleName string
@var isDuplicated bool
@var _view \Awyiss\View\BackendView
#}

<div class="Pages Form Edit">
	{% if AuthorizationHelper.isAccessible('read') %}
		{{ HtmlHelper.link(__('back_to_overview'), {action: 'overview'}, {class: 'BackToOverview'}) }}
	{% endif %}

	{% block headlineEdit %}
		<h1>{{ __df(pageRoleName, 'generic_pages', 'headline_edit', pageRole.title) }}</h1>
	{% endblock %}

	{{ FormHelper.create(page, {method: 'post', idPrefix: pageRoleName}) }}

	{{ FormHelper.checkbox('save_as_copy', {id: 'SaveAsCopy', value: true}) }}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block formEditButtons %}
				{% block tableOverviewCellActionsViewContents %}
					{% if page.duplicate_of is empty and AuthorizationHelper.isAccessible('contents') and contentsEnabled == true %}
						{{ HtmlHelper.link(__df(pageRoleName, 'generic_pages', 'view_contents'), {controller: 'contents', action: 'overview', pageId: page.id}, {class: 'Button Button-Small Button-Subtle Button-View Button-ViewContents'}) }}
					{% endif %}
				{% endblock %}

				<label for="SaveAsCopy" class="Button Button-SaveAsCopy Label-SaveAsCopy">{{ __('as_copy') }}</label>
				{{ FormHelper.button(__('save'), {class: 'Button Button-Success Button-Save'}) }}
				{% if AuthorizationHelper.isAccessible('read') %}
					{{ FormHelper.button(__('save_close'), {class: 'Button Button-SaveClose', name: 'submit', value: 'submit_close'}) }}
				{% endif %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block formEdit %}
		{% include('@Backend/GenericPages/form.twig') %}
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('formEditButtons') }}
		</div>
	{% endblock %}

	{{ FormHelper.end() }}
</div>
