{#
@var page \Awyiss\Model\Entity\Page
@var parentRecord \Awyiss\Model\Entity\Page
@var pageTemplates \Cake\Collection\CollectionInterface
@var threadedPages \Cake\Collection\CollectionInterface
@var possibleParentPages \Cake\Collection\CollectionInterface
@var languageRealm string
@var localConfig array
@var nestable bool
@var pageRole \Awyiss\Model\Entity\PageRole
@var pageRoleName string
@var isDuplicated bool
@var _view \Awyiss\View\BackendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var AttributesHelper \Awyiss\View\Helper\AttributesHelper
@var AuditHelper \Awyiss\View\Helper\AuditHelper
@var AuthorizationHelper \Awyiss\View\Helper\AuthorizationHelper
@var CategoriesHelper \Awyiss\View\Helper\CategoriesHelper
@var FlashHelper \Awyiss\View\Helper\FlashHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var PaginatorHelper \Awyiss\View\Helper\PaginatorHelper
@var SystemOrderHelper \Awyiss\View\Helper\SystemOrderHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

<div class="Pages Form Edit">
	{% block headlinesAdd %}
		<div class="Headlines">
			{% if AuthorizationHelper.isAccessible('read') %}
				{{ HtmlHelper.link(__('back_to_overview'), {action: 'overview'}, {class: 'BackToOverview'}) }}
			{% endif %}

			{% block headlineEdit %}
				<h1>
					<div class="Buttons">
						{% block buttonPreview %}
							{{ HtmlHelper.link(__('preview'), {controller: page.pageRoleId.name|pluralize, action: 'preview', id: page.id}, {class: 'Button Button-Small Button-Subtle Button-Preview'}) }}
						{% endblock %}

						{% block buttonEdit %}
							{% if page.duplicate_of is empty and AuthorizationHelper.isAccessible('contents') and contentsEnabled == true %}
								{{ HtmlHelper.link(__df(pageRoleName, 'generic_pages', 'view_contents'), {controller: 'contents', action: 'overview', pageId: page.id}, {class: 'Button Button-Small Button-Subtle Button-View Button-ViewContents'}) }}
							{% endif %}
						{% endblock %}
					</div>

					{{ __df(pageRoleName, 'generic_pages', 'headline_edit', pageRole.title) }}
				</h1>
			{% endblock %}
		</div>
	{% endblock %}

	{{ FormHelper.checkbox('save_as_copy', {form: 'GenericPageForm', id: 'SaveAsCopy', value: true, 'data-form-updater': true}) }}

	{% block buttonAreaToggle %}
		{{ FormHelper.button(__('button_area_toggle'), {class: 'Button Button-Menu', id: 'ButtonArea-Toggle', name: 'button', type: 'button'}) }}
	{% endblock %}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block formEditButtons %}
				{% block formEditButtonSaveAsCopy %}
					<label for="SaveAsCopy" tabindex="0" class="Button Button-SaveAsCopy Label-SaveAsCopy">{{ __('as_copy') }}</label>
				{% endblock %}

				{% block formEditButtonSave %}
					{{ FormHelper.button(__('save'), {class: 'Button Button-Success Button-Save', form: 'GenericPageForm'}) }}
				{% endblock %}

				{% block formEditButtonSaveClose %}
					{% if isOverlayForm != true and AuthorizationHelper.isAccessible('read') %}
						{{ FormHelper.button(__('save_close'), {class: 'Button Button-SaveClose', form: 'GenericPageForm', name: 'submit_type', value: 'submit_close'}) }}
					{% endif %}
				{% endblock %}

				{% block overlayFormButtonClose %}
					{% if isOverlayForm == true %}
						{{ FormHelper.button(__('close'), {class: 'Button Button-Close'}) }}
					{% endif %}
				{% endblock %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block formEdit %}
		{% include('@Backend/GenericPages/form.twig') %}
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('formEditButtons') }}
		</div>
	{% endblock %}
</div>
