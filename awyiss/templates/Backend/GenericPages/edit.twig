{#
@var ao_page \Awyiss\Model\Entity\Page
@var ao_pageTemplates \Cake\Collection\CollectionInterface
@var ao_threadedPages \Cake\Collection\CollectionInterface
@var ao_possibleParentPages \Cake\Collection\CollectionInterface
@var as_languageRealm string
@var localConfig array
@var ab_nestable bool
@var hasDescendantsWithDifferentPageRole bool
@var _view \Awyiss\View\BackendView
#}

<div class="Pages Form Edit">
	{{ FormHelper.create(ao_page, {method: 'post', idPrefix: 'page'}) }}

	{{ FormHelper.checkbox('save_as_copy', {id: 'SaveAsCopy', value: true}) }}

	{% block headlineEdit %}
		<h1>{{ __('headline_edit') }}</h1>
	{% endblock %}

	{% block formEditButtons %}
		<label for="SaveAsCopy">{{ __('as_copy') }}</label>
		{{ FormHelper.button(__('save')) }}
		{{ FormHelper.button(__('save_close'), {name: 'submit', value: 'submit_close'}) }}
	{% endblock %}

	{% if hasDescendantsWithDifferentPageRole %}
		<p>
			{{ __('copy_descendants_with_different_page_role') }}
			{{ FormHelper.radio('copy_descendants_with_different_page_role', {
				0: __('copy_descendants_with_different_page_role_no'),
				1: __('copy_descendants_with_different_page_role_yes'),
			}) }}
		</p>
	{% endif %}

	{% block formEdit %}
		{% include('@Backend/GenericPages/form.twig') %}
	{% endblock %}

	{% block formEditButtonsBottom %}
		{{ block('formEditButtons') }}
	{% endblock %}

	{{ FormHelper.end() -}}
</div>