{% extends '@Backend/element/overview/overview_paginated_list.twig' %}

{% block tableOverviewCellAuditInfo %}
	<td class="TableCell-AuditInfo">
		<div class="AuditInfo" data-id="{{ entity.id }}" title="">
			<ul class="AuditInfoList">
				<li><strong>ID:</strong> {{ entity.id }}</li>
			</ul>

			{{ HtmlHelper.link(__d('Audit', 'show_history'), {
				controller: 'audit',
				action: 'history',
				scope: entity.source|underscore,
				id: entity.id
			}, {
				escape: false,
				title: __d('Audit', 'show_history'),
			}) }}
		</div>

		{{ HtmlHelper.link(__('preview'), {action: 'preview', id: entity.id}, {class: 'Button Button-Small Button-Subtle Button-Preview'}) }}
	</td>
{% endblock %}

{% block tableOverviewCellTitle %}
	<td class="TableCell-Title">
		{{ entity.title }}
		<br>
		<span class="Slug">{{ HtmlHelper.link((config.Route.includeLanguageShortcode ? entity.languageShortcode ~ '/' : null) ~ entity.slug, {
			lang: config.Route.includeLanguageShortcode ? entity.languageShortcode : null,
			slug: entity.slug,
			_name: 'Frontend',
		}, {
			target: '_blank',
		}) }}</span>
	</td>
{% endblock %}

{% block tableOverviewCellActions %}
	<td class="TableCell-Actions">
		<div class="Actions">
			{% block tableOverviewCellActionsViewContents %}
				{% if entity.hasContentTemplate() and entity.duplicateOf is empty and AuthorizationHelper.isAccessible('contents') and contentsEnabled == true %}
					{{ HtmlHelper.link(__df(pageRoleName, 'GenericPages', 'view_contents'), {controller: 'contents', action: 'overview', pageId: entity.id}, {class: 'Button Button-Small Button-View Button-ViewContents'}) }}
				{% endif %}
			{% endblock %}

			{{ block('tableOverviewCellActionsGallery') }}

			{{ block('tableOverviewCellActionsUpdate') }}

			{{ block('tableOverviewCellActionsDelete') }}
		</div>
	</td>
{% endblock %}
