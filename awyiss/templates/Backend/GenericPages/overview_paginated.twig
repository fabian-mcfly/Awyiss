{#
@var la_pages \Awyiss\Model\Entity\Page[]
@var localConfig array
@var ab_contentsEnabled bool
@var ab_nestable bool
@var ab_paginated bool
@var ab_sortable bool
@var _view \Awyiss\View\BackendView
#}

{% block tableOverview %}
	<table class="Table-Overview">
		{% block tableOverviewHead %}
			<thead>
				{% block tableOverviewHeadRow %}
					<tr>
						{% block tableOverviewHeaderId %}
							<th>{{ PaginatorHelper.sort('id') }}</th>
						{% endblock %}

						{% block tableOverviewHeaderTitle %}
							<th>{{ PaginatorHelper.sort('title') }}</th>
						{% endblock %}

						{% block tableOverviewHeaderSystemOrder %}
							<th>{{ PaginatorHelper.sort('system_order') }}</th>
						{% endblock %}

						{% block tableOverviewHeaderActions %}
							<th class="actions"></th>
						{% endblock %}
					</tr>
				{% endblock %}
			</thead>
		{% endblock %}
		{% block tableOverviewBody %}
			<tbody>
				{# @var lo_page \Awyiss\Model\Entity\Page #}
				{% for lo_page in ao_pages %}
					{% block tableOverviewBodyRow %}
						<tr>
							{% block tableOverviewCellId %}
								<td>{{ lo_page.id }}</td>
							{% endblock %}

							{% block tableOverviewCellTitle %}
								<td>{{ lo_page.title }} <br> {{ lo_page.slug }}</td>
							{% endblock %}

							{% block tableOverviewCellLevel %}
								<td>level {{ lo_page.level }} - order {{ lo_page.systemOrder }}</td>
							{% endblock %}

							{% block tableOverviewCellActions %}
								<td class="actions">
									{% if lo_page.duplicate_of is empty and AuthorizationHelper.isAccessible('contents') and ab_contentsEnabled == true %}
										{{ HtmlHelper.link(__('view_contents'), {controller: 'contents', action: 'overview', page_id: lo_page.id}) }}
									{% endif %}

									{% if AuthorizationHelper.isAccessible('update') %}
										{{ HtmlHelper.link(__('edit'), {action: 'edit', id: lo_page.id}) }}
									{% endif %}

									{% if AuthorizationHelper.isAccessible('delete') %}
										{{ HtmlHelper.link(__('delete'), {action: 'delete', id: lo_page.id}, {
				class: 'Button Button-Small Button-Delete',
				'data-confirm-title': __('confirm_delete_title'),
				'data-confirm-yes': __('confirm_delete_yes'),
				'data-confirm-yes-class': 'Button-Delete',
				'data-confirm-no': __('confirm_delete_no'),
				'data-confirm': __('confirm_delete', lo_page.id) }) }}
									{% endif %}
								</td>
							{% endblock %}
						</tr>
					{% endblock %}
				{% endfor %}
			</tbody>
		{% endblock %}
	</table>
{% endblock %}