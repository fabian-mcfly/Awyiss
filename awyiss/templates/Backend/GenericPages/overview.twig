{#
@var pages \Awyiss\Model\Entity\Page[]|\Cake\Datasource\Paging\PaginatedResultSet
@var localConfig array
@var pageTemplates array
@var contentsEnabled bool
@var nestable bool
@var paginated bool
@var sortable bool
@var pageRole \Awyiss\Model\Entity\PageRole
@var pageRoleName string
@var _view \Awyiss\View\BackendView
#}

<div class="Pages Overview">
	{% block headlinesOverview %}
		<div class="Headlines">
			{% block headlineOverview %}
				<h1>{{ __df(pageRoleName, 'generic_pages', 'headline_overview', pageRole.title) }}</h1>
			{% endblock %}
		</div>
	{% endblock %}

	{% block buttonAreaToggle %}
		{{ FormHelper.button(__('button_area_toggle'), {class: 'Button Button-Menu', id: 'ButtonArea-Toggle', name: 'button', type: 'button'}) }}
	{% endblock %}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block categoriesFilterOverview %}
				{{ CategoriesHelper.filter('category') }}
			{% endblock %}

			{% block overviewButtons %}
				{% block overviewButtonSaveSystemOrder %}
					{% if sortable and paginated == false %}
						<button class="Button Button-SaveSystemOrder" disabled>{{ __d('system', 'save_system_order') }}</button>
					{% endif %}
				{% endblock %}

				{% block overviewButtonAdd %}
					{% if AuthorizationHelper.isAccessible('create') %}
						{{ HtmlHelper.link(__df(pageRoleName, 'generic_pages', 'create', pageRole.title), {action: 'add'}, {class: 'Button Button-Add' }) }}
					{% endif %}
				{% endblock %}

				{% block overviewButtonFilter %}
					{{ element('search/filter_button', {scope: pageRole.identifier|pluralize}) }}
				{% endblock %}

				{% block listControlOverviewListPaginated %}
					{{ HtmlHelper.link(__('list_paginated'), {action: 'userConfiguration', identifier: 'paginate.enabled', value: 'true'}, {
						class: 'Button Button-Small Button-ListView Button-ListView-PaginatedList',
						disabled: localConfig.paginate.enabled == true
					}) }}
				{% endblock %}

				{% block listControlOverviewListNested %}
					{{ HtmlHelper.link(__('list_nested'), {action: 'userConfiguration', identifier: 'paginate.enabled', value: 'false'}, {
						class: 'Button Button-Small Button-ListView Button-ListView-NestedList',
						disabled: localConfig.paginate.enabled == false
					}) }}
				{% endblock %}
			{% endblock %}
		</div>
	{% endblock %}

	{% if paginated %}
		{% block paginatedOverview %}
			{% include '@Backend/GenericPages/overview_paginated_list.twig' with _context|merge({
				i18nDomain: 'generic_pages',
				records: pages.items().toArray(),
			}) %}
		{% endblock %}
	{% else %}
		{% block listOverview %}
			<div class="Overview-List">
				{% from '@Backend/macro/nested_list.twig' import nestedList %}
				{{ nestedList(pages, _context|merge({
					data: {
						nestable: false,
						sortable: sortable and _filter[ pageRole.identifier|pluralize ]['active'] == false,
						'movable-between-groups': false,
					},
					displayedFields: localConfig.overview.displayedFields,
					i18nDomain: 'generic_pages',
					identifier: 'Pages',
					template: '@Backend/GenericPages/overview_nested_list_item.twig',
				})) }}
			</div>
		{% endblock %}
	{% endif %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('categoriesFilterOverview') }}

			{{ block('overviewButtons') }}
		</div>
	{% endblock %}

	{% block listFilter %}
		{{ element('search/filter', {
			scope: pageRole.identifier|pluralize,
			i18nDomain: 'generic_pages',
		}) }}
	{% endblock %}
</div>
