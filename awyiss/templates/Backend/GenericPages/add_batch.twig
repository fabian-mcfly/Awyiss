{% use '@Backend/GenericPages/form.twig' %}

{% block formControlDuplicateOf %}{% endblock %}
{% block formControlTitle %}{% endblock %}
{% block formControlSlug %}{% endblock %}
{% block formControlMetaTitle %}{% endblock %}
{% block formControlMetaDescription %}{% endblock %}
{% block formControlRedirectLink %}{% endblock %}

<div class="Pages Form AddBatch">
	{% block headlinesAddBatch %}
		<div class="Headlines">
			{% if AuthorizationHelper.isAccessible('read') %}
				{{ HtmlHelper.link(__('back_to_overview'), {action: 'overview', pageId: page.id}, {class: 'BackToOverview'}) }}
			{% endif %}

			{% block headlineAddBatch %}
				<h1>{{ __df(pageRoleName, 'GenericPages', 'headline_add_batch', pageRole.title) }}</h1>
			{% endblock %}
		</div>
	{% endblock %}

	{% block buttonAreaToggle %}
		{{ FormHelper.button(__('button_area_toggle'), {class: 'Button Button-Menu', id: 'ButtonArea-Toggle', name: 'button', type: 'button'}) }}
	{% endblock %}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block formAddButtons %}
				{% block formAddButtonSave %}
					{{ FormHelper.button(__('save'), {class: 'Button Button-Success Button-Save', form: 'GenericPageForm'}) }}
				{% endblock %}

				{% block formAddButtonSaveClose %}
					{% if isOverlayForm != true and AuthorizationHelper.isAccessible('read') %}
						{{ FormHelper.button(__('save_close'), {class: 'Button Button-SaveClose', form: 'GenericPageForm', name: 'submitType', value: 'submitClose'}) }}
					{% endif %}
				{% endblock %}

				{% block overlayFormButtonClose %}
					{% if isOverlayForm == true %}
						{{ FormHelper.button(__('close'), {class: 'Button Button-Close'}) }}
					{% endif %}
				{% endblock %}
			{% endblock %}
		</div>
	{% endblock %}

	{{ FormHelper.create(page, {method: 'post', id: 'GenericPageForm', idPrefix: pageRoleName}) }}
	<input type="hidden" name="attributes" value="">

	{% set fieldsetGeneral %}
		{% block fieldsetGeneral %}
			<fieldset class="Fieldset-General">
				<legend>{{ __('fieldset_general') }}</legend>

				{% block fieldsetGeneralInner %}
					{% block formControlPages %}
						{{ FormHelper.control('pages', {
							label: __df(pageRoleName, 'GenericPages', 'pages'),
							type: 'textarea',
						}) }}
					{% endblock %}

					{{ parent() }}
				{% endblock %}
			</fieldset>
		{% endblock %}
	{% endset %}

	{% block fieldsets %}
		<div class="Fieldsets">
			{% block formAddBatch %}
				{% if config.Awyiss.System.Backend.interface.sidebarMode != true or isOverlayForm == true %}
					{{ block("fieldsetPresentation") }}

					{{ block("fieldsetConditions") }}

					{{ block("fieldsetGeneral") }}

					{{ block("fieldsetContent") }}

					{{ block("fieldsetAttributes") }}
				{% endif %}

				{{ block('mainFieldsets') }}

				{{ block('sidebarFieldsets') }}

				{{ block("formInputReloadForm") }}
			{% endblock %}
		</div>
	{% endblock %}

	{{ FormHelper.end() }}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('formAddButtons') }}
		</div>
	{% endblock %}
</div>
