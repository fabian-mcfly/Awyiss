{% extends '@Backend/element/overview/overview_paginated_list.twig' %}

{% block tableOverviewHeaderTitle %}{% endblock %}
{% block tableOverviewHeaderDefaultFields %}
	<th class="TableHeader-Email{% if PaginatorHelper.isCurrentSortKey('email') %} Active{% endif %}">
		{{ PaginatorHelper.sort('email', i18nDomain ? __df(i18nDomain, 'System', 'email') : __('email')) }}
	</th>
{% endblock %}

{% block tableOverviewCellTitle %}{% endblock %}
{% block tableOverviewCellDefaultFields %}
	<td class="TableCell-Email">{{ entity.email }}</td>
{% endblock %}

{% block tableOverviewCellDisplayedFieldDefaultValue %}
	{% if field == 'lastLogin' %}
		{{ entity.lastLogin ? TimeHelper.nice(entity.lastLogin) : '-' }}
	{% else %}
		{{ parent() }}
	{% endif %}
{% endblock %}
