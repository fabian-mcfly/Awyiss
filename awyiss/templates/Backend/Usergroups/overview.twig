{#
@var ao_usergroups \Awyiss\Model\Entity\Usergroup[]
@var _view \Awyiss\View\BackendView
#}

<div class="Usergroups Overview">
	{% block buttonsOverview %}
		{% if helper_Authorization_isAccessible('create') %}
			{{ helper_Html_link(__('create'), {action: 'add'}, {class: 'Button'}) }}
		{% endif %}
	{% endblock %}

	{% block headlineOverview %}
		<h1>{{ __('headline_overview') }}</h1>
	{% endblock %}

	{% block tableOverview %}
		<table class="Table-Overview">
			{% block tableOverviewHead %}
				<thead>
					{% block tableOverviewHeadRow %}
						<tr>
							{% block tableOverviewHeaderTitle %}
								<th>{{ helper_Paginator_sort('title') }}</th>
							{% endblock %}

							{% block tableOverviewHeaderActions %}
								<th class="actions"></th>
							{% endblock %}
						</tr>
					{% endblock %}
				</thead>
			{% endblock %}
			{% block tableOverviewBody %}
				<tbody>
					{# @var lo_usergroup \Awyiss\Model\Entity\Usergroup #}
					{% for lo_usergroup in ao_usergroups %}
						{% block tableOverviewBodyRow %}
							<tr>
								{% block tableOverviewCellTitle %}
									<td>{{ lo_usergroup.title }}</td>
								{% endblock %}

								{% block tableOverviewCellActions %}
									<td class="actions">
										{% if helper_Authorization_isAccessible('update') %}
											{{ helper_Html_link(__('edit'), {action: 'edit', id: lo_usergroup.id}) }}
										{% endif %}
										{% if helper_Authorization_isAccessible('delete') %}
											{{ helper_Html_link(__('delete'), {action: 'delete', id: lo_usergroup.id}) }}
										{% endif %}
									</td>
								{% endblock %}
							</tr>
						{% endblock %}
					{% endfor %}
				</tbody>
			{% endblock %}
		</table>
	{% endblock %}

	{% block paginationOverview %}
		{{ helper_Paginator_render() }}
	{% endblock %}
</div>
