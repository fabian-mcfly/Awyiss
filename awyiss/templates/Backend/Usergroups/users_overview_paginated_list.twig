{#
@var usergroups \Awyiss\Model\Entity\Usergroup[]
@var _view \Awyiss\View\BackendView
#}

{% extends '@Backend/element/overview/overview_paginated_list.twig' %}

{% block tableOverviewHeaderAuditInfo %}{% endblock %}
{% block tableOverviewHeaderTitle %}{% endblock %}

{% block tableOverviewHeadRowInner %}
	<th class="TableHeader-UserCheckbox"></th>
	{{ parent() }}
{% endblock %}

{% block tableOverviewHeaderDisplayedFields %}
	{% for field in config.Awyiss.Users.Backend.overview.displayedFields %}
		{% block tableOverviewHeaderDisplayedField %}
			{{ parent() }}
		{% endblock %}
	{% endfor %}
{% endblock %}

{% block tableOverviewHeaderActions %}{% endblock %}

{% block tableOverviewCellAuditInfo %}{% endblock %}
{% block tableOverviewCellTitle %}{% endblock %}

{% block tableOverviewBodyRowInner %}
	<td class="TableCell-UserCheckbox">
		{{ FormHelper.control('users._ids.' ~ entity.id, {
			hiddenField: false,
			type: 'checkbox',
			value: entity.id,
			label: '',
			checked: entity.id in (usergroup.users ?? [])|column('id'),
		}) }}
	</td>
	{{ parent() }}
{% endblock %}

{% block tableOverviewCellDisplayedFields %}
	{% for field in config.Awyiss.Users.Backend.overview.displayedFields %}
		{% block tableOverviewCellDisplayedField %}
			{{ parent() }}
		{% endblock %}
	{% endfor %}
{% endblock %}

{% block tableOverviewCellDisplayedFieldDefaultValue %}
	{% if field == 'last_login' %}
		{{ entity.last_login ? entity.last_login.nice() : '-' }}
	{% else %}
		{{ parent() }}
	{% endif %}
{% endblock %}

{% block tableOverviewCellActions %}{% endblock %}

{% block listControlListLimitInner %}{% endblock %}

{% block tableOverviewFootColSpan %}{{ config.Awyiss.Users.Backend.overview.displayedFields|length + 2 }}{% endblock %}