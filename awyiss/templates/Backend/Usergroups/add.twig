{#
@var ao_usergroup \Awyiss\Model\Entity\Usergroup
@var ao_users \Awyiss\Model\Entity\User[]
@var aa_authorizationPolicies array
@var _view \Awyiss\View\BackendView
#}

<div class="Usergroups Form Add">
	{{ helper_Form_create(ao_usergroup, {method: 'post', idPrefix: 'Usergroup'}) }}

	{% block headlineAdd %}
		<h1>{{ __('headline_add') }}</h1>
	{% endblock %}

	{% block formAddButtons %}
		{{ helper_Form_button(__('save')) }}
		{{ helper_Form_button(__('save_close'), {name: 'submit', value: 'submit_close'}) }}
	{% endblock %}

	{% block formAdd %}
		{% include('@Backend/Usergroups/form.twig') %}
	{% endblock %}

	{% block formAddButtonsBottom %}
		{{ block('formAddButtons') }}
	{% endblock %}

	{{ helper_Form_end() -}}
</div>