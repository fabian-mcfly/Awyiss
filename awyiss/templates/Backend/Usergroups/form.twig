{% if helper_Authorization_scopeIsAccessible('Users', [], ['read']) %}
	{% block fieldsetUsers %}
		<fieldset class="Fieldset-Users">
			<legend>{{ __('users') }}</legend>

			{% block fieldsetUsersInner %}
				{{ helper_Form_hidden('users._ids', {value: ''}) }}
				{% block usergroupsUsers %}
					<ul class="NoList">
						{% for lo_user in ao_users %}
							{% block usergroupsUser %}
								<li>
									{{ helper_Form_control('users._ids.' ~ lo_user.id, {
										hiddenField: false,
										type: 'checkbox',
										value: lo_user.id,
										label: lo_user.username,
										checked: lo_user.id in (ao_usergroup.users ?? [])|column('id'),
									}) }}
								</li>
							{% endblock %}
						{% endfor %}
					</ul>
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endif %}

{% block fieldsetPermissions %}
	<fieldset class="Fieldset-Permissions">
		<legend>{{ __('permissions') }}</legend>

		{% block fieldsetPermissionsInner %}
			{% block usergroupPolicies %}
				{% for lx_policyClass in aa_authorizationPolicies %}
					{% block usergroupPolicy %}
						<fieldset class="Fieldset-Permission">
							<legend>{{ (lx_policyClass is string ? staticCall(lx_policyClass, 'getScope') : lx_policyClass.getScope)|underscore }}</legend>

							<ul class="NoList Permissions">
								{% block usergroupPermissions %}
									{% set lo_permissions = lx_policyClass is string ? staticCall(lx_policyClass, 'getPermissionOptions') : lx_policyClass.getPermissionOptions %}
									{% for ls_identifier,lo_permission in lo_permissions %}
										{# @var lo_permission \Awyiss\Authorization\Permission\PermissionInterface #}
										{% block usergroupPermission %}
											<li class="Permission">
												{{ __(ls_identifier) }}
												{{ helper_Authorization_permissionOptions(lo_permission, ao_usergroup, null, 'Usergroups') }}
											</li>
										{% endblock %}
									{% endfor %}
								{% endblock %}
							</ul>
						</fieldset>
					{% endblock %}
				{% endfor %}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

