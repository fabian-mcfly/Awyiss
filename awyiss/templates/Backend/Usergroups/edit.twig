{#
@var ao_usergroup \Awyiss\Model\Entity\Usergroup
@var ao_users \Awyiss\Model\Entity\User[]
@var aa_authorizationPolicies array
@var _view \Awyiss\View\BackendView
#}

<div class="Usergroups Form Edit">
	{{ FormHelper.create(ao_usergroup, {method: 'post', idPrefix: 'Usergroup'}) }}

	{{ FormHelper.checkbox('save_as_copy', {id: 'SaveAsCopy', value: true}) }}

	{% block headlineEdit %}
		<h1>{{ __('headline_edit') }}</h1>
	{% endblock %}

	{% block formEditButtons %}
		<label for="SaveAsCopy">{{ __('as_copy') }}</label>
		{{ FormHelper.button(__('save')) }}
		{{ FormHelper.button(__('save_close'), {name: 'submit', value: 'submit_close'}) }}
	{% endblock %}

	{% block formEdit %}
		{% include('@Backend/Usergroups/form.twig') %}
	{% endblock %}

	{% block formEditButtonsBottom %}
		{{ block('formEditButtons') }}
	{% endblock %}

	{{ FormHelper.end() -}}
</div>