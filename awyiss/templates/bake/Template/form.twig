{{ '{#' }}
@var ao_{{ singularVar }} {{ entityClass }}
@var as_languageRealm string
@var as_systemOrderField string
@var _view \{{ namespace }}\View\BackendView
{{ '#}' }}

{%- if associations.BelongsToMany is defined %}
{%- for assocName, assocData in associations.BelongsToMany %}
		{% verbatim %}{{ CategoriesHelper.control('{% endverbatim %}{{ assocData.property }}{% verbatim %}._ids', {options: ao_{% endverbatim %}{{ assocData.variable }}{% verbatim %}}) }}{% endverbatim %}

{%- endfor %}
{% endif %}
{% verbatim %}{% block fieldsetPresentation %}
	<fieldset class="Fieldset-Presentation">
		<legend>{{ __('fieldset_presentation') }}</legend>

		{% block fieldsetPresentationInner %}
			{% block fieldsetPresentationAttributes %}
				{{ AttributesHelper.allControls('presentation') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetConditions %}
	<fieldset class="Fieldset-Conditions">
		<legend>{{ __('fieldset_conditions') }}</legend>

		{% block fieldsetConditionsInner %}
			{% block fieldsetConditionsAttributes %}
				{{ AttributesHelper.allControls('conditions') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetGeneral %}
	<fieldset class="Fieldset-General">
		<legend>{{ __('fieldset_general') }}</legend>
{% endverbatim %}
{% for field in fields %}
{%- if field not in ['deleted', 'created_on', 'created_by', 'changed_on', 'changed_by', 'deleted_on', 'deleted_by']|merge(primaryKey) %}
		{% verbatim %}{% block formControl{% endverbatim %}{{ field|camelize }}{% verbatim %} %}
{% endverbatim %}

{%- if keyFields[field] is defined %}
{%- set fieldData = Bake.columnData(field, schema) %}
{%- if fieldData.null %}
			{% verbatim %}{{ FormHelper.control('{% endverbatim %}{{ field }}{% verbatim %}', {options: ao_{% endverbatim %}{{ keyFields[field] }}{% verbatim %}, empty: true}) }}{% endverbatim %}
{{- "\n" }}
{%- else %}
			{% verbatim %}{{ FormHelper.control('{% endverbatim %}{{ field }}{% verbatim %}', {options: ao_{% endverbatim %}{{ keyFields[field] }}{% verbatim %}}) }}{% endverbatim %}
{{- "\n" }}
{%- endif %}
{%- elseif field == 'parent_id' %}
			{% verbatim %}{% if (as_categoriesIdentifier is defined) %}
				{{ CategoriesHelper.control(as_categoriesIdentifier) }}
			{% endif %}

			{% if (ao_parent{% endverbatim %}{{ pluralVar|camelize }}{% verbatim %} is not null) %}
				{{ FormHelper.control('parent_id', {options: hashPrinter(ao_parent{% endverbatim %}{{ pluralVar|camelize }}{% verbatim %}, 'label', 'id', '- ')}) }}
			{% endif %}{% endverbatim %}
{{- "\n" }}
{%- elseif field == 'system_order' %}
			{% verbatim %}{% if as_systemOrderField == 'systemOrder' %}
				{{ SystemOrderHelper.control('system_order') }}
			{% endif %}{% endverbatim %}
{{- "\n" }}
{%- elseif field == 'languages_shortcode' %}
			{% verbatim %}{{ LocaleHelper.control('language_shortcode', {languageRealm: as_languageRealm}) }}{% endverbatim %}
{{- "\n" }}
{%- elseif field not in ['deleted', 'created_on', 'created_by', 'changed_on', 'changed_by', 'deleted_on', 'deleted_by'] %}
{%- set fieldData = Bake.columnData(field, schema) %}
{%- if fieldData.type in ['date', 'datetime', 'time'] and fieldData.null %}
			{% verbatim %}{{ FormHelper.control('{% endverbatim %}{{ field }}{% verbatim %}', {empty: true}) }}{% endverbatim %}
{{- "\n" }}
{%- else %}
			{% verbatim %}{{ FormHelper.control('{% endverbatim %}{{ field }}{% verbatim %}') }}{% endverbatim %}
{{- "\n" }}
{%- endif %}
{%- endif %}
		{% verbatim %}{% endblock %}

{% endverbatim -%}
{%- endif %}
{%- endfor %}
{% verbatim %}
		{% block fieldsetGeneralInner %}
			{% block fieldsetGeneralAttributes %}
				{{ AttributesHelper.allControls('general') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetContent %}
	<fieldset class="Fieldset-Content">
		<legend>{{ __('fieldset_content') }}</legend>

		{% block fieldsetContentInner %}
			{% block fieldsetContentAttributes %}
				{{ AttributesHelper.allControls('content') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetMedia %}
	<fieldset class="Fieldset-Media">
		<legend>{{ __('fieldset_media') }}</legend>

		{% block fieldsetMediaInner %}
			{% block fieldsetMediaAttributes %}
				{{ AttributesHelper.allControls('media') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block fieldsetAttributes %}
	<fieldset class="Fieldset-Attributes">
		<legend>{{ __('fieldset_attributes') }}</legend>

		{% block fieldsetAttributesInner %}
			{% block fieldsetAttributesAttributes %}
				{{ AttributesHelper.allControls('attributes') }}
			{% endblock %}
		{% endblock %}
	</fieldset>
{% endblock %}

{% block formInputReloadForm %}
	{{ FormHelper.hidden('reload_form', {val: 0}) }}
{% endblock %}
{% endverbatim %}