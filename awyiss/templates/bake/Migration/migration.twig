{%~ set wantedOptions = {'length': '', 'limit': '', 'default': '', 'unsigned': '', 'null': '', 'comment': '', 'autoIncrement': '', 'precision': '', 'scale': ''} %}
{%~ set tableMethod = Migration.tableMethod(action) %}
{%~ set columnMethod = Migration.columnMethod(action) %}
{%~ set indexMethod = Migration.indexMethod(action) %}
<?php declare(strict_types=1);


use Migrations\BaseMigration;


class {{ name }} extends BaseMigration {
{%~ if tableMethod == 'create' and columns['primaryKey'] %}
	public $autoId = false;

{%~ endif %}
	/**
	 * @inheritDoc
	 */
	public function change(): void {
		{%~ for table in tables %}
		$table = $this->table('{{ table }}');
			{%~ if tableMethod != 'drop' %}
				{%~ if columnMethod == 'removeColumn' %}
					{%~ for column, config in columns['fields'] %}
							$table->{{ columnMethod }}('{{ column }}');
					{%~ endfor %}
					{%~ if tableMethod == 'update' %}
						{%~ for indexName, config in columns['indexes'] %}
							{%~ if indexMethod == 'removeIndex' %}
		if ($table->hasIndexByName('{{ indexName }}')) {
			$table->{{ indexMethod }}([{{
				Migration.stringifyList(config['columns'])|raw
			}}]);
		}
							{%~ endif %}
						{%~ endfor %}
					{%~ endif %}
				{%~ else %}
					{%~ for column, config in columns['fields'] %}
						{%~ if columnMethod == 'changeColumn' and config['originalName'] is not empty %}
		$table->renameColumn('{{ config['originalName'] }}', '{{ column }}');
						{%~ endif %}
		$table->{{ columnMethod }}('{{ column }}', '{{ config['columnType'] }}', [{{
			Migration.stringifyList(config['options'], {'indent': 3}, wantedOptions)|raw
		}}]);
					{%~ endfor %}
					{%~ if tableMethod == 'update' %}
						{%~ for indexName, config in columns['indexes'] %}
							{%~ if indexMethod == 'removeIndex' %}
		if ($table->hasIndexByName('{{ indexName }}')) {
							{%~ else %}
		if (!$table->hasIndexByName('{{ indexName }}')) {
							{%~ endif %}
			$table->{{ indexMethod }}([{{
				Migration.stringifyList(config['columns'], {'indent': 4})|raw -}}
			], [{{
				Migration.stringifyList(config['options'], {'indent': 4})|raw
			}}]);
		}
						{%~ else %}{# correct else for the 'indexName, config in columns['indexes']' for loop #}
							{%~ if columnMethod == 'changeColumn' %}
								{%~ for column, config in columns['fields'] %}
		if ($table->hasIndexByName('BY_{{ (config['originalName'] is not empty ? config['originalName'] : column)|upper }}')) {
			$table->removeIndexByName('BY_{{ (config['originalName'] is not empty ? config['originalName'] : column)|upper }}');
		}
								{%~ endfor %}
							{%~ endif %}
						{%~ endfor %}
					{%~ elseif tableMethod == 'create' and indexMethod != 'removeIndex' %}
						{%~ for indexName, config in columns['indexes'] %}

		$table->{{ indexMethod }}([{{
			Migration.stringifyList(config['columns'], {'indent': 3})|raw -}}
		], [{{
			Migration.stringifyList(config['options'], {'indent': 3})|raw
		}}]);
						{%~ endfor %}
					{%~ endif %}
					{%~ if tableMethod == 'create' and columns['primaryKey'] is not empty %}
		$table->addPrimaryKey([{{
			Migration.stringifyList(columns['primaryKey'], {'indent': 3})|raw
		}}]);
					{%~ endif %}
				{%~ endif %}
			{%~ endif %}

		$table->{{ tableMethod }}(){%~ if tableMethod == 'drop' %}->save(){%~ endif %};
		{%~ endfor %}
	}
}
