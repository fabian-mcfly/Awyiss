{{ '{#' }}
@var {{ singularVar }} {{ entityClass }}
@var _view \{{ namespace }}\View\BackendView
{{ '#}' }}

{% set fields = Bake.filterFields(fields, schema, modelObject) %}
<div class="{{ pluralVar[:1]|upper ~ pluralVar[1:] }} Form {{ action|capitalize }}">
	{% verbatim %}{% if AuthorizationHelper.isAccessible('read') %}
		{{ HtmlHelper.link(__('back_to_overview'), {action: 'overview'}, {class: 'BackToOverview'}) }}
	{% endif %}

	{% block headlineEdit %}
		<h1>{{ __('headline_{% endverbatim %}{{ action }}{% verbatim %}') }}</h1>
	{% endblock %}

	{{ FormHelper.create({% endverbatim %}{{ singularVar }}{% verbatim %}, {method: 'post', idPrefix: '{% endverbatim %}{{ singularVar }}{% verbatim %}'}) }}

	{{ FormHelper.checkbox('save_as_copy', {id: 'SaveAsCopy', value: true}) }}{% endverbatim %}

	{% verbatim %}{% block buttonArea %}
		<div class="ButtonArea">
			{% block formEditButtons %}
				{% block formEditButtonSaveAsCopy %}
					<label for="SaveAsCopy" class="Button Button-SaveAsCopy Label-SaveAsCopy">{{ __('as_copy') }}</label>
				{% endblock %}

				{% block formEditButtonSave %}
					{{ FormHelper.button(__('save'), {class: 'Button Button-Success Button-Save'}) }}
				{% endblock %}

				{% block formEditButtonSaveClose %}
					{% if AuthorizationHelper.isAccessible('read') %}
						{{ FormHelper.button(__('save_close'), {class: 'Button Button-SaveClose', name: 'submit', value: 'submit_close'}) }}
					{% endif %}
				{% endblock %}
			{% endblock %}
		</div>
	{% endblock %}{% endverbatim %}

	{% verbatim %}{% block formEdit %}
		{% include('@Backend/{% endverbatim %}{{ modelClass }}{% verbatim %}/form.twig') %}
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('formEditButtons') }}
		</div>
	{% endblock %}

	{{ FormHelper.end() }}{% endverbatim %}
</div>
