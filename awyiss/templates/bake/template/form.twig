{{ '#}' }}

{%- if associations.BelongsToMany is defined %}
{%- for assocName, assocData in associations.BelongsToMany %}

{% verbatim %}{{ CategoriesHelper.control('{% endverbatim %}{{ assocData.property }}{% verbatim %}._ids', {options: {% endverbatim %}{{ assocData.variable }}{% verbatim %}}) }}{% endverbatim %}

{%- endfor %}
{% endif %}
{% verbatim %}

{{ FormHelper.create({% endverbatim %}{{ singularVar }}{% verbatim %}, {
	id: '{% endverbatim %}{{ singularVar|camelize }}{% verbatim %}Form',
	idPrefix: '{% endverbatim %}{{ singularVar }}{% verbatim %}',
	method: 'post',
}) }}

{% set fieldsetGeneral %}
	{% block fieldsetGeneral %}
		<fieldset class="Fieldset-General">
			<legend>{{ __('fieldset_general') }}</legend>

			{% block fieldsetGeneralInner %}
	{% endverbatim %}
	{% for field in fields %}
	{%- if field not in ['deleted', 'createdOn', 'createdBy', 'changedOn', 'changedBy', 'deletedOn', 'deletedBy']|merge(primaryKey) %}
			{% verbatim %}{% block formControl{% endverbatim %}{{ field|camelize }}{% verbatim %} %}
	{% endverbatim %}

	{%- if keyFields[field] is defined %}
	{%- set fieldData = Bake.columnData(field, schema) %}
	{%- if fieldData.null %}
				{% verbatim %}{{ FormHelper.control('{% endverbatim %}{{ field|variable }}{% verbatim %}', {options: {% endverbatim %}{{ keyFields[field] }}{% verbatim %}, empty: true}) }}{% endverbatim %}
	{{- "\n" }}
	{%- else %}
				{% verbatim %}{{ FormHelper.control('{% endverbatim %}{{ field|variable }}{% verbatim %}', {options: {% endverbatim %}{{ keyFields[field] }}{% verbatim %}}) }}{% endverbatim %}
	{{- "\n" }}
	{%- endif %}
	{%- elseif field == 'parentId' %}
				{% verbatim %}{% if (_categoriesIdentifier is defined) %}
					{{ CategoriesHelper.control(_categoriesIdentifier) }}
				{% endif %}

				{% if (parent{% endverbatim %}{{ pluralVar|camelize }}{% verbatim %} is not null) %}
					{{ FormHelper.control('parentId', {options: hashPrinter(parent{% endverbatim %}{{ pluralVar|camelize }}{% verbatim %}, 'label', 'id', '- ')}) }}
				{% endif %}{% endverbatim %}
	{{- "\n" }}
	{%- elseif field == 'systemOrder' %}
				{% verbatim %}{% if systemOrderField|variable == 'systemOrder' %}
					{{ SystemOrderHelper.control('systemOrder') }}
				{% endif %}{% endverbatim %}
	{{- "\n" }}
	{%- elseif field == 'languagesShortcode' %}
				{% verbatim %}{{ LocaleHelper.control('languageShortcode', {languageRealm: languageRealm}) }}{% endverbatim %}
	{{- "\n" }}
	{%- elseif field not in ['deleted', 'createdOn', 'createdBy', 'changedOn', 'changedBy', 'deletedOn', 'deletedBy'] %}
	{%- set fieldData = Bake.columnData(field, schema) %}
	{%- if fieldData.type in ['date', 'datetime', 'time'] and fieldData.null %}
				{% verbatim %}{{ FormHelper.control('{% endverbatim %}{{ field|variable }}{% verbatim %}', {empty: true}) }}{% endverbatim %}
	{{- "\n" }}
	{%- else %}
				{% verbatim %}{{ FormHelper.control('{% endverbatim %}{{ field|variable }}{% verbatim %}') }}{% endverbatim %}
	{{- "\n" }}
	{%- endif %}
	{%- endif %}
			{% verbatim %}{% endblock %}

	{% endverbatim -%}
	{%- endif %}
	{%- endfor %}
	{% verbatim %}
				{% block fieldsetGeneralAttributes %}
					{{ AttributesHelper.allControls('general') }}
				{% endblock %}
			{% endblock %}
		</fieldset>
	{% endblock %}
{% endset %}

