{{ '{#' }}
@var {{ pluralVar }} {{ entityClass }}[]
@var _view \{{ namespace }}\View\BackendView
{{ '#}' }}

<div class="{{ pluralVar[:1]|upper ~ pluralVar[1:] }} Overview">
{% set fields = Bake.filterFields(fields, schema, modelObject, indexColumns, ['binary', 'text']) %}
	{% verbatim %}{% block headlinesOverview %}
		<div class="Headlines">
			{% block headlineOverview %}
				<h1>{{ __('headline_overview') }}</h1>
			{% endblock %}
		</div>
	{% endblock %}

	{% block buttonAreaToggle %}
		{{ FormHelper.button(__('button_area_toggle'), {class: 'Button Button-Menu', id: 'ButtonArea-Toggle', name: 'button', type: 'button'}) }}
	{% endblock %}

	{% block buttonArea %}
		<div class="ButtonArea">
			{% block buttonsOverview %}
				{% block overviewButtonAdd %}
					{% if AuthorizationHelper.isAccessible('create') %}
						{{ HtmlHelper.link(__('create'), {action: 'add'}, {class : 'Button Button-Add'}) }}
					{% endif %}
				{% endblock %}

				{% block overviewButtonFilter %}
					{{ element('search/filter_button', {scope: '{% endverbatim %}{{ pluralVar }}{% verbatim %}'}) }}
				{% endblock %}
			{% endblock %}
		</div>
	{% endblock %}

	{% block paginatedOverview %}
		{% include '@Backend/element/overview/overview_paginated_list.twig' with _context|merge({records: {% endverbatim %}{{ pluralVar }}{% verbatim %}.items().toArray()}) %}
	{% endblock %}

	{% block buttonAreaBottom %}
		<div class="ButtonArea ButtonArea-Bottom">
			{{ block('buttonsOverview') }}
		</div>
	{% endblock %}{% endverbatim %}
</div>
