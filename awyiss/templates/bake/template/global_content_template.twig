{% verbatim %}{#
@var globalContent \Awyiss\Model\Entity\Content
@var children string
@var page \Awyiss\Model\Entity\Page
@var baseUrl string
@var currentLanguage \Awyiss\Model\Entity\Language
@var currentPath string
@var currentUrl string
@var folder string
@var languages \Awyiss\Model\Entity\Language[]
@var languageShortcode string
@var _view \Awyiss\View\FrontendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Awyiss\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
@var mediaRenderOptions \Awyiss\Utility\Media\MediaRenderOptions

// In case you need to set a class for the row, you can do it like this:
{%- do _view.setRowClass('FlexRow') -%}

#}{% endverbatim %}

<div class="{% verbatim %}{{ globalContent.cssClass }}{% endverbatim %}"{% verbatim %} {{ globalContent.data|dataAttr|raw }}{% endverbatim %} id="GlobalContent{% verbatim %}{{ globalContent.id }}{% endverbatim %}">
	{% verbatim %}{% if globalContent.title %}
		{% set tag = globalContent.titleTag ?? 'div' %}
		<{{ tag }} class="Title" id="{{ globalContent.title|ucparts(false) }}">
			{{ globalContent.title|raw }}
		</{{ tag }}>
	{% endif %}

	{% if globalContent.subtitle %}
		{% set tag = globalContent.subtitleTag ?? 'div' %}
		<{{ tag }} class="Subtitle" id="{{ globalContent.subtitle|ucparts(false) }}">
			{{ globalContent.subtitle|raw }}
		</{{ tag }}>
	{% endif %}

	{% if globalContent.text %}
		<div class="Text">
			{{ globalContent.text|raw }}
		</div>
	{% endif %}

	{% if globalContent.formId %}
		{{ form(globalContent.formId, {columnWidth: globalContent.realColumnWidth}) }}
	{% endif %}

	{% if globalContent.surveyId %}
		{{ survey(globalContent.surveyId, {columnWidth: globalContent.realColumnWidth}) }}
	{% endif %}

	{% if children %}
		<div class="Children">
			{{ children|raw }}
		</div>
	{% endif %}{% endverbatim %}
</div>
