{% set belongsTo = Bake.aliasExtractor(modelObj, 'BelongsTo') %}
{% set belongsToMany = Bake.aliasExtractor(modelObj, 'belongsToMany') %}

	/**
	 * Edit method
	 *
	 * @param int $id
	 * @return \Cake\Http\Response|void
	 * @throws \Exception
	 */
	public function edit(int $id) {
		$this->Authorization->ensure('update');

		/**
		 * @var \{{ namespace }}\Model\Entity\{{ entityClassName }} ${{ singularName }}
		 * @uses \Awyiss\Model\Behavior\MediaAssignmentBehavior::findMediaAssignments()
		 * @uses \Awyiss\Model\Behavior\MediaElementAssignmentBehavior::findMediaElementAssignments()
		 * @uses \Awyiss\Model\Table::findTranslations()
		 */
		${{ singularName }} = $this->{{ currentModelName }}->findById($id)->find('translations')->find('mediaAssignments')->find('mediaElementAssignments')->first();
		if (!${{ singularName }}) {
			$this->Flash->error(__('record_not_found'));

			return $this->redirect(['action' => 'overview']);
		}

		if ($this->request->is(['patch', 'post', 'put'])) {
			$this->save(${{ singularName }}, 'edit');
		}

		$this->set([
			'{{ singularName }}' => ${{ singularName }},
		]);
	}
