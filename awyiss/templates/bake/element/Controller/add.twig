	/**
	 * Add method
	 *
	 * @return void
	 * @throws \Exception
	 */
	public function add(): void {
		$this->Authorization->ensure('create');

		$lo_{{ singularName }} = $this->{{ currentModelName }}->newDefaultEntity();

		if ($this->request->is('post')) {
			$this->save($lo_{{ singularName }});
		}

		$this->set([
			'{{ singularName }}' => $lo_{{ singularName }},
{% set associations = Bake.aliasExtractor(modelObj, 'BelongsTo') %}
{% set associations = associations|merge(Bake.aliasExtractor(modelObj, 'BelongsToMany')) %}
{%- for assoc in associations %}
{%- set otherName = Bake.getAssociatedTableAlias(modelObj, assoc) %}
{%- set otherPlural = otherName|variable %}
			'{{ otherPlural }}' => $this->{{ currentModelName }}->{{ otherName }}->find('list', ['limit' => 200]),

{% endfor %}
		]);
	}
