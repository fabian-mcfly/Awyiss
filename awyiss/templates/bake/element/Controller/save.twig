
	/**
	* @param {{ entityClassName }} ${{ singularName }}
	* @param string $method
	* @return void
	* @throws \Cake\Http\Exception\RedirectException
	*/
	protected function save({{ entityClassName }} ${{ singularName }}, string $method = 'add'): void {
		$la_associated = [];
		if ($this->{{ currentModelName }}->hasAttributes()) {
			$la_associated[] = $this->{{ currentModelName }}->getAttributesTableName(true);
			${{ singularName }}->setAccess('attributes', true);
		}

		$this->{{ currentModelName }}->patchEntity(${{ singularName }}, $this->request->getData(), [
			'associated' => $la_associated,
			'validate' => !$this->request->getData('reload_form'),
		]);

		if (!$this->request->getData('reload_form')) { //reload_form is set when we need to reload options based on current values
			if ($this->{{ currentModelName }}->save(${{ singularName }}, ['asCopy' => (bool)$this->request->getData('save_as_copy')])) {
				$this->Flash->success(__($method . '_succeeded'));

				if ($this->request->getData('submit') == 'submit_close') {
					throw new RedirectException(Router::url(['action' => 'overview'], true), 302);
				}

				throw new RedirectException(Router::url(['action' => 'edit', 'id' => ${{ singularName }}->id], true), 302);
			}

			$this->Flash->error(__($method . '_failed'));
			foreach (${{ singularName }}->getError('_general') as $ls_error) {
				$this->Flash->error($ls_error);
			}
		}
		elseif ($this->{{ currentModelName }}->hasBehavior('SystemOrder')) {
			if ($this->{{ currentModelName }}->getSystemOrderRelatedColumns(${{ singularName }})) {
				${{ singularName }}->systemOrder = null;
			}
			else {
				${{ singularName }}->systemOrder = ${{ singularName }}->hasOriginal('systemOrder') ? ${{ singularName }}->getOriginal('systemOrder') : ${{ singularName }}->get('systemOrder');
			}
		}
	}
