
	/**
	 * @param \{{ namespace }}\Model\Entity\{{ entityClassName }} ${{ singularName }}
	 * @param string $method
	 * @return void
	 * @throws \Cake\Http\Exception\RedirectException
	 */
	protected function save({{ entityClassName }} ${{ singularName }}, string $method = 'add'): void {
		$associated = [];
		if ($this->{{ currentModelName }}->hasAttributes()) {
			$associated[] = $this->{{ currentModelName }}->getAttributesTableName(true);
			${{ singularName }}->setAccess('attributes', true);
		}

		$this->{{ currentModelName }}->patchEntity(${{ singularName }}, $this->request->getData(), [
			'associated' => $associated,
			'validate' => !$this->request->getData('reloadForm'),
		]);

		if (!$this->request->getData('reloadForm')) { //reloadForm is set when we need to reload options based on current values
			$saveAsCopy = (bool)$this->request->getData('saveAsCopy');

			if ($this->{{ currentModelName }}->save(${{ singularName }}, ['asCopy' => $saveAsCopy])) {
				if (!$this->request->is('ajax')) {
					$this->Flash->success(__(($saveAsCopy ? 'add' : $method) . '_succeeded'));
				}

				if ($this->request->getData('submitType') == 'submitClose') {
					throw new RedirectException(Router::url([
						'action' => 'overview',
						'page' => $this->Paginate->calculateEntityPagePosition(${{ singularName }}),
					], true), 302);
				}

				throw new RedirectException(Router::url(['action' => 'edit', 'id' => ${{ singularName }}->id], true), 302);
			}

			if (!$this->request->is('ajax')) {
				$this->Flash->error(__(($saveAsCopy ? 'add' : $method) . '_failed'));
				foreach (${{ singularName }}->getError('_general') as $error) {
					$this->Flash->error($error);
				}
			}
		}
	}
