
	/**
	 * Overview method
	 *
	 * @throws \Exception
	 */
	public function overview(): void {
		$this->Authorization->ensure('read');


		$lo_query = $this->getOverviewQuery();
		$lo_{{ pluralName }} = $this->paginate($lo_query);

		$this->set([
			'{{ pluralName }}' => $lo_{{ pluralName }},
			'attributes' => $this->{{ currentModelName }}->getAttributes(),
		]);
	}
