{
	"name": "awyiss/awyiss",
	"description": "Awyiss! The CakePHP-based CMS you didn't know you'd need",
	"homepage": "https://awyiss.2f.media",
	"type": "library",
	"license": "MIT",
	"require": {
		"php": ">=8.4",
		"ext-curl": "*",
		"ext-dom": "*",
		"ext-fileinfo": "*",
		"ext-gd": "*",
		"ext-intl": "*",
		"ext-libxml": "*",
		"ext-openssl": "*",
		"ext-posix": "*",
		"ext-zip": "*",
		"ext-zlib": "*",
		"altcha-org/altcha": "^2.1",
		"cakephp/authentication": "^4.2.1",
		"cakephp/bake": "^3.8.1",
		"cakephp/cakephp": "^5.4.1",
		"cakephp/migrations": "^5.2.6",
		"cakephp/plugin-installer": "^2.0.2",
		"cakephp/twig-view": "^2.1.2",
		"dereuromark/cakephp-queue": "^8.15.1",
		"endroid/qr-code": "^6.1",
		"friendsofcake/cakephp-csvview": "^5.1",
		"intervention/image": "^4.3.1",
		"jaybizzle/crawler-detect": "^1.4.1",
		"josegonzalez/dotenv": "^4.0",
		"matthiasmullie/minify": "^1.3.75",
		"paragonie/csp-builder": "^3.1.0",
		"scssphp/scssphp": "^2.1",
		"spomky-labs/otphp": "^11.5",
		"symfony/var-dumper": "^8.1.5",
		"tijsverkoyen/css-to-inline-styles": "^2.4",
		"tinymce/tinymce": "^8.8.2"
	},
	"require-dev": {
		"awyiss/phpcs-sniffs": "^0.9.0",
		"cakephp/cakephp-codesniffer": "^5.3.2",
		"cakephp/debug_kit": "^5.2.4",
		"dereuromark/cakephp-ide-helper": "^2.22.6",
		"phpunit/phpunit": "^13.3.2",
		"psy/psysh": "@stable",
		"squizlabs/php_codesniffer": "^4.0.4"
	},
	"autoload": {
		"psr-4": {
			"Awyiss\\": "./awyiss/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Awyiss\\Test\\": "./tests/"
		}
	},
	"scripts": {
		"post-update-cmd": "bin/cake integrity_check check -mi",
		"check": [
			"@test",
			"@cs-check"
		],
		"cs-check": "phpcs --colors -p ./awyiss/ ./tests/",
		"cs-fix": "phpcbf --colors -p ./awyiss/ ./tests/",
		"stan": "phpstan analyse",
		"test": "phpunit --colors=always"
	},
	"prefer-stable": true,
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"cakephp/plugin-installer": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
