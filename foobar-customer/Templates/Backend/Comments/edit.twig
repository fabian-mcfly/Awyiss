{#
@var ao_comment Cake\Datasource\EntityInterface
@var _view \Awyiss\View\BackendView
#}

<div class="Comments Form Edit">
	<h1>{{ __('headline_edit') }}</h1>

	{{ helper_Form_create(ao_comment, {method: 'post', idPrefix: 'comment'}) }}

	{% block formButtons %}
		{{ helper_Form_button(__('save')) }}
		{{ helper_Form_button(__('save_close'), {name: 'submit', value: 'submit_close'}) }}
	{% endblock %}

	{% include('@Backend/Comments/form.twig') %}

	{{ block('formButtons') }}

	{{ helper_Form_end() -}}
</div>