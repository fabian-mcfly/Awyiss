{#
@var page \Awyiss\Model\Entity\Page
@var pageRoleEnum \Awyiss\Model\Enum\PageRoleEnumInterface
@var childPages \Awyiss\Model\Entity\Page[]
@var baseUrl string
@var currentLanguage \Awyiss\Model\Entity\Language
@var currentPath string
@var currentUrl string
@var folder string
@var languages \Awyiss\Model\Entity\Language[]
@var languageShortcode string
@var _view \Awyiss\View\FrontendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
#}

{% set contents = content('ContentArea', {includeWrapper: false}) %}
{% if contents %}
	{% block contentArea %}
		<main id="ContentArea">
			{% block contentAreaContent %}
				{{ contents }}
			{% endblock %}
		</main>
	{% endblock %}
{% endif %}

{% if childPages %}
	{% block pageTeasersSection %}
		<section class="ContentElement Template-Section PageTeasers">
			{% block pageTeasersContentRow %}
				<div class="ContentRow">
					{% block pageTeasersList %}
						{% for childPage in childPages %}
							{% block pageTeaser %}
								<article class="PageTeaser">
									{% block pageTeaserTitle %}
										<h2 class="PageTeaser-Title Title">
											{{- childPage.title -}}
										</h2>
									{% endblock %}

									{% if childPage.teaser %}
										{% block pageTeaserTeaser %}
											<p class="PageTeaser-Teaser Teaser">
												{{- childPage.teaser -}}
											</p>
										{% endblock %}
									{% endif %}

									{% block pageTeaserLink %}
										<a href="{{ UrlHelper.build({lang: childPage.languageShortcode, slug: childPage.slug}) }}" class="PageTeaser-Link Link">
											{{- childPage.title -}}
										</a>
									{% endblock %}
								</article>
							{% endblock %}
						{% endfor %}
					{% endblock %}
				</div>
			{% endblock %}
		</section>
	{% endblock %}
{% endif %}
