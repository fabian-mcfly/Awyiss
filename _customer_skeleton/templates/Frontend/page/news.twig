{#
@var page \Awyiss\Model\Entity\Page
@var category \Awyiss\Model\Entity\Page|null
@var newer \Awyiss\Model\Entity\Page|null
@var older \Awyiss\Model\Entity\Page|null
@var pageRoleEnum \Awyiss\Model\Enum\PageRoleEnumInterface
@var baseUrl string
@var currentLanguage \Awyiss\Model\Entity\Language
@var currentPath string
@var currentUrl string
@var folder string
@var languages \Awyiss\Model\Entity\Language[]
@var languageShortcode string
@var _view \Awyiss\View\FrontendView
@var AssetHelper \Awyiss\View\Helper\AssetHelper
@var FormHelper \Awyiss\View\Helper\FormHelper
@var HtmlHelper \Cake\View\Helper\HtmlHelper
@var LocaleHelper \Awyiss\View\Helper\LocaleHelper
@var MediaHelper \Awyiss\View\Helper\MediaHelper
@var UrlHelper \Awyiss\View\Helper\UrlHelper
@var TimeHelper \Cake\View\Helper\TimeHelper
@var mediaRenderOptions \Awyiss\Utility\Media\MediaRenderOptions

Manually built element structure to mimic the structure
of a regular page with contents.

#}

{% macro newsItem(newsItem) %}
	<div class="ContentRow">
		<div class="ContentElement Column-100 Template-Standard BackgroundColor BackgroundColor-Bright NewsItem" id="NewsItem{{ newsItem.id }}">
			{% if newsItem.mediaAssignments.titleAndTeaserImage.teaserMedia %}
				<div class="Image">
					{{ MediaHelper.htmlTag(
						newsItem.mediaAssignments.titleAndTeaserImage.teaserMedia,
						mediaRenderOptions.withColumnWidth(40).withHeight(200).withResizeStrategy('cover')
					) }}
				</div>
			{% endif %}
			<div class="Text">
				<h4>{{ newsItem.title }}</h4>

				<p class="Date">{{ newsItem.date.i18nFormat(0) }}</p>

				{% if newsItem.teaser %}
					{% if '<' in newsItem.teaser %}
						<div class="Teaser">{{ newsItem.teaser|raw }}</div>
					{% else %}
						<p class="Teaser">{{ newsItem.teaser|nl2br }}</p>
					{% endif %}
				{% endif %}

				<p class="Link">
					<a href="{{ UrlHelper.build({lang: newsItem.languageShortcode, slug: newsItem.slug}) }}" class="Button">
						{{ __d('module', 'read_more') }}
					</a>
				</p>
			</div>
		</div>
	</div>
{% endmacro %}
{% import _self as macros %}

{% if page.mediaAssignments.titleAndTeaserImage.titleMedia %}
	{{ MediaHelper.background(
		page.mediaAssignments.titleAndTeaserImage.titleMedia,
		mediaRenderOptions.withSelector('#News' ~ page.id ~ ' .TitleImage::before'),
	) }}
{% endif %}

<article id="ContentArea">
	<section class="ContentElement Template-Section" id="News{{ page.id }}">
		<div class="ContentRow TitleImage">
			<div class="ContentElement Template-Standard">
				<div class="Text">
					<p class="Date">{{ page.date.i18nFormat(0) }}</p>
					<h1 class="Title">{{ page.title }}</h1>
				</div>
			</div>
		</div>
		<div class="ContentRow">
			<div class="ContentElement Column-60 Template-Standard">
				<div class="Text">
					{{ page.text|raw }}
				</div>
			</div>

			{% if newer or older%}
				<div class="ContentElement Column-40 Template-Standard NewsItems">
					<div class="Text">
						<h3>Weitere Meldungen</h3>
					</div>
					<div class="Children">
						{% if newer %}
							{{ macros.newsItem(newer) }}
						{% endif %}

						{% if older %}
							{{ macros.newsItem(older) }}
						{% endif %}
					</div>
				</div>
			{% endif %}
		</div>
		{% if category %}
				<div class="ContentRow">
					<div class="ContentElement Column-60 Template-Standard">
						<div class="Text">
							<a href="{{ UrlHelper.build({lang: category.languageShortcode, slug: category.slug}) }}" class="Button">Zur Übersicht</a>
						</div>
					</div>
				</div>
		{% endif %}
	</section>
</article>
